;\n        max-height: 46px;\n        min-width: calc(100vw - #{$title-offset + $btn-edit-width});\n        max-width: calc(100vw - #{$title-offset + $btn-edit-width});\n        text-overflow: unset;\n        white-space: normal !important;\n        line-height: 18px;\n        overflow-y: auto;\n        border: 1px solid $primary;\n        border-radius: 4px;\n        overflow: hidden;\n\n        &::-webkit-scrollbar {\n            display: none;\n        }\n    }\n\n    &:hover {\n        cursor: pointer;\n    }\n\n    &:focus {\n        cursor: text;\n    }\n}\n\n.editButtonsContainer {\n    position: absolute;\n    top: 0;\n    right: 0;\n    left: 0;\n    width: 100%;\n    background: $white;\n\n    &::before {\n        content: "";\n        position: absolute;\n        top: 0;\n        left: -23px;\n        width: 24px;\n        height: 100%;\n        background: linear-gradient(to left, $white, rgba($white, 0));\n    }\n\n    &::after {\n        content: "";\n        position: absolute;\n        top: 0;\n        right: -23px;\n        width: 24px;\n        height: 100%;\n        background: linear-gradient(to right, $white, rgba($white, 0));\n    }\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6