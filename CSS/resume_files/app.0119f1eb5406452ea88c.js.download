a71;border-color:#249a71}',"",{version:3,sources:["webpack://./src/pages/JobFeed/components/CompanyReviews/CompanyReviews.module.scss","webpack://./node_modules/enhancv-styleguide/variables.scss"],names:[],mappings:"AAAA,sCAEA,wBACI,CAAA,kBACA,CAAA,eACA,CAAA,eACA,CAAA,kBCwEO,CAAA,6CDpEX,mBACI,CAAA,kBACA,CAAA,eACA,CAAA,kBCoEM,CAAA,UA/CF,CAAA,cDlBJ,CAAA,eACA,CAAA,iBACA,CAAA,wBACA,CAAA,mCAGJ,YACI,CAAA,yCAGJ,eACI,CAAA,wBACA,CAAA,2CAGJ,cACI,CAAA,eACA,CAAA,aCYa,CAAA,aDVb,CAAA,uCAGJ,YACI,CAAA,OACA,CAAA,cACA,CAAA,yCAGJ,aACI,CAAA,cACA,CAAA,wCAGJ,aCsDiB,CAAA,cDpDb,CAAA,0CAGJ,cACI,CAAA,aC2BQ,CAAA,cDzBR,CAAA,eACA,CAAA,2CAGJ,MACI,CAAA,WACA,CAAA,YACA,CAAA,qBACA,CAAA,OACA,CAAA,iBACA,CAAA,qCAEA,2CARJ,eASQ,CAAA,iBCrEM,CAAA,CAAA,sCD0Ed,YACI,CAAA,kBACA,CAAA,OC5EU,CAAA,wCDgFd,YACI,CAAA,kBACA,CAAA,OClFU,CAAA,cDoFV,CAAA,aCHQ,CAAA,cDKR,CAAA,wBACA,CAAA,4CAGJ,aCTY,CAAA,cDWR,CAAA,0CAGJ,MACI,CAAA,UACA,CAAA,kBCbM,CAAA,iBDeN,CAAA,eACA,CAAA,2CAGJ,WACI,CAAA,kBC7EM,CAAA,iBD+EN,CAAA,yBACA,CAAA,sCAGJ,cACI,CAAA,eACA,CAAA,aC/BQ,CAAA,cDiCR,CAAA,gBACA,CAAA,0CAGJ,gBACI,CAAA,YACA,CAAA,qBACA,CAAA,QACA,CAAA,yCAGJ,YACI,CAAA,eC7FI,CAAA,iBD+FJ,CAAA,wBACA,CAAA,2CAGJ,YACI,CAAA,sBACA,CAAA,6BACA,CAAA,OCvIU,CAAA,4CD2Id,cACI,CAAA,eACA,CAAA,aC7DM,CAAA,QD+DN,CAAA,yCAGJ,cACI,CAAA,aCjEI,CAAA,kBDmEJ,CAAA,aACA,CAAA,yCAGJ,YACI,CAAA,kBACA,CAAA,OACA,CAAA,cC5JU,CAAA,cD8JV,CAAA,aC7EQ,CAAA,6CDiFZ,aCvIU,CAAA,cDyIN,CAAA,yCAGJ,cCvKc,CAAA,iBDyKV,CAAA,cACA,CAAA,aCzFQ,CAAA,eD2FR,CAAA,iDAEA,WACI,CAAA,gDAGJ,WACI,CAAA,yCAIR,YACI,CAAA,kBACA,CAAA,sBACA,CAAA,OACA,CAAA,gBACA,CAAA,yCAGJ,YACI,CAAA,kBACA,CAAA,sBACA,CAAA,UACA,CAAA,WACA,CAAA,wBACA,CAAA,iBACA,CAAA,eCrKI,CAAA,aAgDI,CAAA,cDwHR,CAAA,cACA,CAAA,wBACA,CAAA,8DAEA,kBCjIG,CAAA,oBAMC,CAAA,kDDgIJ,UACI,CAAA,cACA,CAAA,+CAIR,kBC7LU,CAAA,oBAAA,CAAA,UAMF,CAAA,oED4LJ,kBCjLa,CAAA,oBAAA",sourcesContent:['@import "enhancv-styleguide/variables";\n\n.section {\n    border: 1px solid $accent;\n    border-radius: 12px;\n    overflow: hidden;\n    margin-top: $base-offset * 2;\n    background: $page-alt;\n}\n\n.glassdoorBadge {\n    display: inline-flex;\n    align-items: center;\n    padding: 4px $base-offset;\n    background: $heading;\n    color: $surface;\n    font-size: 12px;\n    font-weight: 500;\n    border-radius: 4px;\n    border: 1px solid $accent;\n}\n\n.body {\n    padding: $base-offset * 2;\n}\n\n.ratingCard {\n    min-width: 200px;\n    border: 2px solid $visual-green-1;\n}\n\n.ratingNumber {\n    font-size: 38px;\n    font-weight: 700;\n    color: $primary-active;\n    line-height: 1;\n}\n\n.starsRow {\n    display: flex;\n    gap: 2px;\n    margin-top: $base-offset / 2;\n}\n\n.starFilled {\n    color: $primary-active;\n    font-size: 16px;\n}\n\n.starEmpty {\n    color: $visual-green-1;\n    font-size: 16px;\n}\n\n.reviewCount {\n    font-size: 12px;\n    color: $paragraph;\n    margin-top: $base-offset / 2;\n    font-weight: 500;\n}\n\n.distribution {\n    flex: 1;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 6px;\n    margin-block: $base-offset * 4;\n\n    @media screen and (max-width: $screen-sm-max) {\n        margin-top: $base-offset * 2;\n        margin-bottom: $base-offset;\n    }\n}\n\n.distRow {\n    display: flex;\n    align-items: center;\n    gap: $base-offset;\n}\n\n.distLabel {\n    display: flex;\n    align-items: center;\n    gap: $base-offset;\n    font-size: 14px;\n    color: $paragraph;\n    min-width: 38px;\n    justify-content: flex-end;\n}\n\n.distLabelStar {\n    color: $paragraph;\n    font-size: 16px;\n}\n\n.progressBar {\n    flex: 1;\n    height: 6px;\n    background: $subtext;\n    border-radius: 4px;\n    overflow: hidden;\n}\n\n.progressFill {\n    height: 100%;\n    background: $primary;\n    border-radius: 4px;\n    transition: width 0.3s ease;\n}\n\n.distPct {\n    font-size: 14px;\n    font-weight: 500;\n    color: $paragraph;\n    min-width: 36px;\n    text-align: right;\n}\n\n.reviewsList {\n    padding-top: $base-offset * 2;\n    display: flex;\n    flex-direction: column;\n    gap: $base-offset * 2;\n}\n\n.reviewCard {\n    padding: $base-offset * 2;\n    background: $surface;\n    border-radius: 8px;\n    border: 1px solid $graphic-2;\n}\n\n.reviewHeader {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: $base-offset;\n}\n\n.reviewSummary {\n    font-size: 14px;\n    font-weight: 700;\n    color: $heading;\n    margin: 0;\n}\n\n.reviewDate {\n    font-size: 12px;\n    color: $label;\n    white-space: nowrap;\n    flex-shrink: 0;\n}\n\n.reviewMeta {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    margin-top: $base-offset;\n    font-size: 14px;\n    color: $paragraph;\n}\n\n.reviewMetaStar {\n    color: $primary;\n    font-size: 16px;\n}\n\n.reviewPros {\n    margin-top: $base-offset;\n    margin-bottom: 0px;\n    font-size: 14px;\n    color: $paragraph;\n    line-height: 1.5;\n\n    &::before {\n        content: "\\201C";\n    }\n\n    &::after {\n        content: "\\201D";\n    }\n}\n\n.pagination {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 4px;\n    padding-top: $base-offset * 2;\n}\n\n.pageButton {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 32px;\n    height: 32px;\n    border: 1px solid $graphic-2;\n    border-radius: 6px;\n    background: $surface;\n    color: $paragraph;\n    font-size: 14px;\n    cursor: pointer;\n    transition: all 0.15s ease;\n\n    &:hover:not(:disabled) {\n        background: $page;\n        border-color: $label;\n    }\n\n    &:disabled {\n        opacity: 0.4;\n        cursor: default;\n    }\n}\n\n.pageButtonActive {\n    background: $primary;\n    border-color: $primary;\n    color: $surface;\n\n    &:hover:not(:disabled) {\n        background: $primary-active;\n        border-color: $primary-active;\n    }\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;