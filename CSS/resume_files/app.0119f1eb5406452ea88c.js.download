ing: border-box;\n    transition: transform 0.1s ease-out, border-color 0.2s ease, box-shadow 0.2s ease;\n\n    &:hover {\n        border-color: rgba($secondary-active, 0.5);\n        box-shadow: $shadow-default;\n    }\n\n    &.selected {\n        border-color: $secondary-active;\n        box-shadow: $shadow-hover;\n    }\n\n    .elementImage {\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n        border-radius: 2px;\n        pointer-events: none;\n        display: block;\n        user-select: none;\n        -webkit-user-drag: none;\n    }\n}\n\n.textElement {\n    width: 100%;\n    height: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    user-select: none;\n    cursor: move;\n    text-align: center;\n    word-wrap: break-word;\n    overflow: hidden;\n    pointer-events: none;\n    white-space: nowrap;\n    text-overflow: ellipsis;\n}\n\n.resizeHandle,\n.rotationHandle,\n.deleteHandle {\n    transition: all 0.2s ease;\n}\n\n// Focus states for accessibility\n.resizeHandle:focus,\n.rotationHandle:focus,\n.deleteHandle:focus {\n    outline: 2px solid $primary;\n    outline-offset: 2px;\n}\n\n// Print styles\n@media print {\n    .canvasContainer {\n        padding: 0;\n    }\n\n    .canvas {\n        box-shadow: none;\n        border-radius: 0;\n    }\n}\n\n.hr {\n    border-color: $graphic-1;\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: 