 textarea + scroll\n    height: $base-offset;\n    position: absolute;\n    left: 9px; // 8px padding + 1px border\n    bottom: 10px;\n    background: $surface;\n    border-radius: $base-offset;\n    cursor: pointer;\n}\n\n.icon {\n    max-width: 32px;\n    width: 100%;\n    display: flex !important;\n    aspect-ratio: 1/1;\n}\n\n.separator {\n    border-top: 1px solid $subtext;\n}\n\n.chevronIcon {\n    transition: all 0.3s ease-in-out;\n}\n\n.rotate {\n    transform: rotate(180deg);\n}\n\n.collapsibleMenu {\n    transition: all 0.5s ease-in-out;\n    overflow: hidden;\n    max-height: 0;\n}\n\n.expand {\n    max-height: 100vh;\n}\n\n.response {\n    background: linear-gradient(239deg, rgba(#000, 0.9) 85.46%, rgba($secondary-active, 0.9) 100%);\n}\n\n.loading {\n    position: relative;\n    width: 6px;\n    height: 6px;\n    border-radius: 5px;\n    background-color: $surface;\n    margin: 5px auto;\n    animation: dot-flashing 1s infinite linear alternate;\n    animation-delay: 0.5s;\n\n    &::before,\n    &::after {\n        content: "";\n        display: inline-block;\n        position: absolute;\n        width: 6px;\n        height: 6px;\n        border-radius: 5px;\n        background-color: $surface;\n        animation: dot-flashing 1s infinite alternate;\n        top: 0;\n    }\n\n    &::before {\n        left: -10px;\n        animation-delay: 0s;\n    }\n\n    &::after {\n        left: 10px;\n        animation-delay: 1s;\n    }\n}\n\n@keyframes dot-flashing {\n    0% {\n        opacity: 1;\n    }\n\n    50%,\n    100% {\n        opacity: 0.5;\n    }\n}\n\n.ignored {\n    opacity: 0.2;\n}\n\n.systemComment {\n    border-radius: 2px $base-offset * 2 $base-offset * 2 $base-offset * 2;\n}\n\n.userComment {\n    border-radius: $base-offset * 2 2px $base-offset * 2 $base-offset * 2;\n    background: linear-gradient(83deg, $visual-violet-2 2.31%, $accent 44.34%);\n}\n\n.userIcon {\n    width: 32px;\n    height: 32px;\n\n    i {\n        position: absolute;\n        transform: translate(-50%, -50%);\n        top: 50%;\n        left: 50%;\n    }\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6df;\n$warning-hover: #feba62;\n\n// // Active elements\n$primary-active: #249a71;\n$secondary-active: #5f4dc7;\n$info-active: #3685bb;\n$warning-active: #d89745;\n$danger-active: #d94a5e;\n\n// // Transparent elements\n// // // opacity: 10%;\n$primary-10: rgba($primary, 0.1);\n$secondary-10: rgba($secondary, 0.1);\n$accent-10: rgba($accent, 0.1);\n$info-10: rgba($info, 0.1);\n$warning-10: rgba($warning, 0.1);\n$danger-10: rgba($danger, 0.1);\n// // // opacity 20%\n$primary-20: rgba($primary, 0.2);\n$secondary-20: rgba($secondary, 0.2);\n$accent-20: rgba($accent, 0.2);\n$info-20: rgba($info, 0.2);\n$warning-20: rgba($warning, 0.2);\n$danger-20: rgba($danger, 0.2);\n// // // opacity 30%\n$primary-30: rgba($primary, 0.3);\n$secondary-30: rgba($secondary, 0.3);\n$accent-30: rgba($accent, 0.3);\n$info-30: rgba($info, 0.3);\n$warning-30: rgba($warning, 0.3);\n$danger-30: rgba($danger, 0.3);\n\n// // Backgrounds\n$surface: $white;\n$surface-accent: #9cb2dc;\n$page: #f5f7fc;\n$page-alt: #fafbfd;\n\n// // Typography Colors\n$heading: #2d3639;\n$paragraph: #384347;\n$label: #60696c;\n$caption: #afb4b5;\n$subtext: #d8d9db;\n\n// // Supportive colors\n$modal: #47445a;\n$graphic-1: #f0f0f0;\n$graphic-2: #e4e4e4;\n$graphic-3: #f2f2f2;\n$border-color: #e0e0e0;\n\n// // CC colors\n$primary-cc: #eaf9f4;\n$secondary-cc: #f3f2fb;\n$danger-cc: #ffeef1;\n$info-cc: #ecf5fc;\n\n// // Visual elements Colors\n$visual-violet-1: #d1cbf1;\n$visual-violet-2: #e3e0f6;\n$visual-green-1: #abe6d1;\n$visual-green-2: #cdf0e4;\n$visual-blue: #b2d7f1;\n$visual-orange: #ffe0b9;\n$visual-pink: #ffcdd4;\n\n// // Shadows\n$shadow-default: 0px 4px 8px rgba(0, 0, 0, 0.1);\n$shadow-hover: 0px 2px 20px rgba(0, 0, 0, 0.1);\n$shadow-flat: 1px 1px 1px rgba(231, 228, 228, 0.5);\n$shadow-main-navigation: 0px 1px 3px rgba(0, 0, 0, 0.1);\n\n// Font-sizes\n$font-size-lg: 20px;\n$font-size-md: 18px;\n$font-size-rg: 16px;\n$font-size-sm: 14px;\n$font-size-xs: 12px;\n$font-size-xs-min: 10px;\n\n// Container - (with padding-inline:16px included)\n$container-xs: 100%;\n$container-md: 736px; // 12columns x 64px\n$container-lg: 956px; // 12columns x 84px\n$container-xl: 1184px; // 12columns x 96px\n$container-xxl: 1328px; // 12columns x 108px\n\n// Z-index modal\n$zindex-modal-background: 1002;\n$zindex-modal-content: 1003;\n'],sourceRoot:""}]),l.locals={locked:"ChatBox-module_locked__jg0Ma",lockedOverlay:"ChatBox-module_lockedOverlay___94tk",lockedMessageContainer:"ChatBox-module_lockedMessageContainer__vmdzY",contentContainer:"ChatBox-module_contentContainer___RxX2",inputContainer:"ChatBox-module_inputContainer__zuFt4",textAreaStyle:"ChatBox-module_textAreaStyle__fnP4t",enterIcon:"ChatBox-module_enterIcon__xlU7I",fakeOverlayOfTextArea:"ChatBox-module_fakeOverlayOfTextArea__RN2Md",icon:"ChatBox-module_icon__DIUX9",separator:"ChatBox-module_separator__LYsW2",chevronIcon:"ChatBox-module_chevronIcon__HqSPa",rotate:"ChatBox-module_rotate__UFAJz",collapsibleMenu:"ChatBox-module_collapsibleMenu__Tz0bu",expand:"ChatBox-module_expand__g2FXT",response:"ChatBox-module_response__m0TqN",loading:"ChatBox-m