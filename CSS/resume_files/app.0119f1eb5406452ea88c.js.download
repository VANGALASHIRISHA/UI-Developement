ast-child {\n        .resume-item-holder {\n            > .inner {\n                border-bottom: 1px dashed $gray-lighter;\n            }\n        }\n    }\n}\n\n/*TODO: Vikich please add this  */\n.resume-renderer-two-column {\n    &:first-child {\n        .resume-item-holder {\n            &:nth-child(2n + 1) {\n                .skill-item {\n                    padding-right: 5px;\n                }\n            }\n\n            &:nth-child(2n) {\n                .skill-item {\n                    padding-left: 5px;\n                }\n            }\n        }\n    }\n\n    &:nth-child(2) {\n        .skill-item.item-object {\n            width: 100%;\n        }\n    }\n}\n'],sourceRoot:""}]),l.locals={skillItemContent:"SkillItemDefault-module_skillItemContent__FeROZ",skillItemName:"SkillItemDefault-module_skillItemName__VNgp5",skillItemNameCondensed:"SkillItemDefault-module_skillItemNameCondensed__QBwra SkillItemDefault-module_skillItemName__VNgp5",sliderComponent:"SkillItemDefault-module_sliderComponent__Bheff",skillItem:"SkillItemDefault-module_skillItem__GdWXC",sliderContainer:"SkillItemDefault-module_sliderContainer__qEHAC",sliderContainerCondensed:"SkillItemDefault-module_sliderContainerCondensed__pj_0V SkillItemDefault-module_sliderContainer__qEHAC",skills:"SkillItemDefault-module_skills__JsXVi","resume-item-holder":"SkillItemDefault-module_resume-item-holder__pbqT5",inner:"SkillItemDefault-module_inner__Wjss6","resume-renderer-two-column":"SkillItemDefault-module_resume-renderer-two-column__ysFZY","skill-item":"SkillItemDefault-module_skill-item__ap62Y","item-object":"SkillItemDefault-module_item-object__YEqQB"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/packages/Resume/ItemTypes/Skill/SkillItemElegant.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-