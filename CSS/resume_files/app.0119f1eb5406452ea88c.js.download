modules/enhancv-styleguide/variables.scss"],names:[],mappings:"AAGI,uDACI,cAAA,CAGJ,gDACI,cAAA,CAIR,8CACI,cAAA,CACA,2CAAA,CAEA,oDACI,wBCqFU,CDjFlB,2CACI,UAAA,CACA,WAAA,CAGJ,iDACI,YAAA,CACA,qBAAA,CACA,WAAA,CACA,gBAAA,CAGJ,iDACI,eAAA,CACA,KAAA,CACA,eCFI,CDGJ,SAAA,CACA,+BAAA,CAGJ,yCACI,MAAA,CACA,YAAA,CACA,eAAA,CAGJ,0CACI,eAAA,CACA,cAAA,CAGJ,6CACI,UAAA,CACA,WAAA,CACA,iBAAA,CACA,gBAAA",sourcesContent:['@import "enhancv-styleguide/variables";\n\n.jobInput {\n    &:global(.form-control) {\n        cursor: pointer;\n    }\n\n    input {\n        font-size: 14px;\n    }\n}\n\n.dropdownItem {\n    cursor: pointer;\n    transition: background-color 0.4s ease-in-out;\n\n    &:hover {\n        background-color: $visual-violet-2;\n    }\n}\n\n.checkmark {\n    width: 16px;\n    height: 16px;\n}\n\n.dropdownContent {\n    display: flex;\n    flex-direction: column;\n    height: 100%;\n    max-height: 260px; // Subtract padding\n}\n\n.addNewJobButton {\n    position: sticky;\n    top: 0;\n    background: $white;\n    z-index: 1;\n    border-bottom: 1px solid $graphic-1;\n}\n\n.jobList {\n    flex: 1;\n    min-height: 0; // This is important for flex child to respect parent height\n    overflow-y: auto;\n}\n\n.jobTitle {\n    font-weight: 500;\n    font-size: 14px;\n}\n\n.companyLogo {\n    width: 24px;\n    height: 24px;\n    border-radius: 50%;\n    object-fit: cover;\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6df;\n$warning-hover: #feba62;\n\n// // Active elements\n$primary-active: #249a71;\n$secondary-active: #5f4dc7;\n$info-active: #3685bb;\n$warning-active: #d89745;\n$danger-active: #d94a5e;\n\n// // Transparent elements\n// // // opacity: 10%;\n$primary-10: rgba($primary, 0.1);\n$secondary-10: rgba($secondary, 0.1);\n$accent-10: rgba($accent, 0.1);\n$info-10: rgba($info, 0.1);\n$warning-10: rgba($warning, 0.1);\n$danger-10: rgba($danger, 0.1);\n// // // opacity 20%\n$primary-20: rgba($primary, 0.2);\n$secondary-20: rgba($secondary, 0.2);\n$accent-20: rgba($accent, 0.2);\n$info-20: rgba($info, 0.2);\n$warning-20: rgba($warning, 0.2);\n$danger-20: rgba($danger, 0.2);\n// // // opacity 30%\n$primary-30: rgba($primary, 0.3);\n$secondary-30: rgba($secondary, 0.3);\n$accent-30: rgba($accent, 0.3);\n$info-30: rgba($info, 0.3);\n$warning-30: rgba($warning, 0.3);\n$danger-30: rgba($danger, 0.3);\n\n// // Backgrounds\n$surface: $white;\n$surface-accent: #9cb2dc;\n$page: #f5f7fc;\n$page-alt: #fafbfd;\n\n// // Typography Colors\n$heading: #2d3639;\n$paragraph: #384347;\n$label: #60696c;\n$caption: #afb4b5;\n$subtext: #d8d9db;\n\n// // Supportive colors\n$modal: #47445a;\n$graphic-1: #f0f0f0;\n$graphic-2: #e4e4e4;\n$graphic-3: #f2f2f2;\n$border-color: #e0e0e0;\n\n// // CC colors\n$primary-cc: #eaf9f4;\n$secondary-cc: #f3f2fb;\n$danger-cc: #ffeef1;\n$info-cc: #ecf5fc;\n\n// // Visual elements Colors\n$visual-violet-1: #d1cbf1;\n$visual-violet-2: #e3e0f6;\n$visual-green-1: #abe6d1;\n$visual-green-2: #cdf0e4;\n$visual-blue: #b2d7f1;\n$visual-orange: #ffe0b9;\n$visual-pink: #ffcdd4;\n\n// // Shadows\n$shadow-default: 0px 4px 8px rgba(0, 0, 0, 0.1);\n$shadow-hover: 0px 2px 20px rgba(0, 0, 0, 0.1);\n$shadow-flat: 1px 1px 1px rgba(231, 228, 228, 0.5);\n$shadow-main-navigation: 0px 1px 3px rgba(0, 0, 0, 0.1);\n\n// Font-sizes\n$font-size-lg: 20px;\n$font-size-md: 18px;\n$font-size-rg: 16px;\n$font-size-sm: 14px;\n$font-size-xs: 12px;\n$font-size-xs-min: 10px;\n\n// Container - (with padding-inline:16px included)\n$container-xs: 100%;\n$container-md: 736px; // 12columns x 64px\n$container-lg: 956px; // 12columns x 84px\n$container-xl: 1184px; // 12columns x 96px\n$container-xxl: 1328px; // 12columns x 108px\n\n// Z-index modal\n$zindex-modal-background: 1002;\n$zindex-modal-content: 1003;\n'],sourceRoot:""}]),l.locals={jobInput:"AddJobAppDropdown-module_jobInput__vxm8n",dropdownItem:"AddJobAppDropdown-module_dropdownItem__IM9D2",checkmark:"AddJobAppDropdown-module_checkmark__xgnYC",dropdownContent:"AddJobAppDropdown-module_dropdownContent__yNK7U",addNewJobButton:"AddJobAppDropdown-module_addNewJobButton__D8u7h",jobList:"AddJobAppDropdown-module_jobList__D4m3c",jobTitle:"AddJobAppDropdown-module_jobTitle__K3x1g",companyLogo:"AddJobAppDropdown-module_companyLogo__Pkk0z"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/modules/BottomRightPopup/BottomRightPopup.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,".BottomRightPopup-module_popup__yl5Kx{position:fixed;bottom:24px;right:24px;z-index:1000;min-width:400px;box-shadow:0 8px 24px 0 rgba(0,0,0,.15);animation:BottomRightPopup-module_slideIn__dU14d .3s cubic-bezier(0.33, 1, 0.68, 1) forwards}.BottomRightPopup-module_closeButton__HosoA{position:absolute;top:12px;right:12px;z-index:1}@keyframes BottomRightPopup-module_slideIn__dU14d{from{transform:translateY(calc(100% + 24px));opacity:0}to{transform:translateY(0);opacity:1}}","",{version:3,sources:["webpack://./src/modules/BottomRightPopup/BottomRightPopup.module.scss"],names:[],mappings:"AAEA,sCACI,cAAA,CACA,WAAA,CACA,UAAA,CACA,YAAA,CACA,eAAA,CACA,uCAAA,CACA,4FAAA,CAGJ,4CACI,iBAAA,CACA,QAAA,CACA,UAAA,CACA,SAAA,CAGJ,kDACI,KACI,uCAAA,CACA,SAAA,CAGJ,GACI,uBAAA,CACA,SAAA,CAAA",sourcesContent:['@import "enhancv-styleguide/variables";\n\n.popup {\n    position: fixed;\n    bottom: 24px;\n    right: 24px;\n    z-index: 1000;\n    min-width: 400px;\n    box-shadow: 0 8px 24px 0 rgba($black, 0.15);\n    animation: slideIn 0.3s cubic-bezier(0.33, 1, 0.68, 1) forwards;\n}\n\n.closeButton {\n    position: absolute;\n    top: 12px;\n    right: 12px;\n    z-index: 1;\n}\n\n@keyframes slideIn {\n    from {\n        transform: translateY(calc(100% + 24px));\n        opacity: 0;\n    }\n\n    to {\n        transform: translateY(0);\n        opacity: 1;\n    }\n}\n'],sourceRoot:""}]),l.locals={popup:"BottomRightPopup-module_popup__yl5Kx",slideIn:"BottomRightPopup-module_slideIn__dU14d",closeButton:"BottomRightPopup-module_closeButton__HosoA"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/modules/Common/Avatar.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,".Avatar-module_avatar__YBvr3{display:inline-block;width:40px;height:40px;color:#fff;background-color:#65696d;border-radius:50%;line-height:40px;text-align:center}@media screen and (max-width: 768px){.Avatar-module_avatar__YBvr3{width:48px;height:48px;line-height:48px}}","",{version:3,sources:["webpack://./src/modules/Common/Avatar.module.scss","webpack://./node_modules/enhancv-styleguide/variables.scss","webpack://./node_modules/sharedstyle/_variables.scss"],names:[],mappings:"AAGA,6BACI,oBAAA,CACA,UAAA,CACA,WAAA,CACA,UC2BI,CD1BJ,wBEqEe,CFpEf,iBAAA,CACA,gBAAA,CACA,iBAAA,CAEA,qCAVJ,6BAWQ,UAAA,CACA,WAAA,CACA,gBAAA,CAAA",sourcesContent:['@import "~sharedstyle/variables";\n@import "enhancv-styleguide/variables";\n\n.avatar {\n    display: inline-block;\n    width: 40px;\n    height: 40px;\n    color: $white;\n    background-color: $brand-gray-color;\n    border-radius: 50%;\n    line-height: 40px;\n    text-align: center;\n\n    @media screen and (max-width: $screen-sm-max) {\n        width: 48px;\n        height: 48px;\n        line-height: 48px;\n    }\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6df;\n$warning-hover: #feba62;\n\n// // Active elements\n$primary-active: #249a71;\n$secondary-active: #5f4dc7;\n$info-active: #3685bb;\n$warning-active: #d89745;\n$danger-active: #d94a5e;\n\n// // Transparent elements\n// // // opacity: 10%;\n$primary-10: rgba($primary, 0.1);\n$secondary-10: rgba($secondary, 0.1);\n$accent-10: rgba($accent, 0.1);\n$info-10: rgba($info, 0.1);\n$warning-10: rgba($warning, 0.1);\n$danger-10: rgba($danger, 0.1);\n// // // opacity 20%\n$primary-20: rgba($primary, 0.2);\n$secondary-20: rgba($secondary, 0.2);\n$accent-20: rgba($accent, 0.2);\n$info-20: rgba($info, 0.2);\n$warning-20: rgba($warning, 0.2);\n$danger-20: rgba($danger, 0.2);\n// // // opacity 30%\n$primary-30: rgba($primary, 0.3);\n$secondary-30: rgba($secondary, 0.3);\n$accent-30: rgba($accent, 0.3);\n$info-30: rgba($info, 0.3);\n$warning-30: rgba($warning, 0.3);\n$danger-30: rgba($danger, 0.3);\n\n// // Backgrounds\n$surface: $white;\n$surface-accent: #9cb2dc;\n$page: #f5f7fc;\n$page-alt: #fafbfd;\n\n// // Typography Colors\n$heading: #2d3639;\n$paragraph: #384347;\n$label: #60696c;\n$caption: #afb4b5;\n$subtext: #d8d9db;\n\n// // Supportive colors\n$modal: #47445a;\n$graphic-1: #f0f0f0;\n$graphic-2: #e4e4e4;\n$graphic-3: #f2f2f2;\n$border-color: #e0e0e0;\n\n// // CC colors\n$primary-cc: #eaf9f4;\n$secondary-cc: #f3f2fb;\n$danger-cc: #ffeef1;\n$info-cc: #ecf5fc;\n\n// // Visual elements Colors\n$visual-violet-1: #d1cbf1;\n$visual-violet-2: #e3e0f6;\n$visual-green-1: #abe6d1;\n$visual-green-2: #cdf0e4;\n$visual-blue: #b2d7f1;\n$visual-orange: #ffe0b9;\n$visual-pink: #ffcdd4;\n\n// // Shadows\n$shadow-default: 0px 4px 8px rgba(0, 0, 0, 0.1);\n$shadow-hover: 0px 2px 20px rgba(0, 0, 0, 0.1);\n$shadow-flat: 1px 1px 1px rgba(231, 228, 228, 0.5);\n$shadow-main-navigation: 0px 1px 3px rgba(0, 0, 0, 0.1);\n\n// Font-sizes\n$font-size-lg: 20px;\n$font-size-md: 18px;\n$font-size-rg: 16px;\n$font-size-sm: 14px;\n$font-size-xs: 12px;\n$font-size-xs-min: 10px;\n\n// Container - (with padding-inline:16px included)\n$container-xs: 100%;\n$container-md: 736px; // 12columns x 64px\n$container-lg: 956px; // 12columns x 84px\n$container-xl: 1184px; // 12columns x 96px\n$container-xxl: 1328px; // 12columns x 108px\n\n// Z-index modal\n$zindex-modal-background: 1002;\n$zindex-modal-content: 1003;\n','@use "sass:color";\n@use "sass:math";\n//\n// Variables\n// --------------------------------------------------\n\n//== Colors\n//\n//## Gray and brand colors for use across Bootstrap.\n\n$shadow-4: 0 0 12px -3px rgba(0, 0, 0, 0.3);\n$shadow-5: 0 0 4px 0px rgba(0, 0, 0, 0.3);\n\n$shadow-1: 0 0 4px 0 rgba(160, 162, 167, 0.15);\n$shadow-2: 0 0 2px 0 rgba(77, 77, 77, 0.16);\n$shadow-3: 0 0 2px 0 rgba(83, 83, 83, 0.5);\n\n$gray-base: #000 !default;\n$gray-dark: #384347 !default;\n$resume-body-color: #3e3e3e !default; // specific body color for the resumes - without blue color included\n$gray-dark-2: #222 !default;\n$gray: color.adjust($gray-base, $lightness: 33.5%) !default; // #555\n$gray-light: color.adjust($gray-base, $lightness: 46.7%) !default; // #777\n$gray-lighter: color.adjust($gray-base, $lightness: 80%) !default; // #ccc\n$green-light: #eaf8f3;\n\n$gray-1: #b2b4b6;\n$gray-1-20: rgba($gray-1, 0.2);\n$gray-1-50: rgba($gray-1, 0.5);\n$gray-2: #65696d;\n$gray-2-20: rgba($gray-2, 0.2);\n$gray-2-50: rgba($gray-2, 0.5);\n$gray-3: #384347;\n$gray-3-20: rgba($gray-3, 0.2);\n$gray-3-50: rgba($gray-3, 0.5);\n\n$green-3: #2dc08d;\n$green-2: #62d0aa;\n$green-1: #d5f2e8;\n$green-hover: #249a71;\n\n$purple-3: #8c7cdb;\n$purple-2: #c5bded;\n$purple-1: #e8e5f8;\n\n$red-3: #ff576f;\n$red-2: #ffabb7;\n$red-1: #ffeef0;\n\n$blue-3: #7aaacb;\n$blue-2: #b5d6ec;\n$blue-1: #e2eff8;\n$blue-background: #f3f5fa;\n\n$yellow-3: #feb251;\n$yellow-2: #fed8a7;\n$yellow-1: #fff0dc;\n\n$background: #fafbfd;\n$brand-primary: #00c091;\n$brand-promo: #e7762e;\n$brand-success: #2dc08c !default;\n$brand-info: #5bc0de !default;\n$brand-warning: #f2994a !default;\n$brand-danger: #ff576f !default;\n$brand-border-color: #e6e6e6 !default;\n$brand-grey-background: #f2f2f2;\n$color-facebook: #3b5998;\n$color-twitter: #5eaade;\n$color-gplus: #dd4b39;\n$color-instagram: #333333;\n$color-linkedin: #2578b5;\n$color-messenger-first: rgb(1, 183, 255);\n$color-messenger-second: rgb(0, 126, 254);\n$color-messenger-border: #ffffff;\n$color-onboarding: #009ee8;\n$purple-color: #8c7cdb;\n$brand-gray-color: #65696d;\n$brand-info-font-color: #b2b4b6;\n$toolbox-border: rgba(223, 223, 223, 0.52);\n$selected-item-border-color: #60d5ba;\n\n$white: white;\n\n$op-background-color: #333333;\n$op-nav-control-color: #464646;\n$op-control-color: $gray-dark;\n$op-light-color: #e6e6e6;\n$op-control-primary-color: $brand-success;\n$op-notification-bg-primary: #ccf5e9;\n$op-notification-bg-danger: #ffc7d4;\n$op-notification-bg-warning: #ffe2ca;\n\n$op-base-offset: 8px !default;\n$op-btn-padding-horizontal: 14px;\n\n//Resume Styles\n$resume-rounding: 5px;\n\n//== Scaffolding\n//\n//## Settings for some of the most global styles.\n\n//** Background color for `<body>`.\n$body-bg: #fff !default;\n//** Global text color on `<body>`.\n$text-color: $gray-dark !default;\n\n$text-color-hover: color.adjust($text-color, $lightness: 30%) !default;\n\n//** Global textual link color.\n$link-color: white !default;\n//** Link hover color set via `darken()` function.\n$link-hover-color: color.adjust(white, $lightness: -10%);\n//** Link hover decoration.\n$link-hover-decoration: none !default;\n\n//== Typography\n//\n//## Font, line-height, and color for body text, headings, and more.\n\n$font-family-sans-serif: "Roboto", Arial, Helvetica, "Noto Sans Devanagari", "Noto Sans CJK SC Thin",\n    "Noto Sans SC", "Noto Sans Hebrew", "Noto Sans Bengali", sans-serif !default;\n$font-family-serif: Georgia, "Times New Roman", Times, "Noto Sans Devanagari",\n    "Noto Sans CJK SC Thin", "Noto Sans SC", "Noto Sans Hebrew", "Noto Sans Bengali", serif !default;\n//** Default monospace fonts for `<code>`, `<kbd>`, and `<pre>`.\n$font-family-monospace: Menlo, Monaco, Consolas, "Courier New", monospace !default;\n$font-family-base: "Inter" !default;\n\n$roboto: "Roboto", Arial, Helvetica, sans-serif;\n$opensans: "Open Sans", Arial, Helvetica, sans-serif;\n$account-heading-font: "Rubik", sans-serif !important;\n\n$font-size-base: 14px !default;\n$font-size-large: 18px !default;\n$font-size-small: 11px !default;\n\n$font-size-h1: 68px !default; // ~36px\n$font-size-h2: 38px !default; // ~30px\n$font-size-h3: 32px !default; // ~24px\n$font-size-h4: 26px !default; // ~18px\n$font-size-h5: 22px !default;\n$font-size-h6: 20px !default; // ~12px\n\n//** Unit-less `line-height` for use in components like buttons.\n$line-height-base: 1.428571429 !default; // 20/14\n//** Computed "line-height" (`font-size` * `line-height`) for use with `margin`, `padding`, etc.\n$line-height-computed: math.floor(($font-size-base * $line-height-base)) !default; // ~20px\n\n//** By default, this inherits from the `<body>`.\n$headings-font-family: "Rubik", sans-serif !default;\n$headings-font-weight: 300 !default;\n$headings-line-height: 1.1 !default;\n$headings-color: $gray-dark !default;\n\n//== Components\n//\n//## Define common padding and border radius sizes and more. Values based on 14px text and 1.428 line-height (~20px to start).\n\n$padding-base-vertical: 9px !default;\n$padding-base-horizontal: 14px !default;\n\n$padding-large-vertical: 12px !default;\n$padding-large-horizontal: 24px !default;\n\n$padding-small-vertical: 5px !default;\n$padding-small-horizontal: 18px !default;\n\n$padding-xs-vertical: 1px !default;\n$padding-xs-horizontal: 12px !default;\n\n$line-height-large: 1.3333333 !default; // extra decimals for Win 8.1 Chrome\n$line-height-small: 1.5 !default;\n\n$border-radius-base: 5px !default;\n$border-radius-large: 9px !default;\n$border-radius-small: 4px !default;\n\n//** Global color for active items (e.g., navs or dropdowns).\n$component-active-color: #fff !default;\n//** Global background color for active items (e.g., navs or dropdowns).\n$component-active-bg: $brand-primary !default;\n\n//** Width of the `border` for generating carets that indicator dropdowns.\n$caret-width-base: 4px !default;\n//** Carets increase slightly in size for larger components.\n$caret-width-large: 5px !default;\n\n//== Tables\n//\n//## Customizes the `.table` component with basic values, each used across all table variations.\n\n//** Padding for `<th>`s and `<td>`s.\n$table-cell-padding: 8px !default;\n//** Padding for cells in `.table-condensed`.\n$table-condensed-cell-padding: 5px !default;\n\n//** Default background color used for all tables.\n$table-bg: transparent !default;\n//** Background color used for `.table-striped`.\n$table-bg-accent: #f9f9f9 !default;\n//** Background color used for `.table-hover`.\n$table-bg-hover: #f5f5f5 !default;\n$table-bg-active: $table-bg-hover !default;\n\n//** Border color for table and cell borders.\n$table-border-color: #ddd !default;\n\n//== Buttons\n//\n//## For each of Bootstrap\'s buttons, define text, background and border color.\n\n$btn-font-weight: bold !default;\n\n$btn-default-color: #8c7cdb !default;\n$btn-default-bg: #fff !default;\n$btn-default-border: #8c7cdb !default;\n\n$btn-primary-color: #fff !default;\n$btn-primary-bg: $brand-primary !default;\n$btn-primary-border: $brand-primary !default;\n\n$btn-success-color: #fff !default;\n$btn-success-bg: $brand-success !default;\n$btn-success-border: color.adjust($btn-success-bg, $lightness: -5%) !default;\n\n$btn-info-color: #fff !default;\n$btn-info-bg: $brand-info !default;\n$btn-info-border: color.adjust($btn-info-bg, $lightness: -5%) !default;\n\n$btn-warning-color: #fff !default;\n$btn-warning-bg: $brand-warning !default;\n$btn-warning-border: color.adjust($btn-warning-bg, $lightness: -5%) !default;\n\n$btn-danger-color: #fff !default;\n$btn-danger-bg: $brand-danger !default;\n$btn-danger-border: color.adjust($btn-danger-bg, $lightness: -5%) !default;\n\n$btn-link-disabled-color: $gray-light !default;\n\n// Allows for customizing button radius independently from global border radius\n$btn-border-radius-base: $border-radius-base;\n$btn-border-radius-large: $border-radius-base;\n$btn-border-radius-small: $border-radius-base;\n\n//== Forms\n//\n//##\n\n//** `<input>` background color\n$input-bg: #fff !default;\n//** `<input disabled>` background color\n$input-bg-disabled: $gray-lighter !default;\n\n//** Text color for `<input>`s\n$input-color: $gray !default;\n//** `<input>` border color\n$input-border: #b3b3b3 !default;\n\n// TODO: Rename `$input-border-radius` to `$input-border-radius-base` in v4\n//** Default `.form-control` border radius\n// This has no effect on `<select>`s in some browsers, due to the limited stylability of `<select>`s in CSS.\n$input-border-radius: $border-radius-base;\n//** Large `.form-control` border radius\n$input-border-radius-large: $border-radius-base;\n//** Small `.form-control` border radius\n$input-border-radius-small: $border-radius-base;\n\n//** Border color for inputs on focus\n$input-border-focus: $brand-primary !default;\n\n//** Placeholder text color\n$input-color-placeholder: color.adjust($gray-base, $lightness: 70%) !default;\n\n//** Default `.form-control` height\n$input-height-base: ($line-height-computed + ($padding-base-vertical * 2) + 2) !default;\n//** Large `.form-control` height\n$input-height-large: (\n    math.ceil($font-size-large * $line-height-large) + ($padding-large-vertical * 2) + 2\n) !default;\n//** Small `.form-control` height\n$input-height-small: (\n    math.floor($font-size-small * $line-height-small) + ($padding-small-vertical * 2) + 2\n) !default;\n\n//** `.form-group` margin\n$form-group-margin-bottom: 15px !default;\n\n$legend-color: $gray-dark !default;\n$legend-border-color: #e5e5e5 !default;\n\n//** Background color for textual input addons\n$input-group-addon-bg: $gray-lighter !default;\n//** Border color for textual input addons\n$input-group-addon-border-color: $input-border !default;\n\n//** Disabled cursor for form controls and buttons.\n$cursor-disabled: not-allowed !default;\n\n//== Dropdowns\n//\n//## Dropdown menu container and contents.\n\n//** Background for the dropdown menu.\n$dropdown-bg: #fff !default;\n//** Dropdown menu `border-color`.\n$dropdown-border: rgba(0, 0, 0, 0.15) !default;\n//** Dropdown menu `border-color` **for IE8**.\n$dropdown-fallback-border: #ccc !default;\n//** Divider color for between dropdown items.\n$dropdown-divider-bg: #e5e5e5 !default;\n\n//** Dropdown link text color.\n$dropdown-link-color: $gray-dark !default;\n//** Hover color for dropdown links.\n$dropdown-link-hover-color: color.adjust($gray-dark, $lightness: 50%) !default;\n//** Hover background for dropdown links.\n$dropdown-link-hover-bg: transparent !default;\n\n//** Active dropdown menu item text color.\n$dropdown-link-active-color: $component-active-color !default;\n//** Active dropdown menu item background color.\n$dropdown-link-active-bg: $component-active-bg !default;\n\n//** Disabled dropdown menu item background color.\n$dropdown-link-disabled-color: $gray-light !default;\n\n//** Text color for headers within dropdown menus.\n$dropdown-header-color: $gray-light !default;\n\n//** Deprecated `$dropdown-caret-color` as of v3.1.0\n$dropdown-caret-color: #000 !default;\n\n//-- Z-index master list\n//\n// Warning: Avoid customizing these values. They\'re used for a bird\'s eye view\n// of components dependent on the z-axis and are designed to all work together.\n//\n// Note: These variables are not generated into the Customizer.\n\n$zindex-navbar: 1000 !default;\n$zindex-dropdown: 1000 !default;\n$zindex-mobile-design-menu: 1001 !default;\n$zindex-modal-background: 1002 !default; // from style guide --\x3e\n$zindex-modal-content: 1003 !default; // <--\n$zindex-full-screen-dropdown: 1004 !default;\n$zindex-popover: 1020 !default;\n$zindex-tooltip: 1050 !default;\n$zindex-navbar-fixed: 1030 !default;\n$zindex-toaster: 1030 !default;\n$zindex-alert: 1060 !default;\n$zindex-op-currdoing-cirle: 100 !default;\n$zindex-op-section-controls: 1 !default;\n$zindex-toasters: 8000 !default;\n\n//== Media queries breakpoints\n//\n//## Define the breakpoints at which your layout will change, adapting to different screen sizes.\n\n//== Grid system\n//\n//## Define your custom responsive grid.\n\n//** Number of columns in the grid.\n$grid-columns: 12 !default;\n//** Padding between columns. Gets divided in half for the left and right.\n$grid-gutter-width: 20px !default;\n\n//== Navbar OP\n//\n//##\n$op-navbar-height: 64px !default;\n$op-navbar-padding: 2 * $op-base-offset !default;\n\n//== Navbar\n//\n//##\n\n// Basics of a navbar\n$navbar-height: 60px !default;\n$navbar-padding: 16px !default;\n$navbar-margin-bottom: 0 !default;\n$navbar-border-radius: 0 !default;\n$navbar-padding-horizontal: math.floor(($grid-gutter-width * 0.5)) !default;\n$navbar-padding-vertical: (($navbar-height - $line-height-computed) * 0.5) !default;\n$navbar-collapse-max-height: 340px !default;\n\n$navbar-default-color: $text-color !default;\n$navbar-default-bg: white !default;\n$navbar-default-border: transparent !default;\n\n// Navbar links\n$navbar-default-link-color: $text-color !default;\n$navbar-default-link-hover-color: $purple-color !default;\n$navbar-default-link-hover-bg: transparent !default;\n$navbar-default-link-active-color: #b2b4b6 !default;\n$navbar-default-link-active-bg: color.adjust($navbar-default-bg, $lightness: -6.5%) !default;\n$navbar-default-link-disabled-color: #ccc !default;\n$navbar-default-link-disabled-bg: transparent !default;\n\n// Navbar brand label\n$navbar-default-brand-color: #e6e6e6 !default;\n$navbar-default-brand-hover-color: color.adjust(\n    $navbar-default-brand-color,\n    $lightness: -10%\n) !default;\n$navbar-default-brand-hover-bg: transparent !default;\n\n// Navbar toggle\n$navbar-default-toggle-hover-bg: color.adjust(white, $lightness: -5%) !default;\n$navbar-default-toggle-icon-bar-bg: $text-color !default;\n$navbar-default-toggle-border-color: transparent !default;\n\n//=== Inverted navbar\n// Reset inverted navbar basics\n$navbar-inverse-color: $brand-gray-color !default;\n$navbar-inverse-bg: white !default;\n$navbar-inverse-border: $brand-border-color !default;\n\n// Inverted navbar links\n$navbar-inverse-link-color: $brand-gray-color !default;\n$navbar-inverse-link-hover-color: $text-color;\n$navbar-inverse-link-hover-bg: transparent !default;\n$navbar-inverse-link-active-color: $navbar-inverse-link-hover-color !default;\n$navbar-inverse-link-active-bg: color.adjust($navbar-inverse-bg, $lightness: -10%) !default;\n$navbar-inverse-link-disabled-color: #444 !default;\n$navbar-inverse-link-disabled-bg: transparent !default;\n\n// Inverted navbar brand label\n$navbar-inverse-brand-color: $navbar-inverse-link-color !default;\n$navbar-inverse-brand-hover-color: #fff !default;\n$navbar-inverse-brand-hover-bg: transparent !default;\n\n// Inverted navbar toggle\n$navbar-inverse-toggle-hover-bg: color.adjust(white, $lightness: -10%) !default;\n$navbar-inverse-toggle-icon-bar-bg: $gray !default;\n$navbar-inverse-toggle-border-color: $gray !default;\n\n//== Navs\n//\n//##\n\n//=== Shared nav styles\n$nav-link-padding: 12px 15px !default;\n$nav-link-hover-bg: transparent !default;\n\n$nav-disabled-link-color: $gray-light !default;\n$nav-disabled-link-hover-color: transparent !default;\n\n//== Tabs\n$nav-tabs-border-color: #ddd !default;\n\n$nav-tabs-link-hover-border-color: $gray-lighter !default;\n\n$nav-tabs-active-link-hover-bg: $body-bg !default;\n$nav-tabs-active-link-hover-color: $gray !default;\n$nav-tabs-active-link-hover-border-color: #ddd !default;\n\n$nav-tabs-justified-link-border-color: #ddd !default;\n$nav-tabs-justified-active-link-border-color: $body-bg !default;\n\n//== Pills\n$nav-pills-border-radius: $border-radius-base !default;\n$nav-pills-active-link-hover-bg: transparent !default;\n$nav-pills-active-link-hover-color: $brand-primary !default;\n\n//== Pagination\n//\n//##\n\n$pagination-color: $link-color !default;\n$pagination-bg: #fff !default;\n$pagination-border: #ddd !default;\n\n$pagination-hover-color: $link-hover-color !default;\n$pagination-hover-bg: $gray-lighter !default;\n$pagination-hover-border: #ddd !default;\n\n$pagination-active-color: #fff !default;\n$pagination-active-bg: $brand-primary !default;\n$pagination-active-border: $brand-primary !default;\n\n$pagination-disabled-color: $gray-light !default;\n$pagination-disabled-bg: #fff !default;\n$pagination-disabled-border: #ddd !default;\n\n//== Pager\n//\n//##\n\n$pager-bg: $pagination-bg !default;\n$pager-border: $pagination-border !default;\n$pager-border-radius: 15px !default;\n\n$pager-hover-bg: $pagination-hover-bg !default;\n\n$pager-active-bg: $pagination-active-bg !default;\n$pager-active-color: $pagination-active-color !default;\n\n$pager-disabled-color: $pagination-disabled-color !default;\n\n//== Jumbotron\n//\n//##\n\n$jumbotron-padding: 30px !default;\n$jumbotron-color: inherit !default;\n$jumbotron-bg: $gray-lighter !default;\n$jumbotron-heading-color: inherit !default;\n$jumbotron-font-size: math.ceil(($font-size-base * 1.5)) !default;\n$jumbotron-heading-font-size: math.ceil(($font-size-base * 4.5)) !default;\n\n//== Form states and alerts\n//\n//## Define colors for form feedback states and, by default, alerts.\n\n$state-success-text: #00c091 !default;\n$state-success-bg: #caf3e9 !default;\n$state-success-border: color.adjust(\n    color.adjust($state-success-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n$state-info-text: #31708f !default;\n$state-info-bg: #d9edf7 !default;\n$state-info-border: color.adjust(color.adjust($state-info-bg, $hue: -10), $lightness: -7%) !default;\n\n$state-warning-text: $brand-warning !default;\n$state-warning-bg: #fcf8e3 !default;\n$state-warning-border: color.adjust(\n    color.adjust($state-warning-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n$state-danger-text: $brand-danger !default;\n$state-danger-bg: #ffcbd6 !default;\n$state-danger-border: color.adjust(\n    color.adjust($state-danger-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n//== Tooltips\n//\n//##\n\n//** Tooltip max width\n$tooltip-max-width: 300px !default;\n//** Tooltip text color\n$tooltip-color: #fff !default;\n//** Tooltip background color\n$tooltip-bg: $gray-dark !default;\n$tooltip-opacity: 0.9 !default;\n\n//** Tooltip arrow width\n$tooltip-arrow-width: 5px !default;\n//** Tooltip arrow color\n$tooltip-arrow-color: $tooltip-bg !default;\n\n//== Popovers\n//\n//##\n\n//** Popover body background color\n$popover-bg: #fff !default;\n//** Popover maximum width\n$popover-max-width: 276px !default;\n//** Popover border color\n$popover-border-color: rgba(0, 0, 0, 0.2) !default;\n//** Popover fallback border color\n$popover-fallback-border-color: #ccc !default;\n\n//** Popover title background color\n$popover-title-bg: color.adjust($popover-bg, $lightness: -3%) !default;\n\n//** Popover arrow width\n$popover-arrow-width: 10px !default;\n//** Popover arrow color\n$popover-arrow-color: $popover-bg !default;\n\n//** Popover outer arrow width\n$popover-arrow-outer-width: ($popover-arrow-width + 1) !default;\n//** Popover outer arrow color\n$popover-arrow-outer-color: color.adjust($popover-border-color, $alpha: 0.05) !default;\n//** Popover outer arrow fallback color\n$popover-arrow-outer-fallback-color: color.adjust(\n    $popover-fallback-border-color,\n    $lightness: -20%\n) !default;\n\n//== Labels\n//\n//##\n\n//** Default label background color\n$label-default-bg: $gray-light !default;\n//** Primary label background color\n$label-primary-bg: $brand-primary !default;\n//** Success label background color\n$label-success-bg: $brand-success !default;\n//** Info label background color\n$label-info-bg: $brand-info !default;\n//** Warning label background color\n$label-warning-bg: $brand-warning !default;\n//** Danger label background color\n$label-danger-bg: $brand-danger !default;\n\n//** Default label text color\n$label-color: #fff !default;\n//** Default text color of a linked label\n$label-link-hover-color: #fff !default;\n$label-gray: #60696c;\n\n//== Modals\n//\n//##\n\n//** Padding applied to the modal body\n$modal-inner-padding: 35px 40px !default;\n\n//** Padding applied to the modal title\n$modal-title-padding: 35px 40px 35px 40px !default;\n//** Modal title line-height\n$modal-title-line-height: $line-height-base !default;\n\n//** Background color of modal content area\n$modal-content-bg: #fff !default;\n//** Modal content border color\n$modal-content-border-color: rgba(255, 255, 255, 0) !default;\n//** Modal content border color **for IE8**\n$modal-content-fallback-border-color: #999 !default;\n\n//** Modal backdrop background color\n$modal-backdrop-bg: #00bf93 !default;\n//** Modal backdrop opacity\n$modal-backdrop-opacity: 0.5 !default;\n//** Modal header border color\n$modal-header-border-color: #e6e6e6 !default;\n//** Modal footer border color\n$modal-footer-border-color: $modal-header-border-color !default;\n\n$modal-lg: 820px !default;\n$modal-md: 630px !default;\n$modal-sm: 420px !default;\n\n//== Alerts\n//\n//## Define alert colors, border radius, and padding.\n\n$alert-padding: 8px 15px !default;\n$alert-border-radius: 45px !default;\n$alert-link-font-weight: bold !default;\n\n$alert-success-bg: $state-success-bg !default;\n$alert-success-text: $state-success-text !default;\n$alert-success-border: #fff !default;\n\n$alert-info-bg: $state-info-bg !default;\n$alert-info-text: $state-info-text !default;\n$alert-info-border: #fff !default;\n\n$alert-warning-bg: $state-warning-bg !default;\n$alert-warning-text: $state-warning-text !default;\n$alert-warning-border: #fff !default;\n\n$alert-danger-bg: $state-danger-bg !default;\n$alert-danger-text: $state-danger-text !default;\n$alert-danger-border: #fff !default;\n\n//== Progress bars\n//\n//##\n\n//** Background color of the whole progress component\n$progress-bg: #e6e6e6 !default;\n//** Progress bar text color\n$progress-bar-color: #fff !default;\n//** Variable for setting rounded corners on progress bar.\n$progress-border-radius: 12px !default;\n\n//** Default progress bar color\n$progress-bar-bg: $brand-primary !default;\n//** Success progress bar color\n$progress-bar-success-bg: $brand-success !default;\n//** Warning progress bar color\n$progress-bar-warning-bg: $brand-warning !default;\n//** Danger progress bar color\n$progress-bar-danger-bg: $brand-danger !default;\n//** Info progress bar color\n$progress-bar-info-bg: $brand-info !default;\n\n//== List group\n//\n//##\n\n//** Background color on `.list-group-item`\n$list-group-bg: #fff !default;\n//** `.list-group-item` border color\n$list-group-border: #ddd !default;\n//** List group border radius\n$list-group-border-radius: $border-radius-base !default;\n\n//** Background color of single list items on hover\n$list-group-hover-bg: #f5f5f5 !default;\n//** Text color of active list items\n$list-group-active-color: $component-active-color !default;\n//** Background color of active list items\n$list-group-active-bg: $component-active-bg !default;\n//** Border color of active list elements\n$list-group-active-border: $list-group-active-bg !default;\n//** Text color for content within active list items\n$list-group-active-text-color: color.adjust($list-group-active-bg, $lightness: 40%) !default;\n\n//** Text color of disabled list items\n$list-group-disabled-color: $gray-light !default;\n//** Background color of disabled list items\n$list-group-disabled-bg: $gray-lighter !default;\n//** Text color for content within disabled list items\n$list-group-disabled-text-color: $list-group-disabled-color !default;\n\n$list-group-link-color: #555 !default;\n$list-group-link-hover-color: $list-group-link-color !default;\n$list-group-link-heading-color: #333 !default;\n\n//== Panels\n//\n//##\n\n$panel-bg: #fff !default;\n$panel-body-padding: 15px !default;\n$panel-heading-padding: 10px 15px !default;\n$panel-footer-padding: $panel-heading-padding !default;\n$panel-border-radius: $border-radius-base !default;\n\n//** Border color for elements within panels\n$panel-inner-border: #ddd !default;\n$panel-footer-bg: #f5f5f5 !default;\n\n$panel-default-text: $gray-dark !default;\n$panel-default-border: #ddd !default;\n$panel-default-heading-bg: #f5f5f5 !default;\n\n$panel-primary-text: #fff !default;\n$panel-primary-border: $brand-primary !default;\n$panel-primary-heading-bg: $brand-primary !default;\n\n$panel-success-text: $state-success-text !default;\n$panel-success-border: $state-success-border !default;\n$panel-success-heading-bg: $state-success-bg !default;\n\n$panel-info-text: $state-info-text !default;\n$panel-info-border: $state-info-border !default;\n$panel-info-heading-bg: $state-info-bg !default;\n\n$panel-warning-text: $state-warning-text !default;\n$panel-warning-border: $state-warning-border !default;\n$panel-warning-heading-bg: $state-warning-bg !default;\n\n$panel-danger-text: $state-danger-text !default;\n$panel-danger-border: $state-danger-border !default;\n$panel-danger-heading-bg: $state-danger-bg !default;\n\n//== Thumbnails\n//\n//##\n\n//** Padding around the thumbnail image\n$thumbnail-padding: 4px !default;\n//** Thumbnail background color\n$thumbnail-bg: $body-bg !default;\n//** Thumbnail border color\n$thumbnail-border: #ddd !default;\n//** Thumbnail border radius\n$thumbnail-border-radius: $border-radius-base !default;\n\n//** Custom text color for thumbnail captions\n$thumbnail-caption-color: $text-color !default;\n//** Padding around the thumbnail caption\n$thumbnail-caption-padding: 9px !default;\n\n//== Wells\n//\n//##\n\n$well-bg: #f5f5f5 !default;\n$well-border: color.adjust($well-bg, $lightness: -7%) !default;\n\n//== Badges\n//\n//##\n\n$badge-color: #fff !default;\n//** Linked badge text color on hover\n$badge-link-hover-color: #fff !default;\n$badge-bg: $gray-light !default;\n\n//** Badge text color in active nav link\n$badge-active-color: $link-color !default;\n//** Badge background color in active nav link\n$badge-active-bg: #fff !default;\n\n$badge-font-weight: bold !default;\n$badge-line-height: 1 !default;\n$badge-border-radius: 35px !default;\n\n//== Breadcrumbs\n//\n//##\n\n$breadcrumb-padding-vertical: 8px !default;\n$breadcrumb-padding-horizontal: 15px !default;\n//** Breadcrumb background color\n$breadcrumb-bg: #f5f5f5 !default;\n//** Breadcrumb text color\n$breadcrumb-color: #ccc !default;\n//** Text color of current page in the breadcrumb\n$breadcrumb-active-color: $gray-light !default;\n//** Textual separator for between breadcrumb elements\n$breadcrumb-separator: "/" !default;\n\n//== Carousel\n//\n//##\n\n$carousel-text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6) !default;\n\n$carousel-control-color: #fff !default;\n$carousel-control-width: 15% !default;\n$carousel-control-opacity: 0.5 !default;\n$carousel-control-font-size: 20px !default;\n\n$carousel-indicator-active-bg: #fff !default;\n$carousel-indicator-border-color: #fff !default;\n\n$carousel-caption-color: #fff !default;\n\n//== Close\n//\n//##\n\n$close-font-weight: bold !default;\n$close-color: #000 !default;\n$close-text-shadow: 0 1px 0 #fff !default;\n\n//== Code\n//\n//##\n\n$code-color: #c7254e !default;\n$code-bg: #f9f2f4 !default;\n\n$kbd-color: #fff !default;\n$kbd-bg: #333 !default;\n\n$pre-bg: #f5f5f5 !default;\n$pre-color: $gray-dark !default;\n$pre-border-color: #ccc !default;\n$pre-scrollable-max-height: 340px !default;\n\n//== Type\n//\n//##\n\n//** Horizontal offset for forms and lists.\n$component-offset-horizontal: 180px !default;\n//** Text muted color\n$text-muted: $gray-lighter !default;\n//** Abbreviations and acronyms border color\n$abbr-border-color: $gray-light !default;\n//** Headings small color\n$headings-small-color: $gray-light !default;\n//** Blockquote small color\n$blockquote-small-color: $gray-light !default;\n//** Blockquote font size\n$blockquote-font-size: ($font-size-base * 1.25) !default;\n//** Blockquote border color\n$blockquote-border-color: $gray-lighter !default;\n//** Page header border color\n$page-header-border-color: $gray-lighter !default;\n//** Horizontal line color.\n$hr-border: $gray-1-50 !default;\n'],sourceRoot:""}]),l.locals={avatar:"Avatar-module_avatar__YBvr3"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/modules/Common/BottomSheet/BottomSheet.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,".BottomSheet-module_overlay__Qvgpl{position:fixed;inset:0;background-color:rgba(0,0,0,.5);z-index:1000;display:flex;align-items:flex-end}.BottomSheet-module_sheet__FezfZ{width:100%;background-color:#fff;border-top-left-radius:16px;border-top-right-radius:16px;max-height:90vh;overflow-y:auto;animation:BottomSheet-module_slide-up__n3U8Z .3s ease-out}.BottomSheet-module_closeButton__RW72K{position:absolute;top:8px;right:8px;z-index:1;color:#384347}.BottomSheet-module_closeButton__RW72K i{font-size:20px !important;line-height:20px}@keyframes BottomSheet-module_slide-up__n3U8Z{from{transform:translateY(100%)}to{transform:translateY(0)}}","",{version:3,sources:["webpack://./src/modules/Common/BottomSheet/BottomSheet.module.scss","webpack://./node_modules/enhancv-styleguide/variables.scss"],names:[],mappings:"AAGA,mCACI,cAAA,CACA,OAAA,CACA,+BAAA,CACA,YAAA,CACA,YAAA,CACA,oBAAA,CAGJ,iCACI,UAAA,CACA,qBCoBI,CDnBJ,2BAAA,CACA,4BAAA,CACA,eAAA,CACA,eAAA,CACA,yDAAA,CAGJ,uCACI,iBAAA,CACA,OCvBU,CDwBV,SCxBU,CDyBV,SAAA,CACA,aCuDQ,CDrDR,yCACI,yBAAA,CACA,gBAAA,CAIR,8CACI,KACI,0BAAA,CAGJ,GACI,uBAAA,CAAA",sourcesContent:['@import "~sharedstyle/variables";\n@import "enhancv-styleguide/variables";\n\n.overlay {\n    position: fixed;\n    inset: 0;\n    background-color: rgba(0, 0, 0, 0.5);\n    z-index: 1000;\n    display: flex;\n    align-items: flex-end;\n}\n\n.sheet {\n    width: 100%;\n    background-color: $surface;\n    border-top-left-radius: 16px;\n    border-top-right-radius: 16px;\n    max-height: 90vh;\n    overflow-y: auto;\n    animation: slide-up 0.3s ease-out;\n}\n\n.closeButton {\n    position: absolute;\n    top: $base-offset;\n    right: $base-offset;\n    z-index: 1;\n    color: $paragraph;\n\n    i {\n        font-size: 20px !important;\n        line-height: 20px;\n    }\n}\n\n@keyframes slide-up {\n    from {\n        transform: translateY(100%);\n    }\n\n    to {\n        transform: translateY(0);\n    }\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6df;\n$warning-hover: #feba62;\n\n// // Active elements\n$primary-active: #249a71;\n$secondary-active: #5f4dc7;\n$info-active: #3685bb;\n$warning-active: #d89745;\n$danger-active: #d94a5e;\n\n// // Transparent elements\n// // // opacity: 10%;\n$primary-10: rgba($primary, 0.1);\n$secondary-10: rgba($secondary, 0.1);\n$accent-10: rgba($accent, 0.1);\n$info-10: rgba($info, 0.1);\n$warning-10: rgba($warning, 0.1);\n$danger-10: rgba($danger, 0.1);\n// // // opacity 20%\n$primary-20: rgba($primary, 0.2);\n$secondary-20: rgba($secondary, 0.2);\n$accent-20: rgba($accent, 0.2);\n$info-20: rgba($info, 0.2);\n$warning-20: rgba($warning, 0.2);\n$danger-20: rgba($danger, 0.2);\n// // // opacity 30%\n$primary-30: rgba($primary, 0.3);\n$secondary-30: rgba($secondary, 0.3);\n$accent-30: rgba($accent, 0.3);\n$info-30: rgba($info, 0.3);\n$warning-30: rgba($warning, 0.3);\n$danger-30: rgba($danger, 0.3);\n\n// // Backgrounds\n$surface: $white;\n$surface-accent: #9cb2dc;\n$page: #f5f7fc;\n$page-alt: #fafbfd;\n\n// // Typography Colors\n$heading: #2d3639;\n$paragraph: #384347;\n$label: #60696c;\n$caption: #afb4b5;\n$subtext: #d8d9db;\n\n// // Supportive colors\n$modal: #47445a;\n$graphic-1: #f0f0f0;\n$graphic-2: #e4e4e4;\n$graphic-3: #f2f2f2;\n$border-color: #e0e0e0;\n\n// // CC colors\n$primary-cc: #eaf9f4;\n$secondary-cc: #f3f2fb;\n$danger-cc: #ffeef1;\n$info-cc: #ecf5fc;\n\n// // Visual elements Colors\n$visual-violet-1: #d1cbf1;\n$visual-violet-2: #e3e0f6;\n$visual-green-1: #abe6d1;\n$visual-green-2: #cdf0e4;\n$visual-blue: #b2d7f1;\n$visual-orange: #ffe0b9;\n$visual-pink: #ffcdd4;\n\n// // Shadows\n$shadow-default: 0px 4px 8px rgba(0, 0, 0, 0.1);\n$shadow-hover: 0px 2px 20px rgba(0, 0, 0, 0.1);\n$shadow-flat: 1px 1px 1px rgba(231, 228, 228, 0.5);\n$shadow-main-navigation: 0px 1px 3px rgba(0, 0, 0, 0.1);\n\n// Font-sizes\n$font-size-lg: 20px;\n$font-size-md: 18px;\n$font-size-rg: 16px;\n$font-size-sm: 14px;\n$font-size-xs: 12px;\n$font-size-xs-min: 10px;\n\n// Container - (with padding-inline:16px included)\n$container-xs: 100%;\n$container-md: 736px; // 12columns x 64px\n$container-lg: 956px; // 12columns x 84px\n$container-xl: 1184px; // 12columns x 96px\n$container-xxl: 1328px; // 12columns x 108px\n\n// Z-index modal\n$zindex-modal-background: 1002;\n$zindex-modal-content: 1003;\n'],sourceRoot:""}]),l.locals={overlay:"BottomSheet-module_overlay__Qvgpl",sheet:"BottomSheet-module_sheet__FezfZ","slide-up":"BottomSheet-module_slide-up__n3U8Z",closeButton:"BottomSheet-module_closeButton__RW72K"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/modules/Common/CombineCoverLetterAndResume.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,".CombineCoverLetterAndResume-module_title__wtiKS{color:#384347;font-size:22px;line-height:26px}.CombineCoverLetterAndResume-module_description__gMG9J{color:#384347;font-size:14px;line-height:22px}","",{version:3,sources:["webpack://./src/modules/Common/CombineCoverLetterAndResume.module.scss","webpack://./node_modules/sharedstyle/_variables.scss"],names:[],mappings:"AAEA,iDACI,aC6BK,CD5BL,cAAA,CACA,gBAAA,CAGJ,uDACI,aCuBK,CDtBL,cAAA,CACA,gBAAA",sourcesContent:['@import "~sharedstyle/variables";\n\n.title {\n    color: $gray-3;\n    font-size: 22px;\n    line-height: 26px;\n}\n\n.description {\n    color: $gray-3;\n    font-size: 14px;\n    line-height: 22px;\n}\n','@use "sass:color";\n@use "sass:math";\n//\n// Variables\n// --------------------------------------------------\n\n//== Colors\n//\n//## Gray and brand colors for use across Bootstrap.\n\n$shadow-4: 0 0 12px -3px rgba(0, 0, 0, 0.3);\n$shadow-5: 0 0 4px 0px rgba(0, 0, 0, 0.3);\n\n$shadow-1: 0 0 4px 0 rgba(160, 162, 167, 0.15);\n$shadow-2: 0 0 2px 0 rgba(77, 77, 77, 0.16);\n$shadow-3: 0 0 2px 0 rgba(83, 83, 83, 0.5);\n\n$gray-base: #000 !default;\n$gray-dark: #384347 !default;\n$resume-body-color: #3e3e3e !default; // specific body color for the resumes - without blue color included\n$gray-dark-2: #222 !default;\n$gray: color.adjust($gray-base, $lightness: 33.5%) !default; // #555\n$gray-light: color.adjust($gray-base, $lightness: 46.7%) !default; // #777\n$gray-lighter: color.adjust($gray-base, $lightness: 80%) !default; // #ccc\n$green-light: #eaf8f3;\n\n$gray-1: #b2b4b6;\n$gray-1-20: rgba($gray-1, 0.2);\n$gray-1-50: rgba($gray-1, 0.5);\n$gray-2: #65696d;\n$gray-2-20: rgba($gray-2, 0.2);\n$gray-2-50: rgba($gray-2, 0.5);\n$gray-3: #384347;\n$gray-3-20: rgba($gray-3, 0.2);\n$gray-3-50: rgba($gray-3, 0.5);\n\n$green-3: #2dc08d;\n$green-2: #62d0aa;\n$green-1: #d5f2e8;\n$green-hover: #249a71;\n\n$purple-3: #8c7cdb;\n$purple-2: #c5bded;\n$purple-1: #e8e5f8;\n\n$red-3: #ff576f;\n$red-2: #ffabb7;\n$red-1: #ffeef0;\n\n$blue-3: #7aaacb;\n$blue-2: #b5d6ec;\n$blue-1: #e2eff8;\n$blue-background: #f3f5fa;\n\n$yellow-3: #feb251;\n$yellow-2: #fed8a7;\n$yellow-1: #fff0dc;\n\n$background: #fafbfd;\n$brand-primary: #00c091;\n$brand-promo: #e7762e;\n$brand-success: #2dc08c !default;\n$brand-info: #5bc0de !default;\n$brand-warning: #f2994a !default;\n$brand-danger: #ff576f !default;\n$brand-border-color: #e6e6e6 !default;\n$brand-grey-background: #f2f2f2;\n$color-facebook: #3b5998;\n$color-twitter: #5eaade;\n$color-gplus: #dd4b39;\n$color-instagram: #333333;\n$color-linkedin: #2578b5;\n$color-messenger-first: rgb(1, 183, 255);\n$color-messenger-second: rgb(0, 126, 254);\n$color-messenger-border: #ffffff;\n$color-onboarding: #009ee8;\n$purple-color: #8c7cdb;\n$brand-gray-color: #65696d;\n$brand-info-font-color: #b2b4b6;\n$toolbox-border: rgba(223, 223, 223, 0.52);\n$selected-item-border-color: #60d5ba;\n\n$white: white;\n\n$op-background-color: #333333;\n$op-nav-control-color: #464646;\n$op-control-color: $gray-dark;\n$op-light-color: #e6e6e6;\n$op-control-primary-color: $brand-success;\n$op-notification-bg-primary: #ccf5e9;\n$op-notification-bg-danger: #ffc7d4;\n$op-notification-bg-warning: #ffe2ca;\n\n$op-base-offset: 8px !default;\n$op-btn-padding-horizontal: 14px;\n\n//Resume Styles\n$resume-rounding: 5px;\n\n//== Scaffolding\n//\n//## Settings for some of the most global styles.\n\n//** Background color for `<body>`.\n$body-bg: #fff !default;\n//** Global text color on `<body>`.\n$text-color: $gray-dark !default;\n\n$text-color-hover: color.adjust($text-color, $lightness: 30%) !default;\n\n//** Global textual link color.\n$link-color: white !default;\n//** Link hover color set via `darken()` function.\n$link-hover-color: color.adjust(white, $lightness: -10%);\n//** Link hover decoration.\n$link-hover-decoration: none !default;\n\n//== Typography\n//\n//## Font, line-height, and color for body text, headings, and more.\n\n$font-family-sans-serif: "Roboto", Arial, Helvetica, "Noto Sans Devanagari", "Noto Sans CJK SC Thin",\n    "Noto Sans SC", "Noto Sans Hebrew", "Noto Sans Bengali", sans-serif !default;\n$font-family-serif: Georgia, "Times New Roman", Times, "Noto Sans Devanagari",\n    "Noto Sans CJK SC Thin", "Noto Sans SC", "Noto Sans Hebrew", "Noto Sans Bengali", serif !default;\n//** Default monospace fonts for `<code>`, `<kbd>`, and `<pre>`.\n$font-family-monospace: Menlo, Monaco, Consolas, "Courier New", monospace !default;\n$font-family-base: "Inter" !default;\n\n$roboto: "Roboto", Arial, Helvetica, sans-serif;\n$opensans: "Open Sans", Arial, Helvetica, sans-serif;\n$account-heading-font: "Rubik", sans-serif !important;\n\n$font-size-base: 14px !default;\n$font-size-large: 18px !default;\n$font-size-small: 11px !default;\n\n$font-size-h1: 68px !default; // ~36px\n$font-size-h2: 38px !default; // ~30px\n$font-size-h3: 32px !default; // ~24px\n$font-size-h4: 26px !default; // ~18px\n$font-size-h5: 22px !default;\n$font-size-h6: 20px !default; // ~12px\n\n//** Unit-less `line-height` for use in components like buttons.\n$line-height-base: 1.428571429 !default; // 20/14\n//** Computed "line-height" (`font-size` * `line-height`) for use with `margin`, `padding`, etc.\n$line-height-computed: math.floor(($font-size-base * $line-height-base)) !default; // ~20px\n\n//** By default, this inherits from the `<body>`.\n$headings-font-family: "Rubik", sans-serif !default;\n$headings-font-weight: 300 !default;\n$headings-line-height: 1.1 !default;\n$headings-color: $gray-dark !default;\n\n//== Components\n//\n//## Define common padding and border radius sizes and more. Values based on 14px text and 1.428 line-height (~20px to start).\n\n$padding-base-vertical: 9px !default;\n$padding-base-horizontal: 14px !default;\n\n$padding-large-vertical: 12px !default;\n$padding-large-horizontal: 24px !default;\n\n$padding-small-vertical: 5px !default;\n$padding-small-horizontal: 18px !default;\n\n$padding-xs-vertical: 1px !default;\n$padding-xs-horizontal: 12px !default;\n\n$line-height-large: 1.3333333 !default; // extra decimals for Win 8.1 Chrome\n$line-height-small: 1.5 !default;\n\n$border-radius-base: 5px !default;\n$border-radius-large: 9px !default;\n$border-radius-small: 4px !default;\n\n//** Global color for active items (e.g., navs or dropdowns).\n$component-active-color: #fff !default;\n//** Global background color for active items (e.g., navs or dropdowns).\n$component-active-bg: $brand-primary !default;\n\n//** Width of the `border` for generating carets that indicator dropdowns.\n$caret-width-base: 4px !default;\n//** Carets increase slightly in size for larger components.\n$caret-width-large: 5px !default;\n\n//== Tables\n//\n//## Customizes the `.table` component with basic values, each used across all table variations.\n\n//** Padding for `<th>`s and `<td>`s.\n$table-cell-padding: 8px !default;\n//** Padding for cells in `.table-condensed`.\n$table-condensed-cell-padding: 5px !default;\n\n//** Default background color used for all tables.\n$table-bg: transparent !default;\n//** Background color used for `.table-striped`.\n$table-bg-accent: #f9f9f9 !default;\n//** Background color used for `.table-hover`.\n$table-bg-hover: #f5f5f5 !default;\n$table-bg-active: $table-bg-hover !default;\n\n//** Border color for table and cell borders.\n$table-border-color: #ddd !default;\n\n//== Buttons\n//\n//## For each of Bootstrap\'s buttons, define text, background and border color.\n\n$btn-font-weight: bold !default;\n\n$btn-default-color: #8c7cdb !default;\n$btn-default-bg: #fff !default;\n$btn-default-border: #8c7cdb !default;\n\n$btn-primary-color: #fff !default;\n$btn-primary-bg: $brand-primary !default;\n$btn-primary-border: $brand-primary !default;\n\n$btn-success-color: #fff !default;\n$btn-success-bg: $brand-success !default;\n$btn-success-border: color.adjust($btn-success-bg, $lightness: -5%) !default;\n\n$btn-info-color: #fff !default;\n$btn-info-bg: $brand-info !default;\n$btn-info-border: color.adjust($btn-info-bg, $lightness: -5%) !default;\n\n$btn-warning-color: #fff !default;\n$btn-warning-bg: $brand-warning !default;\n$btn-warning-border: color.adjust($btn-warning-bg, $lightness: -5%) !default;\n\n$btn-danger-color: #fff !default;\n$btn-danger-bg: $brand-danger !default;\n$btn-danger-border: color.adjust($btn-danger-bg, $lightness: -5%) !default;\n\n$btn-link-disabled-color: $gray-light !default;\n\n// Allows for customizing button radius independently from global border radius\n$btn-border-radius-base: $border-radius-base;\n$btn-border-radius-large: $border-radius-base;\n$btn-border-radius-small: $border-radius-base;\n\n//== Forms\n//\n//##\n\n//** `<input>` background color\n$input-bg: #fff !default;\n//** `<input disabled>` background color\n$input-bg-disabled: $gray-lighter !default;\n\n//** Text color for `<input>`s\n$input-color: $gray !default;\n//** `<input>` border color\n$input-border: #b3b3b3 !default;\n\n// TODO: Rename `$input-border-radius` to `$input-border-radius-base` in v4\n//** Default `.form-control` border radius\n// This has no effect on `<select>`s in some browsers, due to the limited stylability of `<select>`s in CSS.\n$input-border-radius: $border-radius-base;\n//** Large `.form-control` border radius\n$input-border-radius-large: $border-radius-base;\n//** Small `.form-control` border radius\n$input-border-radius-small: $border-radius-base;\n\n//** Border color for inputs on focus\n$input-border-focus: $brand-primary !default;\n\n//** Placeholder text color\n$input-color-placeholder: color.adjust($gray-base, $lightness: 70%) !default;\n\n//** Default `.form-control` height\n$input-height-base: ($line-height-computed + ($padding-base-vertical * 2) + 2) !default;\n//** Large `.form-control` height\n$input-height-large: (\n    math.ceil($font-size-large * $line-height-large) + ($padding-large-vertical * 2) + 2\n) !default;\n//** Small `.form-control` height\n$input-height-small: (\n    math.floor($font-size-small * $line-height-small) + ($padding-small-vertical * 2) + 2\n) !default;\n\n//** `.form-group` margin\n$form-group-margin-bottom: 15px !default;\n\n$legend-color: $gray-dark !default;\n$legend-border-color: #e5e5e5 !default;\n\n//** Background color for textual input addons\n$input-group-addon-bg: $gray-lighter !default;\n//** Border color for textual input addons\n$input-group-addon-border-color: $input-border !default;\n\n//** Disabled cursor for form controls and buttons.\n$cursor-disabled: not-allowed !default;\n\n//== Dropdowns\n//\n//## Dropdown menu container and contents.\n\n//** Background for the dropdown menu.\n$dropdown-bg: #fff !default;\n//** Dropdown menu `border-color`.\n$dropdown-border: rgba(0, 0, 0, 0.15) !default;\n//** Dropdown menu `border-color` **for IE8**.\n$dropdown-fallback-border: #ccc !default;\n//** Divider color for between dropdown items.\n$dropdown-divider-bg: #e5e5e5 !default;\n\n//** Dropdown link text color.\n$dropdown-link-color: $gray-dark !default;\n//** Hover color for dropdown links.\n$dropdown-link-hover-color: color.adjust($gray-dark, $lightness: 50%) !default;\n//** Hover background for dropdown links.\n$dropdown-link-hover-bg: transparent !default;\n\n//** Active dropdown menu item text color.\n$dropdown-link-active-color: $component-active-color !default;\n//** Active dropdown menu item background color.\n$dropdown-link-active-bg: $component-active-bg !default;\n\n//** Disabled dropdown menu item background color.\n$dropdown-link-disabled-color: $gray-light !default;\n\n//** Text color for headers within dropdown menus.\n$dropdown-header-color: $gray-light !default;\n\n//** Deprecated `$dropdown-caret-color` as of v3.1.0\n$dropdown-caret-color: #000 !default;\n\n//-- Z-index master list\n//\n// Warning: Avoid customizing these values. They\'re used for a bird\'s eye view\n// of components dependent on the z-axis and are designed to all work together.\n//\n// Note: These variables are not generated into the Customizer.\n\n$zindex-navbar: 1000 !default;\n$zindex-dropdown: 1000 !default;\n$zindex-mobile-design-menu: 1001 !default;\n$zindex-modal-background: 1002 !default; // from style guide --\x3e\n$zindex-modal-content: 1003 !default; // <--\n$zindex-full-screen-dropdown: 1004 !default;\n$zindex-popover: 1020 !default;\n$zindex-tooltip: 1050 !default;\n$zindex-navbar-fixed: 1030 !default;\n$zindex-toaster: 1030 !default;\n$zindex-alert: 1060 !default;\n$zindex-op-currdoing-cirle: 100 !default;\n$zindex-op-section-controls: 1 !default;\n$zindex-toasters: 8000 !default;\n\n//== Media queries breakpoints\n//\n//## Define the breakpoints at which your layout will change, adapting to different screen sizes.\n\n//== Grid system\n//\n//## Define your custom responsive grid.\n\n//** Number of columns in the grid.\n$grid-columns: 12 !default;\n//** Padding between columns. Gets divided in half for the left and right.\n$grid-gutter-width: 20px !default;\n\n//== Navbar OP\n//\n//##\n$op-navbar-height: 64px !default;\n$op-navbar-padding: 2 * $op-base-offset !default;\n\n//== Navbar\n//\n//##\n\n// Basics of a navbar\n$navbar-height: 60px !default;\n$navbar-padding: 16px !default;\n$navbar-margin-bottom: 0 !default;\n$navbar-border-radius: 0 !default;\n$navbar-padding-horizontal: math.floor(($grid-gutter-width * 0.5)) !default;\n$navbar-padding-vertical: (($navbar-height - $line-height-computed) * 0.5) !default;\n$navbar-collapse-max-height: 340px !default;\n\n$navbar-default-color: $text-color !default;\n$navbar-default-bg: white !default;\n$navbar-default-border: transparent !default;\n\n// Navbar links\n$navbar-default-link-color: $text-color !default;\n$navbar-default-link-hover-color: $purple-color !default;\n$navbar-default-link-hover-bg: transparent !default;\n$navbar-default-link-active-color: #b2b4b6 !default;\n$navbar-default-link-active-bg: color.adjust($navbar-default-bg, $lightness: -6.5%) !default;\n$navbar-default-link-disabled-color: #ccc !default;\n$navbar-default-link-disabled-bg: transparent !default;\n\n// Navbar brand label\n$navbar-default-brand-color: #e6e6e6 !default;\n$navbar-default-brand-hover-color: color.adjust(\n    $navbar-default-brand-color,\n    $lightness: -10%\n) !default;\n$navbar-default-brand-hover-bg: transparent !default;\n\n// Navbar toggle\n$navbar-default-toggle-hover-bg: color.adjust(white, $lightness: -5%) !default;\n$navbar-default-toggle-icon-bar-bg: $text-color !default;\n$navbar-default-toggle-border-color: transparent !default;\n\n//=== Inverted navbar\n// Reset inverted navbar basics\n$navbar-inverse-color: $brand-gray-color !default;\n$navbar-inverse-bg: white !default;\n$navbar-inverse-border: $brand-border-color !default;\n\n// Inverted navbar links\n$navbar-inverse-link-color: $brand-gray-color !default;\n$navbar-inverse-link-hover-color: $text-color;\n$navbar-inverse-link-hover-bg: transparent !default;\n$navbar-inverse-link-active-color: $navbar-inverse-link-hover-color !default;\n$navbar-inverse-link-active-bg: color.adjust($navbar-inverse-bg, $lightness: -10%) !default;\n$navbar-inverse-link-disabled-color: #444 !default;\n$navbar-inverse-link-disabled-bg: transparent !default;\n\n// Inverted navbar brand label\n$navbar-inverse-brand-color: $navbar-inverse-link-color !default;\n$navbar-inverse-brand-hover-color: #fff !default;\n$navbar-inverse-brand-hover-bg: transparent !default;\n\n// Inverted navbar toggle\n$navbar-inverse-toggle-hover-bg: color.adjust(white, $lightness: -10%) !default;\n$navbar-inverse-toggle-icon-bar-bg: $gray !default;\n$navbar-inverse-toggle-border-color: $gray !default;\n\n//== Navs\n//\n//##\n\n//=== Shared nav styles\n$nav-link-padding: 12px 15px !default;\n$nav-link-hover-bg: transparent !default;\n\n$nav-disabled-link-color: $gray-light !default;\n$nav-disabled-link-hover-color: transparent !default;\n\n//== Tabs\n$nav-tabs-border-color: #ddd !default;\n\n$nav-tabs-link-hover-border-color: $gray-lighter !default;\n\n$nav-tabs-active-link-hover-bg: $body-bg !default;\n$nav-tabs-active-link-hover-color: $gray !default;\n$nav-tabs-active-link-hover-border-color: #ddd !default;\n\n$nav-tabs-justified-link-border-color: #ddd !default;\n$nav-tabs-justified-active-link-border-color: $body-bg !default;\n\n//== Pills\n$nav-pills-border-radius: $border-radius-base !default;\n$nav-pills-active-link-hover-bg: transparent !default;\n$nav-pills-active-link-hover-color: $brand-primary !default;\n\n//== Pagination\n//\n//##\n\n$pagination-color: $link-color !default;\n$pagination-bg: #fff !default;\n$pagination-border: #ddd !default;\n\n$pagination-hover-color: $link-hover-color !default;\n$pagination-hover-bg: $gray-lighter !default;\n$pagination-hover-border: #ddd !default;\n\n$pagination-active-color: #fff !default;\n$pagination-active-bg: $brand-primary !default;\n$pagination-active-border: $brand-primary !default;\n\n$pagination-disabled-color: $gray-light !default;\n$pagination-disabled-bg: #fff !default;\n$pagination-disabled-border: #ddd !default;\n\n//== Pager\n//\n//##\n\n$pager-bg: $pagination-bg !default;\n$pager-border: $pagination-border !default;\n$pager-border-radius: 15px !default;\n\n$pager-hover-bg: $pagination-hover-bg !default;\n\n$pager-active-bg: $pagination-active-bg !default;\n$pager-active-color: $pagination-active-color !default;\n\n$pager-disabled-color: $pagination-disabled-color !default;\n\n//== Jumbotron\n//\n//##\n\n$jumbotron-padding: 30px !default;\n$jumbotron-color: inherit !default;\n$jumbotron-bg: $gray-lighter !default;\n$jumbotron-heading-color: inherit !default;\n$jumbotron-font-size: math.ceil(($font-size-base * 1.5)) !default;\n$jumbotron-heading-font-size: math.ceil(($font-size-base * 4.5)) !default;\n\n//== Form states and alerts\n//\n//## Define colors for form feedback states and, by default, alerts.\n\n$state-success-text: #00c091 !default;\n$state-success-bg: #caf3e9 !default;\n$state-success-border: color.adjust(\n    color.adjust($state-success-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n$state-info-text: #31708f !default;\n$state-info-bg: #d9edf7 !default;\n$state-info-border: color.adjust(color.adjust($state-info-bg, $hue: -10), $lightness: -7%) !default;\n\n$state-warning-text: $brand-warning !default;\n$state-warning-bg: #fcf8e3 !default;\n$state-warning-border: color.adjust(\n    color.adjust($state-warning-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n$state-danger-text: $brand-danger !default;\n$state-danger-bg: #ffcbd6 !default;\n$state-danger-border: color.adjust(\n    color.adjust($state-danger-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n//== Tooltips\n//\n//##\n\n//** Tooltip max width\n$tooltip-max-width: 300px !default;\n//** Tooltip text color\n$tooltip-color: #fff !default;\n//** Tooltip background color\n$tooltip-bg: $gray-dark !default;\n$tooltip-opacity: 0.9 !default;\n\n//** Tooltip arrow width\n$tooltip-arrow-width: 5px !default;\n//** Tooltip arrow color\n$tooltip-arrow-color: $tooltip-bg !default;\n\n//== Popovers\n//\n//##\n\n//** Popover body background color\n$popover-bg: #fff !default;\n//** Popover maximum width\n$popover-max-width: 276px !default;\n//** Popover border color\n$popover-border-color: rgba(0, 0, 0, 0.2) !default;\n//** Popover fallback border color\n$popover-fallback-border-color: #ccc !default;\n\n//** Popover title background color\n$popover-title-bg: color.adjust($popover-bg, $lightness: -3%) !default;\n\n//** Popover arrow width\n$popover-arrow-width: 10px !default;\n//** Popover arrow color\n$popover-arrow-color: $popover-bg !default;\n\n//** Popover outer arrow width\n$popover-arrow-outer-width: ($popover-arrow-width + 1) !default;\n//** Popover outer arrow color\n$popover-arrow-outer-color: color.adjust($popover-border-color, $alpha: 0.05) !default;\n//** Popover outer arrow fallback color\n$popover-arrow-outer-fallback-color: color.adjust(\n    $popover-fallback-border-color,\n    $lightness: -20%\n) !default;\n\n//== Labels\n//\n//##\n\n//** Default label background color\n$label-default-bg: $gray-light !default;\n//** Primary label background color\n$label-primary-bg: $brand-primary !default;\n//** Success label background color\n$label-success-bg: $brand-success !default;\n//** Info label background color\n$label-info-bg: $brand-info !default;\n//** Warning label background color\n$label-warning-bg: $brand-warning !default;\n//** Danger label background color\n$label-danger-bg: $brand-danger !default;\n\n//** Default label text color\n$label-color: #fff !default;\n//** Default text color of a linked label\n$label-link-hover-color: #fff !default;\n$label-gray: #60696c;\n\n//== Modals\n//\n//##\n\n//** Padding applied to the modal body\n$modal-inner-padding: 35px 40px !default;\n\n//** Padding applied to the modal title\n$modal-title-padding: 35px 40px 35px 40px !default;\n//** Modal title line-height\n$modal-title-line-height: $line-height-base !default;\n\n//** Background color of modal content area\n$modal-content-bg: #fff !default;\n//** Modal content border color\n$modal-content-border-color: rgba(255, 255, 255, 0) !default;\n//** Modal content border color **for IE8**\n$modal-content-fallback-border-color: #999 !default;\n\n//** Modal backdrop background color\n$modal-backdrop-bg: #00bf93 !default;\n//** Modal backdrop opacity\n$modal-backdrop-opacity: 0.5 !default;\n//** Modal header border color\n$modal-header-border-color: #e6e6e6 !default;\n//** Modal footer border color\n$modal-footer-border-color: $modal-header-border-color !default;\n\n$modal-lg: 820px !default;\n$modal-md: 630px !default;\n$modal-sm: 420px !default;\n\n//== Alerts\n//\n//## Define alert colors, border radius, and padding.\n\n$alert-padding: 8px 15px !default;\n$alert-border-radius: 45px !default;\n$alert-link-font-weight: bold !default;\n\n$alert-success-bg: $state-success-bg !default;\n$alert-success-text: $state-success-text !default;\n$alert-success-border: #fff !default;\n\n$alert-info-bg: $state-info-bg !default;\n$alert-info-text: $state-info-text !default;\n$alert-info-border: #fff !default;\n\n$alert-warning-bg: $state-warning-bg !default;\n$alert-warning-text: $state-warning-text !default;\n$alert-warning-border: #fff !default;\n\n$alert-danger-bg: $state-danger-bg !default;\n$alert-danger-text: $state-danger-text !default;\n$alert-danger-border: #fff !default;\n\n//== Progress bars\n//\n//##\n\n//** Background color of the whole progress component\n$progress-bg: #e6e6e6 !default;\n//** Progress bar text color\n$progress-bar-color: #fff !default;\n//** Variable for setting rounded corners on progress bar.\n$progress-border-radius: 12px !default;\n\n//** Default progress bar color\n$progress-bar-bg: $brand-primary !default;\n//** Success progress bar color\n$progress-bar-success-bg: $brand-success !default;\n//** Warning progress bar color\n$progress-bar-warning-bg: $brand-warning !default;\n//** Danger progress bar color\n$progress-bar-danger-bg: $brand-danger !default;\n//** Info progress bar color\n$progress-bar-info-bg: $brand-info !default;\n\n//== List group\n//\n//##\n\n//** Background color on `.list-group-item`\n$list-group-bg: #fff !default;\n//** `.list-group-item` border color\n$list-group-border: #ddd !default;\n//** List group border radius\n$list-group-border-radius: $border-radius-base !default;\n\n//** Background color of single list items on hover\n$list-group-hover-bg: #f5f5f5 !default;\n//** Text color of active list items\n$list-group-active-color: $component-active-color !default;\n//** Background color of active list items\n$list-group-active-bg: $component-active-bg !default;\n//** Border color of active list elements\n$list-group-active-border: $list-group-active-bg !default;\n//** Text color for content within active list items\n$list-group-active-text-color: color.adjust($list-group-active-bg, $lightness: 40%) !default;\n\n//** Text color of disabled list items\n$list-group-disabled-color: $gray-light !default;\n//** Background color of disabled list items\n$list-group-disabled-bg: $gray-lighter !default;\n//** Text color for content within disabled list items\n$list-group-disabled-text-color: $list-group-disabled-color !default;\n\n$list-group-link-color: #555 !default;\n$list-group-link-hover-color: $list-group-link-color !default;\n$list-group-link-heading-color: #333 !default;\n\n//== Panels\n//\n//##\n\n$panel-bg: #fff !default;\n$panel-body-padding: 15px !default;\n$panel-heading-padding: 10px 15px !default;\n$panel-footer-padding: $panel-heading-padding !default;\n$panel-border-radius: $border-radius-base !default;\n\n//** Border color for elements within panels\n$panel-inner-border: #ddd !default;\n$panel-footer-bg: #f5f5f5 !default;\n\n$panel-default-text: $gray-dark !default;\n$panel-default-border: #ddd !default;\n$panel-default-heading-bg: #f5f5f5 !default;\n\n$panel-primary-text: #fff !default;\n$panel-primary-border: $brand-primary !default;\n$panel-primary-heading-bg: $brand-primary !default;\n\n$panel-success-text: $state-success-text !default;\n$panel-success-border: $state-success-border !default;\n$panel-success-heading-bg: $state-success-bg !default;\n\n$panel-info-text: $state-info-text !default;\n$panel-info-border: $state-info-border !default;\n$panel-info-heading-bg: $state-info-bg !default;\n\n$panel-warning-text: $state-warning-text !default;\n$panel-warning-border: $state-warning-border !default;\n$panel-warning-heading-bg: $state-warning-bg !default;\n\n$panel-danger-text: $state-danger-text !default;\n$panel-danger-border: $state-danger-border !default;\n$panel-danger-heading-bg: $state-danger-bg !default;\n\n//== Thumbnails\n//\n//##\n\n//** Padding around the thumbnail image\n$thumbnail-padding: 4px !default;\n//** Thumbnail background color\n$thumbnail-bg: $body-bg !default;\n//** Thumbnail border color\n$thumbnail-border: #ddd !default;\n//** Thumbnail border radius\n$thumbnail-border-radius: $border-radius-base !default;\n\n//** Custom text color for thumbnail captions\n$thumbnail-caption-color: $text-color !default;\n//** Padding around the thumbnail caption\n$thumbnail-caption-padding: 9px !default;\n\n//== Wells\n//\n//##\n\n$well-bg: #f5f5f5 !default;\n$well-border: color.adjust($well-bg, $lightness: -7%) !default;\n\n//== Badges\n//\n//##\n\n$badge-color: #fff !default;\n//** Linked badge text color on hover\n$badge-link-hover-color: #fff !default;\n$badge-bg: $gray-light !default;\n\n//** Badge text color in active nav link\n$badge-active-color: $link-color !default;\n//** Badge background color in active nav link\n$badge-active-bg: #fff !default;\n\n$badge-font-weight: bold !default;\n$badge-line-height: 1 !default;\n$badge-border-radius: 35px !default;\n\n//== Breadcrumbs\n//\n//##\n\n$breadcrumb-padding-vertical: 8px !default;\n$breadcrumb-padding-horizontal: 15px !default;\n//** Breadcrumb background color\n$breadcrumb-bg: #f5f5f5 !default;\n//** Breadcrumb text color\n$breadcrumb-color: #ccc !default;\n//** Text color of current page in the breadcrumb\n$breadcrumb-active-color: $gray-light !default;\n//** Textual separator for between breadcrumb elements\n$breadcrumb-separator: "/" !default;\n\n//== Carousel\n//\n//##\n\n$carousel-text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6) !default;\n\n$carousel-control-color: #fff !default;\n$carousel-control-width: 15% !default;\n$carousel-control-opacity: 0.5 !default;\n$carousel-control-font-size: 20px !default;\n\n$carousel-indicator-active-bg: #fff !default;\n$carousel-indicator-border-color: #fff !default;\n\n$carousel-caption-color: #fff !default;\n\n//== Close\n//\n//##\n\n$close-font-weight: bold !default;\n$close-color: #000 !default;\n$close-text-shadow: 0 1px 0 #fff !default;\n\n//== Code\n//\n//##\n\n$code-color: #c7254e !default;\n$code-bg: #f9f2f4 !default;\n\n$kbd-color: #fff !default;\n$kbd-bg: #333 !default;\n\n$pre-bg: #f5f5f5 !default;\n$pre-color: $gray-dark !default;\n$pre-border-color: #ccc !default;\n$pre-scrollable-max-height: 340px !default;\n\n//== Type\n//\n//##\n\n//** Horizontal offset for forms and lists.\n$component-offset-horizontal: 180px !default;\n//** Text muted color\n$text-muted: $gray-lighter !default;\n//** Abbreviations and acronyms border color\n$abbr-border-color: $gray-light !default;\n//** Headings small color\n$headings-small-color: $gray-light !default;\n//** Blockquote small color\n$blockquote-small-color: $gray-light !default;\n//** Blockquote font size\n$blockquote-font-size: ($font-size-base * 1.25) !default;\n//** Blockquote border color\n$blockquote-border-color: $gray-lighter !default;\n//** Page header border color\n$page-header-border-color: $gray-lighter !default;\n//** Horizontal line color.\n$hr-border: $gray-1-50 !default;\n'],sourceRoot:""}]),l.locals={title:"CombineCoverLetterAndResume-module_title__wtiKS",description:"CombineCoverLetterAndResume-module_description__gMG9J"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/modules/Common/DownloadToolbar.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,".DownloadToolbar-module_toolbar__S8IK9{position:fixed;background:#fff;top:0;left:0;right:0;z-index:1003;padding:10px 20px}.DownloadToolbar-module_eyeIcon__O9F1M{font-size:20px;line-height:14px}.DownloadToolbar-module_backButton__w94NG{width:20px;height:20px;font-size:20px;transform:rotate(180deg);color:#8c7cdb;margin-right:20px;cursor:pointer}","",{version:3,sources:["webpack://./src/modules/Common/DownloadToolbar.module.scss","webpack://./node_modules/enhancv-styleguide/variables.scss"],names:[],mappings:"AAEA,uCACI,cAAA,CACA,eC8BI,CD7BJ,KAAA,CACA,MAAA,CACA,OAAA,CACA,YAAA,CACA,iBAAA,CAGJ,uCACI,cAAA,CACA,gBAAA,CAGJ,0CACI,UAAA,CACA,WAAA,CACA,cAAA,CACA,wBAAA,CACA,aCOQ,CDNR,iBAAA,CACA,cAAA",sourcesContent:['@import "~enhancv-styleguide/variables";\n\n.toolbar {\n    position: fixed;\n    background: $surface;\n    top: 0;\n    left: 0;\n    right: 0;\n    z-index: 1003;\n    padding: 10px 20px;\n}\n\n.eyeIcon {\n    font-size: 20px;\n    line-height: 14px;\n}\n\n.backButton {\n    width: 20px;\n    height: 20px;\n    font-size: 20px;\n    transform: rotate(180deg);\n    color: $secondary;\n    margin-right: 20px;\n    cursor: pointer;\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6df;\n$warning-hover: #feba62;\n\n// // Active elements\n$primary-active: #249a71;\n$secondary-active: #5f4dc7;\n$info-active: #3685bb;\n$warning-active: #d89745;\n$danger-active: #d94a5e;\n\n// // Transparent elements\n// // // opacity: 10%;\n$primary-10: rgba($primary, 0.1);\n$secondary-10: rgba($secondary, 0.1);\n$accent-10: rgba($accent, 0.1);\n$info-10: rgba($info, 0.1);\n$warning-10: rgba($warning, 0.1);\n$danger-10: rgba($danger, 0.1);\n// // // opacity 20%\n$primary-20: rgba($primary, 0.2);\n$secondary-20: rgba($secondary, 0.2);\n$accent-20: rgba($accent, 0.2);\n$info-20: rgba($info, 0.2);\n$warning-20: rgba($warning, 0.2);\n$danger-20: rgba($danger, 0.2);\n// // // opacity 30%\n$primary-30: rgba($primary, 0.3);\n$secondary-30: rgba($secondary, 0.3);\n$accent-30: rgba($accent, 0.3);\n$info-30: rgba($info, 0.3);\n$warning-30: rgba($warning, 0.3);\n$danger-30: rgba($danger, 0.3);\n\n// // Backgrounds\n$surface: $white;\n$surface-accent: #9cb2dc;\n$page: #f5f7fc;\n$page-alt: #fafbfd;\n\n// // Typography Colors\n$heading: #2d3639;\n$paragraph: #384347;\n$label: #60696c;\n$caption: #afb4b5;\n$subtext: #d8d9db;\n\n// // Supportive colors\n$modal: #47445a;\n$graphic-1: #f0f0f0;\n$graphic-2: #e4e4e4;\n$graphic-3: #f2f2f2;\n$border-color: #e0e0e0;\n\n// // CC colors\n$primary-cc: #eaf9f4;\n$secondary-cc: #f3f2fb;\n$danger-cc: #ffeef1;\n$info-cc: #ecf5fc;\n\n// // Visual elements Colors\n$visual-violet-1: #d1cbf1;\n$visual-violet-2: #e3e0f6;\n$visual-green-1: #abe6d1;\n$visual-green-2: #cdf0e4;\n$visual-blue: #b2d7f1;\n$visual-orange: #ffe0b9;\n$visual-pink: #ffcdd4;\n\n// // Shadows\n$shadow-default: 0px 4px 8px rgba(0, 0, 0, 0.1);\n$shadow-hover: 0px 2px 20px rgba(0, 0, 0, 0.1);\n$shadow-flat: 1px 1px 1px rgba(231, 228, 228, 0.5);\n$shadow-main-navigation: 0px 1px 3px rgba(0, 0, 0, 0.1);\n\n// Font-sizes\n$font-size-lg: 20px;\n$font-size-md: 18px;\n$font-size-rg: 16px;\n$font-size-sm: 14px;\n$font-size-xs: 12px;\n$font-size-xs-min: 10px;\n\n// Container - (with padding-inline:16px included)\n$container-xs: 100%;\n$container-md: 736px; // 12columns x 64px\n$container-lg: 956px; // 12columns x 84px\n$container-xl: 1184px; // 12columns x 96px\n$container-xxl: 1328px; // 12columns x 108px\n\n// Z-index modal\n$zindex-modal-background: 1002;\n$zindex-modal-content: 1003;\n'],sourceRoot:""}]),l.locals={toolbar:"DownloadToolbar-module_toolbar__S8IK9",eyeIcon:"DownloadToolbar-module_eyeIcon__O9F1M",backButton:"DownloadToolbar-module_backButton__w94NG"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/modules/Common/EmptyFieldsMessage.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,".EmptyFieldsMessage-module_borderRounded__eePZx{border-radius:20px}","",{version:3,sources:["webpack://./src/modules/Common/EmptyFieldsMessage.module.scss"],names:[],mappings:"AAAA,gDACI,kBAAA",sourcesContent:[".borderRounded {\n    border-radius: 20px;\n}\n"],sourceRoot:""}]),l.locals={borderRounded:"EmptyFieldsMessage-module_borderRounded__eePZx"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/modules/Common/EnhancvLoader.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,".EnhancvLoader-module_fullScreen__XlJGB{position:fixed;top:50%;left:50%;transform:translateX(-50%) translateY(-50%);z-index:1000000}.EnhancvLoader-module_center__cuodl{position:absolute;top:50%;left:50%;transform:translateX(-50%) translateY(-50%)}","",{version:3,sources:["webpack://./src/modules/Common/EnhancvLoader.module.scss"],names:[],mappings:"AAAA,wCACI,cAAA,CACA,OAAA,CACA,QAAA,CACA,2CAAA,CACA,eAAA,CAGJ,oCACI,iBAAA,CACA,OAAA,CACA,QAAA,CACA,2CAAA",sourcesContent:[".fullScreen {\n    position: fixed;\n    top: 50%;\n    left: 50%;\n    transform: translateX(-50%) translateY(-50%);\n    z-index: 1000000;\n}\n\n.center {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translateX(-50%) translateY(-50%);\n}\n"],sourceRoot:""}]),l.locals={fullScreen:"EnhancvLoader-module_fullScreen__XlJGB",center:"EnhancvLoader-module_center__cuodl"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/modules/Common/FullScreenDropdown.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,".FullScreenDropdown-module_download__pkahH{position:fixed;z-index:1004;top:0;left:0;height:100%;width:100vw;background:rgba(71,68,90,.9)}","",{version:3,sources:["webpack://./src/modules/Common/FullScreenDropdown.module.scss","webpack://./node_modules/sharedstyle/_variables.scss"],names:[],mappings:"AAGA,2CACI,cAAA,CACA,YCoV0B,CDnV1B,KAAA,CACA,MAAA,CACA,WAAA,CACA,WAAA,CACA,4BAAA",sourcesContent:['@import "enhancv-styleguide/variables";\n@import "~sharedstyle/variables";\n\n.download {\n    position: fixed;\n    z-index: $zindex-full-screen-dropdown;\n    top: 0;\n    left: 0;\n    height: 100%;\n    width: 100vw;\n    background: rgba($modal, 0.9);\n}\n','@use "sass:color";\n@use "sass:math";\n//\n// Variables\n// --------------------------------------------------\n\n//== Colors\n//\n//## Gray and brand colors for use across Bootstrap.\n\n$shadow-4: 0 0 12px -3px rgba(0, 0, 0, 0.3);\n$shadow-5: 0 0 4px 0px rgba(0, 0, 0, 0.3);\n\n$shadow-1: 0 0 4px 0 rgba(160, 162, 167, 0.15);\n$shadow-2: 0 0 2px 0 rgba(77, 77, 77, 0.16);\n$shadow-3: 0 0 2px 0 rgba(83, 83, 83, 0.5);\n\n$gray-base: #000 !default;\n$gray-dark: #384347 !default;\n$resume-body-color: #3e3e3e !default; // specific body color for the resumes - without blue color included\n$gray-dark-2: #222 !default;\n$gray: color.adjust($gray-base, $lightness: 33.5%) !default; // #555\n$gray-light: color.adjust($gray-base, $lightness: 46.7%) !default; // #777\n$gray-lighter: color.adjust($gray-base, $lightness: 80%) !default; // #ccc\n$green-light: #eaf8f3;\n\n$gray-1: #b2b4b6;\n$gray-1-20: rgba($gray-1, 0.2);\n$gray-1-50: rgba($gray-1, 0.5);\n$gray-2: #65696d;\n$gray-2-20: rgba($gray-2, 0.2);\n$gray-2-50: rgba($gray-2, 0.5);\n$gray-3: #384347;\n$gray-3-20: rgba($gray-3, 0.2);\n$gray-3-50: rgba($gray-3, 0.5);\n\n$green-3: #2dc08d;\n$green-2: #62d0aa;\n$green-1: #d5f2e8;\n$green-hover: #249a71;\n\n$purple-3: #8c7cdb;\n$purple-2: #c5bded;\n$purple-1: #e8e5f8;\n\n$red-3: #ff576f;\n$red-2: #ffabb7;\n$red-1: #ffeef0;\n\n$blue-3: #7aaacb;\n$blue-2: #b5d6ec;\n$blue-1: #e2eff8;\n$blue-background: #f3f5fa;\n\n$yellow-3: #feb251;\n$yellow-2: #fed8a7;\n$yellow-1: #fff0dc;\n\n$background: #fafbfd;\n$brand-primary: #00c091;\n$brand-promo: #e7762e;\n$brand-success: #2dc08c !default;\n$brand-info: #5bc0de !default;\n$brand-warning: #f2994a !default;\n$brand-danger: #ff576f !default;\n$brand-border-color: #e6e6e6 !default;\n$brand-grey-background: #f2f2f2;\n$color-facebook: #3b5998;\n$color-twitter: #5eaade;\n$color-gplus: #dd4b39;\n$color-instagram: #333333;\n$color-linkedin: #2578b5;\n$color-messenger-first: rgb(1, 183, 255);\n$color-messenger-second: rgb(0, 126, 254);\n$color-messenger-border: #ffffff;\n$color-onboarding: #009ee8;\n$purple-color: #8c7cdb;\n$brand-gray-color: #65696d;\n$brand-info-font-color: #b2b4b6;\n$toolbox-border: rgba(223, 223, 223, 0.52);\n$selected-item-border-color: #60d5ba;\n\n$white: white;\n\n$op-background-color: #333333;\n$op-nav-control-color: #464646;\n$op-control-color: $gray-dark;\n$op-light-color: #e6e6e6;\n$op-control-primary-color: $brand-success;\n$op-notification-bg-primary: #ccf5e9;\n$op-notification-bg-danger: #ffc7d4;\n$op-notification-bg-warning: #ffe2ca;\n\n$op-base-offset: 8px !default;\n$op-btn-padding-horizontal: 14px;\n\n//Resume Styles\n$resume-rounding: 5px;\n\n//== Scaffolding\n//\n//## Settings for some of the most global styles.\n\n//** Background color for `<body>`.\n$body-bg: #fff !default;\n//** Global text color on `<body>`.\n$text-color: $gray-dark !default;\n\n$text-color-hover: color.adjust($text-color, $lightness: 30%) !default;\n\n//** Global textual link color.\n$link-color: white !default;\n//** Link hover color set via `darken()` function.\n$link-hover-color: color.adjust(white, $lightness: -10%);\n//** Link hover decoration.\n$link-hover-decoration: none !default;\n\n//== Typography\n//\n//## Font, line-height, and color for body text, headings, and more.\n\n$font-family-sans-serif: "Roboto", Arial, Helvetica, "Noto Sans Devanagari", "Noto Sans CJK SC Thin",\n    "Noto Sans SC", "Noto Sans Hebrew", "Noto Sans Bengali", sans-serif !default;\n$font-family-serif: Georgia, "Times New Roman", Times, "Noto Sans Devanagari",\n    "Noto Sans CJK SC Thin", "Noto Sans SC", "Noto Sans Hebrew", "Noto Sans Bengali", serif !default;\n//** Default monospace fonts for `<code>`, `<kbd>`, and `<pre>`.\n$font-family-monospace: Menlo, Monaco, Consolas, "Courier New", monospace !default;\n$font-family-base: "Inter" !default;\n\n$roboto: "Roboto", Arial, Helvetica, sans-serif;\n$opensans: "Open Sans", Arial, Helvetica, sans-serif;\n$account-heading-font: "Rubik", sans-serif !important;\n\n$font-size-base: 14px !default;\n$font-size-large: 18px !default;\n$font-size-small: 11px !default;\n\n$font-size-h1: 68px !default; // ~36px\n$font-size-h2: 38px !default; // ~30px\n$font-size-h3: 32px !default; // ~24px\n$font-size-h4: 26px !default; // ~18px\n$font-size-h5: 22px !default;\n$font-size-h6: 20px !default; // ~12px\n\n//** Unit-less `line-height` for use in components like buttons.\n$line-height-base: 1.428571429 !default; // 20/14\n//** Computed "line-height" (`font-size` * `line-height`) for use with `margin`, `padding`, etc.\n$line-height-computed: math.floor(($font-size-base * $line-height-base)) !default; // ~20px\n\n//** By default, this inherits from the `<body>`.\n$headings-font-family: "Rubik", sans-serif !default;\n$headings-font-weight: 300 !default;\n$headings-line-height: 1.1 !default;\n$headings-color: $gray-dark !default;\n\n//== Components\n//\n//## Define common padding and border radius sizes and more. Values based on 14px text and 1.428 line-height (~20px to start).\n\n$padding-base-vertical: 9px !default;\n$padding-base-horizontal: 14px !default;\n\n$padding-large-vertical: 12px !default;\n$padding-large-horizontal: 24px !default;\n\n$padding-small-vertical: 5px !default;\n$padding-small-horizontal: 18px !default;\n\n$padding-xs-vertical: 1px !default;\n$padding-xs-horizontal: 12px !default;\n\n$line-height-large: 1.3333333 !default; // extra decimals for Win 8.1 Chrome\n$line-height-small: 1.5 !default;\n\n$border-radius-base: 5px !default;\n$border-radius-large: 9px !default;\n$border-radius-small: 4px !default;\n\n//** Global color for active items (e.g., navs or dropdowns).\n$component-active-color: #fff !default;\n//** Global background color for active items (e.g., navs or dropdowns).\n$component-active-bg: $brand-primary !default;\n\n//** Width of the `border` for generating carets that indicator dropdowns.\n$caret-width-base: 4px !default;\n//** Carets increase slightly in size for larger components.\n$caret-width-large: 5px !default;\n\n//== Tables\n//\n//## Customizes the `.table` component with basic values, each used across all table variations.\n\n//** Padding for `<th>`s and `<td>`s.\n$table-cell-padding: 8px !default;\n//** Padding for cells in `.table-condensed`.\n$table-condensed-cell-padding: 5px !default;\n\n//** Default background color used for all tables.\n$table-bg: transparent !default;\n//** Background color used for `.table-striped`.\n$table-bg-accent: #f9f9f9 !default;\n//** Background color used for `.table-hover`.\n$table-bg-hover: #f5f5f5 !default;\n$table-bg-active: $table-bg-hover !default;\n\n//** Border color for table and cell borders.\n$table-border-color: #ddd !default;\n\n//== Buttons\n//\n//## For each of Bootstrap\'s buttons, define text, background and border color.\n\n$btn-font-weight: bold !default;\n\n$btn-default-color: #8c7cdb !default;\n$btn-default-bg: #fff !default;\n$btn-default-border: #8c7cdb !default;\n\n$btn-primary-color: #fff !default;\n$btn-primary-bg: $brand-primary !default;\n$btn-primary-border: $brand-primary !default;\n\n$btn-success-color: #fff !default;\n$btn-success-bg: $brand-success !default;\n$btn-success-border: color.adjust($btn-success-bg, $lightness: -5%) !default;\n\n$btn-info-color: #fff !default;\n$btn-info-bg: $brand-info !default;\n$btn-info-border: color.adjust($btn-info-bg, $lightness: -5%) !default;\n\n$btn-warning-color: #fff !default;\n$btn-warning-bg: $brand-warning !default;\n$btn-warning-border: color.adjust($btn-warning-bg, $lightness: -5%) !default;\n\n$btn-danger-color: #fff !default;\n$btn-danger-bg: $brand-danger !default;\n$btn-danger-border: color.adjust($btn-danger-bg, $lightness: -5%) !default;\n\n$btn-link-disabled-color: $gray-light !default;\n\n// Allows for customizing button radius independently from global border radius\n$btn-border-radius-base: $border-radius-base;\n$btn-border-radius-large: $border-radius-base;\n$btn-border-radius-small: $border-radius-base;\n\n//== Forms\n//\n//##\n\n//** `<input>` background color\n$input-bg: #fff !default;\n//** `<input disabled>` background color\n$input-bg-disabled: $gray-lighter !default;\n\n//** Text color for `<input>`s\n$input-color: $gray !default;\n//** `<input>` border color\n$input-border: #b3b3b3 !default;\n\n// TODO: Rename `$input-border-radius` to `$input-border-radius-base` in v4\n//** Default `.form-control` border radius\n// This has no effect on `<select>`s in some browsers, due to the limited stylability of `<select>`s in CSS.\n$input-border-radius: $border-radius-base;\n//** Large `.form-control` border radius\n$input-border-radius-large: $border-radius-base;\n//** Small `.form-control` border radius\n$input-border-radius-small: $border-radius-base;\n\n//** Border color for inputs on focus\n$input-border-focus: $brand-primary !default;\n\n//** Placeholder text color\n$input-color-placeholder: color.adjust($gray-base, $lightness: 70%) !default;\n\n//** Default `.form-control` height\n$input-height-base: ($line-height-computed + ($padding-base-vertical * 2) + 2) !default;\n//** Large `.form-control` height\n$input-height-large: (\n    math.ceil($font-size-large * $line-height-large) + ($padding-large-vertical * 2) + 2\n) !default;\n//** Small `.form-control` height\n$input-height-small: (\n    math.floor($font-size-small * $line-height-small) + ($padding-small-vertical * 2) + 2\n) !default;\n\n//** `.form-group` margin\n$form-group-margin-bottom: 15px !default;\n\n$legend-color: $gray-dark !default;\n$legend-border-color: #e5e5e5 !default;\n\n//** Background color for textual input addons\n$input-group-addon-bg: $gray-lighter !default;\n//** Border color for textual input addons\n$input-group-addon-border-color: $input-border !default;\n\n//** Disabled cursor for form controls and buttons.\n$cursor-disabled: not-allowed !default;\n\n//== Dropdowns\n//\n//## Dropdown menu container and contents.\n\n//** Background for the dropdown menu.\n$dropdown-bg: #fff !default;\n//** Dropdown menu `border-color`.\n$dropdown-border: rgba(0, 0, 0, 0.15) !default;\n//** Dropdown menu `border-color` **for IE8**.\n$dropdown-fallback-border: #ccc !default;\n//** Divider color for between dropdown items.\n$dropdown-divider-bg: #e5e5e5 !default;\n\n//** Dropdown link text color.\n$dropdown-link-color: $gray-dark !default;\n//** Hover color for dropdown links.\n$dropdown-link-hover-color: color.adjust($gray-dark, $lightness: 50%) !default;\n//** Hover background for dropdown links.\n$dropdown-link-hover-bg: transparent !default;\n\n//** Active dropdown menu item text color.\n$dropdown-link-active-color: $component-active-color !default;\n//** Active dropdown menu item background color.\n$dropdown-link-active-bg: $component-active-bg !default;\n\n//** Disabled dropdown menu item background color.\n$dropdown-link-disabled-color: $gray-light !default;\n\n//** Text color for headers within dropdown menus.\n$dropdown-header-color: $gray-light !default;\n\n//** Deprecated `$dropdown-caret-color` as of v3.1.0\n$dropdown-caret-color: #000 !default;\n\n//-- Z-index master list\n//\n// Warning: Avoid customizing these values. They\'re used for a bird\'s eye view\n// of components dependent on the z-axis and are designed to all work together.\n//\n// Note: These variables are not generated into the Customizer.\n\n$zindex-navbar: 1000 !default;\n$zindex-dropdown: 1000 !default;\n$zindex-mobile-design-menu: 1001 !default;\n$zindex-modal-background: 1002 !default; // from style guide --\x3e\n$zindex-modal-content: 1003 !default; // <--\n$zindex-full-screen-dropdown: 1004 !default;\n$zindex-popover: 1020 !default;\n$zindex-tooltip: 1050 !default;\n$zindex-navbar-fixed: 1030 !default;\n$zindex-toaster: 1030 !default;\n$zindex-alert: 1060 !default;\n$zindex-op-currdoing-cirle: 100 !default;\n$zindex-op-section-controls: 1 !default;\n$zindex-toasters: 8000 !default;\n\n//== Media queries breakpoints\n//\n//## Define the breakpoints at which your layout will change, adapting to different screen sizes.\n\n//== Grid system\n//\n//## Define your custom responsive grid.\n\n//** Number of columns in the grid.\n$grid-columns: 12 !default;\n//** Padding between columns. Gets divided in half for the left and right.\n$grid-gutter-width: 20px !default;\n\n//== Navbar OP\n//\n//##\n$op-navbar-height: 64px !default;\n$op-navbar-padding: 2 * $op-base-offset !default;\n\n//== Navbar\n//\n//##\n\n// Basics of a navbar\n$navbar-height: 60px !default;\n$navbar-padding: 16px !default;\n$navbar-margin-bottom: 0 !default;\n$navbar-border-radius: 0 !default;\n$navbar-padding-horizontal: math.floor(($grid-gutter-width * 0.5)) !default;\n$navbar-padding-vertical: (($navbar-height - $line-height-computed) * 0.5) !default;\n$navbar-collapse-max-height: 340px !default;\n\n$navbar-default-color: $text-color !default;\n$navbar-default-bg: white !default;\n$navbar-default-border: transparent !default;\n\n// Navbar links\n$navbar-default-link-color: $text-color !default;\n$navbar-default-link-hover-color: $purple-color !default;\n$navbar-default-link-hover-bg: transparent !default;\n$navbar-default-link-active-color: #b2b4b6 !default;\n$navbar-default-link-active-bg: color.adjust($navbar-default-bg, $lightness: -6.5%) !default;\n$navbar-default-link-disabled-color: #ccc !default;\n$navbar-default-link-disabled-bg: transparent !default;\n\n// Navbar brand label\n$navbar-default-brand-color: #e6e6e6 !default;\n$navbar-default-brand-hover-color: color.adjust(\n    $navbar-default-brand-color,\n    $lightness: -10%\n) !default;\n$navbar-default-brand-hover-bg: transparent !default;\n\n// Navbar toggle\n$navbar-default-toggle-hover-bg: color.adjust(white, $lightness: -5%) !default;\n$navbar-default-toggle-icon-bar-bg: $text-color !default;\n$navbar-default-toggle-border-color: transparent !default;\n\n//=== Inverted navbar\n// Reset inverted navbar basics\n$navbar-inverse-color: $brand-gray-color !default;\n$navbar-inverse-bg: white !default;\n$navbar-inverse-border: $brand-border-color !default;\n\n// Inverted navbar links\n$navbar-inverse-link-color: $brand-gray-color !default;\n$navbar-inverse-link-hover-color: $text-color;\n$navbar-inverse-link-hover-bg: transparent !default;\n$navbar-inverse-link-active-color: $navbar-inverse-link-hover-color !default;\n$navbar-inverse-link-active-bg: color.adjust($navbar-inverse-bg, $lightness: -10%) !default;\n$navbar-inverse-link-disabled-color: #444 !default;\n$navbar-inverse-link-disabled-bg: transparent !default;\n\n// Inverted navbar brand label\n$navbar-inverse-brand-color: $navbar-inverse-link-color !default;\n$navbar-inverse-brand-hover-color: #fff !default;\n$navbar-inverse-brand-hover-bg: transparent !default;\n\n// Inverted navbar toggle\n$navbar-inverse-toggle-hover-bg: color.adjust(white, $lightness: -10%) !default;\n$navbar-inverse-toggle-icon-bar-bg: $gray !default;\n$navbar-inverse-toggle-border-color: $gray !default;\n\n//== Navs\n//\n//##\n\n//=== Shared nav styles\n$nav-link-padding: 12px 15px !default;\n$nav-link-hover-bg: transparent !default;\n\n$nav-disabled-link-color: $gray-light !default;\n$nav-disabled-link-hover-color: transparent !default;\n\n//== Tabs\n$nav-tabs-border-color: #ddd !default;\n\n$nav-tabs-link-hover-border-color: $gray-lighter !default;\n\n$nav-tabs-active-link-hover-bg: $body-bg !default;\n$nav-tabs-active-link-hover-color: $gray !default;\n$nav-tabs-active-link-hover-border-color: #ddd !default;\n\n$nav-tabs-justified-link-border-color: #ddd !default;\n$nav-tabs-justified-active-link-border-color: $body-bg !default;\n\n//== Pills\n$nav-pills-border-radius: $border-radius-base !default;\n$nav-pills-active-link-hover-bg: transparent !default;\n$nav-pills-active-link-hover-color: $brand-primary !default;\n\n//== Pagination\n//\n//##\n\n$pagination-color: $link-color !default;\n$pagination-bg: #fff !default;\n$pagination-border: #ddd !default;\n\n$pagination-hover-color: $link-hover-color !default;\n$pagination-hover-bg: $gray-lighter !default;\n$pagination-hover-border: #ddd !default;\n\n$pagination-active-color: #fff !default;\n$pagination-active-bg: $brand-primary !default;\n$pagination-active-border: $brand-primary !default;\n\n$pagination-disabled-color: $gray-light !default;\n$pagination-disabled-bg: #fff !default;\n$pagination-disabled-border: #ddd !default;\n\n//== Pager\n//\n//##\n\n$pager-bg: $pagination-bg !default;\n$pager-border: $pagination-border !default;\n$pager-border-radius: 15px !default;\n\n$pager-hover-bg: $pagination-hover-bg !default;\n\n$pager-active-bg: $pagination-active-bg !default;\n$pager-active-color: $pagination-active-color !default;\n\n$pager-disabled-color: $pagination-disabled-color !default;\n\n//== Jumbotron\n//\n//##\n\n$jumbotron-padding: 30px !default;\n$jumbotron-color: inherit !default;\n$jumbotron-bg: $gray-lighter !default;\n$jumbotron-heading-color: inherit !default;\n$jumbotron-font-size: math.ceil(($font-size-base * 1.5)) !default;\n$jumbotron-heading-font-size: math.ceil(($font-size-base * 4.5)) !default;\n\n//== Form states and alerts\n//\n//## Define colors for form feedback states and, by default, alerts.\n\n$state-success-text: #00c091 !default;\n$state-success-bg: #caf3e9 !default;\n$state-success-border: color.adjust(\n    color.adjust($state-success-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n$state-info-text: #31708f !default;\n$state-info-bg: #d9edf7 !default;\n$state-info-border: color.adjust(color.adjust($state-info-bg, $hue: -10), $lightness: -7%) !default;\n\n$state-warning-text: $brand-warning !default;\n$state-warning-bg: #fcf8e3 !default;\n$state-warning-border: color.adjust(\n    color.adjust($state-warning-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n$state-danger-text: $brand-danger !default;\n$state-danger-bg: #ffcbd6 !default;\n$state-danger-border: color.adjust(\n    color.adjust($state-danger-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n//== Tooltips\n//\n//##\n\n//** Tooltip max width\n$tooltip-max-width: 300px !default;\n//** Tooltip text color\n$tooltip-color: #fff !default;\n//** Tooltip background color\n$tooltip-bg: $gray-dark !default;\n$tooltip-opacity: 0.9 !default;\n\n//** Tooltip arrow width\n$tooltip-arrow-width: 5px !default;\n//** Tooltip arrow color\n$tooltip-arrow-color: $tooltip-bg !default;\n\n//== Popovers\n//\n//##\n\n//** Popover body background color\n$popover-bg: #fff !default;\n//** Popover maximum width\n$popover-max-width: 276px !default;\n//** Popover border color\n$popover-border-color: rgba(0, 0, 0, 0.2) !default;\n//** Popover fallback border color\n$popover-fallback-border-color: #ccc !default;\n\n//** Popover title background color\n$popover-title-bg: color.adjust($popover-bg, $lightness: -3%) !default;\n\n//** Popover arrow width\n$popover-arrow-width: 10px !default;\n//** Popover arrow color\n$popover-arrow-color: $popover-bg !default;\n\n//** Popover outer arrow width\n$popover-arrow-outer-width: ($popover-arrow-width + 1) !default;\n//** Popover outer arrow color\n$popover-arrow-outer-color: color.adjust($popover-border-color, $alpha: 0.05) !default;\n//** Popover outer arrow fallback color\n$popover-arrow-outer-fallback-color: color.adjust(\n    $popover-fallback-border-color,\n    $lightness: -20%\n) !default;\n\n//== Labels\n//\n//##\n\n//** Default label background color\n$label-default-bg: $gray-light !default;\n//** Primary label background color\n$label-primary-bg: $brand-primary !default;\n//** Success label background color\n$label-success-bg: $brand-success !default;\n//** Info label background color\n$label-info-bg: $brand-info !default;\n//** Warning label background color\n$label-warning-bg: $brand-warning !default;\n//** Danger label background color\n$label-danger-bg: $brand-danger !default;\n\n//** Default label text color\n$label-color: #fff !default;\n//** Default text color of a linked label\n$label-link-hover-color: #fff !default;\n$label-gray: #60696c;\n\n//== Modals\n//\n//##\n\n//** Padding applied to the modal body\n$modal-inner-padding: 35px 40px !default;\n\n//** Padding applied to the modal title\n$modal-title-padding: 35px 40px 35px 40px !default;\n//** Modal title line-height\n$modal-title-line-height: $line-height-base !default;\n\n//** Background color of modal content area\n$modal-content-bg: #fff !default;\n//** Modal content border color\n$modal-content-border-color: rgba(255, 255, 255, 0) !default;\n//** Modal content border color **for IE8**\n$modal-content-fallback-border-color: #999 !default;\n\n//** Modal backdrop background color\n$modal-backdrop-bg: #00bf93 !default;\n//** Modal backdrop opacity\n$modal-backdrop-opacity: 0.5 !default;\n//** Modal header border color\n$modal-header-border-color: #e6e6e6 !default;\n//** Modal footer border color\n$modal-footer-border-color: $modal-header-border-color !default;\n\n$modal-lg: 820px !default;\n$modal-md: 630px !default;\n$modal-sm: 420px !default;\n\n//== Alerts\n//\n//## Define alert colors, border radius, and padding.\n\n$alert-padding: 8px 15px !default;\n$alert-border-radius: 45px !default;\n$alert-link-font-weight: bold !default;\n\n$alert-success-bg: $state-success-bg !default;\n$alert-success-text: $state-success-text !default;\n$alert-success-border: #fff !default;\n\n$alert-info-bg: $state-info-bg !default;\n$alert-info-text: $state-info-text !default;\n$alert-info-border: #fff !default;\n\n$alert-warning-bg: $state-warning-bg !default;\n$alert-warning-text: $state-warning-text !default;\n$alert-warning-border: #fff !default;\n\n$alert-danger-bg: $state-danger-bg !default;\n$alert-danger-text: $state-danger-text !default;\n$alert-danger-border: #fff !default;\n\n//== Progress bars\n//\n//##\n\n//** Background color of the whole progress component\n$progress-bg: #e6e6e6 !default;\n//** Progress bar text color\n$progress-bar-color: #fff !default;\n//** Variable for setting rounded corners on progress bar.\n$progress-border-radius: 12px !default;\n\n//** Default progress bar color\n$progress-bar-bg: $brand-primary !default;\n//** Success progress bar color\n$progress-bar-success-bg: $brand-success !default;\n//** Warning progress bar color\n$progress-bar-warning-bg: $brand-warning !default;\n//** Danger progress bar color\n$progress-bar-danger-bg: $brand-danger !default;\n//** Info progress bar color\n$progress-bar-info-bg: $brand-info !default;\n\n//== List group\n//\n//##\n\n//** Background color on `.list-group-item`\n$list-group-bg: #fff !default;\n//** `.list-group-item` border color\n$list-group-border: #ddd !default;\n//** List group border radius\n$list-group-border-radius: $border-radius-base !default;\n\n//** Background color of single list items on hover\n$list-group-hover-bg: #f5f5f5 !default;\n//** Text color of active list items\n$list-group-active-color: $component-active-color !default;\n//** Background color of active list items\n$list-group-active-bg: $component-active-bg !default;\n//** Border color of active list elements\n$list-group-active-border: $list-group-active-bg !default;\n//** Text color for content within active list items\n$list-group-active-text-color: color.adjust($list-group-active-bg, $lightness: 40%) !default;\n\n//** Text color of disabled list items\n$list-group-disabled-color: $gray-light !default;\n//** Background color of disabled list items\n$list-group-disabled-bg: $gray-lighter !default;\n//** Text color for content within disabled list items\n$list-group-disabled-text-color: $list-group-disabled-color !default;\n\n$list-group-link-color: #555 !default;\n$list-group-link-hover-color: $list-group-link-color !default;\n$list-group-link-heading-color: #333 !default;\n\n//== Panels\n//\n//##\n\n$panel-bg: #fff !default;\n$panel-body-padding: 15px !default;\n$panel-heading-padding: 10px 15px !default;\n$panel-footer-padding: $panel-heading-padding !default;\n$panel-border-radius: $border-radius-base !default;\n\n//** Border color for elements within panels\n$panel-inner-border: #ddd !default;\n$panel-footer-bg: #f5f5f5 !default;\n\n$panel-default-text: $gray-dark !default;\n$panel-default-border: #ddd !default;\n$panel-default-heading-bg: #f5f5f5 !default;\n\n$panel-primary-text: #fff !default;\n$panel-primary-border: $brand-primary !default;\n$panel-primary-heading-bg: $brand-primary !default;\n\n$panel-success-text: $state-success-text !default;\n$panel-success-border: $state-success-border !default;\n$panel-success-heading-bg: $state-success-bg !default;\n\n$panel-info-text: $state-info-text !default;\n$panel-info-border: $state-info-border !default;\n$panel-info-heading-bg: $state-info-bg !default;\n\n$panel-warning-text: $state-warning-text !default;\n$panel-warning-border: $state-warning-border !default;\n$panel-warning-heading-bg: $state-warning-bg !default;\n\n$panel-danger-text: $state-danger-text !default;\n$panel-danger-border: $state-danger-border !default;\n$panel-danger-heading-bg: $state-danger-bg !default;\n\n//== Thumbnails\n//\n//##\n\n//** Padding around the thumbnail image\n$thumbnail-padding: 4px !default;\n//** Thumbnail background color\n$thumbnail-bg: $body-bg !default;\n//** Thumbnail border color\n$thumbnail-border: #ddd !default;\n//** Thumbnail border radius\n$thumbnail-border-radius: $border-radius-base !default;\n\n//** Custom text color for thumbnail captions\n$thumbnail-caption-color: $text-color !default;\n//** Padding around the thumbnail caption\n$thumbnail-caption-padding: 9px !default;\n\n//== Wells\n//\n//##\n\n$well-bg: #f5f5f5 !default;\n$well-border: color.adjust($well-bg, $lightness: -7%) !default;\n\n//== Badges\n//\n//##\n\n$badge-color: #fff !default;\n//** Linked badge text color on hover\n$badge-link-hover-color: #fff !default;\n$badge-bg: $gray-light !default;\n\n//** Badge text color in active nav link\n$badge-active-color: $link-color !default;\n//** Badge background color in active nav link\n$badge-active-bg: #fff !default;\n\n$badge-font-weight: bold !default;\n$badge-line-height: 1 !default;\n$badge-border-radius: 35px !default;\n\n//== Breadcrumbs\n//\n//##\n\n$breadcrumb-padding-vertical: 8px !default;\n$breadcrumb-padding-horizontal: 15px !default;\n//** Breadcrumb background color\n$breadcrumb-bg: #f5f5f5 !default;\n//** Breadcrumb text color\n$breadcrumb-color: #ccc !default;\n//** Text color of current page in the breadcrumb\n$breadcrumb-active-color: $gray-light !default;\n//** Textual separator for between breadcrumb elements\n$breadcrumb-separator: "/" !default;\n\n//== Carousel\n//\n//##\n\n$carousel-text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6) !default;\n\n$carousel-control-color: #fff !default;\n$carousel-control-width: 15% !default;\n$carousel-control-opacity: 0.5 !default;\n$carousel-control-font-size: 20px !default;\n\n$carousel-indicator-active-bg: #fff !default;\n$carousel-indicator-border-color: #fff !default;\n\n$carousel-caption-color: #fff !default;\n\n//== Close\n//\n//##\n\n$close-font-weight: bold !default;\n$close-color: #000 !default;\n$close-text-shadow: 0 1px 0 #fff !default;\n\n//== Code\n//\n//##\n\n$code-color: #c7254e !default;\n$code-bg: #f9f2f4 !default;\n\n$kbd-color: #fff !default;\n$kbd-bg: #333 !default;\n\n$pre-bg: #f5f5f5 !default;\n$pre-color: $gray-dark !default;\n$pre-border-color: #ccc !default;\n$pre-scrollable-max-height: 340px !default;\n\n//== Type\n//\n//##\n\n//** Horizontal offset for forms and lists.\n$component-offset-horizontal: 180px !default;\n//** Text muted color\n$text-muted: $gray-lighter !default;\n//** Abbreviations and acronyms border color\n$abbr-border-color: $gray-light !default;\n//** Headings small color\n$headings-small-color: $gray-light !default;\n//** Blockquote small color\n$blockquote-small-color: $gray-light !default;\n//** Blockquote font size\n$blockquote-font-size: ($font-size-base * 1.25) !default;\n//** Blockquote border color\n$blockquote-border-color: $gray-lighter !default;\n//** Page header border color\n$page-header-border-color: $gray-lighter !default;\n//** Horizontal line color.\n$hr-border: $gray-1-50 !default;\n'],sourceRoot:""}]),l.locals={download:"FullScreenDropdown-module_download__pkahH"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/modules/Common/ImageEditor/View.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,".View-module_imageEditorView__LdxlF .View-module_avatarPanel__zD3b0{width:120px;height:120px}.View-module_imageEditorView__LdxlF .View-module_avatarPanel__zD3b0 .View-module_avatarButtonContainer__wPiTj:hover{background-color:rgba(0,0,0,.6)}.View-module_imageEditorView__LdxlF .View-module_avatarPanel__zD3b0 .View-module_avatarButtonContainerMobile__oNXU_{position:absolute;top:50%;right:-64px;transform:translateY(-50%)}@media screen and (max-width: 768px){.View-module_imageEditorView__LdxlF .View-module_avatarPanel__zD3b0{width:120px;height:120px}}","",{version:3,sources:["webpack://./src/modules/Common/ImageEditor/View.module.scss"],names:[],mappings:"AAGI,oEACI,WAAA,CACA,YAAA,CAGI,oHACI,+BAAA,CAIR,oHACI,iBAAA,CACA,OAAA,CACA,WAAA,CACA,0BAAA,CAGJ,qCAjBJ,oEAkBQ,WAAA,CACA,YAAA,CAAA",sourcesContent:['@import "enhancv-styleguide/variables";\n\n.imageEditorView {\n    .avatarPanel {\n        width: 120px;\n        height: 120px;\n\n        .avatarButtonContainer {\n            &:hover {\n                background-color: rgba(0, 0, 0, 0.6);\n            }\n        }\n\n        .avatarButtonContainerMobile {\n            position: absolute;\n            top: 50%;\n            right: -$base-offset * 8;\n            transform: translateY(-50%);\n        }\n\n        @media screen and (max-width: $screen-sm-max) {\n            width: 120px;\n            height: 120px;\n        }\n    }\n}\n'],sourceRoot:""}]),l.locals={imageEditorView:"View-module_imageEditorView__LdxlF",avatarPanel:"View-module_avatarPanel__zD3b0",avatarButtonContainer:"View-module_avatarButtonContainer__wPiTj",avatarButtonContainerMobile:"View-module_avatarButtonContainerMobile__oNXU_"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/modules/Common/LoadingBar.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,".LoadingBar-module_loadingBar__olH5q{height:10px;overflow:hidden;background:#ccc;border-radius:6px}.LoadingBar-module_bar__CGZJu{position:relative;height:100%;background:#8c7cdb;transition:width .5s ease-in}","",{version:3,sources:["webpack://./src/modules/Common/LoadingBar.module.scss","webpack://./node_modules/sharedstyle/_variables.scss"],names:[],mappings:"AAEA,qCACI,WAAA,CACA,eAAA,CACA,eCkBW,CDjBX,iBAAA,CAGJ,8BACI,iBAAA,CACA,WAAA,CACA,kBCgEW,CD/DX,4BAAA",sourcesContent:['@import "~sharedstyle/variables";\n\n.loadingBar {\n    height: 10px;\n    overflow: hidden;\n    background: $gray-lighter;\n    border-radius: 6px;\n}\n\n.bar {\n    position: relative;\n    height: 100%;\n    background: $purple-color;\n    transition: width 0.5s ease-in;\n}\n','@use "sass:color";\n@use "sass:math";\n//\n// Variables\n// --------------------------------------------------\n\n//== Colors\n//\n//## Gray and brand colors for use across Bootstrap.\n\n$shadow-4: 0 0 12px -3px rgba(0, 0, 0, 0.3);\n$shadow-5: 0 0 4px 0px rgba(0, 0, 0, 0.3);\n\n$shadow-1: 0 0 4px 0 rgba(160, 162, 167, 0.15);\n$shadow-2: 0 0 2px 0 rgba(77, 77, 77, 0.16);\n$shadow-3: 0 0 2px 0 rgba(83, 83, 83, 0.5);\n\n$gray-base: #000 !default;\n$gray-dark: #384347 !default;\n$resume-body-color: #3e3e3e !default; // specific body color for the resumes - without blue color included\n$gray-dark-2: #222 !default;\n$gray: color.adjust($gray-base, $lightness: 33.5%) !default; // #555\n$gray-light: color.adjust($gray-base, $lightness: 46.7%) !default; // #777\n$gray-lighter: color.adjust($gray-base, $lightness: 80%) !default; // #ccc\n$green-light: #eaf8f3;\n\n$gray-1: #b2b4b6;\n$gray-1-20: rgba($gray-1, 0.2);\n$gray-1-50: rgba($gray-1, 0.5);\n$gray-2: #65696d;\n$gray-2-20: rgba($gray-2, 0.2);\n$gray-2-50: rgba($gray-2, 0.5);\n$gray-3: #384347;\n$gray-3-20: rgba($gray-3, 0.2);\n$gray-3-50: rgba($gray-3, 0.5);\n\n$green-3: #2dc08d;\n$green-2: #62d0aa;\n$green-1: #d5f2e8;\n$green-hover: #249a71;\n\n$purple-3: #8c7cdb;\n$purple-2: #c5bded;\n$purple-1: #e8e5f8;\n\n$red-3: #ff576f;\n$red-2: #ffabb7;\n$red-1: #ffeef0;\n\n$blue-3: #7aaacb;\n$blue-2: #b5d6ec;\n$blue-1: #e2eff8;\n$blue-background: #f3f5fa;\n\n$yellow-3: #feb251;\n$yellow-2: #fed8a7;\n$yellow-1: #fff0dc;\n\n$background: #fafbfd;\n$brand-primary: #00c091;\n$brand-promo: #e7762e;\n$brand-success: #2dc08c !default;\n$brand-info: #5bc0de !default;\n$brand-warning: #f2994a !default;\n$brand-danger: #ff576f !default;\n$brand-border-color: #e6e6e6 !default;\n$brand-grey-background: #f2f2f2;\n$color-facebook: #3b5998;\n$color-twitter: #5eaade;\n$color-gplus: #dd4b39;\n$color-instagram: #333333;\n$color-linkedin: #2578b5;\n$color-messenger-first: rgb(1, 183, 255);\n$color-messenger-second: rgb(0, 126, 254);\n$color-messenger-border: #ffffff;\n$color-onboarding: #009ee8;\n$purple-color: #8c7cdb;\n$brand-gray-color: #65696d;\n$brand-info-font-color: #b2b4b6;\n$toolbox-border: rgba(223, 223, 223, 0.52);\n$selected-item-border-color: #60d5ba;\n\n$white: white;\n\n$op-background-color: #333333;\n$op-nav-control-color: #464646;\n$op-control-color: $gray-dark;\n$op-light-color: #e6e6e6;\n$op-control-primary-color: $brand-success;\n$op-notification-bg-primary: #ccf5e9;\n$op-notification-bg-danger: #ffc7d4;\n$op-notification-bg-warning: #ffe2ca;\n\n$op-base-offset: 8px !default;\n$op-btn-padding-horizontal: 14px;\n\n//Resume Styles\n$resume-rounding: 5px;\n\n//== Scaffolding\n//\n//## Settings for some of the most global styles.\n\n//** Background color for `<body>`.\n$body-bg: #fff !default;\n//** Global text color on `<body>`.\n$text-color: $gray-dark !default;\n\n$text-color-hover: color.adjust($text-color, $lightness: 30%) !default;\n\n//** Global textual link color.\n$link-color: white !default;\n//** Link hover color set via `darken()` function.\n$link-hover-color: color.adjust(white, $lightness: -10%);\n//** Link hover decoration.\n$link-hover-decoration: none !default;\n\n//== Typography\n//\n//## Font, line-height, and color for body text, headings, and more.\n\n$font-family-sans-serif: "Roboto", Arial, Helvetica, "Noto Sans Devanagari", "Noto Sans CJK SC Thin",\n    "Noto Sans SC", "Noto Sans Hebrew", "Noto Sans Bengali", sans-serif !default;\n$font-family-serif: Georgia, "Times New Roman", Times, "Noto Sans Devanagari",\n    "Noto Sans CJK SC Thin", "Noto Sans SC", "Noto Sans Hebrew", "Noto Sans Bengali", serif !default;\n//** Default monospace fonts for `<code>`, `<kbd>`, and `<pre>`.\n$font-family-monospace: Menlo, Monaco, Consolas, "Courier New", monospace !default;\n$font-family-base: "Inter" !default;\n\n$roboto: "Roboto", Arial, Helvetica, sans-serif;\n$opensans: "Open Sans", Arial, Helvetica, sans-serif;\n$account-heading-font: "Rubik", sans-serif !important;\n\n$font-size-base: 14px !default;\n$font-size-large: 18px !default;\n$font-size-small: 11px !default;\n\n$font-size-h1: 68px !default; // ~36px\n$font-size-h2: 38px !default; // ~30px\n$font-size-h3: 32px !default; // ~24px\n$font-size-h4: 26px !default; // ~18px\n$font-size-h5: 22px !default;\n$font-size-h6: 20px !default; // ~12px\n\n//** Unit-less `line-height` for use in components like buttons.\n$line-height-base: 1.428571429 !default; // 20/14\n//** Computed "line-height" (`font-size` * `line-height`) for use with `margin`, `padding`, etc.\n$line-height-computed: math.floor(($font-size-base * $line-height-base)) !default; // ~20px\n\n//** By default, this inherits from the `<body>`.\n$headings-font-family: "Rubik", sans-serif !default;\n$headings-font-weight: 300 !default;\n$headings-line-height: 1.1 !default;\n$headings-color: $gray-dark !default;\n\n//== Components\n//\n//## Define common padding and border radius sizes and more. Values based on 14px text and 1.428 line-height (~20px to start).\n\n$padding-base-vertical: 9px !default;\n$padding-base-horizontal: 14px !default;\n\n$padding-large-vertical: 12px !default;\n$padding-large-horizontal: 24px !default;\n\n$padding-small-vertical: 5px !default;\n$padding-small-horizontal: 18px !default;\n\n$padding-xs-vertical: 1px !default;\n$padding-xs-horizontal: 12px !default;\n\n$line-height-large: 1.3333333 !default; // extra decimals for Win 8.1 Chrome\n$line-height-small: 1.5 !default;\n\n$border-radius-base: 5px !default;\n$border-radius-large: 9px !default;\n$border-radius-small: 4px !default;\n\n//** Global color for active items (e.g., navs or dropdowns).\n$component-active-color: #fff !default;\n//** Global background color for active items (e.g., navs or dropdowns).\n$component-active-bg: $brand-primary !default;\n\n//** Width of the `border` for generating carets that indicator dropdowns.\n$caret-width-base: 4px !default;\n//** Carets increase slightly in size for larger components.\n$caret-width-large: 5px !default;\n\n//== Tables\n//\n//## Customizes the `.table` component with basic values, each used across all table variations.\n\n//** Padding for `<th>`s and `<td>`s.\n$table-cell-padding: 8px !default;\n//** Padding for cells in `.table-condensed`.\n$table-condensed-cell-padding: 5px !default;\n\n//** Default background color used for all tables.\n$table-bg: transparent !default;\n//** Background color used for `.table-striped`.\n$table-bg-accent: #f9f9f9 !default;\n//** Background color used for `.table-hover`.\n$table-bg-hover: #f5f5f5 !default;\n$table-bg-active: $table-bg-hover !default;\n\n//** Border color for table and cell borders.\n$table-border-color: #ddd !default;\n\n//== Buttons\n//\n//## For each of Bootstrap\'s buttons, define text, background and border color.\n\n$btn-font-weight: bold !default;\n\n$btn-default-color: #8c7cdb !default;\n$btn-default-bg: #fff !default;\n$btn-default-border: #8c7cdb !default;\n\n$btn-primary-color: #fff !default;\n$btn-primary-bg: $brand-primary !default;\n$btn-primary-border: $brand-primary !default;\n\n$btn-success-color: #fff !default;\n$btn-success-bg: $brand-success !default;\n$btn-success-border: color.adjust($btn-success-bg, $lightness: -5%) !default;\n\n$btn-info-color: #fff !default;\n$btn-info-bg: $brand-info !default;\n$btn-info-border: color.adjust($btn-info-bg, $lightness: -5%) !default;\n\n$btn-warning-color: #fff !default;\n$btn-warning-bg: $brand-warning !default;\n$btn-warning-border: color.adjust($btn-warning-bg, $lightness: -5%) !default;\n\n$btn-danger-color: #fff !default;\n$btn-danger-bg: $brand-danger !default;\n$btn-danger-border: color.adjust($btn-danger-bg, $lightness: -5%) !default;\n\n$btn-link-disabled-color: $gray-light !default;\n\n// Allows for customizing button radius independently from global border radius\n$btn-border-radius-base: $border-radius-base;\n$btn-border-radius-large: $border-radius-base;\n$btn-border-radius-small: $border-radius-base;\n\n//== Forms\n//\n//##\n\n//** `<input>` background color\n$input-bg: #fff !default;\n//** `<input disabled>` background color\n$input-bg-disabled: $gray-lighter !default;\n\n//** Text color for `<input>`s\n$input-color: $gray !default;\n//** `<input>` border color\n$input-border: #b3b3b3 !default;\n\n// TODO: Rename `$input-border-radius` to `$input-border-radius-base` in v4\n//** Default `.form-control` border radius\n// This has no effect on `<select>`s in some browsers, due to the limited stylability of `<select>`s in CSS.\n$input-border-radius: $border-radius-base;\n//** Large `.form-control` border radius\n$input-border-radius-large: $border-radius-base;\n//** Small `.form-control` border radius\n$input-border-radius-small: $border-radius-base;\n\n//** Border color for inputs on focus\n$input-border-focus: $brand-primary !default;\n\n//** Placeholder text color\n$input-color-placeholder: color.adjust($gray-base, $lightness: 70%) !default;\n\n//** Default `.form-control` height\n$input-height-base: ($line-height-computed + ($padding-base-vertical * 2) + 2) !default;\n//** Large `.form-control` height\n$input-height-large: (\n    math.ceil($font-size-large * $line-height-large) + ($padding-large-vertical * 2) + 2\n) !default;\n//** Small `.form-control` height\n$input-height-small: (\n    math.floor($font-size-small * $line-height-small) + ($padding-small-vertical * 2) + 2\n) !default;\n\n//** `.form-group` margin\n$form-group-margin-bottom: 15px !default;\n\n$legend-color: $gray-dark !default;\n$legend-border-color: #e5e5e5 !default;\n\n//** Background color for textual input addons\n$input-group-addon-bg: $gray-lighter !default;\n//** Border color for textual input addons\n$input-group-addon-border-color: $input-border !default;\n\n//** Disabled cursor for form controls and buttons.\n$cursor-disabled: not-allowed !default;\n\n//== Dropdowns\n//\n//## Dropdown menu container and contents.\n\n//** Background for the dropdown menu.\n$dropdown-bg: #fff !default;\n//** Dropdown menu `border-color`.\n$dropdown-border: rgba(0, 0, 0, 0.15) !default;\n//** Dropdown menu `border-color` **for IE8**.\n$dropdown-fallback-border: #ccc !default;\n//** Divider color for between dropdown items.\n$dropdown-divider-bg: #e5e5e5 !default;\n\n//** Dropdown link text color.\n$dropdown-link-color: $gray-dark !default;\n//** Hover color for dropdown links.\n$dropdown-link-hover-color: color.adjust($gray-dark, $lightness: 50%) !default;\n//** Hover background for dropdown links.\n$dropdown-link-hover-bg: transparent !default;\n\n//** Active dropdown menu item text color.\n$dropdown-link-active-color: $component-active-color !default;\n//** Active dropdown menu item background color.\n$dropdown-link-active-bg: $component-active-bg !default;\n\n//** Disabled dropdown menu item background color.\n$dropdown-link-disabled-color: $gray-light !default;\n\n//** Text color for headers within dropdown menus.\n$dropdown-header-color: $gray-light !default;\n\n//** Deprecated `$dropdown-caret-color` as of v3.1.0\n$dropdown-caret-color: #000 !default;\n\n//-- Z-index master list\n//\n// Warning: Avoid customizing these values. They\'re used for a bird\'s eye view\n// of components dependent on the z-axis and are designed to all work together.\n//\n// Note: These variables are not generated into the Customizer.\n\n$zindex-navbar: 1000 !default;\n$zindex-dropdown: 1000 !default;\n$zindex-mobile-design-menu: 1001 !default;\n$zindex-modal-background: 1002 !default; // from style guide --\x3e\n$zindex-modal-content: 1003 !default; // <--\n$zindex-full-screen-dropdown: 1004 !default;\n$zindex-popover: 1020 !default;\n$zindex-tooltip: 1050 !default;\n$zindex-navbar-fixed: 1030 !default;\n$zindex-toaster: 1030 !default;\n$zindex-alert: 1060 !default;\n$zindex-op-currdoing-cirle: 100 !default;\n$zindex-op-section-controls: 1 !default;\n$zindex-toasters: 8000 !default;\n\n//== Media queries breakpoints\n//\n//## Define the breakpoints at which your layout will change, adapting to different screen sizes.\n\n//== Grid system\n//\n//## Define your custom responsive grid.\n\n//** Number of columns in the grid.\n$grid-columns: 12 !default;\n//** Padding between columns. Gets divided in half for the left and right.\n$grid-gutter-width: 20px !default;\n\n//== Navbar OP\n//\n//##\n$op-navbar-height: 64px !default;\n$op-navbar-padding: 2 * $op-base-offset !default;\n\n//== Navbar\n//\n//##\n\n// Basics of a navbar\n$navbar-height: 60px !default;\n$navbar-padding: 16px !default;\n$navbar-margin-bottom: 0 !default;\n$navbar-border-radius: 0 !default;\n$navbar-padding-horizontal: math.floor(($grid-gutter-width * 0.5)) !default;\n$navbar-padding-vertical: (($navbar-height - $line-height-computed) * 0.5) !default;\n$navbar-collapse-max-height: 340px !default;\n\n$navbar-default-color: $text-color !default;\n$navbar-default-bg: white !default;\n$navbar-default-border: transparent !default;\n\n// Navbar links\n$navbar-default-link-color: $text-color !default;\n$navbar-default-link-hover-color: $purple-color !default;\n$navbar-default-link-hover-bg: transparent !default;\n$navbar-default-link-active-color: #b2b4b6 !default;\n$navbar-default-link-active-bg: color.adjust($navbar-default-bg, $lightness: -6.5%) !default;\n$navbar-default-link-disabled-color: #ccc !default;\n$navbar-default-link-disabled-bg: transparent !default;\n\n// Navbar brand label\n$navbar-default-brand-color: #e6e6e6 !default;\n$navbar-default-brand-hover-color: color.adjust(\n    $navbar-default-brand-color,\n    $lightness: -10%\n) !default;\n$navbar-default-brand-hover-bg: transparent !default;\n\n// Navbar toggle\n$navbar-default-toggle-hover-bg: color.adjust(white, $lightness: -5%) !default;\n$navbar-default-toggle-icon-bar-bg: $text-color !default;\n$navbar-default-toggle-border-color: transparent !default;\n\n//=== Inverted navbar\n// Reset inverted navbar basics\n$navbar-inverse-color: $brand-gray-color !default;\n$navbar-inverse-bg: white !default;\n$navbar-inverse-border: $brand-border-color !default;\n\n// Inverted navbar links\n$navbar-inverse-link-color: $brand-gray-color !default;\n$navbar-inverse-link-hover-color: $text-color;\n$navbar-inverse-link-hover-bg: transparent !default;\n$navbar-inverse-link-active-color: $navbar-inverse-link-hover-color !default;\n$navbar-inverse-link-active-bg: color.adjust($navbar-inverse-bg, $lightness: -10%) !default;\n$navbar-inverse-link-disabled-color: #444 !default;\n$navbar-inverse-link-disabled-bg: transparent !default;\n\n// Inverted navbar brand label\n$navbar-inverse-brand-color: $navbar-inverse-link-color !default;\n$navbar-inverse-brand-hover-color: #fff !default;\n$navbar-inverse-brand-hover-bg: transparent !default;\n\n// Inverted navbar toggle\n$navbar-inverse-toggle-hover-bg: color.adjust(white, $lightness: -10%) !default;\n$navbar-inverse-toggle-icon-bar-bg: $gray !default;\n$navbar-inverse-toggle-border-color: $gray !default;\n\n//== Navs\n//\n//##\n\n//=== Shared nav styles\n$nav-link-padding: 12px 15px !default;\n$nav-link-hover-bg: transparent !default;\n\n$nav-disabled-link-color: $gray-light !default;\n$nav-disabled-link-hover-color: transparent !default;\n\n//== Tabs\n$nav-tabs-border-color: #ddd !default;\n\n$nav-tabs-link-hover-border-color: $gray-lighter !default;\n\n$nav-tabs-active-link-hover-bg: $body-bg !default;\n$nav-tabs-active-link-hover-color: $gray !default;\n$nav-tabs-active-link-hover-border-color: #ddd !default;\n\n$nav-tabs-justified-link-border-color: #ddd !default;\n$nav-tabs-justified-active-link-border-color: $body-bg !default;\n\n//== Pills\n$nav-pills-border-radius: $border-radius-base !default;\n$nav-pills-active-link-hover-bg: transparent !default;\n$nav-pills-active-link-hover-color: $brand-primary !default;\n\n//== Pagination\n//\n//##\n\n$pagination-color: $link-color !default;\n$pagination-bg: #fff !default;\n$pagination-border: #ddd !default;\n\n$pagination-hover-color: $link-hover-color !default;\n$pagination-hover-bg: $gray-lighter !default;\n$pagination-hover-border: #ddd !default;\n\n$pagination-active-color: #fff !default;\n$pagination-active-bg: $brand-primary !default;\n$pagination-active-border: $brand-primary !default;\n\n$pagination-disabled-color: $gray-light !default;\n$pagination-disabled-bg: #fff !default;\n$pagination-disabled-border: #ddd !default;\n\n//== Pager\n//\n//##\n\n$pager-bg: $pagination-bg !default;\n$pager-border: $pagination-border !default;\n$pager-border-radius: 15px !default;\n\n$pager-hover-bg: $pagination-hover-bg !default;\n\n$pager-active-bg: $pagination-active-bg !default;\n$pager-active-color: $pagination-active-color !default;\n\n$pager-disabled-color: $pagination-disabled-color !default;\n\n//== Jumbotron\n//\n//##\n\n$jumbotron-padding: 30px !default;\n$jumbotron-color: inherit !default;\n$jumbotron-bg: $gray-lighter !default;\n$jumbotron-heading-color: inherit !default;\n$jumbotron-font-size: math.ceil(($font-size-base * 1.5)) !default;\n$jumbotron-heading-font-size: math.ceil(($font-size-base * 4.5)) !default;\n\n//== Form states and alerts\n//\n//## Define colors for form feedback states and, by default, alerts.\n\n$state-success-text: #00c091 !default;\n$state-success-bg: #caf3e9 !default;\n$state-success-border: color.adjust(\n    color.adjust($state-success-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n$state-info-text: #31708f !default;\n$state-info-bg: #d9edf7 !default;\n$state-info-border: color.adjust(color.adjust($state-info-bg, $hue: -10), $lightness: -7%) !default;\n\n$state-warning-text: $brand-warning !default;\n$state-warning-bg: #fcf8e3 !default;\n$state-warning-border: color.adjust(\n    color.adjust($state-warning-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n$state-danger-text: $brand-danger !default;\n$state-danger-bg: #ffcbd6 !default;\n$state-danger-border: color.adjust(\n    color.adjust($state-danger-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n//== Tooltips\n//\n//##\n\n//** Tooltip max width\n$tooltip-max-width: 300px !default;\n//** Tooltip text color\n$tooltip-color: #fff !default;\n//** Tooltip background color\n$tooltip-bg: $gray-dark !default;\n$tooltip-opacity: 0.9 !default;\n\n//** Tooltip arrow width\n$tooltip-arrow-width: 5px !default;\n//** Tooltip arrow color\n$tooltip-arrow-color: $tooltip-bg !default;\n\n//== Popovers\n//\n//##\n\n//** Popover body background color\n$popover-bg: #fff !default;\n//** Popover maximum width\n$popover-max-width: 276px !default;\n//** Popover border color\n$popover-border-color: rgba(0, 0, 0, 0.2) !default;\n//** Popover fallback border color\n$popover-fallback-border-color: #ccc !default;\n\n//** Popover title background color\n$popover-title-bg: color.adjust($popover-bg, $lightness: -3%) !default;\n\n//** Popover arrow width\n$popover-arrow-width: 10px !default;\n//** Popover arrow color\n$popover-arrow-color: $popover-bg !default;\n\n//** Popover outer arrow width\n$popover-arrow-outer-width: ($popover-arrow-width + 1) !default;\n//** Popover outer arrow color\n$popover-arrow-outer-color: color.adjust($popover-border-color, $alpha: 0.05) !default;\n//** Popover outer arrow fallback color\n$popover-arrow-outer-fallback-color: color.adjust(\n    $popover-fallback-border-color,\n    $lightness: -20%\n) !default;\n\n//== Labels\n//\n//##\n\n//** Default label background color\n$label-default-bg: $gray-light !default;\n//** Primary label background color\n$label-primary-bg: $brand-primary !default;\n//** Success label background color\n$label-success-bg: $brand-success !default;\n//** Info label background color\n$label-info-bg: $brand-info !default;\n//** Warning label background color\n$label-warning-bg: $brand-warning !default;\n//** Danger label background color\n$label-danger-bg: $brand-danger !default;\n\n//** Default label text color\n$label-color: #fff !default;\n//** Default text color of a linked label\n$label-link-hover-color: #fff !default;\n$label-gray: #60696c;\n\n//== Modals\n//\n//##\n\n//** Padding applied to the modal body\n$modal-inner-padding: 35px 40px !default;\n\n//** Padding applied to the modal title\n$modal-title-padding: 35px 40px 35px 40px !default;\n//** Modal title line-height\n$modal-title-line-height: $line-height-base !default;\n\n//** Background color of modal content area\n$modal-content-bg: #fff !default;\n//** Modal content border color\n$modal-content-border-color: rgba(255, 255, 255, 0) !default;\n//** Modal content border color **for IE8**\n$modal-content-fallback-border-color: #999 !default;\n\n//** Modal backdrop background color\n$modal-backdrop-bg: #00bf93 !default;\n//** Modal backdrop opacity\n$modal-backdrop-opacity: 0.5 !default;\n//** Modal header border color\n$modal-header-border-color: #e6e6e6 !default;\n//** Modal footer border color\n$modal-footer-border-color: $modal-header-border-color !default;\n\n$modal-lg: 820px !default;\n$modal-md: 630px !default;\n$modal-sm: 420px !default;\n\n//== Alerts\n//\n//## Define alert colors, border radius, and padding.\n\n$alert-padding: 8px 15px !default;\n$alert-border-radius: 45px !default;\n$alert-link-font-weight: bold !default;\n\n$alert-success-bg: $state-success-bg !default;\n$alert-success-text: $state-success-text !default;\n$alert-success-border: #fff !default;\n\n$alert-info-bg: $state-info-bg !default;\n$alert-info-text: $state-info-text !default;\n$alert-info-border: #fff !default;\n\n$alert-warning-bg: $state-warning-bg !default;\n$alert-warning-text: $state-warning-text !default;\n$alert-warning-border: #fff !default;\n\n$alert-danger-bg: $state-danger-bg !default;\n$alert-danger-text: $state-danger-text !default;\n$alert-danger-border: #fff !default;\n\n//== Progress bars\n//\n//##\n\n//** Background color of the whole progress component\n$progress-bg: #e6e6e6 !default;\n//** Progress bar text color\n$progress-bar-color: #fff !default;\n//** Variable for setting rounded corners on progress bar.\n$progress-border-radius: 12px !default;\n\n//** Default progress bar color\n$progress-bar-bg: $brand-primary !default;\n//** Success progress bar color\n$progress-bar-success-bg: $brand-success !default;\n//** Warning progress bar color\n$progress-bar-warning-bg: $brand-warning !default;\n//** Danger progress bar color\n$progress-bar-danger-bg: $brand-danger !default;\n//** Info progress bar color\n$progress-bar-info-bg: $brand-info !default;\n\n//== List group\n//\n//##\n\n//** Background color on `.list-group-item`\n$list-group-bg: #fff !default;\n//** `.list-group-item` border color\n$list-group-border: #ddd !default;\n//** List group border radius\n$list-group-border-radius: $border-radius-base !default;\n\n//** Background color of single list items on hover\n$list-group-hover-bg: #f5f5f5 !default;\n//** Text color of active list items\n$list-group-active-color: $component-active-color !default;\n//** Background color of active list items\n$list-group-active-bg: $component-active-bg !default;\n//** Border color of active list elements\n$list-group-active-border: $list-group-active-bg !default;\n//** Text color for content within active list items\n$list-group-active-text-color: color.adjust($list-group-active-bg, $lightness: 40%) !default;\n\n//** Text color of disabled list items\n$list-group-disabled-color: $gray-light !default;\n//** Background color of disabled list items\n$list-group-disabled-bg: $gray-lighter !default;\n//** Text color for content within disabled list items\n$list-group-disabled-text-color: $list-group-disabled-color !default;\n\n$list-group-link-color: #555 !default;\n$list-group-link-hover-color: $list-group-link-color !default;\n$list-group-link-heading-color: #333 !default;\n\n//== Panels\n//\n//##\n\n$panel-bg: #fff !default;\n$panel-body-padding: 15px !default;\n$panel-heading-padding: 10px 15px !default;\n$panel-footer-padding: $panel-heading-padding !default;\n$panel-border-radius: $border-radius-base !default;\n\n//** Border color for elements within panels\n$panel-inner-border: #ddd !default;\n$panel-footer-bg: #f5f5f5 !default;\n\n$panel-default-text: $gray-dark !default;\n$panel-default-border: #ddd !default;\n$panel-default-heading-bg: #f5f5f5 !default;\n\n$panel-primary-text: #fff !default;\n$panel-primary-border: $brand-primary !default;\n$panel-primary-heading-bg: $brand-primary !default;\n\n$panel-success-text: $state-success-text !default;\n$panel-success-border: $state-success-border !default;\n$panel-success-heading-bg: $state-success-bg !default;\n\n$panel-info-text: $state-info-text !default;\n$panel-info-border: $state-info-border !default;\n$panel-info-heading-bg: $state-info-bg !default;\n\n$panel-warning-text: $state-warning-text !default;\n$panel-warning-border: $state-warning-border !default;\n$panel-warning-heading-bg: $state-warning-bg !default;\n\n$panel-danger-text: $state-danger-text !default;\n$panel-danger-border: $state-danger-border !default;\n$panel-danger-heading-bg: $state-danger-bg !default;\n\n//== Thumbnails\n//\n//##\n\n//** Padding around the thumbnail image\n$thumbnail-padding: 4px !default;\n//** Thumbnail background color\n$thumbnail-bg: $body-bg !default;\n//** Thumbnail border color\n$thumbnail-border: #ddd !default;\n//** Thumbnail border radius\n$thumbnail-border-radius: $border-radius-base !default;\n\n//** Custom text color for thumbnail captions\n$thumbnail-caption-color: $text-color !default;\n//** Padding around the thumbnail caption\n$thumbnail-caption-padding: 9px !default;\n\n//== Wells\n//\n//##\n\n$well-bg: #f5f5f5 !default;\n$well-border: color.adjust($well-bg, $lightness: -7%) !default;\n\n//== Badges\n//\n//##\n\n$badge-color: #fff !default;\n//** Linked badge text color on hover\n$badge-link-hover-color: #fff !default;\n$badge-bg: $gray-light !default;\n\n//** Badge text color in active nav link\n$badge-active-color: $link-color !default;\n//** Badge background color in active nav link\n$badge-active-bg: #fff !default;\n\n$badge-font-weight: bold !default;\n$badge-line-height: 1 !default;\n$badge-border-radius: 35px !default;\n\n//== Breadcrumbs\n//\n//##\n\n$breadcrumb-padding-vertical: 8px !default;\n$breadcrumb-padding-horizontal: 15px !default;\n//** Breadcrumb background color\n$breadcrumb-bg: #f5f5f5 !default;\n//** Breadcrumb text color\n$breadcrumb-color: #ccc !default;\n//** Text color of current page in the breadcrumb\n$breadcrumb-active-color: $gray-light !default;\n//** Textual separator for between breadcrumb elements\n$breadcrumb-separator: "/" !default;\n\n//== Carousel\n//\n//##\n\n$carousel-text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6) !default;\n\n$carousel-control-color: #fff !default;\n$carousel-control-width: 15% !default;\n$carousel-control-opacity: 0.5 !default;\n$carousel-control-font-size: 20px !default;\n\n$carousel-indicator-active-bg: #fff !default;\n$carousel-indicator-border-color: #fff !default;\n\n$carousel-caption-color: #fff !default;\n\n//== Close\n//\n//##\n\n$close-font-weight: bold !default;\n$close-color: #000 !default;\n$close-text-shadow: 0 1px 0 #fff !default;\n\n//== Code\n//\n//##\n\n$code-color: #c7254e !default;\n$code-bg: #f9f2f4 !default;\n\n$kbd-color: #fff !default;\n$kbd-bg: #333 !default;\n\n$pre-bg: #f5f5f5 !default;\n$pre-color: $gray-dark !default;\n$pre-border-color: #ccc !default;\n$pre-scrollable-max-height: 340px !default;\n\n//== Type\n//\n//##\n\n//** Horizontal offset for forms and lists.\n$component-offset-horizontal: 180px !default;\n//** Text muted color\n$text-muted: $gray-lighter !default;\n//** Abbreviations and acronyms border color\n$abbr-border-color: $gray-light !default;\n//** Headings small color\n$headings-small-color: $gray-light !default;\n//** Blockquote small color\n$blockquote-small-color: $gray-light !default;\n//** Blockquote font size\n$blockquote-font-size: ($font-size-base * 1.25) !default;\n//** Blockquote border color\n$blockquote-border-color: $gray-lighter !default;\n//** Page header border color\n$page-header-border-color: $gray-lighter !default;\n//** Horizontal line color.\n$hr-border: $gray-1-50 !default;\n'],sourceRoot:""}]),l.locals={loadingBar:"LoadingBar-module_loadingBar__olH5q",bar:"LoadingBar-module_bar__CGZJu"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/modules/Common/LoadingRing.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,'.LoadingRing-module_loader__r9jJP{display:inline-block;width:80px;height:80px}.LoadingRing-module_loader__r9jJP::after{content:" ";display:block;width:64px;height:64px;margin:8px;border-radius:50%;border:6px solid #606668;border-color:#606668 transparent #606668 transparent;animation:LoadingRing-module_lds-dual-ring__LDS_O 1.2s linear infinite}@keyframes LoadingRing-module_lds-dual-ring__LDS_O{0%{transform:rotate(0deg)}100%{transform:rotate(360deg)}}',"",{version:3,sources:["webpack://./src/modules/Common/LoadingRing.module.scss"],names:[],mappings:"AAEA,kCACI,oBAAA,CACA,UAAA,CACA,WAAA,CAGJ,yCACI,WAAA,CACA,aAAA,CACA,UAAA,CACA,WAAA,CACA,UAAA,CACA,iBAAA,CACA,wBAAA,CACA,oDAAA,CACA,sEAAA,CAGJ,mDACI,GACI,sBAAA,CAGJ,KACI,wBAAA,CAAA",sourcesContent:['$color: #606668;\n\n.loader {\n    display: inline-block;\n    width: 80px;\n    height: 80px;\n}\n\n.loader::after {\n    content: " ";\n    display: block;\n    width: 64px;\n    height: 64px;\n    margin: 8px;\n    border-radius: 50%;\n    border: 6px solid $color;\n    border-color: $color transparent $color transparent;\n    animation: lds-dual-ring 1.2s linear infinite;\n}\n\n@keyframes lds-dual-ring {\n    0% {\n        transform: 