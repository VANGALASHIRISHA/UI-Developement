 40px;\n    height: 40px;\n    min-width: 40px;\n    border-radius: 50%;\n    background-color: $accent;\n    color: $surface-accent;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 16px;\n    font-weight: 600;\n}\n\n.stepCircleCompleted {\n    background-color: $primary;\n    color: $white;\n}\n\n.stepLabel {\n    font-size: 16px;\n    font-weight: 700;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n    color: $label;\n}\n\n.stepLabelCompleted {\n    color: $primary;\n}\n\n.stepContent {\n    flex: 1;\n    min-width: 0;\n}\n\n.resumePlaceholder {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 12px;\n    padding: 24px 16px;\n    border: 2px dashed $graphic-1;\n    border-radius: 12px;\n    cursor: pointer;\n    transition: border-color 0.2s ease;\n    text-align: center;\n\n    &:hover {\n        border-color: $secondary;\n    }\n}\n\n.resumePlaceholderIcon {\n    width: 56px;\n    height: 56px;\n    border-radius: 50%;\n    background-color: $visual-violet-2;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 32px;\n}\n\n.resumeSelected {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    padding: 12px 16px;\n    border: 1px solid $primary;\n    border-radius: 5px;\n    background-color: $white;\n}\n\n.resumeIconBg {\n    width: 32px;\n    height: 32px;\n    min-width: 32px;\n    border-radius: 50%;\n    background-color: $graphic-1;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: $label;\n}\n\n.jobInputActive {\n    :global(.form-control) {\n        border-color: $primary !important;\n        box-shadow: none;\n    }\n}\n\n.title {\n    line-height: 1;\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6df;\n$warning-hover: #feba62;\n\n// // Active elements\n$primary-active: #249a71;\n$secondary-active: #5f4dc7;\n$info-active: #3685bb;\n$warning-active: #d89745;\n$danger-active: #d94a5e;\n\n// // Transparent elements\n// // // opacity: 10%;\n$primary-10: rgba($primary, 0.1);\n$secondary-10: rgba($secondary, 0.1);\n$accent-10: rgba($accent, 0.1);\n$info-10: rgba($info, 0.1);\n$warning-10: rgba($warning, 0.1);\n$danger-10: rgba($danger, 0.1);\n// // // opacity 20%\n$primary-20: rgba($primary, 0.2);\n$secondary-20: rgba($secondary, 0.2);\n$accent-20: rgba($accent, 0.2);\n$info-20: rgba($info, 0.2);\n$warning-20: rgba($warning, 0.2);\n$danger-20: rgba($danger, 0.2);\n// // // opacity 30%\n$primary-30: rgba($primary, 0.3);\n$secondary-30: rgba($secondary, 0.3);\n$accent-30: rgba($accent, 0.3);\n$info-30: rgba($info, 0.3);\n$warning-30: rgba($warning, 0.3);\n$danger-30: rgba($danger, 0.3);\n\n// // Backgrounds\n$surface: $white;\n$surface-accent: #9cb2dc;\n$page: #f5f7fc;\n$page-alt: #fafbfd;\n\n// // Typography Colors\n$heading: #2d3639;\n$paragraph: #384347;\n$label: #60696c;\n$caption: #afb4b5;\n$subtext: #d8d9db;\n\n// // Supportive colors\n$modal: #47445a;\n$graphic-1: #f0f0f0;\n$graphic-2: #e4e4e4;\n$graphic-3: #f2f2f2;\n$border-color: #e0e0e0;\n\n// // CC colors\n$primary-cc: #eaf9f4;\n$secondary-cc: #f3f2fb;\n$danger-cc: #ffeef1;\n$info-cc