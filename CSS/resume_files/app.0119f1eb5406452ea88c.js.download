4CAGJ,cACI,CAAA,gBACA,CAAA,kDAIA,eACI,CAAA,iBACA,CAAA,6DAGI,WACI,CAAA,iBACA,CAAA,qBACA,CAAA,QACA",sourcesContent:['@import "~sharedstyle/variables";\n\n.title {\n    font-weight: 500;\n}\n\n.fontSize11 {\n    font-size: 11px;\n    line-height: 13px;\n}\n\n.formatBullets {\n    ul {\n        list-style: none;\n        padding-left: 16px;\n\n        li {\n            &::before {\n                content: "•";\n                position: absolute;\n                vertical-align: middle;\n                left: 4px;\n            }\n        }\n    }\n}\n'],sourceRoot:""}]),l.locals={title:"CustomItemClassic-module_title__nSRwA",fontSize11:"CustomItemClassic-module_fontSize11__Uw_QZ",formatBullets:"CustomItemClassic-module_formatBullets__lGzyf"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/packages/Resume/ItemTypes/Custom/CustomItemCompact.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,'.CustomItemCompact-module_icon__VLN6r{text-align:center;line-height:15px;position:relative;margin-right:8px;margin-bottom:-7px;flex:0 0 auto;cursor:pointer}.CustomItemCompact-module_title__F3JgT{font-weight:400}.CustomItemCompact-module_description__uGpsP{color:#3e3e3e}.CustomItemCompact-module_formatBullets__Sx9Su ul{list-style:none;padding-left:16px}.CustomItemCompact-module_formatBullets__Sx9Su ul li::before{content:"•";position:absolute;vertical-align:middle;left:4px}.CustomItemCompact-module_fontSize11__C5cAp{font-size:11px;line-height:13px}.CustomItemCompact-module_iconStyle__IbTJi{font-size:12px;margin-right:5px;color:#555;flex:0 0 auto;height:14px}.CustomItemCompact-module_rowDate__PddOF{margin-left:10px;flex-shrink:0}',"",{version:3,sources:["webpack://./src/packages/Resume/ItemTypes/Custom/CustomItemCompact.module.scss","webpack://./node_modules/sharedstyle/_variables.scss"],names:[],mappings:"AAAA,sCAEA,iBACI,CAAA,gBACA,CAAA,iBACA,CAAA,gBACA,CAAA,kBACA,CAAA,aACA,CAAA,cACA,CAAA,uCAGJ,eACI,CAAA,6CAGJ,aCGoB,CAAA,kDDEhB,eACI,CAAA,iBACA,CAAA,6DAGI,WACI,CAAA,iBACA,CAAA,qBACA,CAAA,QACA,CAAA,4CAMhB,cACI,CAAA,gBACA,CAAA,2CAGJ,cACI,CAAA,gBACA,CAAA,UCtBG,CAAA,aDwBH,CAAA,WACA,CAAA,yCAGJ,gBACI,CAAA,aACA",sourcesContent:['@import "~sharedstyle/variables";\n\n.icon {\n    text-align: center;\n    line-height: 15px;\n    position: relative;\n    margin-right: 8px;\n    margin-bottom: -7px;\n    flex: 0 0 auto;\n    cursor: pointer;\n}\n\n.title {\n    font-weight: 400;\n}\n\n.description {\n    color: $resume-body-color;\n}\n\n.formatBullets {\n    ul {\n        list-style: none;\n        padding-left: 16px;\n\n        li {\n            &::before {\n                content: "•";\n                position: absolute;\n                vertical-align: middle;\n                left: 4px;\n            }\n        }\n    }\n}\n\n.fontSize11 {\n    font-size: 11px;\n    line-height: 13px;\n}\n\n.iconStyle {\n    font-size: 12px;\n    margin-right: 5px;\n    color: $gray;\n    flex: 0 0 auto;\n    height: 14px;\n}\n\n.rowDate {\n    margin-left: 10px;\n    flex-shrink: 0;\n}\n','@use "sass:color";\n@use "sass:math";\n//\n// Variables\n// --------------------------------------------------\n\n//== Colors\n//\n//## Gray and brand colors for use across Bootstrap.\n\n$shadow-4: 0 0 12px -3px rgba(0, 0, 0, 0.3);\n$shadow-5: 0 0 4px 0px rgba(0, 0, 0, 0.3);\n\n$shadow-1: 0 0 4px 0 rgba(160, 162, 167, 0.15);\n$shadow-2: 0 0 2px 0 rgba(77, 77, 77, 0.16);\n$shadow-3: 0 0 2px 0 rgba(83, 83, 83, 0.5);\n\n$gray-base: #000 !default;\n$gray-dark: #384347 !default;\n$resume-body-color: #3e3e3e !default; // specific body color for the resumes - without blue color included\n$gray-dark-2: #222 !default;\n$gray: color.adjust($gray-base, $lightness: 33.5%) !default; // #555\n$gray-light: color.adjust($gray-base, $lightness: 46.7%) !default; // #777\n$gray-lighter: color.adjust($gray-base, $lightness: 80%) !default; // #ccc\n$green-light: #eaf8f3;\n\n$gray-1: #b2b4b6;\n$gray-1-20: rgba($gray-1, 0.2);\n$gray-1-50: rgba($gray-1, 0.5);\n$gray-2: #65696d;\n$gray-2-20: rgba($gray-2, 0.2);\n$gray-2-50: rgba($gray-2, 0.5);\n$gray-3: #384347;\n$gray-3-20: rgba($gray-3, 0.2);\n$gray-3-50: rgba($gray-3, 0.5);\n\n$green-3: #2dc08d;\n$green-2: #62d0aa;\n$green-1: #d5f2e8;\n$green-hover: #249a71;\n\n$purple-3: #8c7cdb;\n$purple-2: #c5bded;\n$purple-1: #e8e5f8;\n\n$red-3: #ff576f;\n$red-2: #ffabb7;\n$red-1: #ffeef0;\n\n$blue-3: #7aaacb;\n$blue-2: #b5d6ec;\n$blue-1: #e2eff8;\n$blue-background: #f3f5fa;\n\n$yellow-3: #feb251;\n$yellow-2: #fed8a7;\n$yellow-1: #fff0dc;\n\n$background: #fafbfd;\n$brand-primary: #00c091;\n$brand-promo: #e7762e;\n$brand-success: #2dc08c !default;\n$brand-info: #5bc0de !default;\n$brand-warning: #f2994a !default;\n$brand-danger: #ff576f !default;\n$brand-border-color: #e6e6e6 !default;\n$brand-grey-background: #f2f2f2;\n$color-facebook: #3b5998;\n$color-twitter: #5eaade;\n$color-gplus: #dd4b39;\n$color-instagram: #333333;\n$color-linkedin: #2578b5;\n$color-messenger-first: rgb(1, 183, 255);\n$color-messenger-second: rgb(0, 126, 254);\n$color-messenger-border: #ffffff;\n$color-onboarding: #009ee8;\n$purple-color: #8c7cdb;\n$brand-gray-color: #65696d;\n$brand-info-font-color: #b2b4b6;\n$toolbox-border: rgba(223, 223, 223, 0.52);\n$selected-item-border-color: #60d5ba;\n\n$white: white;\n\n$op-background-color: #333333;\n$op-nav-control-color: #464646;\n$op-control-color: $gray-dark;\n$op-light-color: #e6e6e6;\n$op-control-primary-color: $brand-success;\n$op-notification-bg-primary: #ccf5e9;\n$op-notification-bg-danger: #ffc7d4;\n$op-notification-bg-warning: #ffe2ca;\n\n$op-base-offset: 8px !default;\n$op-btn-padding-horizontal: 14px;\n\n//Resume Styles\n$resume-rounding: 5px;\n\n//== Scaffolding\n//\n//## Settings for some of the most global styles.\n\n//** Background color for `<body>`.\n$body-bg: #fff !default;\n//** Global text color on `<body>`.\n$text-color: $gray-dark !default;\n\n$text-color-hover: color.adjust($text-color, $lightness: 30%) !default;\n\n//** Global textual link color.\n$link-color: white !default;\n//** Link hover color set via `darken()` function.\n$link-hover-color: color.adjust(white, $lightness: -10%);\n//** Link hover decoration.\n$link-hover-decoration: none !default;\n\n//== Typography\n//\n//## Font, line-height, and color for body text, headings, and more.\n\n$font-family-sans-serif: "Roboto", Arial, Helvetica, "Noto Sans Devanagari", "Noto Sans CJK SC Thin",\n    "Noto Sans SC", "Noto Sans Hebrew", "Noto Sans Bengali", sans-serif !default;\n$font-family-serif: Georgia, "Times New Roman", Times, "Noto Sans Devanagari",\n    "Noto Sans CJK SC Thin", "Noto Sans SC", "Noto Sans Hebrew", "Noto Sans Bengali", serif !default;\n//** Default monospace fonts for `<code>`, `<kbd>`, and `<pre>`.\n$font-family-monospace: Menlo, Monaco, Consolas, "Courier New", monospace !default;\n$font-family-base: "Inter" !default;\n\n$roboto: "Roboto", Arial, Helvetica, sans-serif;\n$opensans: "Open Sans", Arial, Helvetica, sans-serif;\n$account-heading-font: "Rubik", sans-serif !important;\n\n$font-size-base: 14px !default;\n$font-size-large: 18px !default;\n$font-size-small: 11px !default;\n\n$font-size-h1: 68px !default; // ~36px\n$font-size-h2: 38px !default; // ~30px\n$font-size-h3: 32px !default; // ~24px\n$font-size-h4: 26px !default; // ~18px\n$font-size-h5: 22px !default;\n$font-size-h6: 20px !default; // ~12px\n\n//** Unit-less `line-height` for use in components like buttons.\n$line-height-base: 1.428571429 !default; // 20/14\n//** Computed "line-height" (`font-size` * `line-height`) for use with `margin`, `padding`, etc.\n$line-height-computed: math.floor(($font-size-base * $line-height-base)) !default; // ~20px\n\n//** By default, this inherits from the `<body>`.\n$headings-font-family: "Rubik", sans-serif !default;\n$headings-font-weight: 300 !default;\n$headings-line-height: 1.1 !default;\n$headings-color: $gray-dark !default;\n\n//== Components\n//\n//## Define common padding and border radius sizes and more. Values based on 14px text and 1.428 line-height (~20px to start).\n\n$padding-base-vertical: 9px !default;\n$padding-base-horizontal: 14px !default;\n\n$padding-large-vertical: 12px !default;\n$padding-large-horizontal: 24px !default;\n\n$padding-small-vertical: 5px !default;\n$padding-small-horizontal: 18px !default;\n\n$padding-xs-vertical: 1px !default;\n$padding-xs-horizontal: 12px !default;\n\n$line-height-large: 1.3333333 !default; // extra decimals for Win 8.1 Chrome\n$line-height-small: 1.5 !default;\n\n$border-radius-base: 5px !default;\n$border-radius-large: 9px !default;\n$border-radius-small: 4px !default;\n\n//** Global color for active items (e.g., navs or dropdowns).\n$component-active-color: #fff !default;\n//** Global background color for active items (e.g., navs or dropdowns).\n$component-active-bg: $brand-primary !default;\n\n//** Width of the `border` for generating carets that indicator dropdowns.\n$caret-width-base: 4px !default;\n//** Carets increase slightly in size for larger components.\n$caret-width-large: 5px !default;\n\n//== Tables\n//\n//## Customizes the `.table` component with basic values, each used across all table variations.\n\n//** Padding for `<th>`s and `<td>`s.\n$table-cell-padding: 8px !default;\n//** Padding for cells in `.table-condensed`.\n$table-condensed-cell-padding: 5px !default;\n\n//** Default background color used for all tables.\n$table-bg: transparent !default;\n//** Background color used for `.table-striped`.\n$table-bg-accent: #f9f9f9 !default;\n//** Background color used for `.table-hover`.\n$table-bg-hover: #f5f5f5 !default;\n$table-bg-active: $table-bg-hover !default;\n\n//** Border color for table and cell borders.\n$table-border-color: #ddd !default;\n\n//== Buttons\n//\n//## For each of Bootstrap\'s buttons, define text, background and border color.\n\n$btn-font-weight: bold !default;\n\n$btn-default-color: #8c7cdb !default;\n$btn-default-bg: #fff !default;\n$btn-default-border: #8c7cdb !default;\n\n$btn-primary-color: #fff !default;\n$btn-primary-bg: $brand-primary !default;\n$btn-primary-border: $brand-primary !default;\n\n$btn-success-color: #fff !default;\n$btn-success-bg: $brand-success !default;\n$btn-success-border: color.adjust($btn-success-bg, $lightness: -5%) !default;\n\n$btn-info-color: #fff !default;\n$btn-info-bg: $brand-info !default;\n$btn-info-border: color.adjust($btn-info-bg, $lightness: -5%) !default;\n\n$btn-warning-color: #fff !default;\n$btn-warning-bg: $brand-warning !default;\n$btn-warning-border: color.adjust($btn-warning-bg, $lightness: -5%) !default;\n\n$btn-danger-color: #fff !default;\n$btn-danger-bg: $brand-danger !default;\n$btn-danger-border: color.adjust($btn-danger-bg, $lightness: -5%) !default;\n\n$btn-link-disabled-color: $gray-light !default;\n\n// Allows for customizing button radius independently from global border radius\n$btn-border-radius-base: $border-radius-base;\n$btn-border-radius-large: $border-radius-base;\n$btn-border-radius-small: $border-radius-base;\n\n//== Forms\n//\n//##\n\n//** `<input>` background color\n$input-bg: #fff !default;\n//** `<input disabled>` background color\n$input-bg-disabled: $gray-lighter !default;\n\n//** Text color for `<input>`s\n$input-color: $gray !default;\n//** `<input>` border color\n$input-border: #b3b3b3 !default;\n\n// TODO: Rename `$input-border-radius` to `$input-border-radius-base` in v4\n//** Default `.form-control` border radius\n// This has no effect on `<select>`s in some browsers, due to the limited stylability of `<select>`s in CSS.\n$input-border-radius: $border-radius-base;\n//** Large `.form-control` border radius\n$input-border-radius-large: $border-radius-base;\n//** Small `.form-control` border radius\n$input-border-radius-small: $border-radius-base;\n\n//** Border color for inputs on focus\n$input-border-focus: $brand-primary !default;\n\n//** Placeholder text color\n$input-color-placeholder: color.adjust($gray-base, $lightness: 70%) !default;\n\n//** Default `.form-control` height\n$input-height-base: ($line-height-computed + ($padding-base-vertical * 2) + 2) !default;\n//** Large `.form-control` height\n$input-height-large: (\n    math.ceil($font-size-large * $line-height-large) + ($padding-large-vertical * 2) + 2\n) !default;\n//** Small `.form-control` height\n$input-height-small: (\n    math.floor($font-size-small * $line-height-small) + ($padding-small-vertical * 2) + 2\n) !default;\n\n//** `.form-group` margin\n$form-group-margin-bottom: 15px !default;\n\n$legend-color: $gray-dark !default;\n$legend-border-color: #e5e5e5 !default;\n\n//** Background color for textual input addons\n$input-group-addon-bg: $gray-lighter !default;\n//** Border color for textual input addons\n$input-group-addon-border-color: $input-border !default;\n\n//** Disabled cursor for form controls and buttons.\n$cursor-disabled: not-allowed !default;\n\n//== Dropdowns\n//\n//## Dropdown menu container and contents.\n\n//** Background for the dropdown menu.\n$dropdown-bg: #fff !default;\n//** Dropdown menu `border-color`.\n$dropdown-border: rgba(0, 0, 0, 0.15) !default;\n//** Dropdown menu `border-color` **for IE8**.\n$dropdown-fallback-border: #ccc !default;\n//** Divider color for between dropdown items.\n$dropdown-divider-bg: #e5e5e5 !default;\n\n//** Dropdown link text color.\n$dropdown-link-color: $gray-dark !default;\n//** Hover color for dropdown links.\n$dropdown-link-hover-color: color.adjust($gray-dark, $lightness: 50%) !default;\n//** Hover background for dropdown links.\n$dropdown-link-hover-bg: transparent !default;\n\n//** Active dropdown menu item text color.\n$dropdown-link-active-color: $component-active-color !default;\n//** Active dropdown menu item background color.\n$dropdown-link-active-bg: $component-active-bg !default;\n\n//** Disabled dropdown menu item background color.\n$dropdown-link-disabled-color: $gray-light !default;\n\n//** Text color for headers within dropdown menus.\n$dropdown-header-color: $gray-light !default;\n\n//** Deprecated `$dropdown-caret-color` as of v3.1.0\n$dropdown-caret-color: #000 !default;\n\n//-- Z-index master list\n//\n// Warning: Avoid customizing these values. They\'re used for a bird\'s eye view\n// of components dependent on the z-axis and are designed to all work together.\n//\n// Note: These variables are not generated into the Customizer.\n\n$zindex-navbar: 1000 !default;\n$zindex-dropdown: 1000 !default;\n$zindex-mobile-design-menu: 1001 !default;\n$zindex-modal-background: 1002 !default; // from style guide --\x3e\n$zindex-modal-content: 1003 !default; // <--\n$zindex-full-screen-dropdown: 1004 !default;\n$zindex-popover: 1020 !default;\n$zindex-tooltip: 1050 !default;\n$zindex-navbar-fixed: 1030 !default;\n$zindex-toaster: 1030 !default;\n$zindex-alert: 1060 !default;\n$zindex-op-currdoing-cirle: 100 !default;\n$zindex-op-section-controls: 1 !default;\n$zindex-toasters: 8000 !default;\n\n//== Media queries breakpoints\n//\n//## Define the breakpoints at which your layout will change, adapting to different screen sizes.\n\n//== Grid system\n//\n//## Define your custom responsive grid.\n\n//** Number of columns in the grid.\n$grid-columns: 12 !default;\n//** Padding between columns. Gets divided in half for the left and right.\n$grid-gutter-width: 20px !default;\n\n//== Navbar OP\n//\n//##\n$op-navbar-height: 64px !default;\n$op-navbar-padding: 2 * $op-base-offset !default;\n\n//== Navbar\n//\n//##\n\n// Basics of a navbar\n$navbar-height: 60px !default;\n$navbar-padding: 16px !default;\n$navbar-margin-bottom: 0 !default;\n$navbar-border-radius: 0 !default;\n$navbar-padding-horizontal: math.floor(($grid-gutter-width * 0.5)) !default;\n$navbar-padding-vertical: (($navbar-height - $line-height-computed) * 0.5) !default;\n$navbar-collapse-max-height: 340px !default;\n\n$navbar-default-color: $text-color !default;\n$navbar-default-bg: white !default;\n$navbar-default-border: transparent !default;\n\n// Navbar links\n$navbar-default-link-color: $text-color !default;\n$navbar-default-link-hover-color: $purple-color !default;\n$navbar-default-link-hover-bg: transparent !default;\n$navbar-default-link-active-color: #b2b4b6 !default;\n$navbar-default-link-active-bg: color.adjust($navbar-default-bg, $lightness: -6.5%) !default;\n$navbar-default-link-disabled-color: #ccc !default;\n$navbar-default-link-disabled-bg: transparent !default;\n\n// Navbar brand label\n$navbar-default-brand-color: #e6e6e6 !default;\n$navbar-default-brand-hover-color: color.adjust(\n    $navbar-default-brand-color,\n    $lightness: -10%\n) !default;\n$navbar-default-brand-hover-bg: transparent !default;\n\n// Navbar toggle\n$navbar-default-toggle-hover-bg: color.adjust(white, $lightness: -5%) !default;\n$navbar-default-toggle-icon-bar-bg: $text-color !default;\n$navbar-default-toggle-border-color: transparent !default;\n\n//=== Inverted navbar\n// Reset inverted navbar basics\n$navbar-inverse-color: $brand-gray-color !default;\n$navbar-inverse-bg: white !default;\n$navbar-inverse-border: $brand-border-color !default;\n\n// Inverted navbar links\n$navbar-inverse-link-color: $brand-gray-color !default;\n$navbar-inverse-link-hover-color: $text-color;\n$navbar-inverse-link-hover-bg: transparent !default;\n$navbar-inverse-link-active-color: $navbar-inverse-link-hover-color !default;\n$navbar-inverse-link-active-bg: color.adjust($navbar-inverse-bg, $lightness: -10%) !default;\n$navbar-inverse-link-disabled-color: #444 !default;\n$navbar-inverse-link-disabled-bg: transparent !default;\n\n// Inverted navbar brand label\n$navbar-inverse-brand-color: $navbar-inverse-link-color !default;\n$navbar-inverse-brand-hover-color: #fff !default;\n$navbar-inverse-brand-hover-bg: transparent !default;\n\n// Inverted navbar toggle\n$navbar-inverse-toggle-hover-bg: color.adjust(white, $lightness: -10%) !default;\n$navbar-inverse-toggle-icon-bar-bg: $gray !default;\n$navbar-inverse-toggle-border-color: $gray !default;\n\n//== Navs\n//\n//##\n\n//=== Shared nav styles\n$nav-link-padding: 12px 15px !default;\n$nav-link-hover-bg: transparent !default;\n\n$nav-disabled-link-color: $gray-light !default;\n$nav-disabled-link-hover-color: transparent !default;\n\n//== Tabs\n$nav-tabs-border-color: #ddd !default;\n\n$nav-tabs-link-hover-border-color: $gray-lighter !default;\n\n$nav-tabs-active-link-hover-bg: $body-bg !default;\n$nav-tabs-active-link-hover-color: $gray !default;\n$nav-tabs-active-link-hover-border-color: #ddd !default;\n\n$nav-tabs-justified-link-border-color: #ddd !default;\n$nav-tabs-justified-active-link-border-color: $body-bg !default;\n\n//== Pills\n$nav-pills-border-radius: $border-radius-base !default;\n$nav-pills-active-link-hover-bg: transparent !default;\n$nav-pills-active-link-hover-color: $brand-primary !default;\n\n//== Pagination\n//\n//##\n\n$pagination-color: $link-color !default;\n$pagination-bg: #fff !default;\n$pagination-border: #ddd !default;\n\n$pagination-hover-color: $link-hover-color !default;\n$pagination-hover-bg: $gray-lighter !default;\n$pagination-hover-border: #ddd !default;\n\n$pagination-active-color: #fff !default;\n$pagination-active-bg: $brand-primary !default;\n$pagination-active-border: $brand-primary !default;\n\n$pagination-disabled-color: $gray-light !default;\n$pagination-disabled-bg: #fff !default;\n$pagination-disabled-border: #ddd !default;\n\n//== Pager\n//\n//##\n\n$pager-bg: $pagination-bg !default;\n$pager-border: $pagination-border !default;\n$pager-border-radius: 15px !default;\n\n$pager-hover-bg: $pagination-hover-bg !default;\n\n$pager-active-bg: $pagination-active-bg !default;\n$pager-active-color: $pagination-active-color !default;\n\n$pager-disabled-color: $pagination-disabled-color !default;\n\n//== Jumbotron\n//\n//##\n\n$jumbotron-padding: 30px !default;\n$jumbotron-color: inherit !default;\n$jumbotron-bg: $gray-lighter !default;\n$jumbotron-heading-color: inherit !default;\n$jumbotron-font-size: math.ceil(($font-size-base * 1.5)) !default;\n$jumbotron-heading-font-size: math.ceil(($font-size-base * 4.5)) !default;\n\n//== Form states and alerts\n//\n//## Define colors for form feedback states and, by default, alerts.\n\n$state-success-text: #00c091 !default;\n$state-success-bg: #caf3e9 !default;\n$state-success-border: color.adjust(\n    color.adjust($state-success-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n$state-info-text: #31708f !default;\n$state-info-bg: #d9edf7 !default;\n$state-info-border: color.adjust(color.adjust($state-info-bg, $hue: -10), $lightness: -7%) !default;\n\n$state-warning-text: $brand-warning !default;\n$state-warning-bg: #fcf8e3 !default;\n$state-warning-border: color.adjust(\n    color.adjust($state-warning-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n$state-danger-text: $brand-danger !default;\n$state-danger-bg: #ffcbd6 !default;\n$state-danger-border: color.adjust(\n    color.adjust($state-danger-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n//== Tooltips\n//\n//##\n\n//** Tooltip max width\n$tooltip-max-width: 300px !default;\n//** Tooltip text color\n$tooltip-color: #fff !default;\n//** Tooltip background color\n$tooltip-bg: $gray-dark !default;\n$tooltip-opacity: 0.9 !default;\n\n//** Tooltip arrow width\n$tooltip-arrow-width: 5px !default;\n//** Tooltip arrow color\n$tooltip-arrow-color: $tooltip-bg !default;\n\n//== Popovers\n//\n//##\n\n//** Popover body background color\n$popover-bg: #fff !default;\n//** Popover maximum width\n$popover-max-width: 276px !default;\n//** Popover border color\n$popover-border-color: rgba(0, 0, 0, 0.2) !default;\n//** Popover fallback border color\n$popover-fallback-border-color: #ccc !default;\n\n//** Popover title background color\n$popover-title-bg: color.adjust($popover-bg, $lightness: -3%) !default;\n\n//** Popover arrow width\n$popover-arrow-width: 10px !default;\n//** Popover arrow color\n$popover-arrow-color: $popover-bg !default;\n\n//** Popover outer arrow width\n$popover-arrow-outer-width: ($popover-arrow-width + 1) !default;\n//** Popover outer arrow color\n$popover-arrow-outer-color: color.adjust($popover-border-color, $alpha: 0.05) !default;\n//** Popover outer arrow fallback color\n$popover-arrow-outer-fallback-color: color.adjust(\n    $popover-fallback-border-color,\n    $lightness: -20%\n) !default;\n\n//== Labels\n//\n//##\n\n//** Default label background color\n$label-default-bg: $gray-light !default;\n//** Primary label background color\n$label-primary-bg: $brand-primary !default;\n//** Success label background color\n$label-success-bg: $brand-success !default;\n//** Info label background color\n$label-info-bg: $brand-info !default;\n//** Warning label background color\n$label-warning-bg: $brand-warning !default;\n//** Danger label background color\n$label-danger-bg: $brand-danger !default;\n\n//** Default label text color\n$label-color: #fff !default;\n//** Default text color of a linked label\n$label-link-hover-color: #fff !default;\n$label-gray: #60696c;\n\n//== Modals\n//\n//##\n\n//** Padding applied to the modal body\n$modal-inner-padding: 35px 40px !default;\n\n//** Padding applied to the modal title\n$modal-title-padding: 35px 40px 35px 40px !default;\n//** Modal title line-height\n$modal-title-line-height: $line-height-base !default;\n\n//** Background color of modal content area\n$modal-content-bg: #fff !default;\n//** Modal content border color\n$modal-content-border-color: rgba(255, 255, 255, 0) !default;\n//** Modal content border color **for IE8**\n$modal-content-fallback-border-color: #999 !default;\n\n//** Modal backdrop background color\n$modal-backdrop-bg: #00bf93 !default;\n//** Modal backdrop opacity\n$modal-backdrop-opacity: 0.5 !default;\n//** Modal header border color\n$modal-header-border-color: #e6e6e6 !default;\n//** Modal footer border color\n$modal-footer-border-color: $modal-header-border-color !default;\n\n$modal-lg: 820px !default;\n$modal-md: 630px !default;\n$modal-sm: 420px !default;\n\n//== Alerts\n//\n//## Define alert colors, border radius, and padding.\n\n$alert-padding: 8px 15px !default;\n$alert-border-radius: 45px !default;\n$alert-link-font-weight: bold !default;\n\n$alert-success-bg: $state-success-bg !default;\n$alert-success-text: $state-success-text !default;\n$alert-success-border: #fff !default;\n\n$alert-info-bg: $state-info-bg !default;\n$alert-info-text: $state-info-text !default;\n$alert-info-border: #fff !default;\n\n$alert-warning-bg: $state-warning-bg !default;\n$alert-warning-text: $state-warning-text !default;\n$alert-warning-border: #fff !default;\n\n$alert-danger-bg: $state-danger-bg !default;\n$alert-danger-text: $state-danger-text !default;\n$alert-danger-border: #fff !default;\n\n//== Progress bars\n//\n//##\n\n//** Background color of the whole progress component\n$progress-bg: #e6e6e6 !default;\n//** Progress bar text color\n$progress-bar-color: #fff !default;\n//** Variable for setting rounded corners on progress bar.\n$progress-border-radius: 12px !default;\n\n//** Default progress bar color\n$progress-bar-bg: $brand-primary !default;\n//** Success progress bar color\n$progress-bar-success-bg: $brand-success !default;\n//** Warning progress bar color\n$progress-bar-warning-bg: $brand-warning !default;\n//** Danger progress bar color\n$progress-bar-danger-bg: $brand-danger !default;\n//** Info progress bar color\n$progress-bar-info-bg: $brand-info !default;\n\n//== List group\n//\n//##\n\n//** Background color on `.list-group-item`\n$list-group-bg: #fff !default;\n//** `.list-group-item` border color\n$list-group-border: #ddd !default;\n//** List group border radius\n$list-group-border-radius: $border-radius-base !default;\n\n//** Background color of single list items on hover\n$list-group-hover-bg: #f5f5f5 !default;\n//** Text color of active list items\n$list-group-active-color: $component-active-color !default;\n//** Background color of active list items\n$list-group-active-bg: $component-active-bg !default;\n//** Border color of active list elements\n$list-group-active-border: $list-group-active-bg !default;\n//** Text color for content within active list items\n$list-group-active-text-color: color.adjust($list-group-active-bg, $lightness: 40%) !default;\n\n//** Text color of disabled list items\n$list-group-disabled-color: $gray-light !default;\n//** Background color of disabled list items\n$list-group-disabled-bg: $gray-lighter !default;\n//** Text color for content within disabled list items\n$list-group-disabled-text-color: $list-group-disabled-color !default;\n\n$list-group-link-color: #555 !default;\n$list-group-link-hover-color: $list-group-link-color !default;\n$list-group-link-heading-color: #333 !default;\n\n//== Panels\n//\n//##\n\n$panel-bg: #fff !default;\n$panel-body-padding: 15px !default;\n$panel-heading-padding: 10px 15px !default;\n$panel-footer-padding: $panel-heading-padding !default;\n$panel-border-radius: $border-radius-base !default;\n\n//** Border color for elements within panels\n$panel-inner-border: #ddd !default;\n$panel-footer-bg: #f5f5f5 !default;\n\n$panel-default-text: $gray-dark !default;\n$panel-default-border: #ddd !default;\n$panel-default-heading-bg: #f5f5f5 !default;\n\n$panel-primary-text: #fff !default;\n$panel-primary-border: $brand-primary !default;\n$panel-primary-heading-bg: $brand-primary !default;\n\n$panel-success-text: $state-success-text !default;\n$panel-success-border: $state-success-border !default;\n$panel-success-heading-bg: $state-success-bg !default;\n\n$panel-info-text: $state-info-text !default;\n$panel-info-border: $state-info-border !default;\n$panel-info-heading-bg: $state-info-bg !default;\n\n$panel-warning-text: $state-warning-text !default;\n$panel-warning-border: $state-warning-border !default;\n$panel-warning-heading-bg: $state-warning-bg !default;\n\n$panel-danger-text: $state-danger-text !default;\n$panel-danger-border: $state-danger-border !default;\n$panel-danger-heading-bg: $state-danger-bg !default;\n\n//== Thumbnails\n//\n//##\n\n//** Padding around the thumbnail image\n$thumbnail-padding: 4px !default;\n//** Thumbnail background color\n$thumbnail-bg: $body-bg !default;\n//** Thumbnail border color\n$thumbnail-border: #ddd !default;\n//** Thumbnail border radius\n$thumbnail-border-radius: $border-radius-base !default;\n\n//** Custom text color for thumbnail captions\n$thumbnail-caption-color: $text-color !default;\n//** Padding around the thumbnail caption\n$thumbnail-caption-padding: 9px !default;\n\n//== Wells\n//\n//##\n\n$well-bg: #f5f5f5 !default;\n$well-border: color.adjust($well-bg, $lightness: -7%) !default;\n\n//== Badges\n//\n//##\n\n$badge-color: #fff !default;\n//** Linked badge text color on hover\n$badge-link-hover-color: #fff !default;\n$badge-bg: $gray-light !default;\n\n//** Badge text color in active nav link\n$badge-active-color: $link-color !default;\n//** Badge background color in active nav link\n$badge-active-bg: #fff !default;\n\n$badge-font-weight: bold !default;\n$badge-line-height: 1 !default;\n$badge-border-radius: 35px !default;\n\n//== Breadcrumbs\n//\n//##\n\n$breadcrumb-padding-vertical: 8px !default;\n$breadcrumb-padding-horizontal: 15px !default;\n//** Breadcrumb background color\n$breadcrumb-bg: #f5f5f5 !default;\n//** Breadcrumb text color\n$breadcrumb-color: #ccc !default;\n//** Text color of current page in the breadcrumb\n$breadcrumb-active-color: $gray-light !default;\n//** Textual separator for between breadcrumb elements\n$breadcrumb-separator: "/" !default;\n\n//== Carousel\n//\n//##\n\n$carousel-text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6) !default;\n\n$carousel-control-color: #fff !default;\n$carousel-control-width: 15% !default;\n$carousel-control-opacity: 0.5 !default;\n$carousel-control-font-size: 20px !default;\n\n$carousel-indicator-active-bg: #fff !default;\n$carousel-indicator-border-color: #fff !default;\n\n$carousel-caption-color: #fff !default;\n\n//== Close\n//\n//##\n\n$close-font-weight: bold !default;\n$close-color: #000 !default;\n$close-text-shadow: 0 1px 0 #fff !default;\n\n//== Code\n//\n//##\n\n$code-color: #c7254e !default;\n$code-bg: #f9f2f4 !default;\n\n$kbd-color: #fff !default;\n$kbd-bg: #333 !default;\n\n$pre-bg: #f5f5f5 !default;\n$pre-color: $gray-dark !default;\n$pre-border-color: #ccc !default;\n$pre-scrollable-max-height: 340px !default;\n\n//== Type\n//\n//##\n\n//** Horizontal offset for forms and lists.\n$component-offset-horizontal: 180px !default;\n//** Text muted color\n$text-muted: $gray-lighter !default;\n//** Abbreviations and acronyms border color\n$abbr-border-color: $gray-light !default;\n//** Headings small color\n$headings-small-color: $gray-light !default;\n//** Blockquote small color\n$blockquote-small-color: $gray-light !default;\n//** Blockquote font size\n$blockquote-font-size: ($font-size-base * 1.25) !default;\n//** Blockquote border color\n$blockquote-border-color: $gray-lighter !default;\n//** Page header border color\n$page-header-border-color: $gray-lighter !default;\n//** Horizontal line color.\n$hr-border: $gray-1-50 !default;\n'],sourceRoot:""}]),l.locals={icon:"CustomItemCompact-module_icon__VLN6r",title:"CustomItemCompact-module_title__F3JgT",description:"CustomItemCompact-module_description__uGpsP",formatBullets:"CustomItemCompact-module_formatBullets__Sx9Su",fontSize11:"CustomItemCompact-module_fontSize11__C5cAp",iconStyle:"CustomItemCompact-module_iconStyle__IbTJi",rowDate:"CustomItemCompact-module_rowDate__PddOF"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/packages/Resume/ItemTypes/Custom/CustomItemCondensed.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,'.CustomItemCondensed-module_iconContainer__m0R9P{display:flex;align-items:center;justify-content:center;width:40px;height:40px;background-color:#f2f2f2;border-radius:50%;text-align:center;flex:0 0 auto;cursor:pointer;text-align:center;margin-right:10px}.CustomItemCondensed-module_icon__xTz9O{font-size:16px}.CustomItemCondensed-module_title__Hx8HA{font-weight:400}.CustomItemCondensed-module_description__JI8zn{font-weight:400;padding-top:4px;color:#3e3e3e}.CustomItemCondensed-module_formatBullets__AIdnJ ul{list-style:none;padding-left:16px}.CustomItemCondensed-module_formatBullets__AIdnJ ul li::before{content:"•";position:absolute;vertical-align:middle;left:4px}.CustomItemCondensed-module_fontSize11__z_9N5{font-size:11px;line-height:13px}.CustomItemCondensed-module_iconStyle__ip2_g{font-size:12px;margin-right:5px;flex:0 0 auto;height:14px}',"",{version:3,sources:["webpack://./src/packages/Resume/ItemTypes/Custom/CustomItemCondensed.module.scss","webpack://./node_modules/sharedstyle/_variables.scss"],names:[],mappings:"AAAA,iDAEA,YACI,CAAA,kBACA,CAAA,sBACA,CAAA,UACA,CAAA,WACA,CAAA,wBACA,CAAA,iBACA,CAAA,iBACA,CAAA,aACA,CAAA,cACA,CAAA,iBACA,CAAA,iBACA,CAAA,wCAGJ,cACI,CAAA,yCAGJ,eACI,CAAA,+CAGJ,eACI,CAAA,eACA,CAAA,aCRgB,CAAA,oDDahB,eACI,CAAA,iBACA,CAAA,+DAGI,WACI,CAAA,iBACA,CAAA,qBACA,CAAA,QACA,CAAA,8CAMhB,cACI,CAAA,gBACA,CAAA,6CAGJ,cACI,CAAA,gBACA,CAAA,aACA,CAAA,WACA",sourcesContent:['@import "~sharedstyle/variables";\n\n.iconContainer {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 40px;\n    height: 40px;\n    background-color: #f2f2f2;\n    border-radius: 50%;\n    text-align: center;\n    flex: 0 0 auto;\n    cursor: pointer;\n    text-align: center;\n    margin-right: 10px;\n}\n\n.icon {\n    font-size: 16px;\n}\n\n.title {\n    font-weight: 400;\n}\n\n.description {\n    font-weight: 400;\n    padding-top: 4px;\n    color: $resume-body-color;\n}\n\n.formatBullets {\n    ul {\n        list-style: none;\n        padding-left: 16px;\n\n        li {\n            &::before {\n                content: "•";\n                position: absolute;\n                vertical-align: middle;\n                left: 4px;\n            }\n        }\n    }\n}\n\n.fontSize11 {\n    font-size: 11px;\n    line-height: 13px;\n}\n\n.iconStyle {\n    font-size: 12px;\n    margin-right: 5px;\n    flex: 0 0 auto;\n    height: 14px;\n}\n','@use "sass:color";\n@use "sass:math";\n//\n// Variables\n// --------------------------------------------------\n\n//== Colors\n//\n//## Gray and brand colors for use across Bootstrap.\n\n$shadow-4: 0 0 12px -3px rgba(0, 0, 0, 0.3);\n$shadow-5: 0 0 4px 0px rgba(0, 0, 0, 0.3);\n\n$shadow-1: 0 0 4px 0 rgba(160, 162, 167, 0.15);\n$shadow-2: 0 0 2px 0 rgba(77, 77, 77, 0.16);\n$shadow-3: 0 0 2px 0 rgba(83, 83, 83, 0.5);\n\n$gray-base: #000 !default;\n$gray-dark: #384347 !default;\n$resume-body-color: #3e3e3e !default; // specific body color for the resumes - without blue color included\n$gray-dark-2: #222 !default;\n$gray: color.adjust($gray-base, $lightness: 33.5%) !default; // #555\n$gray-light: color.adjust($gray-base, $lightness: 46.7%) !default; // #777\n$gray-lighter: color.adjust($gray-base, $lightness: 80%) !default; // #ccc\n$green-light: #eaf8f3;\n\n$gray-1: #b2b4b6;\n$gray-1-20: rgba($gray-1, 0.2);\n$gray-1-50: rgba($gray-1, 0.5);\n$gray-2: #65696d;\n$gray-2-20: rgba($gray-2, 0.2);\n$gray-2-50: rgba($gray-2, 0.5);\n$gray-3: #384347;\n$gray-3-20: rgba($gray-3, 0.2);\n$gray-3-50: rgba($gray-3, 0.5);\n\n$green-3: #2dc08d;\n$green-2: #62d0aa;\n$green-1: #d5f2e8;\n$green-hover: #249a71;\n\n$purple-3: #8c7cdb;\n$purple-2: #c5bded;\n$purple-1: #e8e5f8;\n\n$red-3: #ff576f;\n$red-2: #ffabb7;\n$red-1: #ffeef0;\n\n$blue-3: #7aaacb;\n$blue-2: #b5d6ec;\n$blue-1: #e2eff8;\n$blue-background: #f3f5fa;\n\n$yellow-3: #feb251;\n$yellow-2: #fed8a7;\n$yellow-1: #fff0dc;\n\n$background: #fafbfd;\n$brand-primary: #00c091;\n$brand-promo: #e7762e;\n$brand-success: #2dc08c !default;\n$brand-info: #5bc0de !default;\n$brand-warning: #f2994a !default;\n$brand-danger: #ff576f !default;\n$brand-border-color: #e6e6e6 !default;\n$brand-grey-background: #f2f2f2;\n$color-facebook: #3b5998;\n$color-twitter: #5eaade;\n$color-gplus: #dd4b39;\n$color-instagram: #333333;\n$color-linkedin: #2578b5;\n$color-messenger-first: rgb(1, 183, 255);\n$color-messenger-second: rgb(0, 126, 254);\n$color-messenger-border: #ffffff;\n$color-onboarding: #009ee8;\n$purple-color: #8c7cdb;\n$brand-gray-color: #65696d;\n$brand-info-font-color: #b2b4b6;\n$toolbox-border: rgba(223, 223, 223, 0.52);\n$selected-item-border-color: #60d5ba;\n\n$white: white;\n\n$op-background-color: #333333;\n$op-nav-control-color: #464646;\n$op-control-color: $gray-dark;\n$op-light-color: #e6e6e6;\n$op-control-primary-color: $brand-success;\n$op-notification-bg-primary: #ccf5e9;\n$op-notification-bg-danger: #ffc7d4;\n$op-notification-bg-warning: #ffe2ca;\n\n$op-base-offset: 8px !default;\n$op-btn-padding-horizontal: 14px;\n\n//Resume Styles\n$resume-rounding: 5px;\n\n//== Scaffolding\n//\n//## Settings for some of the most global styles.\n\n//** Background color for `<body>`.\n$body-bg: #fff !default;\n//** Global text color on `<body>`.\n$text-color: $gray-dark !default;\n\n$text-color-hover: color.adjust($text-color, $lightness: 30%) !default;\n\n//** Global textual link color.\n$link-color: white !default;\n//** Link hover color set via `darken()` function.\n$link-hover-color: color.adjust(white, $lightness: -10%);\n//** Link hover decoration.\n$link-hover-decoration: none !default;\n\n//== Typography\n//\n//## Font, line-height, and color for body text, headings, and more.\n\n$font-family-sans-serif: "Roboto", Arial, Helvetica, "Noto Sans Devanagari", "Noto Sans CJK SC Thin",\n    "Noto Sans SC", "Noto Sans Hebrew", "Noto Sans Bengali", sans-serif !default;\n$font-family-serif: Georgia, "Times New Roman", Times, "Noto Sans Devanagari",\n    "Noto Sans CJK SC Thin", "Noto Sans SC", "Noto Sans Hebrew", "Noto Sans Bengali", serif !default;\n//** Default monospace fonts for `<code>`, `<kbd>`, and `<pre>`.\n$font-family-monospace: Menlo, Monaco, Consolas, "Courier New", monospace !default;\n$font-family-base: "Inter" !default;\n\n$roboto: "Roboto", Arial, Helvetica, sans-serif;\n$opensans: "Open Sans", Arial, Helvetica, sans-serif;\n$account-heading-font: "Rubik", sans-serif !important;\n\n$font-size-base: 14px !default;\n$font-size-large: 18px !default;\n$font-size-small: 11px !default;\n\n$font-size-h1: 68px !default; // ~36px\n$font-size-h2: 38px !default; // ~30px\n$font-size-h3: 32px !default; // ~24px\n$font-size-h4: 26px !default; // ~18px\n$font-size-h5: 22px !default;\n$font-size-h6: 20px !default; // ~12px\n\n//** Unit-less `line-height` for use in components like buttons.\n$line-height-base: 1.428571429 !default; // 20/14\n//** Computed "line-height" (`font-size` * `line-height`) for use with `margin`, `padding`, etc.\n$line-height-computed: math.floor(($font-size-base * $line-height-base)) !default; // ~20px\n\n//** By default, this inherits from the `<body>`.\n$headings-font-family: "Rubik", sans-serif !default;\n$headings-font-weight: 300 !default;\n$headings-line-height: 1.1 !default;\n$headings-color: $gray-dark !default;\n\n//== Components\n//\n//## Define common padding and border radius sizes and more. Values based on 14px text and 1.428 line-height (~20px to start).\n\n$padding-base-vertical: 9px !default;\n$padding-base-horizontal: 14px !default;\n\n$padding-large-vertical: 12px !default;\n$padding-large-horizontal: 24px !default;\n\n$padding-small-vertical: 5px !default;\n$padding-small-horizontal: 18px !default;\n\n$padding-xs-vertical: 1px !default;\n$padding-xs-horizontal: 12px !default;\n\n$line-height-large: 1.3333333 !default; // extra decimals for Win 8.1 Chrome\n$line-height-small: 1.5 !default;\n\n$border-radius-base: 5px !default;\n$border-radius-large: 9px !default;\n$border-radius-small: 4px !default;\n\n//** Global color for active items (e.g., navs or dropdowns).\n$component-active-color: #fff !default;\n//** Global background color for active items (e.g., navs or dropdowns).\n$component-active-bg: $brand-primary !default;\n\n//** Width of the `border` for generating carets that indicator dropdowns.\n$caret-width-base: 4px !default;\n//** Carets increase slightly in size for larger components.\n$caret-width-large: 5px !default;\n\n//== Tables\n//\n//## Customizes the `.table` component with basic values, each used across all table variations.\n\n//** Padding for `<th>`s and `<td>`s.\n$table-cell-padding: 8px !default;\n//** Padding for cells in `.table-condensed`.\n$table-condensed-cell-padding: 5px !default;\n\n//** Default background color used for all tables.\n$table-bg: transparent !default;\n//** Background color used for `.table-striped`.\n$table-bg-accent: #f9f9f9 !default;\n//** Background color used for `.table-hover`.\n$table-bg-hover: #f5f5f5 !default;\n$table-bg-active: $table-bg-hover !default;\n\n//** Border color for table and cell borders.\n$table-border-color: #ddd !default;\n\n//== Buttons\n//\n//## For each of Bootstrap\'s buttons, define text, background and border color.\n\n$btn-font-weight: bold !default;\n\n$btn-default-color: #8c7cdb !default;\n$btn-default-bg: #fff !default;\n$btn-default-border: #8c7cdb !default;\n\n$btn-primary-color: #fff !default;\n$btn-primary-bg: $brand-primary !default;\n$btn-primary-border: $brand-primary !default;\n\n$btn-success-color: #fff !default;\n$btn-success-bg: $brand-success !default;\n$btn-success-border: color.adjust($btn-success-bg, $lightness: -5%) !default;\n\n$btn-info-color: #fff !default;\n$btn-info-bg: $brand-info !default;\n$btn-info-border: color.adjust($btn-info-bg, $lightness: -5%) !default;\n\n$btn-warning-color: #fff !default;\n$btn-warning-bg: $brand-warning !default;\n$btn-warning-border: color.adjust($btn-warning-bg, $lightness: -5%) !default;\n\n$btn-danger-color: #fff !default;\n$btn-danger-bg: $brand-danger !default;\n$btn-danger-border: color.adjust($btn-danger-bg, $lightness: -5%) !default;\n\n$btn-link-disabled-color: $gray-light !default;\n\n// Allows for customizing button radius independently from global border radius\n$btn-border-radius-base: $border-radius-base;\n$btn-border-radius-large: $border-radius-base;\n$btn-border-radius-small: $border-radius-base;\n\n//== Forms\n//\n//##\n\n//** `<input>` background color\n$input-bg: #fff !default;\n//** `<input disabled>` background color\n$input-bg-disabled: $gray-lighter !default;\n\n//** Text color for `<input>`s\n$input-color: $gray !default;\n//** `<input>` border color\n$input-border: #b3b3b3 !default;\n\n// TODO: Rename `$input-border-radius` to `$input-border-radius-base` in v4\n//** Default `.form-control` border radius\n// This has no effect on `<select>`s in some browsers, due to the limited stylability of `<select>`s in CSS.\n$input-border-radius: $border-radius-base;\n//** Large `.form-control` border radius\n$input-border-radius-large: $border-radius-base;\n//** Small `.form-control` border radius\n$input-border-radius-small: $border-radius-base;\n\n//** Border color for inputs on focus\n$input-border-focus: $brand-primary !default;\n\n//** Placeholder text color\n$input-color-placeholder: color.adjust($gray-base, $lightness: 70%) !default;\n\n//** Default `.form-control` height\n$input-height-base: ($line-height-computed + ($padding-base-vertical * 2) + 2) !default;\n//** Large `.form-control` height\n$input-height-large: (\n    math.ceil($font-size-large * $line-height-large) + ($padding-large-vertical * 2) + 2\n) !default;\n//** Small `.form-control` height\n$input-height-small: (\n    math.floor($font-size-small * $line-height-small) + ($padding-small-vertical * 2) + 2\n) !default;\n\n//** `.form-group` margin\n$form-group-margin-bottom: 15px !default;\n\n$legend-color: $gray-dark !default;\n$legend-border-color: #e5e5e5 !default;\n\n//** Background color for textual input addons\n$input-group-addon-bg: $gray-lighter !default;\n//** Border color for textual input addons\n$input-group-addon-border-color: $input-border !default;\n\n//** Disabled cursor for form controls and buttons.\n$cursor-disabled: not-allowed !default;\n\n//== Dropdowns\n//\n//## Dropdown menu container and contents.\n\n//** Background for the dropdown menu.\n$dropdown-bg: #fff !default;\n//** Dropdown menu `border-color`.\n$dropdown-border: rgba(0, 0, 0, 0.15) !default;\n//** Dropdown menu `border-color` **for IE8**.\n$dropdown-fallback-border: #ccc !default;\n//** Divider color for between dropdown items.\n$dropdown-divider-bg: #e5e5e5 !default;\n\n//** Dropdown link text color.\n$dropdown-link-color: $gray-dark !default;\n//** Hover color for dropdown links.\n$dropdown-link-hover-color: color.adjust($gray-dark, $lightness: 50%) !default;\n//** Hover background for dropdown links.\n$dropdown-link-hover-bg: transparent !default;\n\n//** Active dropdown menu item text color.\n$dropdown-link-active-color: $component-active-color !default;\n//** Active dropdown menu item background color.\n$dropdown-link-active-bg: $component-active-bg !default;\n\n//** Disabled dropdown menu item background color.\n$dropdown-link-disabled-color: $gray-light !default;\n\n//** Text color for headers within dropdown menus.\n$dropdown-header-color: $gray-light !default;\n\n//** Deprecated `$dropdown-caret-color` as of v3.1.0\n$dropdown-caret-color: #000 !default;\n\n//-- Z-index master list\n//\n// Warning: Avoid customizing these values. They\'re used for a bird\'s eye view\n// of components dependent on the z-axis and are designed to all work together.\n//\n// Note: These variables are not generated into the Customizer.\n\n$zindex-navbar: 1000 !default;\n$zindex-dropdown: 1000 !default;\n$zindex-mobile-design-menu: 1001 !default;\n$zindex-modal-background: 1002 !default; // from style guide --\x3e\n$zindex-modal-content: 1003 !default; // <--\n$zindex-full-screen-dropdown: 1004 !default;\n$zindex-popover: 1020 !default;\n$zindex-tooltip: 1050 !default;\n$zindex-navbar-fixed: 1030 !default;\n$zindex-toaster: 1030 !default;\n$zindex-alert: 1060 !default;\n$zindex-op-currdoing-cirle: 100 !default;\n$zindex-op-section-controls: 1 !default;\n$zindex-toasters: 8000 !default;\n\n//== Media queries breakpoints\n//\n//## Define the breakpoints at which your layout will change, adapting to different screen sizes.\n\n//== Grid system\n//\n//## Define your custom responsive grid.\n\n//** Number of columns in the grid.\n$grid-columns: 12 !default;\n//** Padding between columns. Gets divided in half for the left and right.\n$grid-gutter-width: 20px !default;\n\n//== Navbar OP\n//\n//##\n$op-navbar-height: 64px !default;\n$op-navbar-padding: 2 * $op-base-offset !default;\n\n//== Navbar\n//\n//##\n\n// Basics of a navbar\n$navbar-height: 60px !default;\n$navbar-padding: 16px !default;\n$navbar-margin-bottom: 0 !default;\n$navbar-border-radius: 0 !default;\n$navbar-padding-horizontal: math.floor(($grid-gutter-width * 0.5)) !default;\n$navbar-padding-vertical: (($navbar-height - $line-height-computed) * 0.5) !default;\n$navbar-collapse-max-height: 340px !default;\n\n$navbar-default-color: $text-color !default;\n$navbar-default-bg: white !default;\n$navbar-default-border: transparent !default;\n\n// Navbar links\n$navbar-default-link-color: $text-color !default;\n$navbar-default-link-hover-color: $purple-color !default;\n$navbar-default-link-hover-bg: transparent !default;\n$navbar-default-link-active-color: #b2b4b6 !default;\n$navbar-default-link-active-bg: color.adjust($navbar-default-bg, $lightness: -6.5%) !default;\n$navbar-default-link-disabled-color: #ccc !default;\n$navbar-default-link-disabled-bg: transparent !default;\n\n// Navbar brand label\n$navbar-default-brand-color: #e6e6e6 !default;\n$navbar-default-brand-hover-color: color.adjust(\n    $navbar-default-brand-color,\n    $lightness: -10%\n) !default;\n$navbar-default-brand-hover-bg: transparent !default;\n\n// Navbar toggle\n$navbar-default-toggle-hover-bg: color.adjust(white, $lightness: -5%) !default;\n$navbar-default-toggle-icon-bar-bg: $text-color !default;\n$navbar-default-toggle-border-color: transparent !default;\n\n//=== Inverted navbar\n// Reset inverted navbar basics\n$navbar-inverse-color: $brand-gray-color !default;\n$navbar-inverse-bg: white !default;\n$navbar-inverse-border: $brand-border-color !default;\n\n// Inverted navbar links\n$navbar-inverse-link-color: $brand-gray-color !default;\n$navbar-inverse-link-hover-color: $text-color;\n$navbar-inverse-link-hover-bg: transparent !default;\n$navbar-inverse-link-active-color: $navbar-inverse-link-hover-color !default;\n$navbar-inverse-link-active-bg: color.adjust($navbar-inverse-bg, $lightness: -10%) !default;\n$navbar-inverse-link-disabled-color: #444 !default;\n$navbar-inverse-link-disabled-bg: transparent !default;\n\n// Inverted navbar brand label\n$navbar-inverse-brand-color: $navbar-inverse-link-color !default;\n$navbar-inverse-brand-hover-color: #fff !default;\n$navbar-inverse-brand-hover-bg: transparent !default;\n\n// Inverted navbar toggle\n$navbar-inverse-toggle-hover-bg: color.adjust(white, $lightness: -10%) !default;\n$navbar-inverse-toggle-icon-bar-bg: $gray !default;\n$navbar-inverse-toggle-border-color: $gray !default;\n\n//== Navs\n//\n//##\n\n//=== Shared nav styles\n$nav-link-padding: 12px 15px !default;\n$nav-link-hover-bg: transparent !default;\n\n$nav-disabled-link-color: $gray-light !default;\n$nav-disabled-link-hover-color: transparent !default;\n\n//== Tabs\n$nav-tabs-border-color: #ddd !default;\n\n$nav-tabs-link-hover-border-color: $gray-lighter !default;\n\n$nav-tabs-active-link-hover-bg: $body-bg !default;\n$nav-tabs-active-link-hover-color: $gray !default;\n$nav-tabs-active-link-hover-border-color: #ddd !default;\n\n$nav-tabs-justified-link-border-color: #ddd !default;\n$nav-tabs-justified-active-link-border-color: $body-bg !default;\n\n//== Pills\n$nav-pills-border-radius: $border-radius-base !default;\n$nav-pills-active-link-hover-bg: transparent !default;\n$nav-pills-active-link-hover-color: $brand-primary !default;\n\n//== Pagination\n//\n//##\n\n$pagination-color: $link-color !default;\n$pagination-bg: #fff !default;\n$pagination-border: #ddd !default;\n\n$pagination-hover-color: $link-hover-color !default;\n$pagination-hover-bg: $gray-lighter !default;\n$pagination-hover-border: #ddd !default;\n\n$pagination-active-color: #fff !default;\n$pagination-active-bg: $brand-primary !default;\n$pagination-active-border: $brand-primary !default;\n\n$pagination-disabled-color: $gray-light !default;\n$pagination-disabled-bg: #fff !default;\n$pagination-disabled-border: #ddd !default;\n\n//== Pager\n//\n//##\n\n$pager-bg: $pagination-bg !default;\n$pager-border: $pagination-border !default;\n$pager-border-radius: 15px !default;\n\n$pager-hover-bg: $pagination-hover-bg !default;\n\n$pager-active-bg: $pagination-active-bg !default;\n$pager-active-color: $pagination-active-color !default;\n\n$pager-disabled-color: $pagination-disabled-color !default;\n\n//== Jumbotron\n//\n//##\n\n$jumbotron-padding: 30px !default;\n$jumbotron-color: inherit !default;\n$jumbotron-bg: $gray-lighter !default;\n$jumbotron-heading-color: inherit !default;\n$jumbotron-font-size: math.ceil(($font-size-base * 1.5)) !default;\n$jumbotron-heading-font-size: math.ceil(($font-size-base * 4.5)) !default;\n\n//== Form states and alerts\n//\n//## Define colors for form feedback states and, by default, alerts.\n\n$state-success-text: #00c091 !default;\n$state-success-bg: #caf3e9 !default;\n$state-success-border: color.adjust(\n    color.adjust($state-success-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n$state-info-text: #31708f !default;\n$state-info-bg: #d9edf7 !default;\n$state-info-border: color.adjust(color.adjust($state-info-bg, $hue: -10), $lightness: -7%) !default;\n\n$state-warning-text: $brand-warning !default;\n$state-warning-bg: #fcf8e3 !default;\n$state-warning-border: color.adjust(\n    color.adjust($state-warning-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n$state-danger-text: $brand-danger !default;\n$state-danger-bg: #ffcbd6 !default;\n$state-danger-border: color.adjust(\n    color.adjust($state-danger-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n//== Tooltips\n//\n//##\n\n//** Tooltip max width\n$tooltip-max-width: 300px !default;\n//** Tooltip text color\n$tooltip-color: #fff !default;\n//** Tooltip background color\n$tooltip-bg: $gray-dark !default;\n$tooltip-opacity: 0.9 !default;\n\n//** Tooltip arrow width\n$tooltip-arrow-width: 5px !default;\n//** Tooltip arrow color\n$tooltip-arrow-color: $tooltip-bg !default;\n\n//== Popovers\n//\n//##\n\n//** Popover body background color\n$popover-bg: #fff !default;\n//** Popover maximum width\n$popover-max-width: 276px !default;\n//** Popover border color\n$popover-border-color: rgba(0, 0, 0, 0.2) !default;\n//** Popover fallback border color\n$popover-fallback-border-color: #ccc !default;\n\n//** Popover title background color\n$popover-title-bg: color.adjust($popover-bg, $lightness: -3%) !default;\n\n//** Popover arrow width\n$popover-arrow-width: 10px !default;\n//** Popover arrow color\n$popover-arrow-color: $popover-bg !default;\n\n//** Popover outer arrow width\n$popover-arrow-outer-width: ($popover-arrow-width + 1) !default;\n//** Popover outer arrow color\n$popover-arrow-outer-color: color.adjust($popover-border-color, $alpha: 0.05) !default;\n//** Popover outer arrow fallback color\n$popover-arrow-outer-fallback-color: color.adjust(\n    $popover-fallback-border-color,\n    $lightness: -20%\n) !default;\n\n//== Labels\n//\n//##\n\n//** Default label background color\n$label-default-bg: $gray-light !default;\n//** Primary label background color\n$label-primary-bg: $brand-primary !default;\n//** Success label background color\n$label-success-bg: $brand-success !default;\n//** Info label background color\n$label-info-bg: $brand-info !default;\n//** Warning label background color\n$label-warning-bg: $brand-warning !default;\n//** Danger label background color\n$label-danger-bg: $brand-danger !default;\n\n//** Default label text color\n$label-color: #fff !default;\n//** Default text color of a linked label\n$label-link-hover-color: #fff !default;\n$label-gray: #60696c;\n\n//== Modals\n//\n//##\n\n//** Padding applied to the modal body\n$modal-inner-padding: 35px 40px !default;\n\n//** Padding applied to the modal title\n$modal-title-padding: 35px 40px 35px 40px !default;\n//** Modal title line-height\n$modal-title-line-height: $line-height-base !default;\n\n//** Background color of modal content area\n$modal-content-bg: #fff !default;\n//** Modal content border color\n$modal-content-border-color: rgba(255, 255, 255, 0) !default;\n//** Modal content border color **for IE8**\n$modal-content-fallback-border-color: #999 !default;\n\n//** Modal backdrop background color\n$modal-backdrop-bg: #00bf93 !default;\n//** Modal backdrop opacity\n$modal-backdrop-opacity: 0.5 !default;\n//** Modal header border color\n$modal-header-border-color: #e6e6e6 !default;\n//** Modal footer border color\n$modal-footer-border-color: $modal-header-border-color !default;\n\n$modal-lg: 820px !default;\n$modal-md: 630px !default;\n$modal-sm: 420px !default;\n\n//== Alerts\n//\n//## Define alert colors, border radius, and padding.\n\n$alert-padding: 8px 15px !default;\n$alert-border-radius: 45px !default;\n$alert-link-font-weight: bold !default;\n\n$alert-success-bg: $state-success-bg !default;\n$alert-success-text: $state-success-text !default;\n$alert-success-border: #fff !default;\n\n$alert-info-bg: $state-info-bg !default;\n$alert-info-text: $state-info-text !default;\n$alert-info-border: #fff !default;\n\n$alert-warning-bg: $state-warning-bg !default;\n$alert-warning-text: $state-warning-text !default;\n$alert-warning-border: #fff !default;\n\n$alert-danger-bg: $state-danger-bg !default;\n$alert-danger-text: $state-danger-text !default;\n$alert-danger-border: #fff !default;\n\n//== Progress bars\n//\n//##\n\n//** Background color of the whole progress component\n$progress-bg: #e6e6e6 !default;\n//** Progress bar text color\n$progress-bar-color: #fff !default;\n//** Variable for setting rounded corners on progress bar.\n$progress-border-radius: 12px !default;\n\n//** Default progress bar color\n$progress-bar-bg: $brand-primary !default;\n//** Success progress bar color\n$progress-bar-success-bg: $brand-success !default;\n//** Warning progress bar color\n$progress-bar-warning-bg: $brand-warning !default;\n//** Danger progress bar color\n$progress-bar-danger-bg: $brand-danger !default;\n//** Info progress bar color\n$progress-bar-info-bg: $brand-info !default;\n\n//== List group\n//\n//##\n\n//** Background color on `.list-group-item`\n$list-group-bg: #fff !default;\n//** `.list-group-item` border color\n$list-group-border: #ddd !default;\n//** List group border radius\n$list-group-border-radius: $border-radius-base !default;\n\n//** Background color of single list items on hover\n$list-group-hover-bg: #f5f5f5 !default;\n//** Text color of active list items\n$list-group-active-color: $component-active-color !default;\n//** Background color of active list items\n$list-group-active-bg: $component-active-bg !default;\n//** Border color of active list elements\n$list-group-active-border: $list-group-active-bg !default;\n//** Text color for content within active list items\n$list-group-active-text-color: color.adjust($list-group-active-bg, $lightness: 40%) !default;\n\n//** Text color of disabled list items\n$list-group-disabled-color: $gray-light !default;\n//** Background color of disabled list items\n$list-group-disabled-bg: $gray-lighter !default;\n//** Text color for content within disabled list items\n$list-group-disabled-text-color: $list-group-disabled-color !default;\n\n$list-group-link-color: #555 !default;\n$list-group-link-hover-color: $list-group-link-color !default;\n$list-group-link-heading-color: #333 !default;\n\n//== Panels\n//\n//##\n\n$panel-bg: #fff !default;\n$panel-body-padding: 15px !default;\n$panel-heading-padding: 10px 15px !default;\n$panel-footer-padding: $panel-heading-padding !default;\n$panel-border-radius: $border-radius-base !default;\n\n//** Border color for elements within panels\n$panel-inner-border: #ddd !default;\n$panel-footer-bg: #f5f5f5 !default;\n\n$panel-default-text: $gray-dark !default;\n$panel-default-border: #ddd !default;\n$panel-default-heading-bg: #f5f5f5 !default;\n\n$panel-primary-text: #fff !default;\n$panel-primary-border: $brand-primary !default;\n$panel-primary-heading-bg: $brand-primary !default;\n\n$panel-success-text: $state-success-text !default;\n$panel-success-border: $state-success-border !default;\n$panel-success-heading-bg: $state-success-bg !default;\n\n$panel-info-text: $state-info-text !default;\n$panel-info-border: $state-info-border !default;\n$panel-info-heading-bg: $state-info-bg !default;\n\n$panel-warning-text: $state-warning-text !default;\n$panel-warning-border: $state-warning-border !default;\n$panel-warning-heading-bg: $state-warning-bg !default;\n\n$panel-danger-text: $state-danger-text !default;\n$panel-danger-border: $state-danger-border !default;\n$panel-danger-heading-bg: $state-danger-bg !default;\n\n//== Thumbnails\n//\n//##\n\n//** Padding around the thumbnail image\n$thumbnail-padding: 4px !default;\n//** Thumbnail background color\n$thumbnail-bg: $body-bg !default;\n//** Thumbnail border color\n$thumbnail-border: #ddd !default;\n//** Thumbnail border radius\n$thumbnail-border-radius: $border-radius-base !default;\n\n//** Custom text color for thumbnail captions\n$thumbnail-caption-color: $text-color !default;\n//** Padding around the thumbnail caption\n$thumbnail-caption-padding: 9px !default;\n\n//== Wells\n//\n//##\n\n$well-bg: #f5f5f5 !default;\n$well-border: color.adjust($well-bg, $lightness: -7%) !default;\n\n//== Badges\n//\n//##\n\n$badge-color: #fff !default;\n//** Linked badge text color on hover\n$badge-link-hover-color: #fff !default;\n$badge-bg: $gray-light !default;\n\n//** Badge text color in active nav link\n$badge-active-color: $link-color !default;\n//** Badge background color in active nav link\n$badge-active-bg: #fff !default;\n\n$badge-font-weight: bold !default;\n$badge-line-height: 1 !default;\n$badge-border-radius: 35px !default;\n\n//== Breadcrumbs\n//\n//##\n\n$breadcrumb-padding-vertical: 8px !default;\n$breadcrumb-padding-horizontal: 15px !default;\n//** Breadcrumb background color\n$breadcrumb-bg: #f5f5f5 !default;\n//** Breadcrumb text color\n$breadcrumb-color: #ccc !default;\n//** Text color of current page in the breadcrumb\n$breadcrumb-active-color: $gray-light !default;\n//** Textual separator for between breadcrumb elements\n$breadcrumb-separator: "/" !default;\n\n//== Carousel\n//\n//##\n\n$carousel-text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6) !default;\n\n$carousel-control-color: #fff !default;\n$carousel-control-width: 15% !default;\n$carousel-control-opacity: 0.5 !default;\n$carousel-control-font-size: 20px !default;\n\n$carousel-indicator-active-bg: #fff !default;\n$carousel-indicator-border-color: #fff !default;\n\n$carousel-caption-color: #fff !default;\n\n//== Close\n//\n//##\n\n$close-font-weight: bold !default;\n$close-color: #000 !default;\n$close-text-shadow: 0 1px 0 #fff !default;\n\n//== Code\n//\n//##\n\n$code-color: #c7254e !default;\n$code-bg: #f9f2f4 !default;\n\n$kbd-color: #fff !default;\n$kbd-bg: #333 !default;\n\n$pre-bg: #f5f5f5 !default;\n$pre-color: $gray-dark !default;\n$pre-border-color: #ccc !default;\n$pre-scrollable-max-height: 340px !default;\n\n//== Type\n//\n//##\n\n//** Horizontal offset for forms and lists.\n$component-offset-horizontal: 180px !default;\n//** Text muted color\n$text-muted: $gray-lighter !default;\n//** Abbreviations and acronyms border color\n$abbr-border-color: $gray-light !default;\n//** Headings small color\n$headings-small-color: $gray-light !default;\n//** Blockquote small color\n$blockquote-small-color: $gray-light !default;\n//** Blockquote font size\n$blockquote-font-size: ($font-size-base * 1.25) !default;\n//** Blockquote border color\n$blockquote-border-color: $gray-lighter !default;\n//** Page header border color\n$page-header-border-color: $gray-lighter !default;\n//** Horizontal line color.\n$hr-border: $gray-1-50 !default;\n'],sourceRoot:""}]),l.locals={iconContainer:"CustomItemCondensed-module_iconContainer__m0R9P",icon:"CustomItemCondensed-module_icon__xTz9O",title:"CustomItemCondensed-module_title__Hx8HA",description:"CustomItemCondensed-module_description__JI8zn",formatBullets:"CustomItemCondensed-module_formatBullets__AIdnJ",fontSize11:"CustomItemCondensed-module_fontSize11__z_9N5",iconStyle:"CustomItemCondensed-module_iconStyle__ip2_g"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/packages/Resume/ItemTypes/Custom/CustomItemDefault.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,'.CustomItemDefault-module_icon__qsB30{width:30px;text-align:center;line-height:15px;position:relative;margin-right:10px;margin-bottom:-7px;flex:0 0 auto;cursor:pointer}.CustomItemDefault-module_title__Ui_P8{font-weight:700}.CustomItemDefault-module_description__by4zK{color:#3e3e3e}.CustomItemDefault-module_formatBullets__URrkE ul{list-style:none;padding-left:16px}.CustomItemDefault-module_formatBullets__URrkE ul li::before{content:"•";position:absolute;vertical-align:middle;left:4px}.CustomItemDefault-module_fontSize11__jonGz{font-size:11px;line-height:13px}.CustomItemDefault-module_iconStyle__dCJ5t{font-size:12px;margin-right:5px;color:#555;flex:0 0 auto;height:14px}.CustomItemDefault-module_rowDate__DjYfp{margin-left:10px}.CustomItemDefault-module_customItemIcon__aETwC{text-align:center;line-height:15px;position:relative;margin-right:10px;margin-bottom:-6px;flex:0 0 auto;padding-bottom:3px}.CustomItemDefault-module_customItemIcon__aETwC i{font-size:25px}.CustomItemDefault-module_customItemIcon__aETwC.CustomItemDefault-module_editable__TXBiu div{cursor:pointer}.CustomItemDefault-module_customItemContent__d1str{display:grid;grid-template-columns:max-content auto max-content}.CustomItemDefault-module_customItemTitle__gAJ8T{font-size:15px;color:#3e3e3e;font-weight:700;position:relative;top:2px;padding-bottom:3px}.CustomItemDefault-module_customItemDescription__JjBzo{padding-top:2px;font-size:13px;color:#3e3e3e}.CustomItemDefault-module_customItemIconCondensed__ezfig{width:22px;line-height:11px;padding:4px 4px 4px 0;margin-bottom:0;margin-right:5px}.CustomItemDefault-module_customItemIconCondensed__ezfig i{font-size:16px}.CustomItemDefault-module_customItemTitleCondensed__kCxaE{font-size:14px;font-weight:400;top:0}.CustomItemDefault-module_customItemDescriptionCondensed__Ll9Dq{color:#65696d}.CustomItemDefault-module_customItemTitleClassic__xTKTl{padding-bottom:1px}.CustomItemDefault-module_customItemTitleElegant__dI9wv{font-weight:400}',"",{version:3,sources:["webpack://./src/packages/Resume/ItemTypes/Custom/CustomItemDefault.module.scss","webpack://./node_modules/sharedstyle/_variables.scss"],names:[],mappings:"AAAA,sCAEA,UACI,CAAA,iBACA,CAAA,gBACA,CAAA,iBACA,CAAA,iBACA,CAAA,kBACA,CAAA,aACA,CAAA,cACA,CAAA,uCAGJ,eACI,CAAA,6CAGJ,aCEoB,CAAA,kDDGhB,eACI,CAAA,iBACA,CAAA,6DAGI,WACI,CAAA,iBACA,CAAA,qBACA,CAAA,QACA,CAAA,4CAMhB,cACI,CAAA,gBACA,CAAA,2CAGJ,cACI,CAAA,gBACA,CAAA,UCvBG,CAAA,aDyBH,CAAA,WACA,CAAA,yCAGJ,gBACI,CAAA,gDAGJ,iBACI,CAAA,gBACA,CAAA,iBACA,CAAA,iBACA,CAAA,kBACA,CAAA,aACA,CAAA,kBACA,CAAA,kDAEA,cACI,CAAA,6FAIA,cACI,CAAA,mDAKZ,YACI,CAAA,kDACA,CAAA,iDAGJ,cACI,CAAA,aC7DgB,CAAA,eD+DhB,CAAA,iBACA,CAAA,OACA,CAAA,kBACA,CAAA,uDAGJ,eACI,CAAA,cACA,CAAA,aCvEgB,CAAA,yDD4EhB,UACA,CAAA,gBACA,CAAA,qBACA,CAAA,eACA,CAAA,gBACA,CAAA,2DAEA,cACI,CAAA,0DAKJ,cACA,CAAA,eACA,CAAA,KACA,CAAA,gEAIA,aCtCe,CAAA,wDD2Cf,kBACA,CAAA,wDAIA,eACA",sourcesContent:['@import "~sharedstyle/variables";\n\n.icon {\n    width: 30px;\n    text-align: center;\n    line-height: 15px;\n    position: relative;\n    margin-right: 10px;\n    margin-bottom: -7px;\n    flex: 0 0 auto;\n    cursor: pointer;\n}\n\n.title {\n    font-weight: 700;\n}\n\n.description {\n    color: $resume-body-color;\n}\n\n.formatBullets {\n    ul {\n        list-style: none;\n        padding-left: 16px;\n\n        li {\n            &::before {\n                content: "•";\n                position: absolute;\n                vertical-align: middle;\n                left: 4px;\n            }\n        }\n    }\n}\n\n.fontSize11 {\n    font-size: 11px;\n    line-height: 13px;\n}\n\n.iconStyle {\n    font-size: 12px;\n    margin-right: 5px;\n    color: $gray;\n    flex: 0 0 auto;\n    height: 14px;\n}\n\n.rowDate {\n    margin-left: 10px;\n}\n\n.customItemIcon {\n    text-align: center;\n    line-height: 15px;\n    position: relative;\n    margin-right: 10px;\n    margin-bottom: -6px;\n    flex: 0 0 auto;\n    padding-bottom: 3px;\n\n    i {\n        font-size: 25px;\n    }\n\n    &.editable {\n        div {\n            cursor: pointer;\n        }\n    }\n}\n\n.customItemContent {\n    display: grid;\n    grid-template-columns: max-content auto max-content;\n}\n\n.customItemTitle {\n    font-size: 15px;\n    color: $resume-body-color;\n    font-weight: 700;\n    position: relative;\n    top: 2px;\n    padding-bottom: 3px;\n}\n\n.customItemDescription {\n    padding-top: 2px;\n    font-size: 13px;\n    color: $resume-body-color;\n}\n\n.customItemIconCondensed {\n    composes: customItemIcon;\n    width: 22px;\n    line-height: 11px;\n    padding: 4px 4px 4px 0;\n    margin-bottom: 0;\n    margin-right: 5px;\n\n    i {\n        font-size: $op-base-offset * 2;\n    }\n}\n\n.customItemTitleCondensed {\n    composes: customItemTitle;\n    font-size: 14px;\n    font-weight: 400;\n    top: 0;\n}\n\n.customItemDescriptionCondensed {\n    composes: customItemDescription;\n    color: $brand-gray-color;\n}\n\n.customItemTitleClassic {\n    composes: customItemTitle;\n    padding-bottom: 1px;\n}\n\n.customItemTitleElegant {\n    composes: customItemTitle;\n    font-weight: 400;\n}\n','@use "sass:color";\n@use "sass:math";\n//\n// Variables\n// --------------------------------------------------\n\n//== Colors\n//\n//## Gray and brand colors for use across Bootstrap.\n\n$shadow-4: 0 0 12px -3px rgba(0, 0, 0, 0.3);\n$shadow-5: 0 0 4px 0px rgba(0, 0, 0, 0.3);\n\n$shadow-1: 0 0 4px 0 rgba(160, 162, 167, 0.15);\n$shadow-2: 0 0 2px 0 rgba(77, 77, 77, 0.16);\n$shadow-3: 0 0 2px 0 rgba(83, 83, 83, 0.5);\n\n$gray-base: #000 !default;\n$gray-dark: #384347 !default;\n$resume-body-color: #3e3e3e !default; // specific body color for the resumes - without blue color included\n$gray-dark-2: #222 !default;\n$gray: color.adjust($gray-base, $lightness: 33.5%) !default; // #555\n$gray-light: color.adjust($gray-base, $lightness: 46.7%) !default; // #777\n$gray-lighter: color.adjust($gray-base, $lightness: 80%) !default; // #ccc\n$green-light: #eaf8f3;\n\n$gray-1: #b2b4b6;\n$gray-1-20: rgba($gray-1, 0.2);\n$gray-1-50: rgba($gray-1, 0.5);\n$gray-2: #65696d;\n$gray-2-20: rgba($gray-2, 0.2);\n$gray-2-50: rgba($gray-2, 0.5);\n$gray-3: #384347;\n$gray-3-20: rgba($gray-3, 0.2);\n$gray-3-50: rgba($gray-3, 0.5);\n\n$green-3: #2dc08d;\n$green-2: #62d0aa;\n$green-1: #d5f2e8;\n$green-hover: #249a71;\n\n$purple-3: #8c7cdb;\n$purple-2: #c5bded;\n$purple-1: #e8e5f8;\n\n$red-3: #ff576f;\n$red-2: #ffabb7;\n$red-1: #ffeef0;\n\n$blue-3: #7aaacb;\n$blue-2: #b5d6ec;\n$blue-1: #e2eff8;\n$blue-background: #f3f5fa;\n\n$yellow-3: #feb251;\n$yellow-2: #fed8a7;\n$yellow-1: #fff0dc;\n\n$background: #fafbfd;\n$brand-primary: #00c091;\n$brand-promo: #e7762e;\n$brand-success: #2dc08c !default;\n$brand-info: #5bc0de !default;\n$brand-warning: #f2994a !default;\n$brand-danger: #ff576f !default;\n$brand-border-color: #e6e6e6 !default;\n$brand-grey-background: #f2f2f2;\n$color-facebook: #3b5998;\n$color-twitter: #5eaade;\n$color-gplus: #dd4b39;\n$color-instagram: #333333;\n$color-linkedin: #2578b5;\n$color-messenger-first: rgb(1, 183, 255);\n$color-messenger-second: rgb(0, 126, 254);\n$color-messenger-border: #ffffff;\n$color-onboarding: #009ee8;\n$purple-color: #8c7cdb;\n$brand-gray-color: #65696d;\n$brand-info-font-color: #b2b4b6;\n$toolbox-border: rgba(223, 223, 223, 0.52);\n$selected-item-border-color: #60d5ba;\n\n$white: white;\n\n$op-background-color: #333333;\n$op-nav-control-color: #464646;\n$op-control-color: $gray-dark;\n$op-light-color: #e6e6e6;\n$op-control-primary-color: $brand-success;\n$op-notification-bg-primary: #ccf5e9;\n$op-notification-bg-danger: #ffc7d4;\n$op-notification-bg-warning: #ffe2ca;\n\n$op-base-offset: 8px !default;\n$op-btn-padding-horizontal: 14px;\n\n//Resume Styles\n$resume-rounding: 5px;\n\n//== Scaffolding\n//\n//## Settings for some of the most global styles.\n\n//** Background color for `<body>`.\n$body-bg: #fff !default;\n//** Global text color on `<body>`.\n$text-color: $gray-dark !default;\n\n$text-color-hover: color.adjust($text-color, $lightness: 30%) !default;\n\n//** Global textual link color.\n$link-color: white !default;\n//** Link hover color set via `darken()` function.\n$link-hover-color: color.adjust(white, $lightness: -10%);\n//** Link hover decoration.\n$link-hover-decoration: none !default;\n\n//== Typography\n//\n//## Font, line-height, and color for body text, headings, and more.\n\n$font-family-sans-serif: "Roboto", Arial, Helvetica, "Noto Sans Devanagari", "Noto Sans CJK SC Thin",\n    "Noto Sans SC", "Noto Sans Hebrew", "Noto Sans Bengali", sans-serif !default;\n$font-family-serif: Georgia, "Times New Roman", Times, "Noto Sans Devanagari",\n    "Noto Sans CJK SC Thin", "Noto Sans SC", "Noto Sans Hebrew", "Noto Sans Bengali", serif !default;\n//** Default monospace fonts for `<code>`, `<kbd>`, and `<pre>`.\n$font-family-monospace: Menlo, Monaco, Consolas, "Courier New", monospace !default;\n$font-family-base: "Inter" !default;\n\n$roboto: "Roboto", Arial, Helvetica, sans-serif;\n$opensans: "Open Sans", Arial, Helvetica, sans-serif;\n$account-heading-font: "Rubik", sans-serif !important;\n\n$font-size-base: 14px !default;\n$font-size-large: 18px !default;\n$font-size-small: 11px !default;\n\n$font-size-h1: 68px !default; // ~36px\n$font-size-h2: 38px !default; // ~30px\n$font-size-h3: 32px !default; // ~24px\n$font-size-h4: 26px !default; // ~18px\n$font-size-h5: 22px !default;\n$font-size-h6: 20px !default; // ~12px\n\n//** Unit-less `line-height` for use in components like buttons.\n$line-height-base: 1.428571429 !default; // 20/14\n//** Computed "line-height" (`font-size` * `line-height`) for use with `margin`, `padding`, etc.\n$line-height-computed: math.floor(($font-size-base * $line-height-base)) !default; // ~20px\n\n//** By default, this inherits from the `<body>`.\n$headings-font-family: "Rubik", sans-serif !default;\n$headings-font-weight: 300 !default;\n$headings-line-height: 1.1 !default;\n$headings-color: $gray-dark !default;\n\n//== Components\n//\n//## Define common padding and border radius sizes and more. Values based on 14px text and 1.428 line-height (~20px to start).\n\n$padding-base-vertical: 9px !default;\n$padding-base-horizontal: 14px !default;\n\n$padding-large-vertical: 12px !default;\n$padding-large-horizontal: 24px !default;\n\n$padding-small-vertical: 5px !default;\n$padding-small-horizontal: 18px !default;\n\n$padding-xs-vertical: 1px !default;\n$padding-xs-horizontal: 12px !default;\n\n$line-height-large: 1.3333333 !default; // extra decimals for Win 8.1 Chrome\n$line-height-small: 1.5 !default;\n\n$border-radius-base: 5px !default;\n$border-radius-large: 9px !default;\n$border-radius-small: 4px !default;\n\n//** Global color for active items (e.g., navs or dropdowns).\n$component-active-color: #fff !default;\n//** Global background color for active items (e.g., navs or dropdowns).\n$component-active-bg: $brand-primary !default;\n\n//** Width of the `border` for generating carets that indicator dropdowns.\n$caret-width-base: 4px !default;\n//** Carets increase slightly in size for larger components.\n$caret-width-large: 5px !default;\n\n//== Tables\n//\n//## Customizes the `.table` component with basic values, each used across all table variations.\n\n//** Padding for `<th>`s and `<td>`s.\n$table-cell-padding: 8px !default;\n//** Padding for cells in `.table-condensed`.\n$table-condensed-cell-padding: 5px !default;\n\n//** Default background color used for all tables.\n$table-bg: transparent !default;\n//** Background color used for `.table-striped`.\n$table-bg-accent: #f9f9f9 !default;\n//** Background color used for `.table-hover`.\n$table-bg-hover: #f5f5f5 !default;\n$table-bg-active: $table-bg-hover !default;\n\n//** Border color for table and cell borders.\n$table-border-color: #ddd !default;\n\n//== Buttons\n//\n//## For each of Bootstrap\'s buttons, define text, background and border color.\n\n$btn-font-weight: bold !default;\n\n$btn-default-color: #8c7cdb !default;\n$btn-default-bg: #fff !default;\n$btn-default-border: #8c7cdb !default;\n\n$btn-primary-color: #fff !default;\n$btn-primary-bg: $brand-primary !default;\n$btn-primary-border: $brand-primary !default;\n\n$btn-success-color: #fff !default;\n$btn-success-bg: $brand-success !default;\n$btn-success-border: color.adjust($btn-success-bg, $lightness: -5%) !default;\n\n$btn-info-color: #fff !default;\n$btn-info-bg: $brand-info !default;\n$btn-info-border: color.adjust($btn-info-bg, $lightness: -5%) !default;\n\n$btn-warning-color: #fff !default;\n$btn-warning-bg: $brand-warning !default;\n$btn-warning-border: color.adjust($btn-warning-bg, $lightness: -5%) !default;\n\n$btn-danger-color: #fff !default;\n$btn-danger-bg: $brand-danger !default;\n$btn-danger-border: color.adjust($btn-danger-bg, $lightness: -5%) !default;\n\n$btn-link-disabled-color: $gray-light !default;\n\n// Allows for customizing button radius independently from global border radius\n$btn-border-radius-base: $border-radius-base;\n$btn-border-radius-large: $border-radius-base;\n$btn-border-radius-small: $border-radius-base;\n\n//== Forms\n//\n//##\n\n//** `<input>` background color\n$input-bg: #fff !default;\n//** `<input disabled>` background color\n$input-bg-disabled: $gray-lighter !default;\n\n//** Text color for `<input>`s\n$input-color: $gray !default;\n//** `<input>` border color\n$input-border: #b3b3b3 !default;\n\n// TODO: Rename `$input-border-radius` to `$input-border-radius-base` in v4\n//** Default `.form-control` border radius\n// This has no effect on `<select>`s in some browsers, due to the limited stylability of `<select>`s in CSS.\n$input-border-radius: $border-radius-base;\n//** Large `.form-control` border radius\n$input-border-radius-large: $border-radius-base;\n//** Small `.form-control` border radius\n$input-border-radius-small: $border-radius-base;\n\n//** Border color for inputs on focus\n$input-border-focus: $brand-primary !default;\n\n//** Placeholder text color\n$input-color-placeholder: color.adjust($gray-base, $lightness: 70%) !default;\n\n//** Default `.form-control` height\n$input-height-base: ($line-height-computed + ($padding-base-vertical * 2) + 2) !default;\n//** Large `.form-control` height\n$input-height-large: (\n    math.ceil($font-size-large * $line-height-large) + ($padding-large-vertical * 2) + 2\n) !default;\n//** Small `.form-control` height\n$input-height-small: (\n    math.floor($font-size-small * $line-height-small) + ($padding-small-vertical * 2) + 2\n) !default;\n\n//** `.form-group` margin\n$form-group-margin-bottom: 15px !default;\n\n$legend-color: $gray-dark !default;\n$legend-border-color: #e5e5e5 !default;\n\n//** Background color for textual input addons\n$input-group-addon-bg: $gray-lighter !default;\n//** Border color for textual input addons\n$input-group-addon-border-color: $input-border !default;\n\n//** Disabled cursor for form controls and buttons.\n$cursor-disabled: not-allowed !default;\n\n//== Dropdowns\n//\n//## Dropdown menu container and contents.\n\n//** Background for the dropdown menu.\n$dropdown-bg: #fff !default;\n//** Dropdown menu `border-color`.\n$dropdown-border: rgba(0, 0, 0, 0.15) !default;\n//** Dropdown menu `border-color` **for IE8**.\n$dropdown-fallback-border: #ccc !default;\n//** Divider color for between dropdown items.\n$dropdown-divider-bg: #e5e5e5 !default;\n\n//** Dropdown link text color.\n$dropdown-link-color: $gray-dark !default;\n//** Hover color for dropdown links.\n$dropdown-link-hover-color: color.adjust($gray-dark, $lightness: 50%) !default;\n//** Hover background for dropdown links.\n$dropdown-link-hover-bg: transparent !default;\n\n//** Active dropdown menu item text color.\n$dropdown-link-active-color: $component-active-color !default;\n//** Active dropdown menu item background color.\n$dropdown-link-active-bg: $component-active-bg !default;\n\n//** Disabled dropdown menu item background color.\n$dropdown-link-disabled-color: $gray-light !default;\n\n//** Text color for headers within dropdown menus.\n$dropdown-header-color: $gray-light !default;\n\n//** Deprecated `$dropdown-caret-color` as of v3.1.0\n$dropdown-caret-color: #000 !default;\n\n//-- Z-index master list\n//\n// Warning: Avoid customizing these values. They\'re used for a bird\'s eye view\n// of components dependent on the z-axis and are designed to all work together.\n//\n// Note: These variables are not generated into the Customizer.\n\n$zindex-navbar: 1000 !default;\n$zindex-dropdown: 1000 !default;\n$zindex-mobile-design-menu: 1001 !default;\n$zindex-modal-background: 1002 !default; // from style guide --\x3e\n$zindex-modal-content: 1003 !default; // <--\n$zindex-full-screen-dropdown: 1004 !default;\n$zindex-popover: 1020 !default;\n$zindex-tooltip: 1050 !default;\n$zindex-navbar-fixed: 1030 !default;\n$zindex-toaster: 1030 !default;\n$zindex-alert: 1060 !default;\n$zindex-op-currdoing-cirle: 100 !default;\n$zindex-op-section-controls: 1 !default;\n$zindex-toasters: 8000 !default;\n\n//== Media queries breakpoints\n//\n//## Define the breakpoints at which your layout will change, adapting to different screen sizes.\n\n//== Grid system\n//\n//## Define your custom responsive grid.\n\n//** Number of columns in the grid.\n$grid-columns: 12 !default;\n//** Padding between columns. Gets divided in half for the left and right.\n$grid-gutter-width: 20px !default;\n\n//== Navbar OP\n//\n//##\n$op-navbar-height: 64px !default;\n$op-navbar-padding: 2 * $op-base-offset !default;\n\n//== Navbar\n//\n//##\n\n// Basics of a navbar\n$navbar-height: 60px !default;\n$navbar-padding: 16px !default;\n$navbar-margin-bottom: 0 !default;\n$navbar-border-radius: 0 !default;\n$navbar-padding-horizontal: math.floor(($grid-gutter-width * 0.5)) !default;\n$navbar-padding-vertical: (($navbar-height - $line-height-computed) * 0.5) !default;\n$navbar-collapse-max-height: 340px !default;\n\n$navbar-default-color: $text-color !default;\n$navbar-default-bg: white !default;\n$navbar-default-border: transparent !default;\n\n// Navbar links\n$navbar-default-link-color: $text-color !default;\n$navbar-default-link-hover-color: $purple-color !default;\n$navbar-default-link-hover-bg: transparent !default;\n$navbar-default-link-active-color: #b2b4b6 !default;\n$navbar-default-link-active-bg: color.adjust($navbar-default-bg, $lightness: -6.5%) !default;\n$navbar-default-link-disabled-color: #ccc !default;\n$navbar-default-link-disabled-bg: transparent !default;\n\n// Navbar brand label\n$navbar-default-brand-color: #e6e6e6 !default;\n$navbar-default-brand-hover-color: color.adjust(\n    $navbar-default-brand-color,\n    $lightness: -10%\n) !default;\n$navbar-default-brand-hover-bg: transparent !default;\n\n// Navbar toggle\n$navbar-default-toggle-hover-bg: color.adjust(white, $lightness: -5%) !default;\n$navbar-default-toggle-icon-bar-bg: $text-color !default;\n$navbar-default-toggle-border-color: transparent !default;\n\n//=== Inverted navbar\n// Reset inverted navbar basics\n$navbar-inverse-color: $brand-gray-color !default;\n$navbar-inverse-bg: white !default;\n$navbar-inverse-border: $brand-border-color !default;\n\n// Inverted navbar links\n$navbar-inverse-link-color: $brand-gray-color !default;\n$navbar-inverse-link-hover-color: $text-color;\n$navbar-inverse-link-hover-bg: transparent !default;\n$navbar-inverse-link-active-color: $navbar-inverse-link-hover-color !default;\n$navbar-inverse-link-active-bg: color.adjust($navbar-inverse-bg, $lightness: -10%) !default;\n$navbar-inverse-link-disabled-color: #444 !default;\n$navbar-inverse-link-disabled-bg: transparent !default;\n\n// Inverted navbar brand label\n$navbar-inverse-brand-color: $navbar-inverse-link-color !default;\n$navbar-inverse-brand-hover-color: #fff !default;\n$navbar-inverse-brand-hover-bg: transparent !default;\n\n// Inverted navbar toggle\n$navbar-inverse-toggle-hover-bg: color.adjust(white, $lightness: -10%) !default;\n$navbar-inverse-toggle-icon-bar-bg: $gray !default;\n$navbar-inverse-toggle-border-color: $gray !default;\n\n//== Navs\n//\n//##\n\n//=== Shared nav styles\n$nav-link-padding: 12px 15px !default;\n$nav-link-hover-bg: transparent !default;\n\n$nav-disabled-link-color: $gray-light !default;\n$nav-disabled-link-hover-color: transparent !default;\n\n//== Tabs\n$nav-tabs-border-color: #ddd !default;\n\n$nav-tabs-link-hover-border-color: $gray-lighter !default;\n\n$nav-tabs-active-link-hover-bg: $body-bg !default;\n$nav-tabs-active-link-hover-color: $gray !default;\n$nav-tabs-active-link-hover-border-color: #ddd !default;\n\n$nav-tabs-justified-link-border-color: #ddd !default;\n$nav-tabs-justified-active-link-border-color: $body-bg !default;\n\n//== Pills\n$nav-pills-border-radius: $border-radius-base !default;\n$nav-pills-active-link-hover-bg: transparent !default;\n$nav-pills-active-link-hover-color: $brand-primary !default;\n\n//== Pagination\n//\n//##\n\n$pagination-color: $link-color !default;\n$pagination-bg: #fff !default;\n$pagination-border: #ddd !default;\n\n$pagination-hover-color: $link-hover-color !default;\n$pagination-hover-bg: $gray-lighter !default;\n$pagination-hover-border: #ddd !default;\n\n$pagination-active-color: #fff !default;\n$pagination-active-bg: $brand-primary !default;\n$pagination-active-border: $brand-primary !default;\n\n$pagination-disabled-color: $gray-light !default;\n$pagination-disabled-bg: #fff !default;\n$pagination-disabled-border: #ddd !default;\n\n//== Pager\n//\n//##\n\n$pager-bg: $pagination-bg !default;\n$pager-border: $pagination-border !default;\n$pager-border-radius: 15px !default;\n\n$pager-hover-bg: $pagination-hover-bg !default;\n\n$pager-active-bg: $pagination-active-bg !default;\n$pager-active-color: $pagination-active-color !default;\n\n$pager-disabled-color: $pagination-disabled-color !default;\n\n//== Jumbotron\n//\n//##\n\n$jumbotron-padding: 30px !default;\n$jumbotron-color: inherit !default;\n$jumbotron-bg: $gray-lighter !default;\n$jumbotron-heading-color: inherit !default;\n$jumbotron-font-size: math.ceil(($font-size-base * 1.5)) !default;\n$jumbotron-heading-font-size: math.ceil(($font-size-base * 4.5)) !default;\n\n//== Form states and alerts\n//\n//## Define colors for form feedback states and, by default, alerts.\n\n$state-success-text: #00c091 !default;\n$state-success-bg: #caf3e9 !default;\n$state-success-border: color.adjust(\n    color.adjust($state-success-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n$state-info-text: #31708f !default;\n$state-info-bg: #d9edf7 !default;\n$state-info-border: color.adjust(color.adjust($state-info-bg, $hue: -10), $lightness: -7%) !default;\n\n$state-warning-text: $brand-warning !default;\n$state-warning-bg: #fcf8e3 !default;\n$state-warning-border: color.adjust(\n    color.adjust($state-warning-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n$state-danger-text: $brand-danger !default;\n$state-danger-bg: #ffcbd6 !default;\n$state-danger-border: color.adjust(\n    color.adjust($state-danger-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n//== Tooltips\n//\n//##\n\n//** Tooltip max width\n$tooltip-max-width: 300px !default;\n//** Tooltip text color\n$tooltip-color: #fff !default;\n//** Tooltip background color\n$tooltip-bg: $gray-dark !default;\n$tooltip-opacity: 0.9 !default;\n\n//** Tooltip arrow width\n$tooltip-arrow-width: 5px !default;\n//** Tooltip arrow color\n$tooltip-arrow-color: $tooltip-bg !default;\n\n//== Popovers\n//\n//##\n\n//** Popover body background color\n$popover-bg: #fff !default;\n//** Popover maximum width\n$popover-max-width: 276px !default;\n//** Popover border color\n$popover-border-color: rgba(0, 0, 0, 0.2) !default;\n//** Popover fallback border color\n$popover-fallback-border-color: #ccc !default;\n\n//** Popover title background color\n$popover-title-bg: color.adjust($popover-bg, $lightness: -3%) !default;\n\n//** Popover arrow width\n$popover-arrow-width: 10px !default;\n//** Popover arrow color\n$popover-arrow-color: $popover-bg !default;\n\n//** Popover outer arrow width\n$popover-arrow-outer-width: ($popover-arrow-width + 1) !default;\n//** Popover outer arrow color\n$popover-arrow-outer-color: color.adjust($popover-border-color, $alpha: 0.05) !default;\n//** Popover outer arrow fallback color\n$popover-arrow-outer-fallback-color: color.adjust(\n    $popover-fallback-border-color,\n    $lightness: -20%\n) !default;\n\n//== Labels\n//\n//##\n\n//** Default label background color\n$label-default-bg: $gray-light !default;\n//** Primary label background color\n$label-primary-bg: $brand-primary !default;\n//** Success label background color\n$label-success-bg: $brand-success !default;\n//** Info label background color\n$label-info-bg: $brand-info !default;\n//** Warning label background color\n$label-warning-bg: $brand-warning !default;\n//** Danger label background color\n$label-danger-bg: $brand-danger !default;\n\n//** Default label text color\n$label-color: #fff !default;\n//** Default text color of a linked label\n$label-link-hover-color: #fff !default;\n$label-gray: #60696c;\n\n//== Modals\n//\n//##\n\n//** Padding applied to the modal body\n$modal-inner-padding: 35px 40px !default;\n\n//** Padding applied to the modal title\n$modal-title-padding: 35px 40px 35px 40px !default;\n//** Modal title line-height\n$modal-title-line-height: $line-height-base !default;\n\n//** Background color of modal content area\n$modal-content-bg: #fff !default;\n//** Modal content border color\n$modal-content-border-color: rgba(255, 255, 255, 0) !default;\n//** Modal content border color **for IE8**\n$modal-content-fallback-border-color: #999 !default;\n\n//** Modal backdrop background color\n$modal-backdrop-bg: #00bf93 !default;\n//** Modal backdrop opacity\n$modal-backdrop-opacity: 0.5 !default;\n//** Modal header border color\n$modal-header-border-color: #e6e6e6 !default;\n//** Modal footer border color\n$modal-footer-border-color: $modal-header-border-color !default;\n\n$modal-lg: 820px !default;\n$modal-md: 630px !default;\n$modal-sm: 420px !default;\n\n//== Alerts\n//\n//## Define alert colors, border radius, and padding.\n\n$alert-padding: 8px 15px !default;\n$alert-border-radius: 45px !default;\n$alert-link-font-weight: bold !default;\n\n$alert-success-bg: $state-success-bg !default;\n$alert-success-text: $state-success-text !default;\n$alert-success-border: #fff !default;\n\n$alert-info-bg: $state-info-bg !default;\n$alert-info-text: $state-info-text !default;\n$alert-info-border: #fff !default;\n\n$alert-warning-bg: $state-warning-bg !default;\n$alert-warning-text: $state-warning-text !default;\n$alert-warning-border: #fff !default;\n\n$alert-danger-bg: $state-danger-bg !default;\n$alert-danger-text: $state-danger-text !default;\n$alert-danger-border: #fff !default;\n\n//== Progress bars\n//\n//##\n\n//** Background color of the whole progress component\n$progress-bg: #e6e6e6 !default;\n//** Progress bar text color\n$progress-bar-color: #fff !default;\n//** Variable for setting rounded corners on progress bar.\n$progress-border-radius: 12px !default;\n\n//** Default progress bar color\n$progress-bar-bg: $brand-primary !default;\n//** Success progress bar color\n$progress-bar-success-bg: $brand-success !default;\n//** Warning progress bar color\n$progress-bar-warning-bg: $brand-warning !default;\n//** Danger progress bar color\n$progress-bar-danger-bg: $brand-danger !default;\n//** Info progress bar color\n$progress-bar-info-bg: $brand-info !default;\n\n//== List group\n//\n//##\n\n//** Background color on `.list-group-item`\n$list-group-bg: #fff !default;\n//** `.list-group-item` border color\n$list-group-border: #ddd !default;\n//** List group border radius\n$list-group-border-radius: $border-radius-base !default;\n\n//** Background color of single list items on hover\n$list-group-hover-bg: #f5f5f5 !default;\n//** Text color of active list items\n$list-group-active-color: $component-active-color !default;\n//** Background color of active list items\n$list-group-active-bg: $component-active-bg !default;\n//** Border color of active list elements\n$list-group-active-border: $list-group-active-bg !default;\n//** Text color for content within active list items\n$list-group-active-text-color: color.adjust($list-group-active-bg, $lightness: 40%) !default;\n\n//** Text color of disabled list items\n$list-group-disabled-color: $gray-light !default;\n//** Background color of disabled list items\n$list-group-disabled-bg: $gray-lighter !default;\n//** Text color for content within disabled list items\n$list-group-disabled-text-color: $list-group-disabled-color !default;\n\n$list-group-link-color: #555 !default;\n$list-group-link-hover-color: $list-group-link-color !default;\n$list-group-link-heading-color: #333 !default;\n\n//== Panels\n//\n//##\n\n$panel-bg: #fff !default;\n$panel-body-padding: 15px !default;\n$panel-heading-padding: 10px 15px !default;\n$panel-footer-padding: $panel-heading-padding !default;\n$panel-border-radius: $border-radius-base !default;\n\n//** Border color for elements within panels\n$panel-inner-border: #ddd !default;\n$panel-footer-bg: #f5f5f5 !default;\n\n$panel-default-text: $gray-dark !default;\n$panel-default-border: #ddd !default;\n$panel-default-heading-bg: #f5f5f5 !default;\n\n$panel-primary-text: #fff !default;\n$panel-primary-border: $brand-primary !default;\n$panel-primary-heading-bg: $brand-primary !default;\n\n$panel-success-text: $state-success-text !default;\n$panel-success-border: $state-success-border !default;\n$panel-success-heading-bg: $state-success-bg !default;\n\n$panel-info-text: $state-info-text !default;\n$panel-info-border: $state-info-border !default;\n$panel-info-heading-bg: $state-info-bg !default;\n\n$panel-warning-text: $state-warning-text !default;\n$panel-warning-border: $state-warning-border !default;\n$panel-warning-heading-bg: $state-warning-bg !default;\n\n$panel-danger-text: $state-danger-text !default;\n$panel-danger-border: $state-danger-border !default;\n$panel-danger-heading-bg: $state-danger-bg !default;\n\n//== Thumbnails\n//\n//##\n\n//** Padding around the thumbnail image\n$thumbnail-padding: 4px !default;\n//** Thumbnail background color\n$thumbnail-bg: $body-bg !default;\n//** Thumbnail border color\n$thumbnail-border: #ddd !default;\n//** Thumbnail border radius\n$thumbnail-border-radius: $border-radius-base !default;\n\n//** Custom text color for thumbnail captions\n$thumbnail-caption-color: $text-color !default;\n//** Padding around the thumbnail caption\n$thumbnail-caption-padding: 9px !default;\n\n//== Wells\n//\n//##\n\n$well-bg: #f5f5f5 !default;\n$well-border: color.adjust($well-bg, $lightness: -7%) !default;\n\n//== Badges\n//\n//##\n\n$badge-color: #fff !default;\n//** Linked badge text color on hover\n$badge-link-hover-color: #fff !default;\n$badge-bg: $gray-light !default;\n\n//** Badge text color in active nav link\n$badge-active-color: $link-color !default;\n//** Badge background color in active nav link\n$badge-active-bg: #fff !default;\n\n$badge-font-weight: bold !default;\n$badge-line-height: 1 !default;\n$badge-border-radius: 35px !default;\n\n//== Breadcrumbs\n//\n//##\n\n$breadcrumb-padding-vertical: 8px !default;\n$breadcrumb-padding-horizontal: 15px !default;\n//** Breadcrumb background color\n$breadcrumb-bg: #f5f5f5 !default;\n//** Breadcrumb text color\n$breadcrumb-color: #ccc !default;\n//** Text color of current page in the breadcrumb\n$breadcrumb-active-color: $gray-light !default;\n//** Textual separator for between breadcrumb elements\n$breadcrumb-separator: "/" !default;\n\n//== Carousel\n//\n//##\n\n$carousel-text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6) !default;\n\n$carousel-control-color: #fff !default;\n$carousel-control-width: 15% !default;\n$carousel-control-opacity: 0.5 !default;\n$carousel-control-font-size: 20px !default;\n\n$carousel-indicator-active-bg: #fff !default;\n$carousel-indicator-border-color: #fff !default;\n\n$carousel-caption-color: #fff !default;\n\n//== Close\n//\n//##\n\n$close-font-weight: bold !default;\n$close-color: #000 !default;\n$close-text-shadow: 0 1px 0 #fff !default;\n\n//== Code\n//\n//##\n\n$code-color: #c7254e !default;\n$code-bg: #f9f2f4 !default;\n\n$kbd-color: #fff !default;\n$kbd-bg: #333 !default;\n\n$pre-bg: #f5f5f5 !default;\n$pre-color: $gray-dark !default;\n$pre-border-color: #ccc !default;\n$pre-scrollable-max-height: 340px !default;\n\n//== Type\n//\n//##\n\n//** Horizontal offset for forms and lists.\n$component-offset-horizontal: 180px !default;\n//** Text muted color\n$text-muted: $gray-lighter !default;\n//** Abbreviations and acronyms border color\n$abbr-border-color: $gray-light !default;\n//** Headings small color\n$headings-small-color: $gray-light !default;\n//** Blockquote small color\n$blockquote-small-color: $gray-light !default;\n//** Blockquote font size\n$blockquote-font-size: ($font-size-base * 1.25) !default;\n//** Blockquote border color\n$blockquote-border-color: $gray-lighter !default;\n//** Page header border color\n$page-header-border-color: $gray-lighter !default;\n//** Horizontal line color.\n$hr-border: $gray-1-50 !default;\n'],sourceRoot:""}]),l.locals={icon:"CustomItemDefault-module_icon__qsB30",title:"CustomItemDefault-module_title__Ui_P8",description:"CustomItemDefault-module_description__by4zK",formatBullets:"CustomItemDefault-module_formatBullets__URrkE",fontSize11:"CustomItemDefault-module_fontSize11__jonGz",iconStyle:"CustomItemDefault-module_iconStyle__dCJ5t",rowDate:"CustomItemDefault-module_rowDate__DjYfp",customItemIcon:"CustomItemDefault-module_customItemIcon__aETwC",editable:"CustomItemDefault-module_editable__TXBiu",customItemContent:"CustomItemDefault-module_customItemContent__d1str",customItemTitle:"CustomItemDefault-module_customItemTitle__gAJ8T",customItemDescription:"CustomItemDefault-module_customItemDescription__JjBzo",customItemIconCondensed:"CustomItemDefault-module_customItemIconCondensed__ezfig CustomItemDefault-module_customItemIcon__aETwC",customItemTitleCondensed:"CustomItemDefault-module_customItemTitleCondensed__kCxaE CustomItemDefault-module_customItemTitle__gAJ8T",customItemDescriptionCondensed:"CustomItemDefault-module_customItemDescriptionCondensed__Ll9Dq CustomItemDefault-module_customItemDescription__JjBzo",customItemTitleClassic:"CustomItemDefault-module_customItemTitleClassic__xTKTl CustomItemDefault-module_customItemTitle__gAJ8T",customItemTitleElegant:"CustomItemDefault-module_customItemTitleElegant__dI9wv CustomItemDefault-module_customItemTitle__gAJ8T"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/packages/Resume/ItemTypes/Custom/CustomItemElegant.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,'.CustomItemElegant-module_customItemIcon__Ttz_u{position:relative;flex:0 0 auto;width:22px;line-height:11px;padding:4px 4px 4px 0;margin-bottom:0;margin-right:5px;top:-2px;cursor:initial}.CustomItemElegant-module_customItemIcon__Ttz_u i{font-size:16px}.CustomItemElegant-module_customItemIcon__Ttz_u.CustomItemElegant-module_editable__zl98E{cursor:pointer}.CustomItemElegant-module_customItemContent__lefuo{display:flex;text-align:start;align-items:normal}.CustomItemElegant-module_customItemTitle__qRZZ3{color:#3e3e3e;font-weight:400;top:0;position:relative;padding-bottom:3px}.CustomItemElegant-module_customItemDescription__IB0Hv{font-size:13px;color:#65696d}.CustomItemElegant-module_customItemTitleRight__Qrc8D{color:#fff}.CustomItemElegant-module_customItemDescriptionRight__KkyGs{color:#e0e0e0}.CustomItemElegant-module_dateRange__Ypuo0{width:140px !important;display:block}.CustomItemElegant-module_iconContainerCircle__Bwwwk{width:40px;height:40px;background-color:#f2f2f2;border-radius:50%;text-align:center;flex:0 0 auto;cursor:pointer;text-align:center;margin-right:10px}.CustomItemElegant-module_iconCircle__pTD7A{position:relative;top:50%;transform:translateY(-50%);width:40px;font-size:16px}.CustomItemElegant-module_formatBullets__eVI6o ul{list-style:none;padding-left:16px}.CustomItemElegant-module_formatBullets__eVI6o ul li::before{content:"•";position:absolute;vertical-align:middle;left:4px}',"",{version:3,sources:["webpack://./src/packages/Resume/ItemTypes/Custom/CustomItemElegant.module.scss","webpack://./node_modules/sharedstyle/_variables.scss"],names:[],mappings:"AAAA,gDAEA,iBACI,CAAA,aACA,CAAA,UACA,CAAA,gBACA,CAAA,qBACA,CAAA,eACA,CAAA,gBACA,CAAA,QACA,CAAA,cACA,CAAA,kDAEA,cACI,CAAA,yFAGJ,cACI,CAAA,mDAIR,YACI,CAAA,gBACA,CAAA,kBACA,CAAA,iDAGJ,aCToB,CAAA,eDWhB,CAAA,KACA,CAAA,iBACA,CAAA,kBACA,CAAA,uDAGJ,cACI,CAAA,aCwCe,CAAA,sDDpCnB,UACI,CAAA,4DAGJ,aACI,CAAA,2CAGJ,sBACI,CAAA,aACA,CAAA,qDAGJ,UACI,CAAA,WACA,CAAA,wBACA,CAAA,iBACA,CAAA,iBACA,CAAA,aACA,CAAA,cACA,CAAA,iBACA,CAAA,iBACA,CAAA,4CAGJ,iBACI,CAAA,OACA,CAAA,0BACA,CAAA,UACA,CAAA,cACA,CAAA,kDAIA,eACI,CAAA,iBACA,CAAA,6DAGI,WACI,CAAA,iBACA,CAAA,qBACA,CAAA,QACA",sourcesContent:['@import "~sharedstyle/variables";\n\n.customItemIcon {\n    position: relative;\n    flex: 0 0 auto;\n    width: 22px;\n    line-height: 11px;\n    padding: 4px 4px 4px 0;\n    margin-bottom: 0;\n    margin-right: 5px;\n    top: -2px;\n    cursor: initial;\n\n    i {\n        font-size: 16px;\n    }\n\n    &.editable {\n        cursor: pointer;\n    }\n}\n\n.customItemContent {\n    display: flex;\n    text-align: start;\n    align-items: normal;\n}\n\n.customItemTitle {\n    color: $resume-body-color;\n    font-weight: 400;\n    top: 0;\n    position: relative;\n    padding-bottom: 3px;\n}\n\n.customItemDescription {\n    font-size: 13px;\n    color: $brand-gray-color;\n}\n\n.customItemTitleRight {\n    color: #fff;\n}\n\n.customItemDescriptionRight {\n    color: #e0e0e0;\n}\n\n.dateRange {\n    width: 140px !important;\n    display: block;\n}\n\n.iconContainerCircle {\n    width: 40px;\n    height: 40px;\n    background-color: #f2f2f2;\n    border-radius: 50%;\n    text-align: center;\n    flex: 0 0 auto;\n    cursor: pointer;\n    text-align: center;\n    margin-right: 10px;\n}\n\n.iconCircle {\n    position: relative;\n    top: 50%;\n    transform: translateY(-50%);\n    width: 40px;\n    font-size: 16px;\n}\n\n.formatBullets {\n    ul {\n        list-style: none;\n        padding-left: 16px;\n\n        li {\n            &::before {\n                content: "•";\n                position: absolute;\n                vertical-align: middle;\n                left: 4px;\n            }\n        }\n    }\n}\n','@use "sass:color";\n@use "sass:math";\n//\n// Variables\n// --------------------------------------------------\n\n//== Colors\n//\n//## Gray and brand colors for use across Bootstrap.\n\n$shadow-4: 0 0 12px -3px rgba(0, 0, 0, 0.3);\n$shadow-5: 0 0 4px 0px rgba(0, 0, 0, 0.3);\n\n$shadow-1: 0 0 4px 0 rgba(160, 162, 167, 0.15);\n$shadow-2: 0 0 2px 0 rgba(77, 77, 77, 0.16);\n$shadow-3: 0 0 2px 0 rgba(83, 83, 83, 0.5);\n\n$gray-base: #000 !default;\n$gray-dark: #384347 !default;\n$resume-body-color: #3e3e3e !default; // specific body color for the resumes - without blue color included\n$gray-dark-2: #222 !default;\n$gray: color.adjust($gray-base, $lightness: 33.5%) !default; // #555\n$gray-light: color.adjust($gray-base, $lightness: 46.7%) !default; // #777\n$gray-lighter: color.adjust($gray-base, $lightness: 80%) !default; // #ccc\n$green-light: #eaf8f3;\n\n$gray-1: #b2b4b6;\n$gray-1-20: rgba($gray-1, 0.2);\n$gray-1-50: rgba($gray-1, 0.5);\n$gray-2: #65696d;\n$gray-2-20: rgba($gray-2, 0.2);\n$gray-2-50: rgba($gray-2, 0.5);\n$gray-3: #384347;\n$gray-3-20: rgba($gray-3, 0.2);\n$gray-3-50: rgba($gray-3, 0.5);\n\n$green-3: #2dc08d;\n$green-2: #62d0aa;\n$green-1: #d5f2e8;\n$green-hover: #249a71;\n\n$purple-3: #8c7cdb;\n$purple-2: #c5bded;\n$purple-1: #e8e5f8;\n\n$red-3: #ff576f;\n$red-2: #ffabb7;\n$red-1: #ffeef0;\n\n$blue-3: #7aaacb;\n$blue-2: #b5d6ec;\n$blue-1: #e2eff8;\n$blue-background: #f3f5fa;\n\n$yellow-3: #feb251;\n$yellow-2: #fed8a7;\n$yellow-1: #fff0dc;\n\n$background: #fafbfd;\n$brand-primary: #00c091;\n$brand-promo: #e7762e;\n$brand-success: #2dc08c !default;\n$brand-info: #5bc0de !default;\n$brand-warning: #f2994a !default;\n$brand-danger: #ff576f !default;\n$brand-border-color: #e6e6e6 !default;\n$brand-grey-background: #f2f2f2;\n$color-facebook: #3b5998;\n$color-twitter: #5eaade;\n$color-gplus: #dd4b39;\n$color-instagram: #333333;\n$color-linkedin: #2578b5;\n$color-messenger-first: rgb(1, 183, 255);\n$color-messenger-second: rgb(0, 126, 254);\n$color-messenger-border: #ffffff;\n$color-onboarding: #009ee8;\n$purple-color: #8c7cdb;\n$brand-gray-color: #65696d;\n$brand-info-font-color: #b2b4b6;\n$toolbox-border: rgba(223, 223, 223, 0.52);\n$selected-item-border-color: #60d5ba;\n\n$white: white;\n\n$op-background-color: #333333;\n$op-nav-control-color: #464646;\n$op-control-color: $gray-dark;\n$op-light-color: #e6e6e6;\n$op-control-primary-color: $brand-success;\n$op-notification-bg-primary: #ccf5e9;\n$op-notification-bg-danger: #ffc7d4;\n$op-notification-bg-warning: #ffe2ca;\n\n$op-base-offset: 8px !default;\n$op-btn-padding-horizontal: 14px;\n\n//Resume Styles\n$resume-rounding: 5px;\n\n//== Scaffolding\n//\n//## Settings for some of the most global styles.\n\n//** Background color for `<body>`.\n$body-bg: #fff !default;\n//** Global text color on `<body>`.\n$text-color: $gray-dark !default;\n\n$text-color-hover: color.adjust($text-color, $lightness: 30%) !default;\n\n//** Global textual link color.\n$link-color: white !default;\n//** Link hover color set via `darken()` function.\n$link-hover-color: color.adjust(white, $lightness: -10%);\n//** Link hover decoration.\n$link-hover-decoration: none !default;\n\n//== Typography\n//\n//## Font, line-height, and color for body text, headings, and more.\n\n$font-family-sans-serif: "Roboto", Arial, Helvetica, "Noto Sans Devanagari", "Noto Sans CJK SC Thin",\n    "Noto Sans SC", "Noto Sans Hebrew", "Noto Sans Bengali", sans-serif !default;\n$font-family-serif: Georgia, "Times New Roman", Times, "Noto Sans Devanagari",\n    "Noto Sans CJK SC Thin", "Noto Sans SC", "Noto Sans Hebrew", "Noto Sans Bengali", serif !default;\n//** Default monospace fonts for `<code>`, `<kbd>`, and `<pre>`.\n$font-family-monospace: Menlo, Monaco, Consolas, "Courier New", monospace !default;\n$font-family-base: "Inter" !default;\n\n$roboto: "Roboto", Arial, Helvetica, sans-serif;\n$opensans: "Open Sans", Arial, Helvetica, sans-serif;\n$account-heading-font: "Rubik", sans-serif !important;\n\n$font-size-base: 14px !default;\n$font-size-large: 18px !default;\n$font-size-small: 11px !default;\n\n$font-size-h1: 68px !default; // ~36px\n$font-size-h2: 38px !default; // ~30px\n$font-size-h3: 32px !default; // ~24px\n$font-size-h4: 26px !default; // ~18px\n$font-size-h5: 22px !default;\n$font-size-h6: 20px !default; // ~12px\n\n//** Unit-less `line-height` for use in components like buttons.\n$line-height-base: 1.428571429 !default; // 20/14\n//** Computed "line-height" (`font-size` * `line-height`) for use with `margin`, `padding`, etc.\n$line-height-computed: math.floor(($font-size-base * $line-height-base)) !default; // ~20px\n\n//** By default, this inherits from the `<body>`.\n$headings-font-family: "Rubik", sans-serif !default;\n$headings-font-weight: 300 !default;\n$headings-line-height: 1.1 !default;\n$headings-color: $gray-dark !default;\n\n//== Components\n//\n//## Define common padding and border radius sizes and more. Values based on 14px text and 1.428 line-height (~20px to start).\n\n$padding-base-vertical: 9px !default;\n$padding-base-horizontal: 14px !default;\n\n$padding-large-vertical: 12px !default;\n$padding-large-horizontal: 24px !default;\n\n$padding-small-vertical: 5px !default;\n$padding-small-horizontal: 18px !default;\n\n$padding-xs-vertical: 1px !default;\n$padding-xs-horizontal: 12px !default;\n\n$line-height-large: 1.3333333 !default; // extra decimals for Win 8.1 Chrome\n$line-height-small: 1.5 !default;\n\n$border-radius-base: 5px !default;\n$border-radius-large: 9px !default;\n$border-radius-small: 4px !default;\n\n//** Global color for active items (e.g., navs or dropdowns).\n$component-active-color: #fff !default;\n//** Global background color for active items (e.g., navs or dropdowns).\n$component-active-bg: $brand-primary !default;\n\n//** Width of the `border` for generating carets that indicator dropdowns.\n$caret-width-base: 4px !default;\n//** Carets increase slightly in size for larger components.\n$caret-width-large: 5px !default;\n\n//== Tables\n//\n//## Customizes the `.table` component with basic values, each used across all table variations.\n\n//** Padding for `<th>`s and `<td>`s.\n$table-cell-padding: 8px !default;\n//** Padding for cells in `.table-condensed`.\n$table-condensed-cell-padding: 5px !default;\n\n//** Default background color used for all tables.\n$table-bg: transparent !default;\n//** Background color used for `.table-striped`.\n$table-bg-accent: #f9f9f9 !default;\n//** Background color used for `.table-hover`.\n$table-bg-hover: #f5f5f5 !default;\n$table-bg-active: $table-bg-hover !default;\n\n//** Border color for table and cell borders.\n$table-border-color: #ddd !default;\n\n//== Buttons\n//\n//## For each of Bootstrap\'s buttons, define text, background and border color.\n\n$btn-font-weight: bold !default;\n\n$btn-default-color: #8c7cdb !default;\n$btn-default-bg: #fff !default;\n$btn-default-border: #8c7cdb !default;\n\n$btn-primary-color: #fff !default;\n$btn-primary-bg: $brand-primary !default;\n$btn-primary-border: $brand-primary !default;\n\n$btn-success-color: #fff !default;\n$btn-success-bg: $brand-success !default;\n$btn-success-border: color.adjust($btn-success-bg, $lightness: -5%) !default;\n\n$btn-info-color: #fff !default;\n$btn-info-bg: $brand-info !default;\n$btn-info-border: color.adjust($btn-info-bg, $lightness: -5%) !default;\n\n$btn-warning-color: #fff !default;\n$btn-warning-bg: $brand-warning !default;\n$btn-warning-border: color.adjust($btn-warning-bg, $lightness: -5%) !default;\n\n$btn-danger-color: #fff !default;\n$btn-danger-bg: $brand-danger !default;\n$btn-danger-border: color.adjust($btn-danger-bg, $lightness: -5%) !default;\n\n$btn-link-disabled-color: $gray-light !default;\n\n// Allows for customizing button radius independently from global border radius\n$btn-border-radius-base: $border-radius-base;\n$btn-border-radius-large: $border-radius-base;\n$btn-border-radius-small: $border-radius-base;\n\n//== Forms\n//\n//##\n\n//** `<input>` background color\n$input-bg: #fff !default;\n//** `<input disabled>` background color\n$input-bg-disabled: $gray-lighter !default;\n\n//** Text color for `<input>`s\n$input-color: $gray !default;\n//** `<input>` border color\n$input-border: #b3b3b3 !default;\n\n// TODO: Rename `$input-border-radius` to `$input-border-radius-base` in v4\n//** Default `.form-control` border radius\n// This has no effect on `<select>`s in some browsers, due to the limited stylability of `<select>`s in CSS.\n$input-border-radius: $border-radius-base;\n//** Large `.form-control` border radius\n$input-border-radius-large: $border-radius-base;\n//** Small `.form-control` border radius\n$input-border-radius-small: $border-radius-base;\n\n//** Border color for inputs on focus\n$input-border-focus: $brand-primary !default;\n\n//** Placeholder text color\n$input-color-placeholder: color.adjust($gray-base, $lightness: 70%) !default;\n\n//** Default `.form-control` height\n$input-height-base: ($line-height-computed + ($padding-base-vertical * 2) + 2) !default;\n//** Large `.form-control` height\n$input-height-large: (\n    math.ceil($font-size-large * $line-height-large) + ($padding-large-vertical * 2) + 2\n) !default;\n//** Small `.form-control` height\n$input-height-small: (\n    math.floor($font-size-small * $line-height-small) + ($padding-small-vertical * 2) + 2\n) !default;\n\n//** `.form-group` margin\n$form-group-margin-bottom: 15px !default;\n\n$legend-color: $gray-dark !default;\n$legend-border-color: #e5e5e5 !default;\n\n//** Background color for textual input addons\n$input-group-addon-bg: $gray-lighter !default;\n//** Border color for textual input addons\n$input-group-addon-border-color: $input-border !default;\n\n//** Disabled cursor for form controls and buttons.\n$cursor-disabled: not-allowed !default;\n\n//== Dropdowns\n//\n//## Dropdown menu container and contents.\n\n//** Background for the dropdown menu.\n$dropdown-bg: #fff !default;\n//** Dropdown menu `border-color`.\n$dropdown-border: rgba(0, 0, 0, 0.15) !default;\n//** Dropdown menu `border-color` **for IE8**.\n$dropdown-fallback-border: #ccc !default;\n//** Divider color for between dropdown items.\n$dropdown-divider-bg: #e5e5e5 !default;\n\n//** Dropdown link text color.\n$dropdown-link-color: $gray-dark !default;\n//** Hover color for dropdown links.\n$dropdown-link-hover-color: color.adjust($gray-dark, $lightness: 50%) !default;\n//** Hover background for dropdown links.\n$dropdown-link-hover-bg: transparent !default;\n\n//** Active dropdown menu item text color.\n$dropdown-link-active-color: $component-active-color !default;\n//** Active dropdown menu item background color.\n$dropdown-link-active-bg: $component-active-bg !default;\n\n//** Disabled dropdown menu item background color.\n$dropdown-link-disabled-color: $gray-light !default;\n\n//** Text color for headers within dropdown menus.\n$dropdown-header-color: $gray-light !default;\n\n//** Deprecated `$dropdown-caret-color` as of v3.1.0\n$dropdown-caret-color: #000 !default;\n\n//-- Z-index master list\n//\n// Warning: Avoid customizing these values. They\'re used for a bird\'s eye view\n// of components dependent on the z-axis and are designed to all work together.\n//\n// Note: These variables are not generated into the Customizer.\n\n$zindex-navbar: 1000 !default;\n$zindex-dropdown: 1000 !default;\n$zindex-mobile-design-menu: 1001 !default;\n$zindex-modal-background: 1002 !default; // from style guide --\x3e\n$zindex-modal-content: 1003 !default; // <--\n$zindex-full-screen-dropdown: 1004 !default;\n$zindex-popover: 1020 !default;\n$zindex-tooltip: 1050 !default;\n$zindex-navbar-fixed: 1030 !default;\n$zindex-toaster: 1030 !default;\n$zindex-alert: 1060 !default;\n$zindex-op-currdoing-cirle: 100 !default;\n$zindex-op-section-controls: 1 !default;\n$zindex-toasters: 8000 !default;\n\n//== Media queries breakpoints\n//\n//## Define the breakpoints at which your layout will change, adapting to different screen sizes.\n\n//== Grid system\n//\n//## Define your custom responsive grid.\n\n//** Number of columns in the grid.\n$grid-columns: 12 !default;\n//** Padding between columns. Gets divided in half for the left and right.\n$grid-gutter-width: 20px !default;\n\n//== Navbar OP\n//\n//##\n$op-navbar-height: 64px !default;\n$op-navbar-padding: 2 * $op-base-offset !default;\n\n//== Navbar\n//\n//##\n\n// Basics of a navbar\n$navbar-height: 60px !default;\n$navbar-padding: 16px !default;\n$navbar-margin-bottom: 0 !default;\n$navbar-border-radius: 0 !default;\n$navbar-padding-horizontal: math.floor(($grid-gutter-width * 0.5)) !default;\n$navbar-padding-vertical: (($navbar-height - $line-height-computed) * 0.5) !default;\n$navbar-collapse-max-height: 340px !default;\n\n$navbar-default-color: $text-color !default;\n$navbar-default-bg: white !default;\n$navbar-default-border: transparent !default;\n\n// Navbar links\n$navbar-default-link-color: $text-color !default;\n$navbar-default-link-hover-color: $purple-color !default;\n$navbar-default-link-hover-bg: transparent !default;\n$navbar-default-link-active-color: #b2b4b6 !default;\n$navbar-default-link-active-bg: color.adjust($navbar-default-bg, $lightness: -6.5%) !default;\n$navbar-default-link-disabled-color: #ccc !default;\n$navbar-default-link-disabled-bg: transparent !default;\n\n// Navbar brand label\n$navbar-default-brand-color: #e6e6e6 !default;\n$navbar-default-brand-hover-color: color.adjust(\n    $navbar-default-brand-color,\n    $lightness: -10%\n) !default;\n$navbar-default-brand-hover-bg: transparent !default;\n\n// Navbar toggle\n$navbar-default-toggle-hover-bg: color.adjust(white, $lightness: -5%) !default;\n$navbar-default-toggle-icon-bar-bg: $text-color !default;\n$navbar-default-toggle-border-color: transparent !default;\n\n//=== Inverted navbar\n// Reset inverted navbar basics\n$navbar-inverse-color: $brand-gray-color !default;\n$navbar-inverse-bg: white !default;\n$navbar-inverse-border: $brand-border-color !default;\n\n// Inverted navbar links\n$navbar-inverse-link-color: $brand-gray-color !default;\n$navbar-inverse-link-hover-color: $text-color;\n$navbar-inverse-link-hover-bg: transparent !default;\n$navbar-inverse-link-active-color: $navbar-inverse-link-hover-color !default;\n$navbar-inverse-link-active-bg: color.adjust($navbar-inverse-bg, $lightness: -10%) !default;\n$navbar-inverse-link-disabled-color: #444 !default;\n$navbar-inverse-link-disabled-bg: transparent !default;\n\n// Inverted navbar brand label\n$navbar-inverse-brand-color: $navbar-inverse-link-color !default;\n$navbar-inverse-brand-hover-color: #fff !default;\n$navbar-inverse-brand-hover-bg: transparent !default;\n\n// Inverted navbar toggle\n$navbar-inverse-toggle-hover-bg: color.adjust(white, $lightness: -10%) !default;\n$navbar-inverse-toggle-icon-bar-bg: $gray !default;\n$navbar-inverse-toggle-border-color: $gray !default;\n\n//== Navs\n//\n//##\n\n//=== Shared nav styles\n$nav-link-padding: 12px 15px !default;\n$nav-link-hover-bg: transparent !default;\n\n$nav-disabled-link-color: $gray-light !default;\n$nav-disabled-link-hover-color: transparent !default;\n\n//== Tabs\n$nav-tabs-border-color: #ddd !default;\n\n$nav-tabs-link-hover-border-color: $gray-lighter !default;\n\n$nav-tabs-active-link-hover-bg: $body-bg !default;\n$nav-tabs-active-link-hover-color: $gray !default;\n$nav-tabs-active-link-hover-border-color: #ddd !default;\n\n$nav-tabs-justified-link-border-color: #ddd !default;\n$nav-tabs-justified-active-link-border-color: $body-bg !default;\n\n//== Pills\n$nav-pills-border-radius: $border-radius-base !default;\n$nav-pills-active-link-hover-bg: transparent !default;\n$nav-pills-active-link-hover-color: $brand-primary !default;\n\n//== Pagination\n//\n//##\n\n$pagination-color: $link-color !default;\n$pagination-bg: #fff !default;\n$pagination-border: #ddd !default;\n\n$pagination-hover-color: $link-hover-color !default;\n$pagination-hover-bg: $gray-lighter !default;\n$pagination-hover-border: #ddd !default;\n\n$pagination-active-color: #fff !default;\n$pagination-active-bg: $brand-primary !default;\n$pagination-active-border: $brand-primary !default;\n\n$pagination-disabled-color: $gray-light !default;\n$pagination-disabled-bg: #fff !default;\n$pagination-disabled-border: #ddd !default;\n\n//== Pager\n//\n//##\n\n$pager-bg: $pagination-bg !default;\n$pager-border: $pagination-border !default;\n$pager-border-radius: 15px !default;\n\n$pager-hover-bg: $pagination-hover-bg !default;\n\n$pager-active-bg: $pagination-active-bg !default;\n$pager-active-color: $pagination-active-color !default;\n\n$pager-disabled-color: $pagination-disabled-color !default;\n\n//== Jumbotron\n//\n//##\n\n$jumbotron-padding: 30px !default;\n$jumbotron-color: inherit !default;\n$jumbotron-bg: $gray-lighter !default;\n$jumbotron-heading-color: inherit !default;\n$jumbotron-font-size: math.ceil(($font-size-base * 1.5)) !default;\n$jumbotron-heading-font-size: math.ceil(($font-size-base * 4.5)) !default;\n\n//== Form states and alerts\n//\n//## Define colors for form feedback states and, by default, alerts.\n\n$state-success-text: #00c091 !default;\n$state-success-bg: #caf3e9 !default;\n$state-success-border: color.adjust(\n    color.adjust($state-success-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n$state-info-text: #31708f !default;\n$state-info-bg: #d9edf7 !default;\n$state-info-border: color.adjust(color.adjust($state-info-bg, $hue: -10), $lightness: -7%) !default;\n\n$state-warning-text: $brand-warning !default;\n$state-warning-bg: #fcf8e3 !default;\n$state-warning-border: color.adjust(\n    color.adjust($state-warning-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n$state-danger-text: $brand-danger !default;\n$state-danger-bg: #ffcbd6 !default;\n$state-danger-border: color.adjust(\n    color.adjust($state-danger-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n//== Tooltips\n//\n//##\n\n//** Tooltip max width\n$tooltip-max-width: 300px !default;\n//** Tooltip text color\n$tooltip-color: #fff !default;\n//** Tooltip background color\n$tooltip-bg: $gray-dark !default;\n$tooltip-opacity: 0.9 !default;\n\n//** Tooltip arrow width\n$tooltip-arrow-width: 5px !default;\n//** Tooltip arrow color\n$tooltip-arrow-color: $tooltip-bg !default;\n\n//== Popovers\n//\n//##\n\n//** Popover body background color\n$popover-bg: #fff !default;\n//** Popover maximum width\n$popover-max-width: 276px !default;\n//** Popover border color\n$popover-border-color: rgba(0, 0, 0, 0.2) !default;\n//** Popover fallback border color\n$popover-fallback-border-color: #ccc !default;\n\n//** Popover title background color\n$popover-title-bg: color.adjust($popover-bg, $lightness: -3%) !default;\n\n//** Popover arrow width\n$popover-arrow-width: 10px !default;\n//** Popover arrow color\n$popover-arrow-color: $popover-bg !default;\n\n//** Popover outer arrow width\n$popover-arrow-outer-width: ($popover-arrow-width + 1) !default;\n//** Popover outer arrow color\n$popover-arrow-outer-color: color.adjust($popover-border-color, $alpha: 0.05) !default;\n//** Popover outer arrow fallback color\n$popover-arrow-outer-fallback-color: color.adjust(\n    $popover-fallback-border-color,\n    $lightness: -20%\n) !default;\n\n//== Labels\n//\n//##\n\n//** Default label background color\n$label-default-bg: $gray-light !default;\n//** Primary label background color\n$label-primary-bg: $brand-primary !default;\n//** Success label background color\n$label-success-bg: $brand-success !default;\n//** Info label background color\n$label-info-bg: $brand-info !default;\n//** Warning label background color\n$label-warning-bg: $brand-warning !default;\n//** Danger label background color\n$label-danger-bg: $brand-danger !default;\n\n//** Default label text color\n$label-color: #fff !default;\n//** Default text color of a linked label\n$label-link-hover-color: #fff !default;\n$label-gray: #60696c;\n\n//== Modals\n//\n//##\n\n//** Padding applied to the modal body\n$modal-inner-padding: 35px 40px !default;\n\n//** Padding applied to the modal title\n$modal-title-padding: 35px 40px 35px 40px !default;\n//** Modal title line-height\n$modal-title-line-height: $line-height-base !default;\n\n//** Background color of modal content area\n$modal-content-bg: #fff !default;\n//** Modal content border color\n$modal-content-border-color: rgba(255, 255, 255, 0) !default;\n//** Modal content border color **for IE8**\n$modal-content-fallback-border-color: #999 !default;\n\n//** Modal backdrop background color\n$modal-backdrop-bg: #00bf93 !default;\n//** Modal backdrop opacity\n$modal-backdrop-opacity: 0.5 !default;\n//** Modal header border color\n$modal-header-border-color: #e6e6e6 !default;\n//** Modal footer border color\n$modal-footer-border-color: $modal-header-border-color !default;\n\n$modal-lg: 820px !default;\n$modal-md: 630px !default;\n$modal-sm: 420px !default;\n\n//== Alerts\n//\n//## Define alert colors, border radius, and padding.\n\n$alert-padding: 8px 15px !default;\n$alert-border-radius: 45px !default;\n$alert-link-font-weight: bold !default;\n\n$alert-success-bg: $state-success-bg !default;\n$alert-success-text: $state-success-text !default;\n$alert-success-border: #fff !default;\n\n$alert-info-bg: $state-info-bg !default;\n$alert-info-text: $state-info-text !default;\n$alert-info-border: #fff !default;\n\n$alert-warning-bg: $state-warning-bg !default;\n$alert-warning-text: $state-warning-text !default;\n$alert-warning-border: #fff !default;\n\n$alert-danger-bg: $state-danger-bg !default;\n$alert-danger-text: $state-danger-text !default;\n$alert-danger-border: #fff !default;\n\n//== Progress bars\n//\n//##\n\n//** Background color of the whole progress component\n$progress-bg: #e6e6e6 !default;\n//** Progress bar text color\n$progress-bar-color: #fff !default;\n//** Variable for setting rounded corners on progress bar.\n$progress-border-radius: 12px !default;\n\n//** Default progress bar color\n$progress-bar-bg: $brand-primary !default;\n//** Success progress bar color\n$progress-bar-success-bg: $brand-success !default;\n//** Warning progress bar color\n$progress-bar-warning-bg: $brand-warning !default;\n//** Danger progress bar color\n$progress-bar-danger-bg: $brand-danger !default;\n//** Info progress bar color\n$progress-bar-info-bg: $brand-info !default;\n\n//== List group\n//\n//##\n\n//** Background color on `.list-group-item`\n$list-group-bg: #fff !default;\n//** `.list-group-item` border color\n$list-group-border: #ddd !default;\n//** List group border radius\n$list-group-border-radius: $border-radius-base !default;\n\n//** Background color of single list items on hover\n$list-group-hover-bg: #f5f5f5 !default;\n//** Text color of active list items\n$list-group-active-color: $component-active-color !default;\n//** Background color of active list items\n$list-group-active-bg: $component-active-bg !default;\n//** Border color of active list elements\n$list-group-active-border: $list-group-active-bg !default;\n//** Text color for content within active list items\n$list-group-active-text-color: color.adjust($list-group-active-bg, $lightness: 40%) !default;\n\n//** Text color of disabled list items\n$list-group-disabled-color: $gray-light !default;\n//** Background color of disabled list items\n$list-group-disabled-bg: $gray-lighter !default;\n//** Text color for content within disabled list items\n$list-group-disabled-text-color: $list-group-disabled-color !default;\n\n$list-group-link-color: #555 !default;\n$list-group-link-hover-color: $list-group-link-color !default;\n$list-group-link-heading-color: #333 !default;\n\n//== Panels\n//\n//##\n\n$panel-bg: #fff !default;\n$panel-body-padding: 15px !default;\n$panel-heading-padding: 10px 15px !default;\n$panel-footer-padding: $panel-heading-padding !default;\n$panel-border-radius: $border-radius-base !default;\n\n//** Border color for elements within panels\n$panel-inner-border: #ddd !default;\n$panel-footer-bg: #f5f5f5 !default;\n\n$panel-default-text: $gray-dark !default;\n$panel-default-border: #ddd !default;\n$panel-default-heading-bg: #f5f5f5 !default;\n\n$panel-primary-text: #fff !default;\n$panel-primary-border: $brand-primary !default;\n$panel-primary-heading-bg: $brand-primary !default;\n\n$panel-success-text: $state-success-text !default;\n$panel-success-border: $state-success-border !default;\n$panel-success-heading-bg: $state-success-bg !default;\n\n$panel-info-text: $state-info-text !default;\n$panel-info-border: $state-info-border !default;\n$panel-info-heading-bg: $state-info-bg !default;\n\n$panel-warning-text: $state-warning-text !default;\n$panel-warning-border: $state-warning-border !default;\n$panel-warning-heading-bg: $state-warning-bg !default;\n\n$panel-danger-text: $state-danger-text !default;\n$panel-danger-border: $state-danger-border !default;\n$panel-danger-heading-bg: $state-danger-bg !default;\n\n//== Thumbnails\n//\n//##\n\n//** Padding around the thumbnail image\n$thumbnail-padding: 4px !default;\n//** Thumbnail background color\n$thumbnail-bg: $body-bg !default;\n//** Thumbnail border color\n$thumbnail-border: #ddd !default;\n//** Thumbnail border radius\n$thumbnail-border-radius: $border-radius-base !default;\n\n//** Custom text color for thumbnail captions\n$thumbnail-caption-color: $text-color !default;\n//** Padding around the thumbnail caption\n$thumbnail-caption-padding: 9px !default;\n\n//== Wells\n//\n//##\n\n$well-bg: #f5f5f5 !default;\n$well-border: color.adjust($well-bg, $lightness: -7%) !default;\n\n//== Badges\n//\n//##\n\n$badge-color: #fff !default;\n//** Linked badge text color on hover\n$badge-link-hover-color: #fff !default;\n$badge-bg: $gray-light !default;\n\n//** Badge text color in active nav link\n$badge-active-color: $link-color !default;\n//** Badge background color in active nav link\n$badge-active-bg: #fff !default;\n\n$badge-font-weight: bold !default;\n$badge-line-height: 1 !default;\n$badge-border-radius: 35px !default;\n\n//== Breadcrumbs\n//\n//##\n\n$breadcrumb-padding-vertical: 8px !default;\n$breadcrumb-padding-horizontal: 15px !default;\n//** Breadcrumb background color\n$breadcrumb-bg: #f5f5f5 !default;\n//** Breadcrumb text color\n$breadcrumb-color: #ccc !default;\n//** Text color of current page in the breadcrumb\n$breadcrumb-active-color: $gray-light !default;\n//** Textual separator for between breadcrumb elements\n$breadcrumb-separator: "/" !default;\n\n//== Carousel\n//\n//##\n\n$carousel-text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6) !default;\n\n$carousel-control-color: #fff !default;\n$carousel-control-width: 15% !default;\n$carousel-control-opacity: 0.5 !default;\n$carousel-control-font-size: 20px !default;\n\n$carousel-indicator-active-bg: #fff !default;\n$carousel-indicator-border-color: #fff !default;\n\n$carousel-caption-color: #fff !default;\n\n//== Close\n//\n//##\n\n$close-font-weight: bold !default;\n$close-color: #000 !default;\n$close-text-shadow: 0 1px 0 #fff !default;\n\n//== Code\n//\n//##\n\n$code-color: #c7254e !default;\n$code-bg: #f9f2f4 !default;\n\n$kbd-color: #fff !default;\n$kbd-bg: #333 !default;\n\n$pre-bg: #f5f5f5 !default;\n$pre-color: $gray-dark !default;\n$pre-border-color: #ccc !default;\n$pre-scrollable-max-height: 340px !default;\n\n//== Type\n//\n//##\n\n//** Horizontal offset for forms and lists.\n$component-offset-horizontal: 180px !default;\n//** Text muted color\n$text-muted: $gray-lighter !default;\n//** Abbreviations and acronyms border color\n$abbr-border-color: $gray-light !default;\n//** Headings small color\n$headings-small-color: $gray-light !default;\n//** Blockquote small color\n$blockquote-small-color: $gray-light !default;\n//** Blockquote font size\n$blockquote-font-size: ($font-size-base * 1.25) !default;\n//** Blockquote border color\n$blockquote-border-color: $gray-lighter !default;\n//** Page header border color\n$page-header-border-color: $gray-lighter !default;\n//** Horizontal line color.\n$hr-border: $gray-1-50 !default;\n'],sourceRoot:""}]),l.locals={customItemIcon:"CustomItemElegant-module_customItemIcon__Ttz_u",editable:"CustomItemElegant-module_editable__zl98E",customItemContent:"CustomItemElegant-module_customItemContent__lefuo",customItemTitle:"CustomItemElegant-module_customItemTitle__qRZZ3",customItemDescription:"CustomItemElegant-module_customItemDescription__IB0Hv",customItemTitleRight:"CustomItemElegant-module_customItemTitleRight__Qrc8D",customItemDescriptionRight:"CustomItemElegant-module_customItemDescriptionRight__KkyGs",dateRange:"CustomItemElegant-module_dateRange__Ypuo0",iconContainerCircle:"CustomItemElegant-module_iconContainerCircle__Bwwwk",iconCircle:"CustomItemElegant-module_iconCircle__pTD7A",formatBullets:"CustomItemElegant-module_formatBullets__eVI6o"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/packages/Resume/ItemTypes/Custom/CustomItemIvyLeague.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,'.CustomItemIvyLeague-module_icon__ql5MJ{text-align:center;line-height:15px;position:relative;margin-right:8px;margin-bottom:-7px;flex:0 0 auto;cursor:pointer}.CustomItemIvyLeague-module_description__LJRbb{padding-top:4px;color:#3e3e3e}.CustomItemIvyLeague-module_formatBullets__koO3k ul{list-style:none;padding-left:16px}.CustomItemIvyLeague-module_formatBullets__koO3k ul li::before{content:"•";position:absolute;vertical-align:middle;left:4px}',"",{version:3,sources:["webpack://./src/packages/Resume/ItemTypes/Custom/CustomItemIvyLeague.module.scss","webpack://./node_modules/sharedstyle/_variables.scss"],names:[],mappings:"AAAA,wCAGA,iBACI,CAAA,gBACA,CAAA,iBACA,CAAA,gBACA,CAAA,kBACA,CAAA,aACA,CAAA,cACA,CAAA,+CAGJ,eACI,CAAA,aCKgB,CAAA,oDAAA,eDCZ,CAAA,iBACA,CAAA,+DAGI,WACI,CAAA,iBACA,CAAA,qBACA,CAAA,QACA",sourcesContent:['@import "enhancv-styleguide/variables";\n@import "~sharedstyle/variables";\n\n.icon {\n    text-align: center;\n    line-height: 15px;\n    position: relative;\n    margin-right: 8px;\n    margin-bottom: -7px;\n    flex: 0 0 auto;\n    cursor: pointer;\n}\n\n.description {\n    padding-top: 4px;\n    color: $resume-body-color;\n}\n\n.formatBullets {\n    ul {\n        list-style: none;\n        padding-left: 16px;\n\n        li {\n            &::before {\n                content: "•";\n                position: absolute;\n                vertical-align: middle;\n                left: 4px;\n            }\n        }\n    }\n}\n','@use "sass:color";\n@use "sass:math";\n//\n// Variables\n// --------------------------------------------------\n\n//== Colors\n//\n//## Gray and brand colors for use across Bootstrap.\n\n$shadow-4: 0 0 12px -3px rgba(0, 0, 0, 0.3);\n$shadow-5: 0 0 4px 0px rgba(0, 0, 0, 0.3);\n\n$shadow-1: 0 0 4px 0 rgba(160, 162, 167, 0.15);\n$shadow-2: 0 0 2px 0 rgba(77, 77, 77, 0.16);\n$shadow-3: 0 0 2px 0 rgba(83, 83, 83, 0.5);\n\n$gray-base: #000 !default;\n$gray-dark: #384347 !default;\n$resume-body-color: #3e3e3e !default; // specific body color for the resumes - without blue color included\n$gray-dark-2: #222 !default;\n$gray: color.adjust($gray-base, $lightness: 33.5%) !default; // #555\n$gray-light: color.adjust($gray-base, $lightness: 46.7%) !default; // #777\n$gray-lighter: color.adjust($gray-base, $lightness: 80%) !default; // #ccc\n$green-light: #eaf8f3;\n\n$gray-1: #b2b4b6;\n$gray-1-20: rgba($gray-1, 0.2);\n$gray-1-50: rgba($gray-1, 0.5);\n$gray-2: #65696d;\n$gray-2-20: rgba($gray-2, 0.2);\n$gray-2-50: rgba($gray-2, 0.5);\n$gray-3: #384347;\n$gray-3-20: rgba($gray-3, 0.2);\n$gray-3-50: rgba($gray-3, 0.5);\n\n$green-3: #2dc08d;\n$green-2: #62d0aa;\n$green-1: #d5f2e8;\n$green-hover: #249a71;\n\n$purple-3: #8c7cdb;\n$purple-2: #c5bded;\n$purple-1: #e8e5f8;\n\n$red-3: #ff576f;\n$red-2: #ffabb7;\n$red-1: #ffeef0;\n\n$blue-3: #7aaacb;\n$blue-2: #b5d6ec;\n$blue-1: #e2eff8;\n$blue-background: #f3f5fa;\n\n$yellow-3: #feb251;\n$yellow-2: #fed8a7;\n$yellow-1: #fff0dc;\n\n$background: #fafbfd;\n$brand-primary: #00c091;\n$brand-promo: #e7762e;\n$brand-success: #2dc08c !default;\n$brand-info: #5bc0de !default;\n$brand-warning: #f2994a !default;\n$brand-danger: #ff576f !default;\n$brand-border-color: #e6e6e6 !default;\n$brand-grey-background: #f2f2f2;\n$color-facebook: #3b5998;\n$color-twitter: #5eaade;\n$color-gplus: #dd4b39;\n$color-instagram: #333333;\n$color-linkedin: #2578b5;\n$color-messenger-first: rgb(1, 183, 255);\n$color-messenger-second: rgb(0, 126, 254);\n$color-messenger-border: #ffffff;\n$color-onboarding: #009ee8;\n$purple-color: #8c7cdb;\n$brand-gray-color: #65696d;\n$brand-info-font-color: #b2b4b6;\n$toolbox-border: rgba(223, 223, 223, 0.52);\n$selected-item-border-color: #60d5ba;\n\n$white: white;\n\n$op-background-color: #333333;\n$op-nav-control-color: #464646;\n$op-control-color: $gray-dark;\n$op-light-color: #e6e6e6;\n$op-control-primary-color: $brand-success;\n$op-notification-bg-primary: #ccf5e9;\n$op-notification-bg-danger: #ffc7d4;\n$op-notification-bg-warning: #ffe2ca;\n\n$op-base-offset: 8px !default;\n$op-btn-padding-horizontal: 14px;\n\n//Resume Styles\n$resume-rounding: 5px;\n\n//== Scaffolding\n//\n//## Settings for some of the most global styles.\n\n//** Background color for `<body>`.\n$body-bg: #fff !default;\n//** Global text color on `<body>`.\n$text-color: $gray-dark !default;\n\n$text-color-hover: color.adjust($text-color, $lightness: 30%) !default;\n\n//** Global textual link color.\n$link-color: white !default;\n//** Link hover color set via `darken()` function.\n$link-hover-color: color.adjust(white, $lightness: -10%);\n//** Link hover decoration.\n$link-hover-decoration: none !default;\n\n//== Typography\n//\n//## Font, line-height, and color for body text, headings, and more.\n\n$font-family-sans-serif: "Roboto", Arial, Helvetica, "Noto Sans Devanagari", "Noto Sans CJK SC Thin",\n    "Noto Sans SC", "Noto Sans Hebrew", "Noto Sans Bengali", sans-serif !default;\n$font-family-serif: Georgia, "Times New Roman", Times, "Noto Sans Devanagari",\n    "Noto Sans CJK SC Thin", "Noto Sans SC", "Noto Sans Hebrew", "Noto Sans Bengali", serif !default;\n//** Default monospace fonts for `<code>`, `<kbd>`, and `<pre>`.\n$font-family-monospace: Menlo, Monaco, Consolas, "Courier New", monospace !default;\n$font-family-base: "Inter" !default;\n\n$roboto: "Roboto", Arial, Helvetica, sans-serif;\n$opensans: "Open Sans", Arial, Helvetica, sans-serif;\n$account-heading-font: "Rubik", sans-serif !important;\n\n$font-size-base: 14px !default;\n$font-size-large: 18px !default;\n$font-size-small: 11px !default;\n\n$font-size-h1: 68px !default; // ~36px\n$font-size-h2: 38px !default; // ~30px\n$font-size-h3: 32px !default; // ~24px\n$font-size-h4: 26px !default; // ~18px\n$font-size-h5: 22px !default;\n$font-size-h6: 20px !default; // ~12px\n\n//** Unit-less `line-height` for use in components like buttons.\n$line-height-base: 1.428571429 !default; // 20/14\n//** Computed "line-height" (`font-size` * `line-height`) for use with `margin`, `padding`, etc.\n$line-height-computed: math.floor(($font-size-base * $line-height-base)) !default; // ~20px\n\n//** By default, this inherits from the `<body>`.\n$headings-font-family: "Rubik", sans-serif !default;\n$headings-font-weight: 300 !default;\n$headings-line-height: 1.1 !default;\n$headings-color: $gray-dark !default;\n\n//== Components\n//\n//## Define common padding and border radius sizes and more. Values based on 14px text and 1.428 line-height (~20px to start).\n\n$padding-base-vertical: 9px !default;\n$padding-base-horizontal: 14px !default;\n\n$padding-large-vertical: 12px !default;\n$padding-large-horizontal: 24px !default;\n\n$padding-small-vertical: 5px !default;\n$padding-small-horizontal: 18px !default;\n\n$padding-xs-vertical: 1px !default;\n$padding-xs-horizontal: 12px !default;\n\n$line-height-large: 1.3333333 !default; // extra decimals for Win 8.1 Chrome\n$line-height-small: 1.5 !default;\n\n$border-radius-base: 5px !default;\n$border-radius-large: 9px !default;\n$border-radius-small: 4px !default;\n\n//** Global color for active items (e.g., navs or dropdowns).\n$component-active-color: #fff !default;\n//** Global background color for active items (e.g., navs or dropdowns).\n$component-active-bg: $brand-primary !default;\n\n//** Width of the `border` for generating carets that indicator dropdowns.\n$caret-width-base: 4px !default;\n//** Carets increase slightly in size for larger components.\n$caret-width-large: 5px !default;\n\n//== Tables\n//\n//## Customizes the `.table` component with basic values, each used across all table variations.\n\n//** Padding for `<th>`s and `<td>`s.\n$table-cell-padding: 8px !default;\n//** Padding for cells in `.table-condensed`.\n$table-condensed-cell-padding: 5px !default;\n\n//** Default background color used for all tables.\n$table-bg: transparent !default;\n//** Background color used for `.table-striped`.\n$table-bg-accent: #f9f9f9 !default;\n//** Background color used for `.table-hover`.\n$table-bg-hover: #f5f5f5 !default;\n$table-bg-active: $table-bg-hover !default;\n\n//** Border color for table and cell borders.\n$table-border-color: #ddd !default;\n\n//== Buttons\n//\n//## For each of Bootstrap\'s buttons, define text, background and border color.\n\n$btn-font-weight: bold !default;\n\n$btn-default-color: #8c7cdb !default;\n$btn-default-bg: #fff !default;\n$btn-default-border: #8c7cdb !default;\n\n$btn-primary-color: #fff !default;\n$btn-primary-bg: $brand-primary !default;\n$btn-primary-border: $brand-primary !default;\n\n$btn-success-color: #fff !default;\n$btn-success-bg: $brand-success !default;\n$btn-success-border: color.adjust($btn-success-bg, $lightness: -5%) !default;\n\n$btn-info-color: #fff !default;\n$btn-info-bg: $brand-info !default;\n$btn-info-border: color.adjust($btn-info-bg, $lightness: -5%) !default;\n\n$btn-warning-color: #fff !default;\n$btn-warning-bg: $brand-warning !default;\n$btn-warning-border: color.adjust($btn-warning-bg, $lightness: -5%) !default;\n\n$btn-danger-color: #fff !default;\n$btn-danger-bg: $brand-danger !default;\n$btn-danger-border: color.adjust($btn-danger-bg, $lightness: -5%) !default;\n\n$btn-link-disabled-color: $gray-light !default;\n\n// Allows for customizing button radius independently from global border radius\n$btn-border-radius-base: $border-radius-base;\n$btn-border-radius-large: $border-radius-base;\n$btn-border-radius-small: $border-radius-base;\n\n//== Forms\n//\n//##\n\n//** `<input>` background color\n$input-bg: #fff !default;\n//** `<input disabled>` background color\n$input-bg-disabled: $gray-lighter !default;\n\n//** Text color for `<input>`s\n$input-color: $gray !default;\n//** `<input>` border color\n$input-border: #b3b3b3 !default;\n\n// TODO: Rename `$input-border-radius` to `$input-border-radius-base` in v4\n//** Default `.form-control` border radius\n// This has no effect on `<select>`s in some browsers, due to the limited stylability of `<select>`s in CSS.\n$input-border-radius: $border-radius-base;\n//** Large `.form-control` border radius\n$input-border-radius-large: $border-radius-base;\n//** Small `.form-control` border radius\n$input-border-radius-small: $border-radius-base;\n\n//** Border color for inputs on focus\n$input-border-focus: $brand-primary !default;\n\n//** Placeholder text color\n$input-color-placeholder: color.adjust($gray-base, $lightness: 70%) !default;\n\n//** Default `.form-control` height\n$input-height-base: ($line-height-computed + ($padding-base-vertical * 2) + 2) !default;\n//** Large `.form-control` height\n$input-height-large: (\n    math.ceil($font-size-large * $line-height-large) + ($padding-large-vertical * 2) + 2\n) !default;\n//** Small `.form-control` height\n$input-height-small: (\n    math.floor($font-size-small * $line-height-small) + ($padding-small-vertical * 2) + 2\n) !default;\n\n//** `.form-group` margin\n$form-group-margin-bottom: 15px !default;\n\n$legend-color: $gray-dark !default;\n$legend-border-color: #e5e5e5 !default;\n\n//** Background color for textual input addons\n$input-group-addon-bg: $gray-lighter !default;\n//** Border color for textual input addons\n$input-group-addon-border-color: $input-border !default;\n\n//** Disabled cursor for form controls and buttons.\n$cursor-disabled: not-allowed !default;\n\n//== Dropdowns\n//\n//## Dropdown menu container and contents.\n\n//** Background for the dropdown menu.\n$dropdown-bg: #fff !default;\n//** Dropdown menu `border-color`.\n$dropdown-border: rgba(0, 0, 0, 0.15) !default;\n//** Dropdown menu `border-color` **for IE8**.\n$dropdown-fallback-border: #ccc !default;\n//** Divider color for between dropdown items.\n$dropdown-divider-bg: #e5e5e5 !default;\n\n//** Dropdown link text color.\n$dropdown-link-color: $gray-dark !default;\n//** Hover color for dropdown links.\n$dropdown-link-hover-color: color.adjust($gray-dark, $lightness: 50%) !default;\n//** Hover background for dropdown links.\n$dropdown-link-hover-bg: transparent !default;\n\n//** Active dropdown menu item text color.\n$dropdown-link-active-color: $component-active-color !default;\n//** Active dropdown menu item background color.\n$dropdown-link-active-bg: $component-active-bg !default;\n\n//** Disabled dropdown menu item background color.\n$dropdown-link-disabled-color: $gray-light !default;\n\n//** Text color for headers within dropdown menus.\n$dropdown-header-color: $gray-light !default;\n\n//** Deprecated `$dropdown-caret-color` as of v3.1.0\n$dropdown-caret-color: #000 !default;\n\n//-- Z-index master list\n//\n// Warning: Avoid customizing these values. They\'re used for a bird\'s eye view\n// of components dependent on the z-axis and are designed to all work together.\n//\n// Note: These variables are not generated into the Customizer.\n\n$zindex-navbar: 1000 !default;\n$zindex-dropdown: 1000 !default;\n$zindex-mobile-design-menu: 1001 !default;\n$zindex-modal-background: 1002 !default; // from style guide --\x3e\n$zindex-modal-content: 1003 !default; // <--\n$zindex-full-screen-dropdown: 1004 !default;\n$zindex-popover: 1020 !default;\n$zindex-tooltip: 1050 !default;\n$zindex-navbar-fixed: 1030 !default;\n$zindex-toaster: 1030 !default;\n$zindex-alert: 1060 !default;\n$zindex-op-currdoing-cirle: 100 !default;\n$zindex-op-section-controls: 1 !default;\n$zindex-toasters: 8000 !default;\n\n//== Media queries breakpoints\n//\n//## Define the breakpoints at which your layout will change, adapting to different screen sizes.\n\n//== Grid system\n//\n//## Define your custom responsive grid.\n\n//** Number of columns in the grid.\n$grid-columns: 12 !default;\n//** Padding between columns. Gets divided in half for the left and right.\n$grid-gutter-width: 20px !default;\n\n//== Navbar OP\n//\n//##\n$op-navbar-height: 64px !default;\n$op-navbar-padding: 2 * $op-base-offset !default;\n\n//== Navbar\n//\n//##\n\n// Basics of a navbar\n$navbar-height: 60px !default;\n$navbar-padding: 16px !default;\n$navbar-margin-bottom: 0 !default;\n$navbar-border-radius: 0 !default;\n$navbar-padding-horizontal: math.floor(($grid-gutter-width * 0.5)) !default;\n$navbar-padding-vertical: (($navbar-height - $line-height-computed) * 0.5) !default;\n$navbar-collapse-max-height: 340px !default;\n\n$navbar-default-color: $text-color !default;\n$navbar-default-bg: white !default;\n$navbar-default-border: transparent !default;\n\n// Navbar links\n$navbar-default-link-color: $text-color !default;\n$navbar-default-link-hover-color: $purple-color !default;\n$navbar-default-link-hover-bg: transparent !default;\n$navbar-default-link-active-color: #b2b4b6 !default;\n$navbar-default-link-active-bg: color.adjust($navbar-default-bg, $lightness: -6.5%) !default;\n$navbar-default-link-disabled-color: #ccc !default;\n$navbar-default-link-disabled-bg: transparent !default;\n\n// Navbar brand label\n$navbar-default-brand-color: #e6e6e6 !default;\n$navbar-default-brand-hover-color: color.adjust(\n    $navbar-default-brand-color,\n    $lightness: -10%\n) !default;\n$navbar-default-brand-hover-bg: transparent !default;\n\n// Navbar toggle\n$navbar-default-toggle-hover-bg: color.adjust(white, $lightness: -5%) !default;\n$navbar-default-toggle-icon-bar-bg: $text-color !default;\n$navbar-default-toggle-border-color: transparent !default;\n\n//=== Inverted navbar\n// Reset inverted navbar basics\n$navbar-inverse-color: $brand-gray-color !default;\n$navbar-inverse-bg: white !default;\n$navbar-inverse-border: $brand-border-color !default;\n\n// Inverted navbar links\n$navbar-inverse-link-color: $brand-gray-color !default;\n$navbar-inverse-link-hover-color: $text-color;\n$navbar-inverse-link-hover-bg: transparent !default;\n$navbar-inverse-link-active-color: $navbar-inverse-link-hover-color !default;\n$navbar-inverse-link-active-bg: color.adjust($navbar-inverse-bg, $lightness: -10%) !default;\n$navbar-inverse-link-disabled-color: #444 !default;\n$navbar-inverse-link-disabled-bg: transparent !default;\n\n// Inverted navbar brand label\n$navbar-inverse-brand-color: $navbar-inverse-link-color !default;\n$navbar-inverse-brand-hover-color: #fff !default;\n$navbar-inverse-brand-hover-bg: transparent !default;\n\n// Inverted navbar toggle\n$navbar-inverse-toggle-hover-bg: color.adjust(white, $lightness: -10%) !default;\n$navbar-inverse-toggle-icon-bar-bg: $gray !default;\n$navbar-inverse-toggle-border-color: $gray !default;\n\n//== Navs\n//\n//##\n\n//=== Shared nav styles\n$nav-link-padding: 12px 15px !default;\n$nav-link-hover-bg: transparent !default;\n\n$nav-disabled-link-color: $gray-light !default;\n$nav-disabled-link-hover-color: transparent !default;\n\n//== Tabs\n$nav-tabs-border-color: #ddd !default;\n\n$nav-tabs-link-hover-border-color: $gray-lighter !default;\n\n$nav-tabs-active-link-hover-bg: $body-bg !default;\n$nav-tabs-active-link-hover-color: $gray !default;\n$nav-tabs-active-link-hover-border-color: #ddd !default;\n\n$nav-tabs-justified-link-border-color: #ddd !default;\n$nav-tabs-justified-active-link-border-color: $body-bg !default;\n\n//== Pills\n$nav-pills-border-radius: $border-radius-base !default;\n$nav-pills-active-link-hover-bg: transparent !default;\n$nav-pills-active-link-hover-color: $brand-primary !default;\n\n//== Pagination\n//\n//##\n\n$pagination-color: $link-color !default;\n$pagination-bg: #fff !default;\n$pagination-border: #ddd !default;\n\n$pagination-hover-color: $link-hover-color !default;\n$pagination-hover-bg: $gray-lighter !default;\n$pagination-hover-border: #ddd !default;\n\n$pagination-active-color: #fff !default;\n$pagination-active-bg: $brand-primary !default;\n$pagination-active-border: $brand-primary !default;\n\n$pagination-disabled-color: $gray-light !default;\n$pagination-disabled-bg: #fff !default;\n$pagination-disabled-border: #ddd !default;\n\n//== Pager\n//\n//##\n\n$pager-bg: $pagination-bg !default;\n$pager-border: $pagination-border !default;\n$pager-border-radius: 15px !default;\n\n$pager-hover-bg: $pagination-hover-bg !default;\n\n$pager-active-bg: $pagination-active-bg !default;\n$pager-active-color: $pagination-active-color !default;\n\n$pager-disabled-color: $pagination-disabled-color !default;\n\n//== Jumbotron\n//\n//##\n\n$jumbotron-padding: 30px !default;\n$jumbotron-color: inherit !default;\n$jumbotron-bg: $gray-lighter !default;\n$jumbotron-heading-color: inherit !default;\n$jumbotron-font-size: math.ceil(($font-size-base * 1.5)) !default;\n$jumbotron-heading-font-size: math.ceil(($font-size-base * 4.5)) !default;\n\n//== Form states and alerts\n//\n//## Define colors for form feedback states and, by default, alerts.\n\n$state-success-text: #00c091 !default;\n$state-success-bg: #caf3e9 !default;\n$state-success-border: color.adjust(\n    color.adjust($state-success-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n$state-info-text: #31708f !default;\n$state-info-bg: #d9edf7 !default;\n$state-info-border: color.adjust(color.adjust($state-info-bg, $hue: -10), $lightness: -7%) !default;\n\n$state-warning-text: $brand-warning !default;\n$state-warning-bg: #fcf8e3 !default;\n$state-warning-border: color.adjust(\n    color.adjust($state-warning-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n$state-danger-text: $brand-danger !default;\n$state-danger-bg: #ffcbd6 !default;\n$state-danger-border: color.adjust(\n    color.adjust($state-danger-bg, $hue: -10),\n    $lightness: -5%\n) !default;\n\n//== Tooltips\n//\n//##\n\n//** Tooltip max width\n$tooltip-max-width: 300px !default;\n//** Tooltip text color\n$tooltip-color: #fff !default;\n//** Tooltip background color\n$tooltip-bg: $gray-dark !default;\n$tooltip-opacity: 0.9 !default;\n\n//** Tooltip arrow width\n$tooltip-arrow-width: 5px !default;\n//** Tooltip arrow color\n$tooltip-arrow-color: $tooltip-bg !default;\n\n//== Popovers\n//\n//##\n\n//** Popover body background color\n$popover-bg: #fff !default;\n//** Popover maximum width\n$popover-max-width: 276px !default;\n//** Popover border color\n$popover-border-color: rgba(0, 0, 0, 0.2) !default;\n//** Popover fallback border color\n$popover-fallback-border-color: #ccc !default;\n\n//** Popover title background color\n$popover-title-bg: color.adjust($popover-bg, $lightness: -3%) !default;\n\n//** Popover arrow width\n$popover-arrow-width: 10px !default;\n//** Popover arrow color\n$popover-arrow-color: $popover-bg !default;\n\n//** Popover outer arrow width\n$popover-arrow-outer-width: ($popover-arrow-width + 1) !default;\n//** Popover outer arrow color\n$popover-arrow-outer-color: color.adjust($popover-border-color, $alpha: 0.05) !default;\n//** Popover outer arrow fallback color\n$popover-arrow-outer-fallback-color: color.adjust(\n    $popover-fallback-border-color,\n    $lightness: -20%\n) !default;\n\n//== Labels\n//\n//##\n\n//** Default label background color\n$label-default-bg: $gray-light !default;\n//** Primary label background color\n$label-primary-bg: $brand-primary !default;\n//** Success label background color\n$label-success-bg: $brand-success !default;\n//** Info label background color\n$label-info-bg: $brand-info !default;\n//** Warning label background color\n$label-warning-bg: $brand-warning !default;\n//** Danger label background color\n$label-danger-bg: $brand-danger !default;\n\n//** Default label text color\n$label-color: #fff !default;\n//** Default text color of a linked label\n$label-link-hover-color: #fff !default;\n$label-gray: #60696c;\n\n//== Modals\n//\n//##\n\n//** Padding applied to the modal body\n$modal-inner-padding: 35px 40px !default;\n\n//** Padding applied to the modal title\n$modal-title-padding: 35px 40px 35px 40px !default;\n//** Modal title line-height\n$modal-title-line-height: $line-height-base !default;\n\n//** Background color of modal content area\n$modal-content-bg: #fff !default;\n//** Modal content border color\n$modal-content-border-color: rgba(255, 255, 255, 0) !default;\n//** Modal content border color **for IE8**\n$modal-content-fallback-border-color: #999 !default;\n\n//** Modal backdrop background color\n$modal-backdrop-bg: #00bf93 !default;\n//** Modal backdrop opacity\n$modal-backdrop-opacity: 0.5 !default;\n//** Modal header border color\n$modal-header-border-color: #e6e6e6 !default;\n//** Modal footer border color\n$modal-footer-border-color: $modal-header-border-color !default;\n\n$modal-lg: 820px !default;\n$modal-md: 630px !default;\n$modal-sm: 420px !default;\n\n//== Alerts\n//\n//## Define alert colors, border radius, and padding.\n\n$alert-padding: 8px 15px !default;\n$alert-border-radius: 45px !default;\n$alert-link-font-weight: bold !default;\n\n$alert-success-bg: $state-success-bg !default;\n$alert-success-text: $state-success-text !default;\n$alert-success-border: #fff !default;\n\n$alert-info-bg: $state-info-bg !default;\n$alert-info-text: $state-info-text !default;\n$alert-info-border: #fff !default;\n\n$alert-warning-bg: $state-warning-bg !default;\n$alert-warning-text: $state-warning-text !default;\n$alert-warning-border: #fff !default;\n\n$alert-danger-bg: $state-danger-bg !default;\n$alert-danger-text: $state-danger-text !default;\n$alert-danger-border: #fff !default;\n\n//== Progress bars\n//\n//##\n\n//** Background color of the whole progress component\n$progress-bg: #e6e6e6 !default;\n//** Progress bar text color\n$progress-bar-color: #fff !default;\n//** Variable for setting rounded corners on progress bar.\n$progress-border-radius: 12px !default;\n\n//** Default progress bar color\n$progress-bar-bg: $brand-primary !default;\n//** Success progress bar color\n$progress-bar-success-bg: $brand-success !default;\n//** Warning progress bar color\n$progress-bar-warning-bg: $brand-warning !default;\n//** Danger progress bar color\n$progress-bar-danger-bg: $brand-danger !default;\n//** Info progress bar color\n$progress-bar-info-bg: $brand-info !default;\n\n//== List group\n//\n//##\n\n//** Background color on `.list-group-item`\n$list-group-bg: #fff !default;\n//** `.list-group-item` border color\n$list-group-border: #ddd !default;\n//** List group border radius\n$list-group-border-radius: $border-radius-base !default;\n\n//** Background color of single list items on hover\n$list-group-hover-bg: #f5f5f5 !default;\n//** Text color of active list items\n$list-group-active-color: $component-active-color !default;\n//** Background color of active list items\n$list-group-active-bg: $component-active-bg !default;\n//** Border color of active list elements\n$list-group-active-border: $list-group-active-bg !default;\n//** Text color for content within active list items\n$list-group-active-text-color: color.adjust($list-group-active-bg, $lightness: 40%) !default;\n\n//** Text color of disabled list items\n$list-group-disabled-color: $gray-light !default;\n//** Background color of disabled list items\n$list-group-disabled-bg: $gray-lighter !default;\n//** Text color for content within disabled list items\n$list-group-disabled-text-color: $list-group-disabled-color !default;\n\n$list-group-link-color: #555 !default;\n$list-group-link-hover-color: $list-group-link-color !default;\n$list-group-link-heading-color: #333 !default;\n\n//== Panels\n//\n//##\n\n$panel-bg: #fff !default;\n$panel-body-padding: 15px !default;\n$panel-heading-padding: 10px 15px !default;\n$panel-footer-padding: $panel-heading-padding !default;\n$panel-border-radius: $border-radius-base !default;\n\n//** Border color for elements within panels\n$panel-inner-border: #ddd !default;\n$panel-footer-bg: #f5f5f5 !default;\n\n$panel-default-text: $gray-dark !default;\n$panel-default-border: #ddd !default;\n$panel-default-heading-bg: #f5f5f5 !default;\n\n$panel-primary-text: #fff !default;\n$panel-primary-border: $brand-primary !default;\n$panel-primary-heading-bg: $brand-primary !default;\n\n$panel-success-text: $state-success-text !default;\n$panel-success-border: $state-success-border !default;\n$panel-success-heading-bg: $state-success-bg !default;\n\n$panel-info-text: $state-info-text !default;\n$panel-info-border: $state-info-border !default;\n$panel-info-heading-bg: $state-info-bg !default;\n\n$panel-warning-text: $state-warning-text !default;\n$panel-warning-border: $state-warning-border !default;\n$panel-warning-heading-bg: $state-warning-bg !default;\n\n$panel-danger-text: $state-danger-text !default;\n$panel-danger-border: $state-danger-border !default;\n$panel-danger-heading-bg: $state-danger-bg !default;\n\n//== Thumbnails\n//\n//##\n\n//** Padding around the thumbnail image\n$thumbnail-padding: 4px !default;\n//** Thumbnail background color\n$thumbnail-bg: $body-bg !default;\n//** Thumbnail border color\n$thumbnail-border: #ddd !default;\n//** Thumbnail border radius\n$thumbnail-border-radius: $border-radius-base !default;\n\n//** Custom text color for thumbnail captions\n$thumbnail-caption-color: $text-color !default;\n//** Padding around the thumbnail caption\n$thumbnail-caption-padding: 9px !default;\n\n//== Wells\n//\n//##\n\n$well-bg: #f5f5f5 !default;\n$well-border: color.adjust($well-bg, $lightness: -7%) !default;\n\n//== Badges\n//\n//##\n\n$badge-color: #fff !default;\n//** Linked badge text color on hover\n$badge-link-hover-color: #fff !default;\n$badge-bg: $gray-light !default;\n\n//** Badge text color in active nav link\n$badge-active-color: $link-color !default;\n//** Badge background color in active nav link\n$badge-active-bg: #fff !default;\n\n$badge-font-weight: bold !default;\n$badge-line-height: 1 !default;\n$badge-border-radius: 35px !default;\n\n//== Breadcrumbs\n//\n//##\n\n$breadcrumb-padding-vertical: 8px !default;\n$breadcrumb-padding-horizontal: 15px !default;\n//** Breadcrumb background color\n$breadcrumb-bg: #f5f5f5 !default;\n//** Breadcrumb text color\n$breadcrumb-color: #ccc !default;\n//** Text color of current page in the breadcrumb\n$breadcrumb-active-color: $gray-light !default;\n//** Textual separator for between breadcrumb elements\n$breadcrumb-separator: "/" !default;\n\n//== Carousel\n//\n//##\n\n$carousel-text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6) !default;\n\n$carousel-control-color: #fff !default;\n$carousel-control-width: 15% !default;\n$carousel-control-opacity: 0.5 !default;\n$carousel-control-font-size: 20px !default;\n\n$carousel-indicator-active-bg: #fff !default;\n$carousel-indicator-border-color: #fff !default;\n\n$carousel-caption-color: #fff !default;\n\n//== Close\n//\n//##\n\n$close-font-weight: bold !default;\n$close-color: #000 !default;\n$close-text-shadow: 0 1px 0 #fff !default;\n\n//== Code\n//\n//##\n\n$code-color: #c7254e !default;\n$code-bg: #f9f2f4 !default;\n\n$kbd-color: #fff !default;\n$kbd-bg: #333 !default;\n\n$pre-bg: #f5f5f5 !default;\n$pre-color: $gray-dark !default;\n$pre-border-color: #ccc !default;\n$pre-scrollable-max-height: 340px !default;\n\n//== Type\n//\n//##\n\n//** Horizontal offset for forms and lists.\n$component-offset-horizontal: 180px !default;\n//** Text muted color\n$text-muted: $gray-lighter !default;\n//** Abbreviations and acronyms border color\n$abbr-border-color: $gray-light !default;\n//** Headings small color\n$headings-small-color: $gray-light !default;\n//** Blockquote small color\n$blockquote-small-color: $gray-light !default;\n//** Blockquote font size\n$blockquote-font-size: ($font-size-base * 1.25) !default;\n//** Blockquote border color\n$blockquote-border-color: $gray-lighter !default;\n//** Page header border color\n$page-header-border-color: $gray-lighter !default;\n//** Horizontal line color.\n$hr-border: $gray-1-50 !default;\n'],sourceRoot:""}]),l.locals={icon:"CustomItemIvyLeague-module_icon__ql5MJ",description:"CustomItemIvyLeague-module_description__LJRbb",formatBullets:"CustomItemIvyLeague-module_formatBullets__koO3k"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/packages/Resume/ItemTypes/Custom/CustomItemMinimal.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,'.CustomItemMinimal-module_formatBullets__WSeYG ul{list-style:none;padding-left:16px}.CustomItemMinimal-module_formatBullets__WSeYG ul li::before{content:"•";position:absolute;vertical-align:middle;left:4px}',"",{version:3,sources:["webpack://./src/packages/Resume/ItemTypes/Custom/CustomItemMinimal.module.scss"],names:[],mappings:"AAAA,kDAGI,eACI,CAAA,iBACA,CAAA,6DAGI,WACI,CAAA,iBACA,CAAA,qBACA,CAAA,QACA",sourcesContent:['@import "~sharedstyle/variables";\n\n.formatBullets {\n    ul {\n        list-style: none;\n        padding-left: 16px;\n\n        li {\n            &::before {\n                content: "•";\n             