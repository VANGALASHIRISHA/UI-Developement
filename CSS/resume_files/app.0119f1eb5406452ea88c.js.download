ents: none;\n    z-index: 10;\n    overflow: hidden;\n    width: 100%;\n\n    :global(.resume-renderer-page.browser-resume-page) {\n        background: transparent !important;\n    }\n\n    :global(.browser-resume-page::before),\n    :global(.browser-resume-page::after) {\n        content: none !important;\n    }\n\n    :global(.resume-background-wrapper) {\n        display: none !important;\n    }\n}\n'],sourceRoot:""}]),l.locals={canvasContainer:"Canvas-module_canvasContainer__uzX59",canvas:"Canvas-module_canvas__ZOGLI",draggedOver:"Canvas-module_draggedOver__cG5do",resumeOverlay:"Canvas-module_resumeOverlay__f_T3t"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/modules/Modal/shared/components/CanvasElement.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,".CanvasElement-module_imageElement__k6qsk{position:absolute;cursor:move;z-index:10;border:2px solid transparent;border-radius:4px;transition:all .2s ease;box-sizing:border-box;transition:transform .1s ease-out,border-color .2s ease,box-shadow .2s ease}.CanvasElement-module_imageElement__k6qsk:hover{border-color:rgba(95,77,199,.5);box-shadow:0px 4px 8px rgba(0,0,0,.1)}.CanvasElement-module_imageElement__k6qsk.CanvasElement-module_selected__dDMIh{border-color:#5f4dc7;box-shadow:0px 2px 20px rgba(0,0,0,.1)}.CanvasElement-module_imageElement__k6qsk .CanvasElement-module_elementImage__IRYEu{width:100%;height:100%;object-fit:cover;border-radius:2px;pointer-events:none;display:block;user-select:none;-webkit-user-drag:none}.CanvasElement-module_textElement__s5u7a{width:100%;height:100%;display:flex;align-items:center;justify-content:center;user-select:none;cursor:move;text-align:center;word-wrap