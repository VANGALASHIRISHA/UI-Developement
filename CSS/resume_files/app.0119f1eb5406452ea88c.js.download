\n        background-color: rgba($modal, 0.9);\n        position: absolute;\n        bottom: 0;\n        left: 50%;\n        transform: translate(-50%, 50%);\n        z-index: 3;\n    }\n}\n\n.progressCircleContainer {\n    height: 65px;\n    width: 130px;\n    position: relative;\n    overflow: hidden;\n}\n\n.progressCircle {\n    width: 130px;\n    height: 130px;\n    border-radius: 50%;\n    position: relative;\n\n    &::before {\n        content: "";\n        width: 98px;\n        height: 98px;\n        border-radius: 50%;\n        position: absolute;\n        top: 50%;\n        left: 50%;\n        z-index: 2;\n        transform: translate(-50%, -50%);\n        background-color: $surface;\n    }\n}\n\n.skeleton {\n    position: relative;\n    overflow: hidden;\n    background-color: $graphic-2;\n\n    &::after {\n        position: absolute;\n        top: 0;\n        right: 0;\n        bottom: 0;\n        left: 0;\n        transform: translateX(-100%);\n        /* stylelint-disable */\n        background-image: linear-gradient(\n            110deg,\n            rgba($graphic-1, 0) 5%,\n            rgba($white, 0.5) 50%,\n            rgba($graphic-1, 0) 95%\n        );\n        animation: skeleton 2s infinite linear;\n        content: "";\n    }\n\n    @keyframes skeleton {\n        100% {\n            transform: translateX(100%);\n        }\n    }\n}\n\n.skeletonTitle {\n    border-radius: 50px;\n    width: 89px;\n    height: 24px;\n}\n\n.skeletonSubtitle {\n    border-radius: 50px;\n    width: 89px;\n    height: 16px;\n}\n\n.containerBox {\n    border-radius: 25px;\n    height: 100%;\n}\n\n.titleContent {\n    color: $heading;\n    transition: all ease-in-out 300ms;\n    position: relative;\n\n    &::after {\n        display: block;\n        position: absolute;\n        width: 100%;\n        left: 0;\n        bottom: 0px;\n        content: "";\n        border-bottom: solid 2px $page-alt;\n        transform: scaleX(0);\n        transition: transform 300ms ease-in-out;\n    }\n\n    &.active {\n        .check {\n            color: $white;\n        }\n\n        .icon {\n            path {\n                fill: $secondary-active;\n                stroke: $secondary-active;\n            }\n        }\n    }\n\n    &.current {\n        &::after {\n            transform: scale(1);\n        }\n\n        .check {\n            color: $secondary-active;\n        }\n\n        .icon {\n            path {\n                fill: rgba($secondary, 0.2);\n                transform-origin: center;\n                stroke: $secondary-active;\n                animation: shimmer 3s infinite;\n\n                @keyframes shimmer {\n                    0% {\n                        transform: rotate(0deg);\n                    }\n\n                    80% {\n                        transform: rotate(160deg);\n                    }\n\n                    100% {\n                        transform: rotate(0dex);\n                    }\n                }\n            }\n        }\n    }\n}\n\n.icon {\n    path {\n        transition: 0.4s;\n        fill: transparent;\n        stroke: $secondary-active;\n        d: path(\n            "M16.25 1.87639L25.1064 6.98964C26.4987 7.79348 27.3564 9.27906 27.3564 10.8868V21.1132C27.3564 22.7209 26.4987 24.2065 25.1064 25.0104L16.25 30.1236C14.8577 30.9275 13.1423 30.9275 11.75 30.1236L2.89359 25.0104C1.50129 24.2065 0.643594 22.7209 0.643594 21.1132V10.8868C0.643594 9.27906 1.50129 7.79348 2.89359 6.98964L11.75 1.87639C13.1423 1.07254 14.8577 1.07254 16.25 1.87639Z"\n        );\n    }\n}\n\n.check {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    color: $secondary-active;\n    transition: all ease-in-out 300ms;\n    font-size: 16px;\n}\n\n.iconContainer {\n    position: relative;\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tab