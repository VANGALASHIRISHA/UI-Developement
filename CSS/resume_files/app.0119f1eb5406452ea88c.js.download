feItemContemporary.module.scss","webpack://./node_modules/enhancv-styleguide/variables.scss"],names:[],mappings:"AAIA,0GAEI,SAAA,CACA,kBAAA,CACA,aAAA,CAGJ,kDACI,iBAAA,CAGJ,wDACI,gBAAA,CAGJ,sDACI,YAAA,CACA,kBAAA,CACA,gBAAA,CACA,eAAA,CAGJ,iDACI,UAAA,CACA,oBAAA,CACA,UAAA,CACA,WAAA,CACA,cAAA,CACA,gBAAA,CACA,UAAA,CACA,kBAAA,CACA,iBAAA,CACA,gBCnCU,CDoCV,iBAAA,CACA,UAAA,CAGJ,0DACI,UAAA,CACA,uBAAA,CAGJ,uDACI,qBAAA,CAGJ,iDACI,qBAAA,CAGJ,gDACI,YAAA,CACA,4BAAA,CAGJ,wDACI,SAAA,CACA,oBAAA,CACA,kBAAA",sourcesContent:['@import "~enhancv-styleguide/variables";\n\n// TODO: clean css\n\n.labels,\n.narrowLabels {\n    width: 50%;\n    vertical-align: top;\n    margin: auto 0;\n}\n\n.labels {\n    padding-left: $base-offset * 2;\n}\n\n.narrowLabels {\n    padding-top: $base-offset * 2;\n}\n\n.labelsItem {\n    display: flex;\n    align-items: center;\n    padding: 4px $base-offset * 2;\n    overflow: hidden;\n}\n\n.label {\n    float: left;\n    display: inline-block;\n    width: 20px;\n    height: 20px;\n    font-size: 12px;\n    line-height: 20px;\n    color: #fff;\n    border-radius: 10px;\n    text-align: center;\n    margin-right: $base-offset;\n    position: relative;\n    z-index: 10;\n}\n\n.fieldContainer {\n    float: left;\n    width: calc(100% - 30px);\n}\n\n.isFullWidth {\n    width: 100% !important;\n}\n\n.title {\n    vertical-align: middle;\n}\n\n.flex {\n    display: flex;\n    justify-content: space-around;\n}\n\n.chartWrapper {\n    width: 50%;\n    display: inline-block;\n    vertical-align: top;\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm