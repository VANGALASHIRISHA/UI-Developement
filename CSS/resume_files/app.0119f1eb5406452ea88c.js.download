 #5f4dc7 54.1%, #9747ff 100%);\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n}\n\n.contentContainerAnimation {\n    animation-delay: 0.4s;\n    --translateY: 10%;\n}\n\n.avatarFloat {\n    &.loading {\n        animation: floatAnimation 3s ease-in-out infinite;\n    }\n}\n\n@keyframes floatAnimation {\n    0% {\n        transform: translate(0, 0);\n    }\n\n    50% {\n        transform: translate(4px, -4px);\n    }\n\n    100% {\n        transform: translate(0, 0);\n    }\n}\n\n.spinIcon {\n    animation: spin 2s linear infinite;\n}\n\n@keyframes spin {\n    from {\n        transform: rotate(0deg);\n    }\n\n    to {\n        transform: rotate(360deg);\n    }\n}\n'],sourceRoot:""}]),l.locals={fullSize:"InterviewHelpLoadingPage-module_fullSize__deRuq",gradientHeader:"InterviewHelpLoadingPage-module_gradientHeader__Z6P7O",contentContainerAnimation:"InterviewHelpLoadingPage-module_contentContainerAnimation__jCFao",avatarFloat:"InterviewHelpLoadingPage-module_avatarFloat__UI5wy",loading:"InterviewHelpLoadingPage-module_loading__qfKVq",floatAnimation:"InterviewHelpLoadingPage-module_floatAnimation__BNbQj",spinIcon:"InterviewHelpLoadingPage-module_spinIcon__FN3ZM",spin:"InterviewHelpLoadingPage-module_spin__vCuvT"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/pages/InterviewSimulation/InterviewSimulationPage.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,'.InterviewSimulationPage-module_pageBackground__voqlU{background:#f5f7fc}.InterviewSimulationPage-module_fullSize__f7j2Z{max-width:1328px;margin:0 auto;width:100%;padding:32px 56px;box-sizing:border-box}@media(max-width: 768px){.InterviewSimulationPage-module_fullSize__f7j2Z{padding:16px 0px}}.InterviewSimulationPage-module_topNav__celBB{background:#fff;border:1px solid #e4e4e4;border-radius:16px;box-shadow:0px 2px 20px rgba(0,0,0,.1);padding:16px 24px;display:flex;flex-direction:column;gap:8px;margin-bottom:16px;box-sizing:border-box;min-height:88px}@media(max-width: 768px){.InterviewSimulationPage-module_topNav__celBB{padding:16px}}.InterviewSimulationPage-module_topNavRow__qTeSt{display:grid;grid-template-columns:auto 1fr auto;align-items:center;column-gap:24px;width:100%}@media screen and (max-width: 768px){.InterviewSimulationPage-module_topNavRow__qTeSt{grid-template-columns:1fr;column-gap:8px}}.InterviewSimulationPage-module_backLink__eFPha{display:inline-flex;align-items:center;gap:8px;color:#384347;text-decoration:none;padding:6px 0;transition:color .2s ease}.InterviewSimulationPage-module_backLink__eFPha:hover{color:#2d3639}.InterviewSimulationPage-module_roleWrapper__r4BXH{display:flex;align-items:center;justify-content:center;gap:8px;min-width:0}@media screen and (max-width: 768px){.InterviewSimulationPage-module_roleWrapper__r4BXH{display:block}}.InterviewSimulationPage-module_roleTitle__FSYEW{margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:inline-block;background:linear-gradient(90deg, #2d3639 2.59%, #5f4dc7 54.1%, #9747ff 100%);background-clip:text;-webkit-text-fill-color:transparent}.InterviewSimulationPage-module_roleDivider__nBxmu{width:16px;height:2px;background:#5f4dc7;border-radius:8px;flex-shrink:0}.InterviewSimulationPage-module_companyName__THVGv{color:#5f4dc7;white-space:nowrap;text-overflow:ellipsis;overflow:hidden}.InterviewSimulationPage-module_badge__y7Azs{background:#f3f2fb;color:#5f4dc7;padding:4px 8px;border-radius:4px;white-space:nowrap;justify-self:end;text-align:center}.InterviewSimulationPage-module_chatPanel__jIgVl{flex:1;background:#fff;border:1px solid #e4e4e4;border-radius:16px;box-shadow:0px 2px 20px rgba(0,0,0,.1);padding:24px 0px;display:flex;flex-direction:col