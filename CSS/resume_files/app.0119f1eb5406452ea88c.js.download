reen-1: #abe6d1;\n$visual-green-2: #cdf0e4;\n$visual-blue: #b2d7f1;\n$visual-orange: #ffe0b9;\n$visual-pink: #ffcdd4;\n\n// // Shadows\n$shadow-default: 0px 4px 8px rgba(0, 0, 0, 0.1);\n$shadow-hover: 0px 2px 20px rgba(0, 0, 0, 0.1);\n$shadow-flat: 1px 1px 1px rgba(231, 228, 228, 0.5);\n$shadow-main-navigation: 0px 1px 3px rgba(0, 0, 0, 0.1);\n\n// Font-sizes\n$font-size-lg: 20px;\n$font-size-md: 18px;\n$font-size-rg: 16px;\n$font-size-sm: 14px;\n$font-size-xs: 12px;\n$font-size-xs-min: 10px;\n\n// Container - (with padding-inline:16px included)\n$container-xs: 100%;\n$container-md: 736px; // 12columns x 64px\n$container-lg: 956px; // 12columns x 84px\n$container-xl: 1184px; // 12columns x 96px\n$container-xxl: 1328px; // 12columns x 108px\n\n// Z-index modal\n$zindex-modal-background: 1002;\n$zindex-modal-content: 1003;\n'],sourceRoot:""}]),l.locals={content:"InterviewHelpReportPage-module_content__JjIg6",fullSize:"InterviewHelpReportPage-module_fullSize__yW5tn",gradientHeader:"InterviewHelpReportPage-module_gradientHeader__GN71x",progressBarContainer:"InterviewHelpReportPage-module_progressBarContainer__hHiB7",progressBar:"InterviewHelpReportPage-module_progressBar___R1W5",borderActive:"InterviewHelpReportPage-module_borderActive__LbFmb",gradientBorder:"InterviewHelpReportPage-module_gradientBorder__A59s6",editIcon:"InterviewHelpReportPage-module_editIcon__qqD73",hr:"InterviewHelpReportPage-module_hr__HLCcA",borderSuccess:"InterviewHelpReportPage-module_borderSuccess__U0Meb",borderDanger:"InterviewHelpReportPage-module_borderDanger__BZmAY",latestNewsLinks:"InterviewHelpReportPage-module_latestNewsLinks__t8o7Y",addSkillButton:"InterviewHelpReportPage-module_addSkillButton__rhxDn",scrollMobileBarContainer:"InterviewHelpReportPage-module_scrollMobileBarContainer__TzBh_",scrollMobileBarIcon:"InterviewHelpReportPage-module_scrollMobileBarIcon__jv9fG",scrollMobileBar:"InterviewHelpReportPage-module_scrollMobileBar__mXEr5",loaderOverlay:"InterviewHelpReportPage-module_lo