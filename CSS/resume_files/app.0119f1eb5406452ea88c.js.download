        animation-delay: 0.1s;\n\n        @media (max-width: $screen-sm-max) {\n            right: 5px;\n            width: 68px;\n        }\n    }\n\n    &:nth-child(3) {\n        bottom: 0;\n        right: 37px;\n        width: 108px;\n        animation-delay: 0.1s;\n\n        @media (max-width: $screen-sm-max) {\n            bottom: 0px;\n            right: 15px;\n            width: 60px;\n        }\n    }\n}\n\n.animatedOnboardingPhoto {\n    top: 45px;\n    left: 45px;\n    border-radius: 70px;\n    width: 140px;\n    height: 140px;\n    position: absolute;\n    z-index: 5;\n\n    &.invisible {\n        opacity: 0;\n    }\n\n    @media (max-width: $screen-sm-max) {\n        width: 95px;\n        height: 95px;\n        left: 0;\n        right: 0;\n        top: 0;\n        bottom: 0;\n        margin: auto;\n    }\n}\n\n@keyframes moveHeaderUp {\n    from {\n        transform: translateY(100px);\n    }\n\n    to {\n        transform: translateY(0);\n    }\n}\n\n@keyframes splashScaleUp {\n    from {\n        transform: scale(0);\n    }\n\n    to {\n        transform: scale(1);\n    }\n}\n'],sourceRoot:""}]),l.locals={animatedOnboardingHeader:"Header-module_animatedOnboardingHeader__vRtun",animatedOnboardingSplash:"Header-module_animatedOnboardingSplash__TKzRY",splashScaleUp:"Header-module_splashScaleUp__hq9X2",animatedOnboardingPhoto:"Header-module_animatedOnboardingPhoto__GsmeB",invisible:"Header-module_invisible__bXLgL",moveHeaderUp:"Header-module_moveHeaderUp__7cyuf"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/pages/Onboarding/components/ResumeTemplateCard/ResumeTemplateCard.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,".ResumeTe