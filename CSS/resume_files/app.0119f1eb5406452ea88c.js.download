direction: column;\n    gap: 16px;\n}\n\n.noReport {\n    text-align: center;\n    padding: 40px 20px;\n    background: $surface;\n    border-radius: 16px;\n    border: 1px solid $graphic-2;\n}\n\n.tipList {\n    margin: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 24px;\n    font-family: "Inter", sans-serif;\n    font-size: 14px;\n    line-height: 22px;\n    color: #384347;\n}\n\n.tipCard {\n    background: $accent-10;\n    border-radius: $base-offset;\n    padding: $base-offset * 2;\n    border: 1px solid $graphic-2;\n    opacity: 0;\n    transform: translateY(20px) scale(0.95);\n\n    &.visible {\n        animation: tipPopup 0.8s ease forwards;\n        transition: transform 0.2s ease;\n\n        &:hover {\n            transform: translateY(-4px);\n        }\n    }\n}\n\n.gradientBorder {\n    border-radius: $base-offset * 2;\n    background: linear-gradient(#fff, #fff) padding-box,\n        linear-gradient(45deg, #9747ff, #2dc08d) border-box;\n    border: 2px solid transparent;\n}\n\n.tipSeparator {\n    border-top: 1px solid $graphic-2;\n    margin: $base-offset * 2 0;\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6df;\n$warning-hover: #feba62;\n\n// // Active elements\n$primary-