  width: 100px;\n    }\n\n    .icon {\n        position: absolute;\n        left: 73%;\n        top: 61%;\n        width: 23px;\n        animation: icon 2s linear infinite;\n    }\n\n    @media (max-width: $screen-sm-max) {\n        height: 56px;\n        width: 56px;\n\n        .email {\n            width: 56px;\n        }\n\n        .icon {\n            width: 16px;\n        }\n    }\n}\n\n@keyframes email {\n    0% {\n        transform: translate(-50%, -50%) scale(0.8) rotate(-15deg);\n    }\n\n    100% {\n        transform: translate(-50%, -50%) scale(1) rotate(0deg);\n    }\n}\n\n@keyframes icon {\n    0% {\n        transform: scale(0.9);\n    }\n\n    50% {\n        transform: scale(1.2);\n    }\n\n    100% {\n        transform: scale(0.9);\n    }\n}\n\n.dash {\n    width: 16px;\n    height: 2px;\n    border-radius: 8px;\n    background-color: $caption;\n    margin: 9px 16px 9px 0;\n}\n\n.blur {\n    filter: blur(3px);\n    min-height: 240px;\n    pointer-events: none;\n\n    div {\n        user-select: none;\n    }\n}\n\n.getPro {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    background-color: rgba($color: $visual-violet-2, $alpha: 0.9);\n    max-width: 450px;\n}\n\n.content {\n    box-shadow: $shadow-default;\n    border-radius: 4px;\n\n    @media screen and (max-width: $screen-sm-max) {\n        border: 1px solid $accent;\n        border-radius: 8px;\n        box-shadow: none;\n        padding: $base-offset $base-offset * 2;\n    }\n}\n\n.borderBottom {\n    border-bottom-left-radius: $base-offset;\n    border-bottom-right-radius: $base-offset;\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\