nimate {\n            width: 26px;\n            animation: none;\n\n            img {\n                width: 26px;\n                height: 26px;\n            }\n        }\n    }\n}\n\n@keyframes bg {\n    50% {\n        transform: scale(1.1);\n    }\n}\n\n@keyframes animate {\n    20% {\n        transform: translateY(-10px);\n    }\n\n    40% {\n        transform: translateY(-5px);\n    }\n\n    60% {\n        transform: translateY(-10px);\n    }\n}\n\n.blur {\n    filter: blur(3px);\n    min-height: 240px;\n    pointer-events: none;\n\n    div {\n        user-select: none;\n    }\n\n    @media (max-width: $screen-sm-max) {\n        min-height: auto;\n    }\n}\n\n.getPro {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    max-width: 450px;\n    background-color: rgba($color: $visual-violet-2, $alpha: 0.9);\n    @media (max-width: $screen-sm-max) {\n        bottom: 0;\n        top: auto;\n        transform: translate(-50%, 0px);\n    }\n}\n\n.minHeight {\n    min-height: 170px;\n    @media (max-width: $screen-sm-max) {\n        min-height: auto;\n    }\n}\n\n.borderBottom {\n    border-bottom-left-radius: $base-offset;\n    border-bottom-right-radius: $base-offset;\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondar