eAAA,CAEA,yBAbJ,8CAcQ,YAAA,CAAA,CAIR,iDACI,YAAA,CACA,mCAAA,CACA,kBAAA,CACA,eAAA,CACA,UAAA,CAEA,qCAPJ,iDAQQ,yBAAA,CACA,cC7CM,CAAA,CDiDd,gDACI,mBAAA,CACA,kBAAA,CACA,OCpDU,CDqDV,aC4BQ,CD3BR,oBAAA,CACA,aAAA,CACA,yBAAA,CAEA,sDACI,aCqBE,CDjBV,mDACI,YAAA,CACA,kBAAA,CACA,sBAAA,CACA,OCnEU,CDoEV,WAAA,CAEA,qCAPJ,mDAQQ,aAAA,CAAA,CAIR,iDACI,QAAA,CACA,kBAAA,CACA,eAAA,CACA,sBAAA,CACA,oBAAA,CAEA,6EAAA,CACA,oBAAA,CACA,mCAAA,CAGJ,mDACI,UAAA,CACA,UAAA,CACA,kBC7Ce,CD8Cf,iBAAA,CACA,aAAA,CAGJ,mDACI,aCnDe,CDoDf,kBAAA,CACA,sBAAA,CACA,eAAA,CAGJ,6CACI,kBCRW,CDSX,aC3De,CD4Df,eAAA,CACA,iBAAA,CACA,kBAAA,CACA,gBAAA,CACA,iBAAA,CAIJ,iDACI,MAAA,CACA,eClFI,CDmFJ,wBAAA,CACA,kBAAA,CACA,sCCRW,CDSX,gBAAA,CACA,YAAA,CACA,qBAAA,CACA,eAAA,CACA,iBAAA,CACA,0BAAA,CAEA,yBAbJ,iDAcQ,gBAAA,CACA,gBAAA,CAAA,CAIR,sDACI,MAAA,CACA,YAAA,CACA,eAAA,CACA,iBAAA,CAEA,8DACI,UAAA,CACA,iBAAA,CACA,QAAA,CACA,MAAA,CACA,OAAA,CACA,WAAA,CAEA,8IAAA,CASA,mBAAA,CACA,SAAA,CAGJ,6DACI,UAAA,CACA,iBAAA,CACA,WAAA,CACA,MAAA,CACA,OAAA,CACA,WAAA,CAEA,iJAAA,CAQA,mBAAA,CACA,SAAA,CAIR,mDACI,MAAA,CACA,eAAA,CACA,YAAA,CACA,qBAAA,CAGJ,mDACI,MAAA,CACA,UAAA,CACA,kBCrGQ,CDwGZ,0DACI,wBAAA,CACA,eClKI,CDmKJ,aCnHQ,CDoHR,iBAAA,CACA,gBAAA,CACA,cAAA,CACA,qCCxFqB,CD4FzB,qDACI,cAAA,CACA,KAAA,CACA,MAAA,CACA,UAAA,CACA,YAAA,CACA,4BAAA,CACA,WAAA,CACA,mEAAA,CAGJ,wDACI,KACI,SAAA,CAGJ,GACI,SAAA,CAAA",sourcesContent:['@import "~enhancv-styleguide/variables";\n\n.pageBackground {\n    background: $page;\n}\n\n.fullSize {\n    max-width: $container-xxl;\n    margin: 0 auto;\n    width: 100%;\n    padding: $base-offset * 4 $base-offset * 7;\n    box-sizing: border-box;\n\n    @media (max-width: $screen-sm-max) {\n        padding: $base-offset * 2 0px;\n    }\n}\n\n// Header\n.topNav {\n    background: $surface;\n    border: 1px solid $graphic-2;\n    border-radius: 16px;\n    box-shadow: $shadow-hover;\n    padding: $base-offset * 2 $base-offset * 3;\n    display: flex;\n    flex-direction: column;\n    gap: $base-offset;\n    margin-bottom: $base-offset * 2;\n    box-sizing: border-box;\n    min-height: 88px;\n\n    @media (max-width: $screen-sm-max) {\n        padding: $base-offset * 2;\n    }\n}\n\n.topNavRow {\n    display: grid;\n    grid-template-columns: auto 1fr auto;\n    align-items: center;\n    column-gap: $base-offset * 3;\n    width: 100%;\n\n    @media screen and (max-width: $screen-sm-max) {\n        grid-template-columns: 1fr;\n        column-gap: $base-offset;\n    }\n}\n\n.backLink {\n    display: inline-flex;\n    align-items: center;\n    gap: $base-offset;\n    color: $paragraph;\n    text-decoration: none;\n    padding: $base-offset * 0.75 0;\n    transition: color 0.2s ease;\n\n    &:hover {\n        color: $heading;\n    }\n}\n\n.roleWrapper {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: $base-offset;\n    min-width: 0;\n\n    @media screen and (max-width: $screen-sm-max) {\n        display: block;\n    }\n}\n\n.roleTitle {\n    margin: 0;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    display: inline-block;\n\n    background: linear-gradient(90deg, #2d3639 2.59%, #5f4dc7 54.1%, #9747ff 100%);\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n}\n\n.roleDivider {\n    width: 16px;\n    height: 2px;\n    background: $secondary-active;\n    border-radius: 8px;\n    flex-shrink: 0;\n}\n\n.companyName {\n    color: $secondary-active;\n    white-space: nowrap;\n    text-overflow: ellipsis;\n    overflow: hidden;\n}\n\n.badge {\n    background: $secondary-cc;\n    color: $secondary-active;\n    padding: 4px $base-offset;\n    border-radius: 4px;\n    white-space: nowrap;\n    justify-self: end;\n    text-align: center;\n}\n\n// Chat Panel\n.chatPanel {\n    flex: 1;\n    background: $surface;\n    border: 1px solid $graphic-2;\n    border-radius: 16px;\n    box-shadow: $shadow-hover;\n    padding: $base-offset * 3 0px;\n    display: flex;\n    flex-direction: column;\n    overflow: hidden;\n    position: relative;\n    height: calc(100vh - 220px); // 220px is the height of the top nav and chat navigation\n\n    @media (max-width: $screen-sm-max) {\n        padding: $base-offset * 2 0px;\n        min-height: 400px;\n    }\n}\n\n.scrollableArea {\n    flex: 1;\n    min-height: 0; // Critical - allows flex item to shrink below content size\n    overflow: hidden;\n    position: relative;\n\n    &::before {\n        content: "";\n        position: absolute;\n        top: -1px;\n        left: 0;\n        right: 0;\n        height: 16px;\n        /* stylelint-disable function-parentheses-space-inside */\n        background: linear-gradient(\n            to top,\n            transparent 0%,\n            rgba(255, 255, 255, 0.1) 30%,\n            rgba(255, 255, 255, 0.5) 60%,\n            rgba(255, 255, 255, 0.95) 100%\n        );\n        /* stylelint-enable function-parentheses-space-inside */\n\n        pointer-events: none;\n        z-index: 1;\n    }\n\n    &::after {\n        content: "";\n        position: absolute;\n        bottom: -1px;\n        left: 0;\n        right: 0;\n        height: 16px;\n        /* stylelint-disable function-parentheses-space-inside */\n        background: linear-gradient(\n            to bottom,\n            transparent 0%,\n            rgba(255, 255, 255, 0.1) 30%,\n            rgba(255, 255, 255, 0.5) 60%,\n            rgba(255, 255, 255, 0.95) 100%\n        );\n        /* stylelint-enable function-parentheses-space-inside */\n        pointer-events: none;\n        z-index: 1;\n    }\n}\n\n.chatContent {\n    flex: 1;\n    overflow-y: auto;\n    display: flex;\n    flex-direction: column;\n}\n\n.dividerLine {\n    flex: 1;\n    height: 1px;\n    background: $graphic-2;\n}\n\n.nextQuestionButton {\n    border: 1px solid $paragraph;\n    background: $surface;\n    color: $paragraph;\n    border-radius: 6px;\n    padding: $base-offset * 0.75 $base-offset * 1.75;\n    cursor: pointer;\n    box-shadow: $shadow-main-navigation;\n}\n\n// Mobile Slider Overlay\n.mobileOverlay {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100vh;\n    background: rgba(71, 68, 90, 0.9);\n    z-index: 999;\n    animation: fadeIn 0.3s ease-out;\n}\n\n@keyframes fadeIn {\n    from {\n        opacity: 0;\n    }\n\n    to {\n        opacity: 1;\n    }\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6df;\n$warning-hover: #feba62;\n\n// // Active elements\n$primary-active: #249a71;\n$secondary-active: #5f4dc7;\n$info-active: #3685bb;\n$warning-active: #d89745;\n$danger-active: #d94a5e;\n\n// // Transparent elements\n// // // opacity: 10%;\n$primary-10: rgba($primary, 0.1);\n$secondary-10: rgba($secondary, 0.1);\n$accent-10: rgba($accent, 0.1);\n$info-10: rgba($info, 0.1);\n$warning-10: rgba($warning, 0.1);\n$danger-10: rgba($danger, 0.1);\n// // // opacity 20%\n$primary-20: rgba($primary, 0.2);\n$secondary-20: rgba($secondary, 0.2);\n$accent-20: rgba($accent, 0.2);\n$info-20: rgba($info, 0.2);\n$warning-20: rgba($warning, 0.2);\n$danger-20: rgba($danger, 0.2);\n// // // opacity 30%\n$primary-30: rgba($primary, 0.3);\n$secondary-30: rgba($secondary, 0.3);\n$accent-30: rgba($accent, 0.3);\n$info-30: rgba($info, 0.3);\n$warning-30: rgba($warning, 0.3);\n$danger-30: rgba($danger, 0.3);\n\n// // Backgrounds\n$surface: $white;\n$surface-accent: #9cb2dc;\n$page: #f5f7fc;\n$page-alt: #fafbfd;\n\n// // Typography Colors\n$heading: #2d3639;\n$paragraph: #384347;\n$label: #60696c;\n$caption: #afb4b5;\n$subtext: #d8d9db;\n\n// // Supportive colors\n$modal: #47445a;\n$graphic-1: #f0f0f0;\n$graphic-2: #e4e4e4;\n$graphic-3: #f2f2f2;\n$border-color: #e0e0e0;\n\n// // CC colors\n$primary-cc: #eaf9f4;\n$secondary-cc: #f3f2fb;\n$danger-cc: #ffeef1;\n$info-cc: #ecf5fc;\n\n// // Visual elements Colors\n$visual-violet-1: #d1cbf1;\n$visual-violet-2: #e3e0f6;\n$visual-green-1: #abe6d1;\n$visual-green-2: #cdf0e4;\n$visual-blue: #b2d7f1;\n$visual-orange: #ffe0b9;\n$visual-pink: #ffcdd4;\n\n// // Shadows\n$shadow-default: 0px 4px 8px rgba(0, 0, 0, 0.1);\n$shadow-hover: 0px 2px 20px rgba(0, 0, 0, 0.1);\n$shadow-flat: 1px 1px 1px rgba(231, 228, 228, 0.5);\n$shadow-main-navigation: 0px 1px 3px rgba(0, 0, 0, 0.1);\n\n// Font-sizes\n$font-size-lg: 20px;\n$font-size-md: 18px;\n$font-size-rg: 16px;\n$font-size-sm: 14px;\n$font-size-xs: 12px;\n$font-size-xs-min: 10px;\n\n// Container - (with padding-inline:16px included)\n$container-xs: 100%;\n$container-md: 736px; // 12columns x 64px\n$container-lg: 956px; // 12columns x 84px\n$container-xl: 1184px; // 12columns x 96px\n$container-xxl: 1328px; // 12columns x 108px\n\n// Z-index modal\n$zindex-modal-background: 1002;\n$zindex-modal-content: 1003;\n'],sourceRoot:""}]),l.locals={pageBackground:"InterviewSimulationPage-module_pageBackground__voqlU",fullSize:"InterviewSimulationPage-module_fullSize__f7j2Z",topNav:"InterviewSimulationPage-module_topNav__celBB",topNavRow:"InterviewSimulationPage-module_topNavRow__qTeSt",backLink:"InterviewSimulationPage-module_backLink__eFPha",roleWrapper:"InterviewSimulationPage-module_roleWrapper__r4BXH",roleTitle:"InterviewSimulationPage-module_roleTitle__FSYEW",roleDivider:"InterviewSimulationPage-module_roleDivider__nBxmu",companyName:"InterviewSimulationPage-mo