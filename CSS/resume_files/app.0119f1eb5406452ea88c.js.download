splay: block;\n    margin: 0 auto;\n    width: calc(100% - 2 * $base-offset);\n    border-radius: 30px 30px 0px 0px;\n}\n\n.suggestions {\n    max-height: 0px;\n    border-top: 1px solid rgba($color: $surface, $alpha: 0.2);\n    display: grid;\n    grid-template-columns: 1fr;\n    row-gap: 2 * $base-offset;\n    overflow: hidden;\n    transition: all ease-in-out 300ms;\n\n    &.open {\n        max-height: 300px;\n        padding-bottom: 2 * $base-offset;\n        overflow: scroll;\n    }\n\n    .suggestion {\n        border-radius: 8px;\n        background-color: $surface;\n    }\n}\n\n.handler {\n    position: absolute;\n    top: 2 * $base-offset;\n    height: 4px;\n    width: 4 * $base-offset;\n    background-color: rgba($color: #e8e5f8, $alpha: 0.4);\n    border-radius: 4px;\n    transform: translate(-50%, 0);\n    left: 50%;\n}\n\n.input {\n    width: 100%;\n    padding: 12px;\n    font-size: $font-size-sm;\n    color: $paragraph;\n    background-color: $white;\n    background-image: none;\n    border: 1px solid $caption;\n    border-radius: 5px;\n    outline: none;\n    transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out,\n        -webkit-box-shadow 0.15s ease-in-out;\n\n    &:focus,\n    &:focus-within,\n    &:active,\n    &:hover {\n        border-color: $primary-active;\n    }\n\n    a {\n        color: $secondary;\n    }\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cd