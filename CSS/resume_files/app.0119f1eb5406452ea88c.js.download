mary-active;\n    transition: border-color 0.4s ease-in-out;\n}\n\n.gradientBorder {\n    border-radius: $base-offset * 2;\n    background: linear-gradient(#fff, #fff) padding-box,\n        linear-gradient(45deg, #9747ff, #2dc08d) border-box;\n    border: 2px solid transparent;\n}\n\n.editIcon {\n    position: absolute;\n    right: $base-offset * 2;\n    bottom: $base-offset;\n    z-index: 1;\n}\n\n.hr {\n    border-top: 2px solid $subtext;\n}\n\n.borderSuccess {\n    border-radius: $base-offset * 2;\n    border: 2px solid $primary-active;\n}\n\n.borderDanger {\n    border-radius: $base-offset * 2;\n    border: 2px solid $danger-hover;\n}\n\n.latestNewsLinks {\n    a {\n        color: $secondary-active;\n\n        &:hover {\n            color: $info;\n        }\n    }\n}\n\n.addSkillButton {\n    margin: 0;\n\n    > div {\n        border-radius: $base-offset * 3;\n        border: 2px solid $paragraph;\n        min-width: 160px;\n        width: 160px;\n    }\n}\n\n.scrollMobileBarContainer {\n    position: fixed;\n    bottom: 0;\n    z-index: 1000;\n    width: 100%;\n}\n\n.scrollMobileBarIcon {\n    transition: background 0.6s ease-out;\n}\n\n.scrollMobileBar {\n    height: 4px;\n    width: 0%;\n    background: $secondary-active;\n    transition: width 0.4s ease-out;\n}\n\n.loaderOverlay {\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: rgba(255, 255, 255, 0.5);\n    backdrop-filter: blur(4px);\n    z-index: 1;\n}\n\n.evaluationText {\n    white-space: pre-wrap;\n    word-break: break-word;\n}\n\n.companySummaryItem {\n    word-break: break-word;\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-l