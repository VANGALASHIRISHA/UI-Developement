.module.scss","webpack://./node_modules/enhancv-styleguide/variables.scss"],names:[],mappings:"AAEA,0CACI,iBAAA,CACA,WAAA,CACA,UAAA,CACA,4BAAA,CACA,iBAAA,CACA,uBAAA,CACA,qBAAA,CACA,2EAAA,CAEA,gDACI,+BAAA,CACA,qCCgGS,CD7Fb,+EACI,oBC4BW,CD3BX,sCC4FO,CDzFX,oFACI,UAAA,CACA,WAAA,CACA,gBAAA,CACA,iBAAA,CACA,mBAAA,CACA,aAAA,CACA,gBAAA,CACA,sBAAA,CAIR,yCACI,UAAA,CACA,WAAA,CACA,YAAA,CACA,kBAAA,CACA,sBAAA,CACA,gBAAA,CACA,WAAA,CACA,iBAAA,CACA,oBAAA,CACA,eAAA,CACA,mBAAA,CACA,kBAAA,CACA,sBAAA,CAGJ,0CACI,iBAAA,CACA,UAAA,CACA,WAAA,CACA,qBCpBI,CDqBJ,wBAAA,CACA,iBAAA,CACA,UAAA,CACA,uBAAA,CACA,sCCoDW,CDlDX,gDACI,sCCiDO,CD9CX,yEACI,SAAA,CACA,UAAA,CACA,gBAAA,CAGJ,yEACI,SAAA,CACA,WAAA,CACA,gBAAA,CAGJ,yEACI,YAAA,CACA,UAAA,CACA,gBAAA,CAGJ,yEACI,YAAA,CACA,WAAA,CACA,gBAAA,CAIR,4CACI,iBAAA,CACA,YAAA,CACA,QAAA,CACA,0BAAA,CACA,UAAA,CACA,WAAA,CACA,qBC/DI,CDgEJ,wBAAA,CACA,iBAAA,CACA,WAAA,CACA,YAAA,CACA,kBAAA,CACA,sBAAA,CACA,UAAA,CACA,sCCMW,CDLX,uBAAA,CAEA,kDACI,qCAAA,CAGJ,mDACI,eAAA,CACA,sCAAA,CAIR,0CACI,iBAAA,CACA,SAAA,CACA,QAAA,CACA,0BAAA,CACA,UAAA,CACA,WAAA,CACA,qBC3FI,CD4FJ,wBAAA,CACA,iBAAA,CACA,cAAA,CACA,YAAA,CACA,kBAAA,CACA,sBAAA,CACA,UAAA,CACA,sCCtBW,CDuBX,uBAAA,CAEA,gDACI,qCAAA,CAGJ,iDACI,eAAA,CACA,sCAAA",sourcesContent:['@import "enhancv-styleguide/variables";\n\n.imageElement {\n    position: absolute;\n    cursor: move;\n    z-index: 10;\n    border: 2px solid transparent;\n    border-radius: 4px;\n    transition: all 0.2s ease;\n    box-sizing: border-box;\n    transition: transform 0.1s ease-out, border-color 0.2s ease, box-shadow 0.2s ease;\n\n    &:hover {\n        border-color: rgba($secondary-active, 0.5);\n        box-shadow: $shadow-default;\n    }\n\n    &.selected {\n        border-color: $secondary-active;\n        box-shadow: $shadow-hover;\n    }\n\n    .elementImage {\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n        border-radius: 2px;\n        pointer-events: none;\n        display: block;\n        user-select: none;\n        -webkit-user-drag: none;\n    }\n}\n\n.textElement {\n    width: 100%;\n    height: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    user-select: none;\n    cursor: move;\n    text-align: center;\n    word-wrap: break-word;\n    overflow: hidden;\n    pointer-events: none;\n    white-space: nowrap;\n    text-overflow: ellipsis;\n}\n\n.resizeHandle {\n    position: absolute;\n    width: 20px;\n    height: 20px;\n    background-color: $white;\n    border: 2px solid $secondary-active;\n    border-radius: 50%;\n    z-index: 15;\n    transition: all 0.2s ease;\n    box-shadow: $shadow-hover;\n\n    &:hover {\n        box-shadow: $shadow-hover;\n    }\n\n    &.nw {\n        top: -10px;\n        left: -10px;\n        cursor: nw-resize;\n    }\n\n    &.ne {\n        top: -10px;\n        right: -10px;\n        cursor: ne-resize;\n    }\n\n    &.sw {\n        bottom: -10px;\n        left: -10px;\n        cursor: sw-resize;\n    }\n\n    &.se {\n        bottom: -10px;\n        right: -10px;\n        cursor: se-resize;\n    }\n}\n\n.rotationHandle {\n    position: absolute;\n    bottom: -42px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 36px;\n    height: 36px;\n    background-color: $white;\n    border: 2px solid $subtext;\n    border-radius: 50%;\n    cursor: grab;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    z-index: 15;\n    box-shadow: $shadow-hover;\n    transition: all 0.2s ease;\n\n    &:hover {\n        transform: translateX(-50%) scale(1.1);\n    }\n\n    &:active {\n        cursor: grabbing;\n        transform: translateX(-50%) scale(0.95);\n    }\n}\n\n.deleteHandle {\n    position: absolute;\n    top: -42px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 36px;\n    height: 36px;\n    background-color: $white;\n    border: 2px solid $subtext;\n    border-radius: 50%;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    z-index: 15;\n    box-shadow: $shadow-hover;\n    transition: all 0.2s ease;\n\n    &:hover {\n        transform: translateX(-50%) scale(1.1);\n    }\n\n    &:active {\n        cursor: grabbing;\n        transform: translateX(-50%) scale(0.95);\n    }\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6df;\n$warning-hover: #feba62;\n\n// // Active elements\n$primary-active: #249a71;\n$secondary-active: #5f4dc7;\n$info-active: #3685bb;\n$warning-active: #d89745;\n$danger-active: #d94a5e;\n\n// // Transparent elements\n// // // opacity: 10%;\n$primary-10: rgba($primary, 0.1);\n$secondary-10: rgba($secondary, 0.1);\n$accent-10: rgba($accent, 0.1);\n$info-10: rgba($info, 0.1);\n$warning-10: rgba($warning, 0.1);\n$danger-10: rgba($danger, 0.1);\n// // // opacity 20%\n$primary-20: rgba($primary, 0.2);\n$secondary-20: rgba($secondary, 0.2);\n$accent-20: rgba($accent, 0.2);\n$info-20: rgba($info, 0.2);\n$warning-20: rgba($warning, 0.2);\n$danger-20: rgba($danger, 0.2);\n// // // opacity 30%\n$primary-30: rgba($primary, 0.3);\n$secondary-30: rgba($secondary, 0.3);\n$accent-30: rgba($accent, 0.3);\n$info-30: rgba($info, 0.3);\n$warning-30: rgba($warning, 0.3);\n$danger-30: rgba($danger, 0.3);\n\n// // Backgrounds\n$surface: $white;\n$surface-accent: #9cb2dc;\n$page: #f5f7fc;\n$page-alt: #fafbfd;\n\n// // Typography Colors\n$heading: #2d3639;\n$paragraph: #384347;\n$label: #60696c;\n$caption: #afb4b5;\n$subtext: #d8d9db;\n\n// // Supportive colors\n$modal: #47445a;\n$graphic-1: #f0f0f0;\n$graphic-2: #e4e4e4;\n$graphic-3: #f2f2f2;\n$border-color: #e0e0e0;\n\n// // CC colors\n$primary-cc: #eaf9f4;\n$secondary-cc: #f3f2fb;\n$danger-cc: #ffeef1;\n$info-cc: #ecf5fc;\n\n// // Visual elements Colors\n$visual-violet-1: #d1cbf1;\n$visual-violet-2: #e3e0f6;\n$visual-green-1: #abe6d1;\n$visual-green-2: #cdf0e4;\n$visual-blue: #b2d7f1;\n$visual-orange: #ffe0b9;\n$visual-pink: #ffcdd4;\n\n// // Shadows\n$shadow-default: 0px 4px 8px rgba(0, 0, 0, 0.1);\n$shadow-hover: 0px 2px 20px rgba(0, 0, 0, 0.1);\n$shadow-flat: 1px 1px 1px rgba(231, 228, 228, 0.5);\n$shadow-main-navigation: 0px 1px 3px rgba(0, 0, 0, 0.1);\n\n// Font-sizes\n$font-size-lg: 20px;\n$font-size-md: 18px;\n$font-size-rg: 16px;\n$font-size-sm: 14px;\n$font-size-xs: 12px;\n$font-size-xs-min: 10px;\n\n// Container - (with padding-inline:16px included)\n$container-xs: 100%;\n$container-md: 736px; // 12columns x 64px\n$container-lg: 956px; // 12columns x 84px\n$container-xl: 1184px; // 12columns x 96px\n$container-xxl: 1328px; // 12columns x 108px\n\n// Z-index modal\n$zindex-modal-background: 1002;\n$zindex-modal-content: 1003;\n'],sourceRoot:""}]),l.locals={imageElement:"CanvasElement-module_imageElement__k6qsk",selected:"CanvasElement-module_selected__dDMIh",elementImage:"CanvasElement-module_elementImage__IRYEu",textElement:"CanvasElement-module_textElement__s5u7a",resizeHandle:"CanvasElement-module_resizeHandle__c_HvM",nw:"CanvasElement-module_nw__hJfQN",ne:"CanvasElement-module_ne__UTFi3",sw:"CanvasElement-module_sw__h8T1A",se:"CanvasElement-module_se__JPDi2",rotationHandle:"CanvasElement-module_rotationHandle__MTaTF",deleteHandle:"CanvasElement-module_deleteHandle__ERcu7"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSe