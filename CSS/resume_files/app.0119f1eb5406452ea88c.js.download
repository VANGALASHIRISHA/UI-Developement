/variables";\n\n.container {\n    width: 100%;\n    height: 270px;\n    border-radius: 8px;\n    background: #fafbfd;\n    border: 1px solid #e3e9f5;\n    display: inline-block;\n\n    .circle {\n        position: absolute;\n        top: 50%;\n        left: 50%;\n        transform: translate(-50%, -50%);\n    }\n\n    &.containerDark {\n        background: #2d3639;\n        border: 0px;\n    }\n\n    .radial {\n        position: absolute;\n        top: 0;\n        left: 0;\n        bottom: 0;\n        right: 0;\n        width: 100%;\n        height: 100%;\n        opacity: 0.3;\n        border-radius: 8px;\n        background: radial-gradient(100% 131.48% at 50% 50%, #5f4dc7 0%, #fafbfd 38.54%);\n\n        &.radialDark {\n            /* stylelint-disable-next-line */\n            background: radial-gradient(\n                50% 373.56% at 50% 50%,\n                #5f4dc7 0%,\n                rgba(95, 77, 199, 0.28) 100%\n            ); /* stylelint-disable-line */\n        }\n    }\n\n    .text {\n        position: absolute;\n        bottom: 27px;\n        left: 50%;\n        transform: translate(-50%, 0);\n        width: 90%;\n        @media (max-width: $screen-sm-max) {\n            bottom: 0px;\n        }\n    }\n\n    svg {\n        height: 135px;\n        width: 135px;\n    }\n\n    .path {\n        stroke-dasharray: 276.5;\n        stroke-dashoffset: 276.5;\n        animation: dash 2s linear normal infinite;\n    }\n\n    .path2 {\n        stroke-dasharray: 276.5;\n        stroke-dashoffset: 276.5;\n        animation: dash2 2s linear normal infinite;\n    }\n\n    .spinner {\n        animation: rotate 1.4s linear infinite;\n    }\n\n    @keyframes rotate {\n        to {\n            transform: rotate(360deg);\n        }\n    }\n\n    @keyframes dash {\n        0% {\n            stroke-dashoffset: 276.5;\n        }\n\n        50% {\n            stroke-dashoffset: 0;\n        }\n\n        100% {\n            stroke-dashoffset: 0;\n        }\n    }\n\n    @keyframes dash2 {\n        0% {\n            stroke-dashoffset: 276.5;\n        }\n\n        50% {\n            stroke-dashoffset: 276.5;\n        }\n\n        100% {\n            stroke-dashoffset: 0;\n        }\n    }\n}\n'],sourceRoot:""}]),l.locals={container:"LoadingPanel-module_container__fdnhj",circle:"LoadingPanel-module_circle__WwoMl",containerDark:"LoadingPanel-module_containerDark__e8YmP",radial:"LoadingPanel-module_radial__McOct",radialDark:"LoadingPanel-module_radialDark__MDmcE",text:"LoadingPanel-module_text__kItpF",path:"LoadingPanel-module_path__X_5SF",dash:"LoadingPanel-module_dash__aOfwH",path2:"LoadingPanel-module_path2__M7lq3",dash2:"LoadingPanel-module_dash2__MdbKG",spinner:"LoadingPanel-module_spinner__uKa0x",rotate:"LoadingPanel-module_rotate__ogBJk"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/pages/ResumeChecker/components/ReportSectionsV2/Common/ProgressBars/Line/Line.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,".Line-module_progressRed__zPrUI{background:linear-gradient(84.83deg, #ff576f 70%, #ffcdd4);box-shadow:inset 0px -4px 10px #d94a5e}.Line-module_progressYellow__gGmA5{background:linear-gradient(84.83deg, #feb251 70%, #ffe0b9);box-shadow:inset 0px -4px 10px #d89745}.Line-module_progressGreen__Ff3dd{background:linear-gradient(84.83deg, #2dc08d 70%, #abe6d1);box-shadow:inset 0px -4px 10px #249a71}.Line-module_progressOuter__uOEh2{position:relative;height:16px;box-shadow:inset 0px -4px 10px rgba(0,0,0,.1);border-radius:20px;width:100%;border:1px solid #9cb2dc}.Line-module_progressOuterMobile__QXx4h{position:relative;height:8px;background-color:#e4e4e4;border-radius:16px;width:100%}.Line-module_progressInner__xZ