    display: inline-block;\n    transition: opacity 0.5s;\n    position: sticky;\n    z-index: 2;\n    top: 87%;\n    bottom: 30px;\n    border-radius: 20px;\n    height: fit-content;\n    background-color: rgba($visual-violet-2, 0.9);\n}\n\n.resumeContainer {\n    display: block;\n    position: sticky;\n    top: $base-offset * 2;\n    left: 0;\n    max-height: 100vh;\n    overflow-y: auto;\n    scrollbar-width: none;\n}\n\n.resumeImage {\n    width: 100%;\n    height: auto;\n    box-shadow: 0px 2px 20px 0px rgba(0, 0, 0, 0.1);\n    z-index: 2;\n}\n\n.loadingResumeImage {\n    width: 100%;\n    height: calc(100vh - 64px); // 64px is the padding top\n    max-height: 842px;\n    background: $surface;\n    animation-duration: 0.8s;\n\n    .loading {\n        line-height: 0px;\n    }\n}\n\n.layoutSwitch {\n    float: right;\n    width: 208px;\n}\n\n.container {\n    border-radius: 20px;\n    border: $base-offset solid $surface;\n\n    @media (max-width: $screen-sm-max) {\n        border-radius: $base-offset;\n        border: 0;\n        background: $surface;\n        margin-top: $base-offset * 3;\n    }\n}\n\n.resume {\n    position: absolute;\n    top: 0;\n    overflow: hidden;\n    width: 100%;\n    height: 100%;\n}\n\n.animateOpacity {\n    transition: opacity ease-in-out 300ms;\n}\n\n.noBackground {\n    background: transparent;\n\n    @media (max-width: $screen-sm-max) {\n        background: $page;\n        border-radius: $base-offset;\n    }\n}\n\n.stickyContainer {\n    @media (min-width: $screen-md-min) {\n        position: sticky;\n        top: 16px;\n    }\n}\n\n.zoomedResponsiveContainer {\n    @media (max-width: $screen-sm-max) {\n        background: rgba($modal, 0.9);\n        border-radius: $base-offset;\n        padding-block: $base-offset * 1;\n        margin-top: $base-offset * 4;\n    }\n\n    > div {\n        @media (max-width: $screen-sm-max) {\n            max-width: 70%;\n            margin-inline: auto;\n            border-radius: $base-offset;\n            overflow: hidden;\n        }\n    }\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6df;\n$warning-hover: #feba62;\n\n// // Active elements\n$primary-active: #249a71;\n$secondary-active: #5f4dc7;\n$info-active: #3685bb;\n$warning-active: #d89745;\n$danger-active: #d94a5e;\n\n// // Transparent elements\n// // // opacity: 10%;\n$primary-10: rgba($primary, 0.1);\n$secondary-10: rgba($secondary, 0.1);\n$accent-10: rgba($accent, 0.1);\n$info-10: rgba($info, 0.1);\n$warning-10: rgba($warning, 0.1);\n$danger-10: rgba($danger, 0.1);\n// // // opacity 20%\n$primary-20: rgba($primary, 0.2);\n$secondary-20: rgba($secondary, 0.2);\n$accent-20: rgba($accent, 0.2);\n$info-20: rgba($info, 0.2);\n$warning-20: rgba($warning, 0.2);\n$danger-20: rgba($danger, 0.2);\n// // // opacity 30%\n$primary-30: rgba($primary, 0.3);\n$secondary-30: rgba($secondary, 0.3);\n$accent-30: rgba($accent, 0.3);\n$info-30: rgba($info, 0.3);\n$warning-30: rgba($warning, 0.3);\n$danger-30: rgba($danger, 0.3);\n\n// // Backgrounds\n$surface: $white;\n$surface-accent: #9cb2dc;\n$page: #f5f7fc;\n$page-alt: #fafbfd;\n\n// // Typography Colors\n$heading: #2d3639;\n$paragraph: #384347;\n$label: #60696c;\n$caption: #afb4b5;\n$subtext: #d8d9