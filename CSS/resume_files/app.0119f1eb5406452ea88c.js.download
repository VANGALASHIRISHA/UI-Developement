 flex-end;\n    position: relative;\n}\n\n.photo {\n    position: relative;\n    cursor: pointer;\n    border-radius: 5px;\n    vertical-align: top;\n    display: inline-block;\n    background-size: cover;\n    transition: border-radius 0.3s linear;\n    background-position: 50%;\n    background-repeat: no-repeat;\n}\n\n.photoCircle {\n    border-radius: 50%;\n}\n\n.initialsContainer {\n    height: 100%;\n    font-size: 34px;\n    font-weight: 500;\n}\n'],sourceRoot:""}]),l.locals={name:"HeaderClassic-module_name__wB2R1",title:"HeaderClassic-module_title__sin5c",resumeHeaderColLeft:"HeaderClassic-module_resumeHeaderColLeft__bVLn0",contactInfoClass:"HeaderClassic-module_contactInfoClass__NyXbc",resumeHeader:"HeaderClassic-module_resumeHeader__K61ng",selected:"HeaderClassic-module_selected__P1K_S",row:"HeaderClassic-module_row__SeH5d",photoContainer:"HeaderClassic-module_photoContainer__esYc6",photo:"HeaderClassic-module_photo__tS5Wz",photoCircle:"HeaderClassic-module_photoCircle__p_JlT",initialsContainer:"HeaderClassic-module_initialsContainer__kQH7Q"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/packages/Resume/Header/HeaderCompact.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,".HeaderCompact-module_name__B898v{font-weight:400}.HeaderCompact-module_title__VE_Na{font-weight:400}.HeaderCompact-module_icons__tA33i{color:#3e3e3e;margin-right:5px}.HeaderCompact-module_resumeHeaderColLeft__lWvul{width:100%}.HeaderCompact-module_contactInfoClass__okHD4{color:#3e3e3e;font-weight:400;display:flex;width:auto;padding-right:12px !important}.HeaderCompact-module_resumeHeader__lSGBo{border-radius:5px;border:1px solid transparent;display:flex;flex-wrap