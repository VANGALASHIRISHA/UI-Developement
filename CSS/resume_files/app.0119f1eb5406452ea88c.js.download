PJ,+CAQQ,eAAA,CAAA,CAIR,+CACI,kBCrLe,CDsLf,UClMI,CDqMR,mDACI,eAAA,CACA,aAAA,CACA,8BAAA,CACA,cAAA,CACA,eAAA,CACA,mBAAA,CACA,kBAAA,CACA,gBAAA,CAGJ,mDACI,kBAAA,CACA,sGAAA,CAEA,4BAAA,CAGJ,+CACI,UAAA,CACA,6EAAA,CAGJ,oDACI,SAAA,CACA,uBAAA,CACA,8CAAA,CAEA,yGACI,SAAA,CACA,0BAAA,CAGJ,yGACI,SAAA,CACA,2BAAA",sourcesContent:['@import "enhancv-styleguide/variables";\n\n.sectionCard {\n    background: #fff;\n    border: 1px solid #e4e4e4;\n    border-radius: 16px;\n    padding: 24px;\n    box-shadow: 0px 2px 20px rgba(0, 0, 0, 0.1);\n\n    @media (max-width: $screen-sm-max) {\n        padding: 16px;\n    }\n}\n\n.sectionHeader {\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n    margin-bottom: 12px;\n\n    h2 {\n        margin: 0;\n        font-family: "Rubik", sans-serif;\n        font-size: 16px;\n        font-weight: 700;\n        color: #2d3639;\n    }\n}\n\n.sectionIcon {\n    width: 32px;\n    height: 32px;\n    border-radius: 8px;\n    background: #e3e0f6;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #5f4dc7;\n\n    i {\n        font-size: 16px;\n    }\n}\n\n.questionPill,\n.answerLabel {\n    display: inline-flex;\n    align-items: center;\n    gap: 4px;\n    font-size: 16px;\n    font-weight: 500;\n    margin-bottom: $base-offset;\n\n    i {\n        font-size: 20px;\n    }\n}\n\n.questionBubble {\n    position: relative;\n    padding: 12px 14px;\n    border: 1px solid transparent;\n    border-radius: 8px;\n    background: $page;\n    font-family: "Inter", sans-serif;\n    font-size: 16px;\n    line-height: 27px;\n    color: #2d3639;\n    margin-bottom: 24px;\n    margin-top: $base-offset * 2;\n    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;\n    cursor: pointer;\n\n    &:hover {\n        background: darken($page, 3%);\n        transform: translateY(-4px);\n        box-shadow: $shadow-hover;\n    }\n}\n\n.questionBubble::before {\n    content: "";\n    position: absolute;\n    left: 13%;\n    top: -16px;\n    width: 0;\n    height: 0;\n    border-right: 24px solid transparent;\n    border-bottom: 16px solid $page;\n}\n\n.answerBox {\n    position: relative;\n    border: 1px solid transparent;\n    border-radius: 8px;\n    padding: 14px 16px;\n    background: $page;\n    margin-bottom: 24px;\n    font-family: "Inter", sans-serif;\n    font-size: 14px;\n    line-height: 22px;\n    color: #384347;\n    margin-top: $base-offset * 2;\n    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;\n    cursor: pointer;\n\n    &:hover {\n        background: darken($page, 3%);\n        transform: translateY(-4px);\n        box-shadow: $shadow-hover;\n    }\n}\n\n.answerBox::before {\n    content: "";\n    position: absolute;\n    top: -16px;\n    right: 13%;\n    width: 0;\n    height: 0;\n    border-left: 24px solid transparent;\n    border-bottom: 16px solid $page;\n}\n\n.scoreTipsRow {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n    gap: 24px;\n    margin-bottom: $base-offset * 3;\n    margin-top: $base-offset * 4;\n}\n\n@keyframes cardHighlight {\n    0% {\n        transform: scale(1);\n        box-shadow: none;\n    }\n\n    50% {\n        transform: scale(1.03);\n        box-shadow: 0 8px 25px rgba(151, 71, 255, 0.3);\n    }\n\n    100% {\n        transform: scale(1);\n        box-shadow: none;\n    }\n}\n\n.infoCard {\n    border: 2px solid #e3e0f6;\n    border-radius: 16px;\n    padding: 16px 18px;\n    background: #fafbfd;\n    transition: transform 0.2s ease, box-shadow 0.2s ease;\n\n    &.highlighted {\n        animation: cardHighlight 0.6s ease;\n    }\n}\n\n.cardTitle {\n    font-family: "Rubik", sans-serif;\n    font-size: 22px;\n    font-weight: 700;\n    color: #2d3639;\n    margin: 0 0 10px;\n\n    @media (max-width: $screen-sm-max) {\n        font-size: 18px;\n    }\n}\n\n.infoCard ul {\n    margin: 0;\n    padding-left: 18px;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n}\n\n.scorePositive {\n    color: #249a71;\n    font-weight: 700;\n}\n\n.scoreNeutral {\n    color: #d89745;\n    font-weight: 700;\n}\n\n.scoreNegative {\n    color: #d94a5e;\n    font-weight: 700;\n}\n\n.flatTextButton {\n    background: none;\n    border: 0;\n    color: #384347;\n    font-family: "Rubik", sans-serif;\n    font-size: 18px;\n    font-weight: 500;\n    cursor: pointer;\n    display: inline-flex;\n    align-items: center;\n    gap: 4px;\n}\n\n.flatTextButton:disabled {\n    color: #afb4b5;\n    cursor: not-allowed;\n}\n\n.pageNumber {\n    padding: 6px 8px;\n    border-radius: 4px;\n    background: $surface;\n    cursor: pointer;\n    border: 1px solid transparent;\n\n    @media (max-width: $screen-sm-max) {\n        min-height: 50px;\n    }\n}\n\n.activePage {\n    background: $secondary-active;\n    color: $surface;\n}\n\n.paginationDots {\n    padding: 6px 8px;\n    color: #384347;\n    font-family: "Rubik", sans-serif;\n    font-size: 18px;\n    font-weight: 500;\n    display: inline-flex;\n    align-items: center;\n    user-select: none;\n}\n\n.gradientBorder {\n    border-radius: $base-offset * 2;\n    background: linear-gradient(#fff, #fff) padding-box,\n        linear-gradient(45deg, #9747ff, #2dc08d) border-box;\n    border: 2px solid transparent;\n}\n\n.hrGradient {\n    height: 1px;\n    background: linear-gradient(90deg, #2dc08d 2.59%, #5f4dc7 54.1%, #9747ff 100%);\n}\n\n.questionContent {\n    opacity: 1;\n    transform: translateX(0);\n    transition: opacity 0.4s ease, transform 0.4s ease;\n\n    &.transitioningNext {\n        opacity: 0;\n        transform: translateX(30px);\n    }\n\n    &.transitioningPrev {\n        opacity: 0;\n        transform: translateX(-30px);\n    }\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6df;\n$warning-hover: #feba62;\n\n// // Active elements\n$primary-active: #249a71;\n$secondary-active: #5f4dc7;\n$info-active: #3685bb;\n$warning-active: #d89745;\n$danger-active: #d94a5e;\n\n// // Transparent elements\n// // // opacity: 10%;\n$primary-10: rgba($primary, 0.1);\n$secondary-10: rgba($secondary, 0.1);\n$accent-10: rgba($accent, 0.1);\n$info-10: rgba($info, 0.1);\n$warning-10: rgba($warning, 0.1);\n$danger-10: rgba($danger, 0.1);\n// // // opacity 20%\n$primary-20: rgba($primary, 0.2);\n$secondary-20: rgba($secondary, 0.2);\n$accent-20: rgba($accent, 0.2);\n$info-20: rgba($info, 0.2);\n$warning-20: rgba($warning, 0.2);\n$danger-20: rgba($danger, 0.2);\n// // // opacity 30%\n$primary-30: rgba($primary, 0.3);\n$secondary-30: rgba($secondary, 0.3);\n$accent-30: rgba($accent, 0.3);\n$info-30: rgba($info, 0.3);\n$warning-30: rgba($warning, 0.3);\n$danger-30: rgba($danger, 0.3);\n\n// // Backgrounds\n$surface: $white;\n$surface-accent: #9cb2dc;\n$page: #f5f7fc;\n$page-alt: #fafbfd;\n\n// // Typography Colors\n$heading: #2d3639;\n$paragraph: #384347;\n$label: #60696c;\n$caption: #afb4b5;\n$subtext: #d8d9db;\n\n// // Supportive colors\n$modal: #47445a;\n$graphic-1: #f0f0f0;\n$graphic-2: #e4e4e4;\n$graphic-3: #f2f2f2;\n$border-color: #e0e0e0;\n\n// // CC colors\n$primary-cc: #eaf9f4;\n$secondary-cc: #f3f2fb;\n$danger-cc: #ffeef1;\n$info-cc: #ecf5fc;\n\n// // Visual elements Colors\n$visual-violet-1: #d1cbf1;\n$visual-violet-2: #e3e0f6;\n$visual-green-1: #abe6d1;\n$visual-green-2: #cdf0e4;\n$visual-blue: #b2d7f1;\n$visual-orange: #ffe0b9;\n$visual-pink: #ffcdd4;\n\n// // Shadows\n$shadow-default: 0px 4px 8px rgba(0, 0, 0, 0.1);\n$shadow-hover: 0px 2px 20px rgba(0, 0, 0, 0.1);\n$shadow-flat: 1px 1px 1px rgba(231, 228, 228, 0.5);\n$shadow-main-navigation: 0px 1px 3px rgba(0, 0, 0, 0.1);\n\n// Font-sizes\n$font-size-lg: 20px;\n$font-size-md: 18px;\n$font-size-rg: 16px;\n$font-size-sm: 14px;\n$font-size-xs: 12px;\n$font-size-xs-min: 10px;\n\n// Container - (with padding-inline:16px included)\n$container-xs: 100%;\n$container-md: 736px; // 12columns x 64px\n$container-lg: 956px; // 12columns x 84px\n$container-xl: 1184px; // 12columns x 96px\n$container-xxl: 1328px; // 12columns x 108px\n\n// Z-index modal\n$zindex-modal-background: 1002;\n$zindex-modal-content: 1003;\n'],sourceRoot:""}]),l.locals={sectionCard:"QuestionAnswerReview-module_sectionCard__fv2CT",sectionHeader:"QuestionAnswerReview-module_sectionHeader__kdJc1",sectionIcon:"QuestionAnswerReview-module_sectionIcon__HoGXA",questionPill:"QuestionAnswerReview-module_questionPill__A1GDT",answerLabel:"QuestionAnswerReview-module_answerLabel__gm6Yf",questionBubble:"QuestionAnswerReview-module_questionBubble__AKM_1",answerBox:"QuestionAnswerReview-module_answerBox__AakHS",scoreTipsRow:"QuestionAnswerReview-module_scoreTipsRow__hcU4j",infoCard:"QuestionAnswerReview-module_infoCard__jGo0p",highlighted:"QuestionAnswerReview-module_highlighted__NPXE5",cardHighlight:"QuestionAnswerReview-module_cardHighlight__ZFdp_",cardTitle:"QuestionAnswerReview-module_cardTitle__JILfe",scorePositive:"QuestionAnswerReview-module_scorePositive__MUMmI",scoreNeutral:"QuestionAnswerReview-module_scoreNeutral__Z347S",scoreNegative:"QuestionAnswerReview-module_scoreNegative__mb_VE",flatTextButton:"QuestionAnswerReview-module_flatTextButton__W4Pci",pageNumber:"QuestionAnswerReview-module_pageNumber__am0x4",activePage:"Question