s Nagrody","addressItem.text":"Data utworzenia dokumentu","addressItem.name":"Imię Menedżera ds. Zatrudnienia","addressItem.workplace":"Nazwa Firmy","addressItem.address":"Adres","addressItem.location":"Miasto, Województwo, Kod Pocztowy","addressItem.contact":"Numer telefonu","addressItem.email":"hiring.manager@email.com","achievementItem.title":"Twoje Osiągnięcie","achievementItem.descriptionLabel":"Opis","achievementItem.description":"Opisz, co zrobiłeś i jaki miało to wpływ.","experienceItem.position":"Tytuł","experienceItem.description":"Opis Firmy","experienceItem.location":"Lokalizacja","experienceItem.workplace":"Nazwa Firmy","experienceItem.link":"URL","experienceItem.bullets":"Podkreśl swoje osiągnięcia, używając liczb, jeśli to możliwe.","educationItem.degree":"Stopień i Dziedzina Studiów","educationItem.location":"Lokalizacja","educationItem.institution":"Szkoła lub Uniwersytet","educationItem.bullets":"Zanotuj kluczowe umiejętności, doświadczenia i inne przyswojone umiejętności istotne dla stanowiska.","educationItem.gpa":"4.0","educationItem.gpaText":"GPA","educationItem.maxGpa":"4.0","volunteerItem.role":"Tytuł","volunteerItem.description":"Opisz organizację lub projekt, nad którym pracowałeś.","volunteerItem.institution":"Nazwa Organizacji","volunteerItem.location":"Lokalizacja","volunteerItem.bullets":"Opisz wpływ swoich działań","activityItem.title":"Nazwa Projektu","activityItem.descriptionLabel":"Opis","activityItem.description":"Krótki opis twojej pracy","activityItem.location":"Lokalizacja","activityItem.link":"URL","activityItem.bullets":"Jaki był sukces twojej pracy? (np. Zebrano 3000$ dla organizacji charytatywnej)","achievementSection.name":"Kluczowe Osiągnięcia","achievementSection.use":"Rekruterzy uwielbiają wymierne wyniki, więc staraj się pokazać zakres i wymiar swoich osiągnięć.","activitySection.name":"Projekty","activitySection.use":"Podkreśl osobiste, zawodowe lub akademickie działania i pokaż wyniki swoich działań (np. zebrałem 3000$ dla charytatywnej).","additionalExperienceSection.name":"Dodatkowe Doświadczenie","additionalExperienceSection.use":"Zachowaj sekcję doświadczenia zwięzłą i czytelną dla rekruterów. Staraj się pokazać wpływ swojego działania, zamiast wypisywać obowiązki. Dołącz metryki i KPI, gdy to możliwe.","additionalTechnologySection.name":"Dodatkowe Umiejętności","additionalTechnologySection.use":"Wskazówka ATS: Upewnij się, że wszystkie umiejętności wymienione w ogłoszeniu o pracę są wymienione w tej sekcji.","addressSection.name":"adres","addressSection.use":"Dodaj tutaj adres odbiorcy twojego listu motywacyjnego","awardSection.name":"Nagrody","awardSection.use":"Wymień nagrody, wyróżnienia, stypendia, osiągnięcia, które zdobyłeś, aby pokazać, że jesteś ponad przeciętnymi standardami w danej dziedzinie.","bookSection.name":"Książki","bookItem.imageLabel":"Prześlij okładkę","bookSection.use":"Wyróżnij swoje ulubione książki: świetny sposób na nawiązanie kontaktu z rekruterami na ludzkim poziomie.","customSection.name":"Niestandardowy","customSection.use":"Zmień nazwę tej sekcji i użyj jej do podawania dodatkowych informacji.","languageSection.name":"Języki","languageSection.use":"Wymień języki, które znasz i poziom biegłości w każdym z nich.","passionSection.name":"Zainteresowania","passionSection.use":"To pomoże rekruterom zobaczyć, że jesteś dobrym dopasowaniem do kultury firmy.","publicationSection.name":"Publikacje","additionalPublicationSection.name":"Dodatkowe Publikacje","publicationSection.use":"Wymień artykuły, publikacje, lub książki, które wydałeś.","skillSection.name":"Ekspertyza Branżowa","skillSection.use":"Podkreśl swoje kluczowe kompetencje w wizualny sposób.","socialSection.name":"Znajdź mnie w sieci","socialSection.use":"Wymień swoje profile w mediach społecznościowych.","talentSection.name":"Mocne Strony","talentSection.use":"Skieruj uwagę rekrutera na 2 lub 3 z twoich unikalnych mocnych stron.","technologySection.name":"Umiejętności","technologySection.use":"Wskazówka ATS: Upewnij się, że wszystkie umiejętności wymienione w ogłoszeniu o pracę są wymienione w tej sekcji.","certificateItem.issuerLabel":"Wydawca","certificateSection.use":"Wymień wszystkie swoje certyfikaty, które są istotne dla twojej następnej pożądanej roli, firmy lub branży.","courseSection.name":"Szkolenie / Kursy","courseSection.use":"Zachowaj swoje CV w kompaktowej formie: dołączaj tylko kursy istotne dla roli, na którą aplikujesz.","dayofmylifeSection.name":"Mój czas","dayofmylifeSection.use":"Wyróżnij się z wysoko wizualną sekcją. Pokaż menedżerom zatrudnienia, jak spędzasz swój czas.","educationSection.name":"Edukacja","educationSection.use":"Wymień najnowsze 1 lub 2 stopnie, które posiadasz - zazwyczaj nie ma potrzeby wymieniać GPA.","experienceSection.name":"Doświadczenie","experienceSection.use":"Zachowaj sekcję doświadczenia zwięzłą i czytelną dla rekruterów. Staraj się pokazać wpływ swojego działania, zamiast wypisywać obowiązki. Dołącz metryki i KPI, gdy to możliwe.","quoteSection.name":"Moja Filozofia Życia","quoteSection.use":"Dołącz cytat, który cię inspiruje i pomaga rekruterom zrozumieć twój styl pracy i osobowość.","referenceSection.name":"Referencje","referenceSection.use":"Wymień profesjonalistów, z którymi pracowałeś, i którzy naprawdę mogą zaświadczyć o twoich umiejętnościach i osiągnięciach. Upewnij się, że są gotowi być twoimi referencjami.","summarySection.name":"Podsumowanie","summarySection.use":"Rekruterzy wolą krótką, dostosowaną sekcję podsumowania, która jest istotna dla pracy. Skup się na swoich unikalnych mocnych stronach i pokaż pasję do roli.","volunteerSection.name":"Wolontariat","volunteerItem.descriptionLabel":"Opis","volunteerSection.use":"Pokaż, że zależy ci na innych i społeczeństwie: rekruterzy uwielbiają zatrudniać ludzi, którzy idą o krok dalej.","dateRangeField.placeholder":"Okres dat","dateRangeField.onGoing":"Obecnie","removeBrandTooltip.text":"Usuń branding","placeholderSection.addNew":"Dodaj nową sekcję","editUi.summaryLimit":"Aby kontynuować, proszę usunąć linię lub dodać nową pozycję z menu kontekstowego.","editUi.bulletsLimit":"Osiągnąłeś limit maksymalnych punktów na wpis. Zachęcamy do skupienia się na swoich najlepszych osiągnięciach i wpływach. Nasze badania pokazują, że posiadanie mniej niż 8 punktów jest optymalne.","editUi.bulletsSymbolLimit":"Osiągnąłeś limit znaków punktów. Zachęcamy do skupienia się na swoich najlepszych osiągnięciach i wpływach.","editUi.actions.addRow":"Dodaj Wiersz","editUi.actions.addColumn":"Dodaj Kolumnę","editUi.actions.moveRowUp":"Przenieś Wiersz Wgórę","editUi.actions.moveRowDown":"Przenieś Wiersz W Dół","editUi.actions.deleteRow":"Usuń Wiersz","editUi.actions.moveColumnLeft":"Przenieś Kolumnę W Lewo","editUi.actions.moveColumnRight":"Przenieś Kolumnę W Prawo","editUi.actions.deleteColumn":"Usuń Kolumnę","footer.enhancv.url":"www.enhancv.com","footer.resumementor.url":"www.resumementor.com","footer.poweredBy":"Dostarczone przez","page.numeration":"Strona","sectionSettings.showTitle":"Pokaż Tytuł","sectionSettings.showPhone":"Pokaż Telefon","sectionSettings.showLink":"Pokaż Link","sectionSettings.showExtraLink":"Pokaż Dodatkowy Link","sectionSettings.showEmail":"Pokaż Email","sectionSettings.showLocation":"Pokaż Lokalizację","sectionSettings.uppercaseName":"Wielkie Litery w Imieniu","sectionSettings.showPhoto":"Pokaż Zdjęcie","sectionSettings.showExtraField":"Pokaż Dodatkowe Pole","sectionSettings.showDateOfBirth":"Pokaż Datę Urodzenia","sectionSettings.showNationality":"Pokaż Narodowość","sectionSettings.photoStyle":"Styl Zdjęcia","sectionSettings.showCompanyName":"Pokaż Nazwę Firmy","sectionSettings.showDescription":"Pokaż Opis","sectionSettings.showBullets":"Pokaż Punkty","sectionSettings.showPeriod":"Pokaż Okres","sectionSettings.showIcons":"Pokaż Ikony","sectionSettings.showGroupName":"Pokaż Nazwę Grupy","sectionSettings.showInstitution":"Pokaż Instytucję","sectionSettings.borderStyle":"Styl Ramki","sectionSettings.numbe