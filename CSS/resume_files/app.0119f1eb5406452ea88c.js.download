erflow-y: auto;\n        border: 1px solid $primary;\n        border-radius: 4px;\n        padding-left: 2px;\n\n        &::-webkit-scrollbar {\n            display: none;\n        }\n\n        @media (min-width: $screen-sm-min) {\n            min-width: calc(100vw / 2 - #{$title-offset - $btn-edit-width});\n            max-width: calc(100vw / 2 - #{$title-offset - $btn-edit-width});\n        }\n    }\n\n    &:hover {\n        cursor: pointer;\n    }\n\n    &:focus {\n        cursor: text;\n    }\n}\n\n.titleWithAPreviewBtn {\n    min-width: $title-min-width;\n    max-width: calc(100vw - #{$title-offset + $btn-preview-width});\n\n    &.focused {\n        min-width: calc(100vw - #{$title-offset + $btn-preview-width - $btn-edit-width});\n        max-width: calc(100vw - #{$title-offset + $btn-preview-width - $btn-edit-width});\n    }\n}\n\n.editIcon {\n    position: absolute;\n    top: $base-offset * 2;\n    right: -$base-offset * 2;\n    animation-duration: 1s;\n}\n'],sourceRoot:""}]),l.locals={title:"EditDocumentTitle-module_title__pmJOi",focused:"EditDocumentTitle-module_focused__BNi0G",titleWithAPreviewBtn:"EditDocumentTitle-module_titleWithAPreviewBtn__cL9L6",editIcon:"EditDocumentTitle-module_editIcon__bKzjI"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/pages/EditorMobile/components/EditorFooterSticky/EditorFooterFixed.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,".EditorFooterFixed-module_stickyFooter__aewFq{position:fixed;bottom:0;left:0;right:0;box-shadow:0px -4px 10px rgba(0,0,0,.05);padding-block:6px}","",{version:3,sources:["webpack://./src/pages/EditorMobile/components/EditorFooterSticky/EditorFooterFixed.module.scss"],names: