I,eAAA,CAGJ,oCACI,YAAA,CACA,kBAAA,CACA,sBAAA,CACA,8BAAA,CACA,YAAA,CAEA,qCAPJ,oCAQQ,8BAAA,CAAA,CAIR,sCACI,UAAA,CACA,eAAA,CACA,aAAA,CAGJ,8BACI,UAAA,CAGJ,+BACI,iBAAA,CACA,kBAAA,CACA,wBAAA,CACA,eAAA,CAEA,qCANJ,+BAOQ,WAAA,CACA,QAAA,CACA,iBAAA,CAAA,CAIR,wCACI,YAAA,CACA,kBAAA,CACA,sBAAA,CACA,8BAAA,CAGJ,qCACI,WAAA,CACA,aAAA,CACA,aAAA,CAEA,qEACI,8BAAA,CAGJ,sCATJ,qCAUQ,WAAA,CAAA,CAGJ,qCAbJ,qCAcQ,UAAA,CAAA,CAIR,uCACI,MAAA,CACA,WAAA,CACA,8BAAA,CACA,eAAA,CACA,eAAA,CACA,QAAA,CAEA,qCARJ,uCASQ,cAAA,CACA,UAAA,CACA,eAAA,CACA,YAAA,CACA,KAAA,CACA,YAAA,CACA,gBAAA,CACA,eAAA,CACA,sBAAA,CACA,eAAA,CAAA,CAIR,sCACI,cAAA,CACA,WAAA,CACA,UAAA,CACA,YAAA,CACA,kBAAA,CACA,OCtGU,CDuGV,iBAAA,CACA,kBC7EM,CD8EN,UCxEI,CDyEJ,QAAA,CACA,kBAAA,CACA,cAAA,CACA,eAAA,CACA,cAAA,CACA,sCCDW,CDEX,uBAAA,CACA,UAAA,CAEA,4CACI,kBAAA,CACA,0BAAA,CAGJ,wCACI,cAAA,CAGJ,qCA5BJ,sCA6BQ,WAAA,CACA,UAAA,CACA,eAAA,CAAA,CAIR,2BACI,SAAA,CACA,2BAAA,CAEA,4DACI,SAAA,CAIR,8CACI,oCAAA,CACA,wBCjHK,CDqHL,4DADJ,wCAEQ,qBAAA,CAAA,CAGJ,qCALJ,wCAMQ,gBAAA,CACA,iBAAA,CAAA",sourcesContent:['@import "enhancv-styleguide/variables";\n\n.jobFeed {\n    margin-top: 50px;\n    min-height: calc(100vh - 200px);\n\n    @media screen and (max-width: $screen-sm-max) {\n        min-height: calc(100vh - 100px);\n    }\n}\n\n.page {\n    overflow: hidden;\n}\n\n.initialState {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    min-height: calc(100vh - 200px);\n    padding: $base-offset * 2;\n\n    @media screen and (max-width: $screen-sm-max) {\n        min-height: calc(100vh - 100px);\n    }\n}\n\n.centeredSearch {\n    width: 100%;\n    max-width: 700px;\n    margin: 0 auto;\n}\n\n.header {\n    width: 100%;\n}\n\n.content {\n    position: relative;\n    border-radius: 12px;\n    border: 1px solid $graphic-2;\n    overflow: hidden;\n\n    @media screen and (max-width: $screen-sm-max) {\n        padding: 0px;\n        border: 0;\n        border-radius: 0px;\n    }\n}\n\n.loadingContainer {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    min-height: calc(100vh - 350px);\n}\n\n.listContainer {\n    width: 580px;\n    flex-shrink: 0;\n    margin: 0 auto;\n\n    &.hasBorder {\n        border-right: 1px solid $graphic-2;\n    }\n\n    @media screen and (max-width: $screen-lg-max) {\n        width: 300px;\n    }\n\n    @media screen and (max-width: $screen-sm-max) {\n        width: 100%;\n    }\n}\n\n.detailContainer {\n    flex: 1;\n    min-width: 0;\n    max-height: calc(100vh - 235px);\n    overflow-y: auto;\n    position: sticky;\n    top: 74px;\n\n    @media screen and (max-width: $screen-sm-max) {\n        position: fixed;\n        width: 100%;\n        border-radius: 0;\n        z-index: 1000;\n        top: 0;\n        height: 100vh;\n        max-height: unset;\n        overflow: hidden;\n        background: transparent;\n        box-shadow: none;\n    }\n}\n\n.feedbackButton {\n    position: fixed;\n    bottom: $base-offset * 3;\n    right: $base-offset * 3;\n    display: flex;\n    align-items: center;\n    gap: $base-offset;\n    padding: $base-offset * 1.5 $base-offset * 2;\n    background: $primary;\n    color: $white;\n    border: 0;\n    border-radius: 24px;\n    font-size: 14px;\n    font-weight: 600;\n    cursor: pointer;\n    box-shadow: $shadow-hover;\n    transition: all 0.2s ease;\n    z-index: 50;\n\n    &:hover {\n        background: darken($primary, 8%);\n        transform: translateY(-2px);\n    }\n\n    i {\n        font-size: 18px;\n    }\n\n    @media screen and (max-width: $screen-sm-max) {\n        bottom: $base-offset * 2;\n        right: $base-offset * 2;\n        padding: $base-offset * 0.5 $base-offset * 1;\n    }\n}\n\n.tip {\n    opacity: 0;\n    transition: opacity 0.3s ease;\n\n    &.tipVisible {\n        opacity: 1;\n    }\n}\n\n.trySearchExample:hover {\n    transition: background-color 0.2s ease;\n    background-color: $accent;\n}\n\n.containerPadding {\n    @media screen and (max-width: $screen-lg-max) and (min-width: $screen-sm-min) {\n        width: 100% !important;\n    }\n\n    @media screen and (max-width: $screen-sm-max) {\n        padding-left: 0px;\n        padding-right: 0px;\n    }\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6df;\n$warning-hover: #feba62;\n\n// // Active elements\n$primary-active: #249a71;\n$secondary-active: #5f4dc7;\n$info-active: #3685bb;\n$warning-active: #d89745;\n$danger-active: #d94a5e;\n\n// // Transparent elements\n// // // opacity: 10%;\n$primary-10: rgba($primary, 0.1);\n$secondary-10: rgba($secondary, 0.1);\n$accent-10: rgba($accent, 0.1);\n$info-10: rgba($info, 0.1);\n$warning-10: rgba($warning, 0.1);\n$danger-10: rgba($danger, 0.1);\n// // // opacity 20%\n$primary-20: rgba($primary, 0.2);\n$secondary-20: rgba($secondary, 0.2);\n$accent-20: rgba($accent, 0.2);\n$info-20: rgba($info, 0.2);\n$warning-20: rgba($warning, 0.2);\n$danger-20: rgba($danger, 0.2);\n// // // opacity 30%\n$primary-30: rgba($primary, 0.3);\n$secondary-30: rgba($secondary, 0.3);\n$accent-30: rgba($accent, 0.3);\n$info-30: rgba($info, 0.3);\n$warning-30: rgba($warning, 0.3);\n$danger-30: rgba($danger, 0.3);\n\n// // Backgrounds\n$surface: $white;\n$surface-accent: #9cb2dc;\n$page: #f5f7fc;\n$page-alt: #fafbfd;\n\n// // Typography Colors\n$heading: #2d3639;\n$paragraph: #384347;\n$label: #60696c;\n$caption: #afb4b5;\n$subtext: #d8d9db;\n\n// // Supportive colors\n$modal: #47445a;\n$graphic-1: #f0f0f0;\n$graphic-2: #e4e4e4;\n$graphic-3: #f2f2f2;\n$border-color: #e0e0e0;\n\n// // CC colors\n$primary-cc: #eaf9f4;\n$secondary-cc: #f3f2fb;\n$danger-cc: #ffeef1;\n$info-cc: #ecf5fc;\n\n// // Visual elements Colors\n$visual-violet-1: #d1cbf1;\n$visual-violet-2: #e3e0f6;\n$visual-green-1: #abe6d1;\n$visual-green-2: #cdf0e4;\n$visual-blue: #b2d7f1;\n$visual-orange: #ffe0b9;\n$visual-pink: #ffcdd4;\n\n// // Shadows\n$shadow-default: 0px 4px 8px rgba(0, 0, 0, 0.1);\n$shadow-hover: 0px 2px 20px rgba(0, 0, 0, 0.1);\n$shadow-flat: 1px 1px 1px rgba(231, 228, 228, 0.5);\n$shadow-main-navigation: 0px 1px 3px rgba(0, 0, 0, 0.1);\n\n// Font-sizes\n$font-size-lg: 20px;\n$font-size-md: 18px;\n$font-size-rg: 16px;\n$font-size-sm: 14px;\n$font-size-xs: 12px;\n$font-size-xs-min: 10px;\n\n// Container - (with padding-inline:16px included)\n$container-xs: 100%;\n$container-md: 736px; // 12columns x 64px\n$container-lg: 956px; // 12columns x 84px\n$container-xl: 1184px; // 12columns x 96px\n$container-xxl: 1328px; // 12columns x 108px\n\n// Z-index modal\n$zindex-modal-background: 1002;\n$zindex-modal-content: 1003;\n'],sourceRoot:""}]),l.locals={jobFeed:"JobFeed-module_jobFeed__fr9Yq",page:"JobFeed-module_page__NX4uh",initialState:"JobFeed-module_initialState__Ah5Ta",centeredSearch:"JobFeed-module_centeredSearch__cJvFf",header:"JobFeed-module_header__UnRW9",content:"JobFeed-module_content__l4Tev",loadingContainer:"JobFeed-module_loadingContainer__bhitk",listContainer:"JobFeed-module_listContainer__SDPTf",hasBorder:"JobFeed-module_hasBorder__ktKkh",detailContainer:"JobFeed-module_detailContainer__Tess6",feedbackButton:"JobFeed-module_feedbackButton__tTlxy",tip:"JobFeed-module_tip__YRg7w",tipVisible:"JobFeed-module_tipVisible__Mt6Bs",trySearchExample:"JobFeed-module_trySearchExample__X_K_T",containerP