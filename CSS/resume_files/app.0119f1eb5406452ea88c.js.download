1;\n$info-cc: #ecf5fc;\n\n// // Visual elements Colors\n$visual-violet-1: #d1cbf1;\n$visual-violet-2: #e3e0f6;\n$visual-green-1: #abe6d1;\n$visual-green-2: #cdf0e4;\n$visual-blue: #b2d7f1;\n$visual-orange: #ffe0b9;\n$visual-pink: #ffcdd4;\n\n// // Shadows\n$shadow-default: 0px 4px 8px rgba(0, 0, 0, 0.1);\n$shadow-hover: 0px 2px 20px rgba(0, 0, 0, 0.1);\n$shadow-flat: 1px 1px 1px rgba(231, 228, 228, 0.5);\n$shadow-main-navigation: 0px 1px 3px rgba(0, 0, 0, 0.1);\n\n// Font-sizes\n$font-size-lg: 20px;\n$font-size-md: 18px;\n$font-size-rg: 16px;\n$font-size-sm: 14px;\n$font-size-xs: 12px;\n$font-size-xs-min: 10px;\n\n// Container - (with padding-inline:16px included)\n$container-xs: 100%;\n$container-md: 736px; // 12columns x 64px\n$container-lg: 956px; // 12columns x 84px\n$container-xl: 1184px; // 12columns x 96px\n$container-xxl: 1328px; // 12columns x 108px\n\n// Z-index modal\n$zindex-modal-background: 1002;\n$zindex-modal-content: 1003;\n'],sourceRoot:""}]),l.locals={fontTitle:"Fonts-module_fontTitle__N8NdV",icon:"Fonts-module_icon__p_tWj"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/pages/Editor/components/Toolbox/ToolboxStates/DesignState/components/SignatureState.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,".SignatureState-module_signature__KRUyV{border:1px solid #e4e4e4;border-radius:2px;padding:4px;cursor:pointer;height:48px;display:flex;align-items:center;justify-content:center}.SignatureState-module_signature__KRUyV:hover{border:1px solid #2dc08d}.SignatureState-module_signature__KRUyV.SignatureState-module_selected__OaEok{background-color:#2dc08d;border:1px solid #2dc08d;color:#fff}.SignatureState-module_signature__KRUyV .S