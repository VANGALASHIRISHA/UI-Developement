iGF,aCjGE,CDqGV,0CACI,8BC7ES,CD8ET,oBCvGM,CDwGN,aCxGM,CD2GV,sCACI,cAAA",sourcesContent:['@import "enhancv-styleguide/variables";\n\n.jobList {\n    max-height: calc(100vh - 235px);\n    overflow-y: auto;\n    padding: $base-offset * 2;\n    background: $page;\n    border-top-left-radius: 12px;\n    border-bottom-left-radius: 12px;\n\n    @media screen and (max-width: $screen-sm-max) {\n        padding: 0px 16px;\n        border: 0;\n        background: transparent;\n        border-radius: 0px;\n        max-height: calc(100vh - 150px);\n    }\n}\n\n.listHeader {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-bottom: $base-offset * 2;\n}\n\n.sortWrapper {\n    display: flex;\n    align-items: center;\n    gap: $base-offset;\n    position: relative;\n}\n\n.sortButton {\n    display: flex;\n    align-items: center;\n    gap: $base-offset / 2;\n    padding: 4px $base-offset;\n    background: none;\n    border: 0;\n    cursor: pointer;\n    font-size: 14px;\n    font-weight: 500;\n    color: $paragraph;\n\n    &:hover {\n        color: $secondary;\n    }\n}\n\n.sortChevron {\n    font-size: 12px;\n    color: inherit;\n}\n\n.sortDropdown {\n    position: absolute;\n    top: calc(100% + 4px);\n    right: 0;\n    min-width: 160px;\n    background: $white;\n    border: 1px solid $accent;\n    border-radius: $base-offset;\n    box-shadow: $shadow-hover;\n    z-index: 100;\n    overflow: hidden;\n}\n\n.sortItem {\n    display: block;\n    width: 100%;\n    padding: $base-offset $base-offset * 1.5;\n    text-align: left;\n    font-size: 14px;\n    color: $paragraph;\n    background: none;\n    border: 0;\n    cursor: pointer;\n\n    &:hover {\n        background: $accent;\n    }\n\n    &.selected {\n        background: $secondary-10;\n        color: $secondary-active;\n        font-weight: 500;\n    }\n}\n\n.cards {\n    display: flex;\n    flex-direction: column;\n    gap: $base-offset * 2;\n}\n\n.empty {\n    min-height: 200px;\n}\n\n.resultsCount {\n    @media screen and (max-width: $screen-sm-max) {\n        background: $page;\n        border-radius: 4px;\n    }\n}\n\n.alertsButton {\n    display: flex;\n    align-items: center;\n    gap: $base-offset / 2;\n    padding: $base-offset / 2 $base-offset * 1.5;\n    border: 1px solid $subtext;\n    border-radius: 100px;\n    background: $white;\n    cursor: pointer;\n    font-family: inherit;\n    font-size: 13px;\n    font-weight: 600;\n    color: $paragraph;\n    white-space: nowrap;\n    transition: all 0.15s ease;\n\n    &:hover {\n        border-color: $primary;\n        color: $primary;\n    }\n}\n\n.alertsButtonActive {\n    background: $primary-10;\n    border-color: $primary;\n    color: $primary;\n}\n\n.alertsBellIcon {\n    font-size: 16px;\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6df;\n$warning-hover: #feba62;\n\n// // Active elements\n$primary-active: #249a71;\n$secondary-active: #5f4dc7;\n$info-active: #3685bb;\n$warning-active: #d89745;\n$danger-active: #d94a5e;\n\n// // Transparent elements\n// // // opacity: 10%;\n$primary-10: rgba($primary, 0.1);\n$secondary-10: rgba($secondary, 0.1);\n$accent-10: rgba($accent, 0.1);\n$info-10: rgba($info, 0.1);\n$warning-10: rgba($warning, 0.1);\n$danger-10: rgba($danger, 0.1);\n// // // opacity 20%\n$primary-20: rgba($primary, 0.2);\n$secondary-20: rgba($secondary, 0.2);\n$accent-20: rgba($accent, 0.2);\n$info-20: rgba($info, 0.2);\n$warning-20: rgba($warning, 0.2);\n$danger-20: rgba($danger, 0.2);\n// // // opacity 30%\n$primary-30: rgba($primary, 0.3);\n$secondary-30: rgba($secondary, 0.3);\n$accent-30: rgba($accent, 0.3);\n$info-30: rgba($info, 0.3);\n$warning-30: rgba($warning, 0.3);\n$danger-30: rgba($danger, 0.3);\n\n// // Backgrounds\n$surface: $white;\n$surface-accent: #9cb2dc;\n$page: #f5f7fc;\n$page-alt: #fafbfd;\n\n// // Typography Colors\n$heading: #2d3639;\n$paragraph: #384347;\n$label: #60696c;\n$caption: #afb4b5;\n$subtext: #d8d9db;\n\n// // Supportive colors\n$modal: #47445a;\n$graphic-1: #f0f0f0;\n$graphic-2: #e4e4e4;\n$graphic-3: #f2f2f2;\n$border-color: #e0e0e0;\n\n// // CC colors\n$primary-cc: #eaf9f4;\n$secondary-cc: #f3f2fb;\n$danger-cc: #ffeef1;\n$info-cc: #ecf5fc;\n\n// // Visual elements Colors\n$visual-violet-1: #d1cbf1;\n$visual-violet-2: #e3e0f6;\n$visual-green-1: #abe6d1;\n$visual-green-2: #cdf0e4;\n$visual-blue: #b2d7f1;\n$visual-orange: #ffe0b9;\n$visual-pink: #ffcdd4;\n\n// // Shadows\n$shadow-default: 0px 4px 8px rgba(0, 0, 0, 0.1);\n$shadow-hover: 0px 2px 20px rgba(0, 0, 0, 0.1);\n$shadow-flat: 1px 1px 1px rgba(231, 228, 228, 0.5);\n$shadow-main-navigation: 0px 1px 3px rgba(0, 0, 0, 0.1);\n\n// Font-sizes\n$font-size-lg: 20px;\n$font-size-md: 18px;\n$font-size-rg: 16px;\n$font-size-sm: 14px;\n$font-size-xs: 12px;\n$font-size-xs-min: 10px;\n\n// Container - (with padding-inline:16px included)\n$container-xs: 100%;\n$container-md: 736px; // 12columns x 64px\n$container-lg: 956px; // 12columns x 84px\n$container-xl: 1184px; // 12columns x 96px\n$container-xxl: 1328px; // 12columns x 108px\n\n// Z-index modal\n$zindex-modal-background: 1002;\n$zindex-modal-content: 1003;\n'],sourceRoot:""}]),l.locals={jobList:"JobList-module_jobList__EqlzJ",listHeader: