I,eCncA,CDocA,aCxbW,CDybX,oCAAA,CAIR,yCACI,cC3eU,CD4eV,eAAA,CACA,QAAA,CACA,SAAA,CACA,cCxXW,CDyXX,eAAA,CACA,2BAAA,CACA,cAAA,CACA,yBAAA,CACA,yBAAA,CAEA,+CACI,UCtdA,CD0dR,0CACI,YAAA,CACA,qBAAA,CACA,QAAA,CACA,sBAAA,CAGJ,2CACI,YAAA,CACA,cAAA,CACA,OCrgBU,CDwgBd,wCACI,YAAA,CACA,kBAAA,CACA,OAAA,CACA,gBAAA,CACA,kBAAA,CACA,cCvZW,CDwZX,eAAA,CACA,gBAAA,CAEA,0CACI,cAAA,CAGJ,iDACI,8BAAA,CACA,aAAA,CAGJ,mDACI,8BAAA,CACA,aAAA,CAIR,sCACI,YAAA,CACA,QAAA,CACA,YAAA,CAEA,qCALJ,sCAMQ,qBAAA,CAAA,CAIR,mCACI,YAAA,CACA,qBAAA,CACA,kBAAA,CACA,sBAAA,CACA,eAAA,CACA,YAAA,CACA,4DAAA,CACA,kBAAA,CAEA,qCAVJ,mCAWQ,UAAA,CACA,eAAA,CAAA,CAGJ,8CACI,4DAAA,CAGJ,yCACI,4DAAA,CAGJ,yCACI,4DAAA,CAGJ,wCACI,4DAAA,CAIR,0CACI,iBAAA,CACA,UAAA,CACA,WAAA,CAEA,8CACI,wBAAA,CACA,UAAA,CACA,WAAA,CAIR,oCACI,SAAA,CACA,2BAAA,CACA,cAAA,CAGJ,oCACI,SAAA,CACA,WC9jBI,CD+jBJ,cAAA,CACA,oBAAA,CACA,oCAAA,CAGJ,wCACI,iBAAA,CACA,OAAA,CACA,QAAA,CACA,+BAAA,CACA,cAAA,CACA,eAAA,CACA,UC3kBI,CD8kBR,yCACI,iBAAA,CACA,OAAA,CACA,QAAA,CACA,+BAAA,CACA,cAAA,CACA,eAAA,CACA,UCrlBI,CDslBJ,yBAAA,CACA,iBAAA,CACA,UAAA,CACA,aAAA,CAGJ,0CACI,MAAA,CACA,WAAA,CAGJ,yCACI,cC7gBW,CD8gBX,eAAA,CACA,aCrjBM,CDsjBN,gBAAA,CAGJ,uCACI,cCnhBW,CDohBX,eAAA,CACA,aC3jBQ,CD4jBR,wBAAA,CAGJ,uCACI,cC1hBW,CD2hBX,eAAA,CACA,aCjkBI,CDmkBJ,8CACI,eAAA,CACA,aCtkBI,CD0kBZ,oCACI,cCviBW,CDwiBX,eAAA,CACA,gBAAA,CACA,aC/kBM,CDglBN,gBAAA,CAGJ,kCACI,cC/iBW,CDgjBX,gBAAA,CACA,aCrlBQ,CDwlBZ,4CACI,cAAA,CACA,eAAA,CACA,mBAAA,CACA,aC7nBY,CD8nBZ,8BCrnBQ,CDsnBR,eAAA,CAGJ,qCACI,YAAA,CACA,kBAAA,CACA,OCrrBU,CDsrBV,iBAAA,CACA,eAAA,CACA,iBCxrBU,CDyrBV,+BCpoBW,CDqoBX,qCAAA,CACA,iBC3rBU,CD4rBV,iDAAA,CAEA,qCAZJ,qCAaQ,YAAA,CACA,iBChsBM,CAAA,CDosBd,uCACI,gBAAA,CACA,wBAAA,CACA,iBCvsBU,CDwsBV,eCvqBI,CDwqBJ,mBAAA,CACA,cCplBW,CDqlBX,eAAA,CACA,aC3nBQ,CD4nBR,cAAA,CAEA,6CACI,kBCpoBD,CDwoBP,wCACI,gBAAA,CACA,QAAA,CACA,iBCvtBU,CDwtBV,kBC5rBQ,CD6rBR,mBAAA,CACA,cCpmBW,CDqmBX,eAAA,CACA,UC3rBI,CD4rBJ,cAAA,CAEA,8CACI,kBCnrBW,CDurBnB,4CACI,YAAA,CACA,kBAAA,CACA,OCvuBU,CDwuBV,iBAAA,CACA,eAAA,CACA,iBC1uBU,CD2uBV,+BAAA,CACA,oCAAA,CACA,iBC7uBU,CD8uBV,iDAAA,CAEA,qCAZJ,4CAaQ,YAAA,CACA,iBClvBM,CAAA,CDsvBd,0CACI,KACI,SAAA,CACA,0BAAA,CAGJ,GACI,SAAA,CACA,uBAAA,CAAA,CAIR,mCACI,YAAA,CACA,kBAAA,CACA,QAAA,CACA,iBAAA,CACA,4BAAA,CACA,cAAA,CACA,+BAAA,CAEA,yCACI,gCAAA,CAIR,uCACI,YAAA,CACA,kBAAA,CACA,sBAAA,CACA,UAAA,CACA,WAAA,CACA,iBAAA,CACA,+BAAA,CACA,aC5vBQ,CD6vBR,aAAA,CAEA,yCACI,cAAA",sourcesContent:['@import "enhancv-styleguide/variables";\n\n.overlay {\n    display: none;\n}\n\n.panel {\n    padding: $base-offset * 3;\n\n    @media screen and (max-width: $screen-sm-max) {\n        padding: 0;\n        display: flex;\n        flex-direction: column;\n        height: 100%;\n    }\n}\n\n.mobileHeader {\n    display: none;\n\n    @media screen and (max-width: $screen-sm-max) {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        padding: 4px $base-offset * 2 4px 12px;\n        border-bottom: 1px solid $accent;\n        flex-shrink: 0;\n        background: $surface;\n    }\n}\n\n.backButton {\n    display: flex;\n    align-items: center;\n    gap: $base-offset;\n    background: none;\n    border: 0;\n    cursor: pointer;\n    font-size: 16px;\n    font-weight: 500;\n    color: $heading;\n    padding: 0;\n\n    i {\n        font-size: 24px;\n    }\n}\n\n.mobileHeaderActions {\n    display: flex;\n    align-items: center;\n    gap: $base-offset * 2;\n}\n\n.bookmarked,\n.bookmarked i {\n    color: $secondary-active;\n}\n\n.scrollContent {\n    @media screen and (max-width: $screen-sm-max) {\n        flex: 1;\n        overflow-y: auto;\n        padding: $base-offset * 2;\n        -webkit-overflow-scrolling: touch;\n    }\n}\n\n.beatTheCrowd {\n    font-size: $font-size-xs;\n    font-weight: 700;\n    color: $danger;\n    white-space: nowrap;\n    flex-shrink: 0;\n    margin-left: auto;\n}\n\n.header {\n    position: relative;\n}\n\n.topActions {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: $base-offset;\n    padding-bottom: $base-offset * 2;\n    border-bottom: 1px solid $subtext;\n\n    @media screen and (max-width: $screen-sm-max) {\n        display: none;\n    }\n}\n\n.topActionsRight {\n    display: flex;\n    align-items: center;\n    gap: $base-offset;\n    margin-left: auto;\n}\n\n.headerTop {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: $base-offset;\n}\n\n.freshnessBadge {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    padding: 4px $base-offset;\n    background: $danger-10;\n    color: $danger;\n    font-size: 12px;\n    font-weight: 700;\n    border-radius: 16px;\n\n    i {\n        font-size: 14px;\n    }\n}\n\n.headerActions {\n    display: flex;\n    align-items: center;\n    gap: $base-offset;\n    margin-left: auto;\n}\n\n.saveButton {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    font-family: Rubik, sans-serif;\n    font-size: 14px;\n    font-weight: 500;\n    color: $paragraph;\n    background: none;\n    border: 0;\n    cursor: pointer;\n    padding: 4px 12px;\n\n    &:hover {\n        color: $secondary-active;\n    }\n\n    &:disabled {\n        opacity: 0.5;\n        cursor: not-allowed;\n    }\n\n    &.saved {\n        color: $secondary-active;\n        cursor: default;\n\n        &:hover {\n            color: $secondary-active;\n        }\n    }\n}\n\n.closeButton {\n    position: absolute;\n    top: 0;\n    right: 0;\n    display: none;\n}\n\n.logo {\n    width: 48px;\n    height: 48px;\n    border-radius: 12px;\n    object-fit: cover;\n    flex-shrink: 0;\n\n    @media screen and (max-width: $screen-sm-max) {\n        width: 40px;\n        height: 40px;\n        border-radius: $base-offset;\n    }\n}\n\n.logoPlaceholder {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 48px;\n    height: 48px;\n    border-radius: 12px;\n    background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);\n    flex-shrink: 0;\n}\n\n.logoIcon {\n    font-size: 20px;\n    color: $white;\n}\n\n.titleSection {\n    flex: 1;\n    min-width: 0;\n}\n\n.companyLink {\n    font-size: $font-size-sm;\n    font-weight: 400;\n    line-height: 22px;\n    color: $heading;\n    text-decoration: underline;\n    display: block;\n    margin-top: $base-offset / 2;\n\n    &:hover {\n        color: $secondary;\n    }\n\n    @media screen and (max-width: $screen-sm-max) {\n        margin-top: 0px;\n    }\n}\n\n.companyName {\n    font-size: $font-size-sm;\n    font-weight: 400;\n    line-height: 22px;\n    color: $heading;\n    display: block;\n    margin-top: $base-offset / 2;\n}\n\n.metaRow {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: $base-offset * 2;\n    margin-block: $base-offset * 2;\n    padding: 4px;\n    border-radius: 8px;\n    background: $page;\n\n    @media screen and (max-width: $screen-sm-max) {\n        flex-wrap: nowrap;\n        overflow-x: auto;\n        -webkit-overflow-scrolling: touch;\n\n        &::-webkit-scrollbar {\n            display: none;\n        }\n    }\n}\n\n.metaItem {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    padding: 4px $base-offset;\n    font-size: 12px;\n    font-weight: 500;\n    color: $heading;\n    white-space: nowrap;\n\n    i {\n        font-size: 16px;\n    }\n}\n\n.infoIcon {\n    font-size: 12px !important;\n    position: relative;\n    top: 0;\n    left: -2px;\n    transition: color 0.2s ease;\n}\n\n.salaryWithEstimate {\n    &:hover .infoIcon {\n        color: $warning;\n    }\n}\n\n.salaryEstimateTooltip {\n    max-width: 320px;\n}\n\n.remoteBadge {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    padding: 2px 8px;\n    background: $secondary-10;\n    color: $secondary;\n    font-size: 12px;\n    font-weight: 500;\n    border-radius: 4px;\n\n    i {\n        font-size: 14px;\n    }\n}\n\n.matchScoreSection {\n    margin-top: $base-offset * 2;\n    padding: $base-offset * 2;\n    background: $white;\n    border-radius: 12px;\n    border: 1px solid $accent;\n    border-left: 4px solid $primary;\n}\n\n.matchScoreHeader {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-bottom: $base-offset * 2;\n}\n\n.matchScoreActions {\n    display: flex;\n    gap: $base-offset / 2;\n}\n\n.matchScoreContent {\n    display: flex;\n    gap: $base-offset * 2;\n    align-items: flex-start;\n}\n\n.scoreCircle {\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    flex-shrink: 0;\n    padding: $base-offset * 2;\n    background: linear-gradient(135deg, #8b5cf6 0%, #3b82f6 50%, #06b6d4 100%);\n    border-radius: 12px;\n}\n\n.scoreContent {\n    position: absolute;\n    top: calc(50% - 12px);\n    left: 50%;\n    transform: translate(-50%, -50%);\n    text-align: center;\n}\n\n.scoreValue {\n    font-size: 38px;\n    font-weight: 500;\n    color: $white;\n}\n\n.scorePercent {\n    font-size: 26px;\n    font-weight: 400;\n    color: $white;\n}\n\n.scoreLabel {\n    margin-top: 4px;\n    padding: 4px 12px;\n    background: $primary;\n    color: $white;\n    font-size: 14px;\n    font-weight: 700;\n    text-transform: uppercase;\n    border-radius: 4px;\n}\n\n.matchScoreInfo {\n    flex: 1;\n    min-width: 0;\n}\n\n.criteriaMet {\n    display: flex;\n    flex-direction: column;\n    gap: $base-offset / 2;\n    margin-top: $base-offset * 2;\n    padding-top: $base-offset;\n    border-top: 1px solid $accent;\n}\n\n.criteriaRow {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n}\n\n.criteriaProgress {\n    width: 100%;\n    height: 4px;\n    background: $accent;\n    border-radius: 2px;\n    overflow: hidden;\n}\n\n.criteriaProgressBar {\n    height: 100%;\n    background: $primary;\n    border-radius: 2px;\n    transition: width 0.3s ease;\n}\n\n.description {\n    word-break: break-word;\n}\n\n.jobTitle {\n    font-size: 18px;\n    font-weight: 700;\n    line-height: 26px;\n    color: $heading;\n    margin: 0;\n\n    @media screen and (max-width: $screen-sm-max) {\n        font-size: 14px;\n        line-height: 22px;\n        font-weight: 700;\n    }\n}\n\n.sectionHeading {\n    font-size: $font-size-rg;\n    font-weight: 700;\n    line-height: 27px;\n    color: $heading;\n    margin: 0;\n}\n\n.aboutHeading {\n    font-size: $font-size-md;\n    font-weight: 700;\n    line-height: 31px;\n    color: $heading;\n    margin: 0 0 $base-offset * 2 0;\n}\n\n.matchSection {\n    border: 1px solid $accent;\n    border-radius: 12px;\n    overflow: hidden;\n}\n\n.matchHeader {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: $base-offset;\n    border-bottom: 1px solid $accent;\n}\n\n.matchViewToggle {\n    display: flex;\n    gap: 2px;\n    background: $page;\n    border-radius: $base-offset;\n    padding: 2px;\n    border: 1px solid $graphic-2;\n}\n\n.matchViewButton {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 32px;\n    height: 32px;\n    border: 0;\n    border-radius: $base-offset;\n    background: transparent;\n    color: $caption;\n    cursor: pointer;\n    transition: background 0.15s ease, color 0.15s ease;\n\n    i {\n        font-size: 20px;\n    }\n\n    &:hover {\n        color: $paragraph;\n    }\n\n    &--active {\n        background: $white;\n        color: $secondary-active;\n        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);\n    }\n}\n\n.criteriaMetLink {\n    margin-top: $base-offset;\n    background: none;\n    border: 0;\n    padding: 0;\n    font-size: $font-size-xs;\n    font-weight: 600;\n    color: rgba($white, 0.85);\n    cursor: pointer;\n    text-decoration: underline;\n    text-underline-offset: 2px;\n\n    &:hover {\n        color: $white;\n    }\n}\n\n.requirementsList {\n    display: flex;\n    flex-direction: column;\n    gap: $base-offset * 2;\n    justify-content: center;\n}\n\n.requirementsGroup {\n    display: flex;\n    flex-wrap: wrap;\n    gap: $base-offset;\n}\n\n.requirementTag {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    padding: 4px 10px;\n    border-radius: 16px;\n    font-size: $font-size-xs;\n    font-weight: 500;\n    line-height: 18px;\n\n    i {\n        font-size: 12px;\n    }\n\n    &--matched {\n        background: rgba($primary, 0.1);\n        color: darken($primary, 10%);\n    }\n\n    &--unmatched {\n        background: rgba($danger, 0.1);\n        color: darken($danger, 5%);\n    }\n}\n\n.matchContent {\n    display: flex;\n    gap: $base-offset * 2;\n    padding: $base-offset * 2;\n\n    @media screen and (max-width: $screen-sm-max) {\n        flex-direction: column;\n    }\n}\n\n.scoreCard {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    min-width: 140px;\n    padding: $base-offset * 2;\n    background: linear-gradient(135deg, #8b5cf6 0%, #06b6d4 100%);\n    border-radius: 12px;\n\n    @media screen and (max-width: $screen-sm-max) {\n        width: 100%;\n        min-width: unset;\n    }\n\n    &--excellent {\n        background: linear-gradient(135deg, $primary 0%, #57cda4 100%);\n    }\n\n    &--good {\n        background: linear-gradient(135deg, $secondary 0%, #a396e2 100%);\n    }\n\n    &--fair {\n        background: linear-gradient(135deg, $info 0%, #52a6df 100%);\n    }\n\n    &--low {\n        background: linear-gradient(135deg, $label 0%, #8a9295 100%);\n    }\n}\n\n.circularProgress {\n    position: relative;\n    width: 90px;\n    height: 90px;\n\n    svg {\n        transform: rotate(-90deg);\n        width: 100%;\n        height: 100%;\n    }\n}\n\n.progressBg {\n    fill: none;\n    stroke: rgba($white, 0.3);\n    stroke-width: 6;\n}\n\n.progressFg {\n    fill: none;\n    stroke: $white;\n    stroke-width: 6;\n    stroke-linecap: round;\n    transition: stroke-dasharray 0.5s ease;\n}\n\n.miniScoreValue {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    font-size: 24px;\n    font-weight: 700;\n    color: $white;\n}\n\n.scoreValueLabel {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    font-size: 14px;\n    font-weight: 700;\n    color: $white;\n    text-transform: capitalize;\n    text-align: center;\n    width: 100%;\n    padding: 0 8px;\n}\n\n.matchExplanation {\n    flex: 1;\n    min-width: 0;\n}\n\n.matchScoreTitle {\n    font-size: $font-size-sm;\n    font-weight: 700;\n    color: $heading;\n    margin: 0 0 $base-offset / 2 0;\n}\n\n.criteriaLabel {\n    font-size: $font-size-xs;\n    font-weight: 600;\n    color: $paragraph;\n    text-transform: uppercase;\n}\n\n.criteriaValue {\n    font-size: $font-size-xs;\n    font-weight: 500;\n    color: $label;\n\n    strong {\n        font-weight: 700;\n        color: $paragraph;\n    }\n}\n\n.subHeading {\n    font-size: $font-size-rg;\n    font-weight: 700;\n    line-height: 27px;\n    color: $heading;\n    margin: 0 0 $base-offset 0;\n}\n\n.bodyText {\n    font-size: $font-size-rg;\n    line-height: 27px;\n    color: $paragraph;\n}\n\n.beatTheCrowdMobile {\n    font-size: 12px;\n    padding: 2px $base-offset;\n    border-radius: 100px;\n    color: $danger-active;\n    background: $danger-10;\n    font-weight: 700;\n}\n\n.applyBanner {\n    display: flex;\n    align-items: center;\n    gap: $base-offset;\n    padding: $base-offset * 1.5 $base-offset * 2;\n    margin-top: $base-offset * 2;\n    margin-bottom: $base-offset;\n    background: $secondary-10;\n    border: 1px solid rgba($secondary, 0.2);\n    border-radius: $base-offset;\n    animation: fadeIn 0.2s ease;\n\n    @media screen and (max-width: $screen-sm-max) {\n        margin-top: 0;\n        margin-bottom: $base-offset;\n    }\n}\n\n.applyBannerNo {\n    padding: 4px 16px;\n    border: 1px solid $subtext;\n    border-radius: $base-offset;\n    background: $white;\n    font-family: inherit;\n    font-size: $font-size-sm;\n    font-weight: 600;\n    color: $paragraph;\n    cursor: pointer;\n\n    &:hover {\n        background: $page;\n    }\n}\n\n.applyBannerYes {\n    padding: 4px 16px;\n    border: 0;\n    border-radius: $base-offset;\n    background: $secondary;\n    font-family: inherit;\n    font-size: $font-size-sm;\n    font-weight: 600;\n    color: $white;\n    cursor: pointer;\n\n    &:hover {\n        background: $secondary-active;\n    }\n}\n\n.applyBannerSuccess {\n    display: flex;\n    align-items: center;\n    gap: $base-offset;\n    padding: $base-offset * 1.5 $base-offset * 2;\n    margin-top: $base-offset * 2;\n    margin-bottom: $base-offset;\n    background: rgba($primary, 0.08);\n    border: 1px solid rgba($primary, 0.2);\n    border-radius: $base-offset;\n    animation: fadeIn 0.2s ease;\n\n    @media screen and (max-width: $screen-sm-max) {\n        margin-top: 0;\n        margin-bottom: $base-offset;\n    }\n}\n\n@keyframes fadeIn {\n    from {\n        opacity: 0;\n        transform: translateY(-4px);\n    }\n\n    to {\n        opacity: 1;\n        transform: translateY(0);\n    }\n}\n\n.tailorCta {\n    display: flex;\n    align-items: center;\n    gap: $base-offset * 1.5;\n    padding: $base-offset * 1.5 $base-offset * 2;\n    border-top: 1px solid $accent;\n    cursor: pointer;\n    transition: background 0.15s ease;\n\n    &:hover {\n        background: rgba($secondary, 0.04);\n    }\n}\n\n.tailorCtaIcon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 36px;\n    height: 36px;\n    border-radius: 50%;\n    background: rgba($secondary, 0.1);\n    color: $secondary;\n    flex-shrink: 0;\n\n    i {\n        font-size: 16px;\n    }\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6df;\n$warning-hover: #feba62;\n\n// // Active elements\n$primary-active: #249a71;\n$secondary-active: #5f4dc7;\n$info-active: #3685bb;\n$warning-active: #d89745;\n$danger-active: #d94a5e;\n\n// // Transparent elements\n// // // opacity: 10%;\n$primary-10: rgba($primary, 0.1);\n$secondary-10: rgba($secondary, 0.1);\n$accent-10: rgba($accent, 0.1);\n$info-10: rgba($info, 0.1);\n$warning-10: rgba($warning, 0.1);\n$danger-10: rgba($danger, 0.1);\n// // // opacity 20%\n$primary-20: rgba($primary, 0.2);\n$secondary-20: rgba($secondary, 0.2);\n$accent-20: rgba($accent, 0.2);\n$info-20: rgba($info, 0.2);\n$warning-20: rgba($warning, 0.2);\n$danger-20: rgba($danger, 0.2);\n// // // opacity 30%\n$primary-30: rgba($primary, 0.3);\n$secondary-30: rgba($secondary, 0.3);\n$accent-30: rgba($accent, 0.3);\n$info-30: rgba($info, 0.3);\n$warning-30: rgba($warning, 0.3);\n$danger-30: rgba($danger, 0.3);\n\n// // Backgrounds\n$surface: $white;\n$surface-accent: #9cb2dc;\n$page: #f5f7fc;\n$page-alt: #fafbfd;\n\n// // Typography Colors\n$heading: #2d3639;\n$paragraph: #384347;\n$label: #60696c;\n$caption: #afb4b5;\n$subtext: #d8d9db;\n\n// // Supportive colors\n$modal: #47445a;\n$graphic-1: #f0f0f0;\n$graphic-2: #e4e4e4;\n$graphic-3: #f2f2f2;\n$border-color: #e0e0e0;\n\n// // CC colors\n$primary-cc: #eaf9f4;\n$secondary-cc: #f3f2fb;\n$danger-cc: #ffeef1;\n$info-cc: #ecf5fc;\n\n// // Visual elements Colors\n$visual-violet-1: #d1cbf1;\n$visual-violet-2: #e3e0f6;\n$visual-green-1: #abe6d1;\n$visual-green-2: #cdf0e4;\n$visual-blue: #b2d7f1;\n$visual-orange: #ffe0b9;\n$visual-pink: #ffcdd4;\n\n// // Shadows\n$shadow-default: 0px 4px 8px rgba(0, 0, 0, 0.1);\n$shadow-hover: 0px 2px 20px rgba(0, 0, 0, 0.1);\n$shadow-flat: 1px 1px 1px rgba(231, 228, 228, 0.5);\n$shadow-main-navigation: 0px 1px 3px rgba(0, 0, 0, 0.1);\n\n// Font-sizes\n$font-size-lg: 20px;\n$font-size-md: 18px;\n$font-size-rg: 16px;\n$font-size-sm: 14px;\n$font-size-xs: 12px;\n$font-size-xs-min: 10px;\n\n// Container - (with padding-inline:16px included)\n$container-xs: 100%;\n$container-md: 736px; // 12columns x 64px\n$container-lg: 956px; // 12columns x 84px\n$container-xl: 1184px; // 12columns x 96px\n$container-xxl: 1328px; // 12columns x 108px\n\n// Z-index modal\n$zindex-modal-background: 1002;\n$zindex-modal-content: 1003;\n'],sourceRoot:""}]),l.locals={overlay:"JobDetail-module_overlay__SJ_ZW",panel:"JobDetail-module_panel__T38G_",mobileHeader:"JobDetail-module_mobileHeader__SwkAA",backButton:"JobDetail-module_backButton__MsYWq",mobileHeaderActions:"JobDetail-module_mobileHeaderActions__qy7Am",bookmarked:"JobDetail-module_bookmarked__LkNhy",scrollContent:"JobDetail-module_scrollContent__mUpjK",beatTheCrowd:"JobDetail-module_beatTheCrowd__nYMCI",header:"JobDetail-module_header__dmJb1",topActions:"JobDetail-module_topActions__CJAaq",topActionsRight:"JobDetail-module_topActionsRight__Ewa3G",headerTop:"JobDetail-module_headerTop__QEk89",freshnessBadge:"JobDetail-module_freshnessBadge__XOzSR",headerActions:"JobDetail-module_headerActions__a7lO5",saveButton:"JobDetail-module_saveButton__il_AH",saved:"JobDetail-module_saved__i6DcY",closeButton:"JobDetail-module_closeButton__vzAUH",logo:"JobDetail-module_logo__c7s7Z",logoPlaceholder:"JobDetail-module_logoPlaceholder__dg4LD",logoIcon:"JobDetail-module_logoIcon__XYWR2",titleSection:"JobDetail-module_titleSection__TZuQC",companyLink:"JobDetail-module_companyLink__mubnU",companyName:"JobDetail-module_compan