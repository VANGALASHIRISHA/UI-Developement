.active {\n        pointer-events: initial;\n        opacity: 1;\n        transform: translateY(0px);\n    }\n\n    &.after {\n        opacity: 0;\n        height: 0px;\n        overflow: hidden;\n        transform: translateY(-30px);\n    }\n}\n\n.topBar {\n    height: 32px;\n    transform: translateY(-30px);\n    opacity: 0;\n    will-change: transform, opacity;\n    transition: opacity 0.35s, transform 0.35s;\n\n    &.appear {\n        transform: translateY(0px);\n        opacity: 1;\n    }\n}\n\n.backButton {\n    position: absolute;\n    left: 32px;\n    top: 4px;\n    font-size: 22px;\n    overflow: hidden;\n    cursor: pointer;\n}\n\n.progressbar {\n    height: 100%;\n    width: 100%;\n    max-width: 560px;\n    margin: 0 auto;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n\n    &.multiple {\n        .progressbarStep {\n            &:nth-child(1) {\n                left: 0px;\n            }\n\n            &:nth-child(2) {\n                left: calc(50% - 16px); // 1/2\n            }\n\n            &:nth-child(3) {\n                right: 0px;\n            }\n        }\n    }\n}\n\n.progressbarStep {\n    width: 32px;\n    height: 32px;\n    min-width: 32px;\n    border-radius: 16px;\n    background: #9cb2dc;\n    color: #fff;\n    padding-top: 5px;\n    text-align: center;\n    z-index: 5;\n    transition-delay: 0.3s;\n    transition: background 0.35s, color 0.35s;\n\n    &:nth-child(1) {\n        left: 0px;\n    }\n\n    &:nth-child(2) {\n        left: calc(50% - 16px); // half\n    }\n\n    &:nth-child(3) {\n        right: 0px;\n    }\n\n    &Active {\n        background: #2dc08d;\n        color: #fff;\n    }\n\n    &Line {\n        height: 3px;\n        background: #e7ecf5;\n        width: 100%;\n\n        &.green {\n            background: #2dc08d;\n            z-index: 2;\n        }\n    }\n}\n\n.progressbarLine {\n    margin-top: 15px;\n    height: 3px;\n    background: #e7ecf5;\n    left: 0px;\n    right: 0px;\n    position: absolute;\n\n    &.green {\n        background: #2dc08d;\n        z-index: 2;\n    }\n}\n\n.steps {\n    position: relative;\n    margin-top: $base-offset * 4;\n    opacity: 0;\n    animation-name: stepOpacityUp;\n    animation-duration: 0.1s;\n    animation-fill-mode: forwards;\n}\n\n@keyframes stepOpacityUp {\n    from {\n        opacity: 0;\n        pointer-events: none;\n    }\n\n    to {\n        opacity: 1;\n        pointer-events: initial;\n    }\n}\n\n.input {\n    max-width: 600px;\n    margin: 0 auto;\n}\n\n.newTemplatesWrapper {\n    width: 90%;\n    max-width: 1600px;\n    margin: auto;\n}\n\n.authButton {\n    position: absolute;\n    right: 32px;\n    top: 32px;\n}\n\n.icon {\n    position: absolute;\n    transform: translate(-50%, -50%);\n    top: 50%;\n    left: 50%;\n    width: 14px;\n    height: 16px;\n}\n\n.linkedinLinkInput {\n    width: 584px;\n}\n'],sourceRoot:""}]),l.locals={step:"OnboardingPageDesktop-module_step__yG27V",before:"OnboardingPageDesktop-module_before__U8wpP",active:"OnboardingPageDesktop-module_active__NI7C2",after:"OnboardingPageDesktop-module_after__Ld5f7",topBar:"OnboardingPageDesktop-module_topBar__cs0F0",appear:"OnboardingPageDesktop-module_appear__Rdtur",backButton:"OnboardingPageDesktop-module_backButton__QiHKM",progressbar:"OnboardingPageDesktop-module_progressbar__QREf8",multiple:"OnboardingPageDesktop-module_multiple__Y7zEI",progressbarStep:"OnboardingPageDesktop-module_progressbarStep__cT9Wo",progressbarStepActive:"OnboardingPageDesktop-module_progressbarStepActive__Mev3C",progressbarStepLine:"OnboardingPageDesktop-module_progressbarStepLine__WH75q",green:"OnboardingPageDesktop-module_green__GK0d1",progressbarLine:"OnboardingPageDesktop-module_progressbarLine__todlm",steps:"OnboardingPageDesktop-module_steps__Je3Ec",stepOpacityUp:"OnboardingPageDesktop-module_stepOpacityUp__FHi7E",input:"OnboardingPageDesktop-module_input__yQGsE",newTemplatesWrapper:"OnboardingPageDesktop-module_newTemplatesWrapper__WnwOU",authBu