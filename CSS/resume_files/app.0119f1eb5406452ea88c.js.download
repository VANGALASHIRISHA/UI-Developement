    }\n\n    100% {\n        background-position: 400px 0;\n    }\n}\n\n.bone {\n    background: linear-gradient(90deg, $graphic-1 25%, darken($graphic-1, 3%) 37%, $graphic-1 63%);\n    background-size: 800px 100%;\n    animation: shimmer 1.6s ease-in-out infinite;\n    border-radius: 6px;\n}\n\n// Desktop / Mobile skeleton toggle\n.desktopSkeleton {\n    display: flex;\n\n    @media screen and (max-width: $screen-sm-max) {\n        display: none;\n    }\n}\n\n.mobileSkeleton {\n    display: none;\n\n    @media screen and (max-width: $screen-sm-max) {\n        display: flex;\n    }\n}\n\n.simpleCard {\n    background: linear-gradient(90deg, $graphic-1 25%, darken($graphic-1, 3%) 37%, $graphic-1 63%);\n    background-size: 800px 100%;\n    animation: shimmer 1.6s ease-in-out infinite;\n    border-radius: 16px;\n    height: 180px;\n    width: 100%;\n\n    @media screen and (max-width: $screen-sm-max) {\n        border-radius: 12px;\n        height: 132px;\n    }\n}\n\n// Left side — card skeletons\n.card {\n    padding: $base-offset * 2;\n    border-bottom: 1px solid $graphic-1;\n\n    &:last-child {\n        border-bottom: 0;\n    }\n}\n\n.cardHeader {\n    display: flex;\n    gap: $base-offset * 1.5;\n    margin-bottom: $base-offset * 1.5;\n}\n\n.logo {\n    width: 48px;\n    height: 48px;\n    border-radius: 12px;\n    flex-shrink: 0;\n}\n\n.cardInfo {\n    flex: 1;\n    min-width: 0;\n}\n\n.titleLine {\n    height: 14px;\n    width: 75%;\n    margin-bottom: 8px;\n}\n\n.companyLine {\n    height: 12px;\n    width: 40%;\n}\n\n.metaRow {\n    display: flex;\n    gap: $base-offset * 2;\n    margin-bottom: $base-offset * 1.5;\n}\n\n.metaItem {\n    height: 12px;\n    width: 70px;\n}\n\n.cardFooter {\n    border-top: 1px solid $graphic-1;\n    padding-top: $base-offset * 1.5;\n    display: flex;\n}\n\n.saveBtn {\n    height: 14px;\n    width: 56px;\n}\n\n// Right side — detail skeleton\n.detail {\n    padding: $base-offset * 3;\n}\n\n.detailActions {\n    display: flex;\n    justify-content: flex-end;\n    gap: $base-offset;\n    padding-bottom: $base-offset * 2;\n    border-bottom: 1px solid $graphic-1;\n    margin-bottom: $base-offset * 2;\n}\n\n.actionBtn {\n    height: 36px;\n    width: 90px;\n    border-radius: 8px;\n}\n\n.detailHeader {\n    display: flex;\n    gap: $base-offset;\n    margin-bottom: $base-offset * 2;\n}\n\n.detailTitle {\n    height: 18px;\n    width: 60%;\n    margin-bottom: 8px;\n}\n\n.detailCompany {\n    height: 13px;\n    width: 30%;\n}\n\n.detailMeta {\n    background: $graphic-1;\n    border-radius: 8px;\n    padding: $base-offset;\n    display: flex;\n    gap: $base-offset * 2;\n    margin-bottom: $base-offset * 2;\n}\n\n.detailMetaItem {\n    height: 12px;\n    width: 80px;\n}\n\n.descBlock {\n    background: $graphic-1;\n    border-radius: 12px;\n    height: 290px;\n    margin-bottom: $base-offset * 2;\n}\n\n.textLine {\n    height: 20px;\n    margin-bottom: $base-offset * 3;\n    border-radius: 4px;\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6df;\n$warning-hover: #feba62;\n\n// // Active elements\n$primary-active: #249a71;\n$secondary-active: #5f4dc7;\n$info-active: #3685bb;\n$warning-active: #d89745;\n$danger-active: #d94a5e;\n\n// // Transparent elements\n// // // opacity: 10%;\n$primary-10: rgba($primary, 0.1);\n$secondary-10: rgba($secondary, 0.1);\n$accent-10: rgba($accent, 0.1);\n$info-10: rgba($info, 0.1);\n$warning-10: rgba($warning, 0.1);\n$danger-10: rgba($danger, 0.1);\n// // // opacity 20%\n$primary-20: rgba($primary, 0.2);\n$secondary-20: rgba($secondary, 0.2);\n$accent-20: rgba($accent, 0.2);\n$info-20: rgba($info, 0.2);\n$warning-20: rgba($warning, 0.2);\n$danger-20: rgba($danger, 0.2);\n// // // opacity 30%\n$primary-30: rgba($primary, 0.3);\n$secondary-30: rgba($secondary, 0.3);\n$accent-30: rgba($accent, 0.3);\n$info-30: rgba($info, 0.3);\n$warning-30: rgba($warning, 0.3);\n$danger-30: rgba($danger, 0.3);\n\n// // Backgrounds\n$surface: $white;\n$surface-accent: #9cb2dc;\n$page: #f5f7fc;\n$page-alt: #fafbfd;\n\n// // Typography Colors\n$heading: #2d3639;\n$paragraph: #384347;\n$label: #60696c;\n$caption: #afb4b5;\n$subtext: #d8d9db;\n\n// // Supportive colors\n$modal: #47445a;\n$graphic-1: #f0f0f0;\n$graphic-2: #e4e4e4;\n$graphic-3: #f2f2f2;\n$border-color: #e0e0e0;\n\n// // CC colors\n$primary-cc: #eaf9f4;\n$secondary-cc: #f3f2fb;\n$danger-cc: #ffeef1;\n$info-cc: #ecf5fc;\n\n// // Visual elements Colors\n$visual-violet-1: #d1cbf1;\n$visual-violet-2: #e3e0f6;\n$visual-green-1: #abe6d1;\n$visual-green-2: #cdf0e4;\n$visual-blue: #b2d7f1;\n$visual-orange: #ffe0b9;\n$visual-pink: #ffcdd4;\n\n// // Shadows\n$shadow-default: 0px 4px 8px rgba(0, 0, 0, 0.1);\n$shadow-hover: 0px 2px 20px rgba(0, 0, 0, 0.1);\n$shadow-flat: 1px 1px 1px rgba(231, 228, 228, 0.5);\n$shadow-main-navigation: 0px 1px 3px rgba(0, 0, 0, 0.1);\n\n// Font-sizes\n$font-size-lg: 20px;\n$font-size-md: 18px;\n$font-size-rg: 16px;\n$font-size-sm: 14px;\n$font-size-xs: 12px;\n$font-size-xs-min: 10px;\n\n// Container - (with padding-inline:16px included)\n$container-xs: 100%;\n$container-md: 736px; // 12columns x 64px\n$container-lg: 956px; // 12columns x 84px\n$container-xl: 1184px; // 12columns x 96px\n$container-x