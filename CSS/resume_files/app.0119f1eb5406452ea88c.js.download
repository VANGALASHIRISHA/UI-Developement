AAA,CAIR,+CACI,WAAA,CACA,iBAAA,CACA,4BAAA,CACA,+BAAA,CAGA,sDAAA,CAEA,uDACI,aCwBW,CDvBX,oBAAA,CAEA,yDACI,iBAAA,CAGJ,gEACI,UAAA,CACA,oBAAA,CACA,UAAA,CACA,WAAA,CACA,iBAAA,CACA,qCC0BG,CDzBH,iBAAA,CACA,QAAA,CACA,SAAA,CACA,sEAAA,CAKZ,wDACI,UAAA,CACA,iBAAA,CAEA,6DACI,qBAAA,CAIR,sCACI,SAAA,CAGJ,gDACI,gCAAA,CACA,yCAAA,CAGJ,4DACI,WAAA,CAGJ,wCACI,4BAAA,CACA,UAAA,CACA,YAAA,CAIA,0BADJ,gDAEQ,YAAA,CAAA,CAIR,wCACI,iBAAA,CACA,UAAA,CACA,KAAA,CACA,UAAA,CACA,WAAA,CACA,kBAAA,CAEA,8CACI,+BC1BO,CD2BP,aC3DI,CD+DZ,4CACI,cAAA,CACA,WAAA",sourcesContent:['@import "enhancv-styleguide/variables";\n\n@keyframes fade-in {\n    0% {\n        opacity: 0;\n    }\n\n    100% {\n        opacity: 1;\n    }\n}\n\n.toolboxContainer {\n    width: 156px;\n    border-radius: 6px;\n    border-top: $base-offset solid $page;\n    border-bottom: $base-offset solid $page;\n\n    //  transition: width 0.4s ease;\n    transition: width 0.2s cubic-bezier(0.08, 0.52, 0.52, 1);\n\n    a:hover {\n        color: $secondary-active;\n        transition: color 0.1s;\n\n        i {\n            position: relative;\n        }\n\n        i::after {\n            content: "";\n            display: inline-block;\n            width: 24px;\n            height: 24px;\n            border-radius: 50%;\n            background-color: $secondary-20;\n            position: absolute;\n            top: -2px;\n            left: -2px;\n            animation: fade-in 0.5s forwards !important;\n        }\n    }\n}\n\n.toolboxContainerCollapsed {\n    width: 52px;\n    overflow-x: hidden;\n\n    span {\n        color: $surface !important;\n    }\n}\n\n.toolbox {\n    width: 2px;\n}\n\n.scrollAreaInitial {\n    transition: all ease-in-out 500ms;\n    max-height: calc(100vh - 106px) !important; // height of navbar (60px) + padding\n}\n\n.scrollAreaInitialMediumScreen {\n    width: 156px;\n}\n\n.separator {\n    border-top: 1px solid $graphic-2;\n    width: 100%;\n    margin: $base-offset 0;\n}\n\n.separatorBranding {\n    @media (max-height: 665px) {\n        display: none;\n    }\n}\n\n.boxButton {\n    position: absolute;\n    left: -44px;\n    top: 0;\n    width: 36px;\n    height: 36px;\n    transition: all 0.3s;\n\n    &:hover {\n        background: $secondary-20;\n        color: $secondary;\n    }\n}\n\n.boxButtonIcon {\n    font-size: 18px;\n    height: 24px;\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6df;\n$warning-hover: #feba62;\n\n// // Active elements\n$primary-active: #249a71;\n$secondary-active: #5f4dc7;\n$info-active: #3685bb;\n$warning-active: #d89745;\n$danger-active: #d94a5e;\n\n// // Transparent elements\n// // // opacity: 10%;\n$primary-10: rgba($primary, 0.1);\n$secondary-10: rgba($secondary, 0.1);\n$accent-10: rgba($accent, 0.1);\n$info-10: rgba($info, 0.1);\n$warning-10: rgba($warning, 0.1);\n$danger-10: rgba($danger, 0.1);\n// // // opacity 20%\n$primary-20: rgba($primary, 0.2);\n$secondary-20: rgba($secondary, 0.2);\n$accent-20: rgba($accent, 0.2);\n$info-20: rgba($info, 0.2);\n$warning-20: rgba($warning, 0.2);\n$danger-20: rgba($danger, 0.2);\n// // // opacity 30%\n$primary-30: rgba($primary, 0.3);\n$secondary-30: rgba($secondary, 0.3);\n$accent-30: rgba($accent, 0.3);\n$info-30: rgba($info, 0.3);\n$warning-30: rgba($warning, 0.3);\n$danger-30: rgba($danger, 0.3);\n\n// // Backgrounds\n$surface: $white;\n$surface-accent: #9cb2dc;\n$page: #f5f7fc;\n$page-alt: #fafbfd;\n\n// // Typography Colors\n$heading: #2d3639;\n$paragraph: #384347;\n$label: #60696c;\n$caption: #afb4b5;\n$subtext: #d8d9db;\n\n// // Supportive colors\n$modal: #47445a;\n$graphic-1: #f0f0f0;\n$graphic-2: #e4e4e4;\n$graphic-3: #f2f2f2;\n$border-color: #e0e0e0;\n\n// // CC colors\n$primary-cc: #eaf9f4;\n$secondary-cc: #f3f2fb;\n$danger-cc: #ffeef1;\n$info-cc: #ecf5fc;\n\n// // Visual elements Colors\n$visual-violet-1: #d1cbf1;\n$visual-violet-2: #e3e0f6;\n$visual-green-1: #abe6d1;\n$visual-green-2: #cdf0e4;\n$visual-blue: #b2d7f1;\n$visual-orange: #ffe0b9;\n$visual-pink: #ffcdd4;\n\n// // Shadows\n$shadow-default: 0px 4px 8px rgba(0, 0, 0, 0.1);\n$shadow-hover: 0px 2px 20px rgba(0, 0, 0, 0.1);\n$shadow-flat: 1px 1px 1px rgba(231, 228, 228, 0.5);\n$shadow-main-navigation: 0px 1px 3px rgba(0, 0, 0, 0.1);\n\n// Font-sizes\n$font-size-lg: 20px;\n$font-size-md: 18px;\n$font-size-rg: 16px;\n$font-size-sm: 14px;\n$font-size-xs: 12px;\n$font-size-xs-min: 10px;\n\n// Container - (with padding-inline:16px included)\n$container-xs: 100%;\n$container-md: 736px; // 12columns x 64px\n$container-lg: 956px; // 12columns x 84px\n$container-xl: 1184px; // 12columns x 96px\n$container-xxl: 1328px; // 12columns x 108px\n\n// Z-index modal\n$zindex-modal-background: 1002;\n$zindex-modal-content: 1003;\n'],sourceRoot:""}]),l.locals={toolboxContainer:"ToolboxDesktop-module_toolboxContainer__vECJ1","fade-in":"ToolboxDesktop-module_fade-in__qF47z",toolboxContainerCollapsed:"ToolboxDesktop-module_toolboxContainerCollapsed__NOmZk",toolbox:"ToolboxDesktop-module_toolbox__i7pVI",scrollAreaInitial:"ToolboxDesktop-module_scrollAreaInitial__QSztK",scrollAreaInitialMediumScreen:"ToolboxDesktop-module_scrollAreaInitialMediumScreen__WpCCP",separator:"ToolboxDesktop-module_separator__CECTG",separatorBranding:"ToolboxDesktop-module_separatorBrandi