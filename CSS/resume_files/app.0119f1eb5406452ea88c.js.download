AAA,uBACA,CAAA,sCACA,CAAA,gDAEA,0CACI,CAAA,4CAIR,gBACI,CAAA,aACA,CAAA,yCAGJ,OACI,CAAA,UACA,CAAA,0BACA,CAAA,eACA,CAAA,QACA,CAAA,SACA,CAAA,4CAGJ,+BACI,CAAA,6DAEA,kBC1QU,CAAA,mDD+Qd,WACI,CAAA,6CAGJ,eACI,CAAA,QACA,CAAA,WACA,CAAA,aCpMI",sourcesContent:['@import "enhancv-styleguide/variables";\n\n/*\n    AI Assistant Trigger styles\n*/\n\n.circle {\n    z-index: 49;\n    position: absolute;\n    cursor: pointer;\n\n    &:hover {\n        .aiText {\n            width: 80px;\n            opacity: 1;\n            padding-left: calc($base-offset / 2);\n            padding-right: $base-offset;\n            margin-left: $base-offset * 3;\n        }\n    }\n}\n\n.withLowerPriority {\n    opacity: 0;\n    visibility: hidden;\n    animation: lowerZIndex 1s 0.2s forwards;\n}\n\n.circleWithAnimation {\n    animation: showCircle 0.3s ease-out forwards;\n}\n\n.pin {\n    position: absolute;\n    width: 14px;\n    height: 14px;\n    z-index: -1;\n    right: -5px;\n    background-repeat: no-repeat;\n    background-size: contain;\n}\n\n.innerContainer {\n    border-radius: 200px;\n    background: linear-gradient(141deg, #8c7cdb 9.94%, #5f4dc7 50%);\n    box-shadow: 0px 2px 20px 0px rgba(0, 0, 0, 0.1);\n    height: 28px;\n    min-width: 28px;\n    overflow: hidden;\n    opacity: 1;\n    visibility: visible;\n    transition-property: opacity, visibility;\n    transition-duration: 0.3s;\n    transition-timing-function: ease-in-out;\n}\n\n.aiText {\n    width: 0px;\n    text-wrap: nowrap;\n    transition: all 0.5s;\n    opacity: 0;\n}\n\n.hidden {\n    display: none;\n}\n\n@keyframes showCircle {\n    from {\n        opacity: 0;\n        transform: translateX(10px);\n    }\n\n    to {\n        opacity: 1;\n        transform: translateX(0);\n    }\n}\n\n@keyframes lowerZIndex {\n    to {\n        z-index: -1;\n    }\n}\n\n/*\n    AI Assistant Popup styles\n*/\n\n.aiPopup {\n    width: 250px;\n    z-index: 55;\n    transition-property: box-shadow, opacity, visibility;\n    transition-duration: 0.3s;\n    transition-timing-function: ease-in-out;\n\n    &:hover {\n        box-shadow: 0px 2px 20px 0px rgba($black, 0.1);\n    }\n}\n\n.aiActionsContainer {\n    opacity: 1;\n    transition: opacity 0.3s ease-in-out;\n}\n\n.aiDot {\n    width: 8px;\n    height: 8px;\n    border-radius: 10px;\n}\n\n.aiActionsListItem {\n    width: 100%;\n}\n\n.aiActionButton {\n    width: 100%;\n    background: none;\n    border: 0;\n    transition: background 0.3s ease-in-out;\n\n    &:hover {\n        background: $page;\n    }\n}\n\n.aiSeparator {\n    position: relative;\n    border-top: 1px solid $subtext;\n\n    &::before {\n        content: attr(data-text);\n        padding: 0 $base-offset;\n        background: $white;\n        position: absolute;\n        left: 50%;\n        transform: translate(-50%, -50%);\n        color: $label;\n    }\n}\n\n.aiTextarea {\n    width: 100%;\n    height: 56px;\n    resize: none;\n    outline: none;\n    transition: border-color 0.3s ease-in-out;\n\n    &:focus {\n        border-color: $primary;\n    }\n}\n\n.aiTextareaContainerLoading {\n    &::before {\n        content: "";\n        position: absolute;\n        top: 0;\n        left: 0;\n        width: 100%;\n        height: 100%;\n        background: $graphic-1;\n    }\n}\n\n.aiTextareaLoader {\n    z-index: 2;\n    top: 50%;\n    left: 50%;\n    translate: -50% -50%;\n}\n\n.aiLoading {\n    opacity: 0.5;\n    pointer-events: none;\n}\n\n/*\n    Icon styles\n*/\n\n.animatedIcon {\n    &::before {\n        animation: iconsRoll 9s infinite linear;\n    }\n}\n\n@keyframes iconsRoll {\n    0% {\n        opacity: 1;\n        content: "\\e13e";\n    }\n\n    17% {\n        opacity: 0;\n    }\n\n    31% {\n        opacity: 1;\n    }\n\n    33% {\n        opacity: 1;\n        content: "\\e12e";\n    }\n\n    50% {\n        opacity: 0;\n    }\n\n    64% {\n        opacity: 1;\n    }\n\n    66% {\n        opacity: 1;\n        content: "\\e160";\n    }\n\n    83% {\n        opacity: 0;\n    }\n\n    98% {\n        opacity: 1;\n    }\n\n    100% {\n        opacity: 1;\n        content: "\\e13e";\n    }\n}\n\n/*\n    AI Assistant Results popup styles\n*/\n\n.aiResultsPopup {\n    width: 445px;\n    z-index: 46;\n    transition-property: box-shadow, opacity, visibility;\n    transition-duration: 0.3s;\n    transition-timing-function: ease-in-out;\n\n    &:hover {\n        box-shadow: 0px 2px 20px 0px rgba($black, 0.1);\n    }\n}\n\n.aiResultsContent {\n    max-height: 328px;\n    overflow: auto;\n}\n\n.aiCloseButton {\n    top: 50%;\n    right: $base-offset * 2;\n    transform: translateY(-50%);\n    background: none;\n    border: 0;\n    padding: 0;\n}\n\n.aiSuggestionItem {\n    border-bottom: 1px solid $subtext;\n\n    &:not(:last-child) {\n        padding-bottom: $base-offset;\n    }\n}\n\n.aiSuggestionItemContent {\n    flex-grow: 1;\n}\n\n.aiSecondaryButton {\n    background: none;\n    border: 0;\n    padding: 4px;\n    color: $label;\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6df;\n$warning-hover: #feba62;\n\n// // Active elements\n$primary-active: #249a71;\n$secondary-active: #5f4dc7;\n$info-active: #3685bb;\n$warning-active: #d89745;\n$danger-active: #d94a5e;\n\n// // Transparent elements\n// // // opacity: 10%;\n$primary-10: rgba($primary, 0.1);\n$secondary-10: rgba($secondary, 0.1);\n$accent-10: rgba($accent, 0.1);\n$info-10: rgba($info, 0.1);\n$warning-10: rgba($warning, 0.1);\n$danger-10: rgba($danger, 0.1);\n// // // opacity 20%\n$primary-20: rgba($primary, 0.2);\n$secondary-20: rgba($secondary, 0.2);\n$accent-20: rgba($accent, 0.2);\n$info-20: rgba($info, 0.2);\n$warning-20: rgba($warning, 0.2);\n$danger-20: rgba($danger, 0.2);\n// // // opacity 30%\n$primary-30: rgba($primary, 0.3);\n$secondary-30: rgba($secondary, 0.3);\n$accent-30: rgba($accent, 0.3);\n$info-30: rgba($info, 0.3);\n$warning-30: rgba($warning, 0.3);\n$danger-30: rgba($danger, 0.3);\n\n// // Backgrounds\n$surface: $white;\n$surface-accent: #9cb2dc;\n$page: #f5f7fc;\n$page-alt: #fafbfd;\n\n// // Typography Colors\n$heading: #2d3639;\n$paragraph: #384347;\n$label: #60696c;\n$caption: #afb4b5;\n$subtext: #d8d9db;\n\n// // Supportive colors\n$modal: #47445a;\n$graphic-1: #f0f0f0;\n$graphic-2: #e4e4e4;\n$graphic-3: #f2f2f2;\n$border-color: #e0e0e0;\n\n// // CC colors\n$primary-cc: #eaf9f4;\n$secondary-cc: #f3f2fb;\n$danger-cc: #ffeef1;\n$info-cc: #ecf5fc;\n\n// // Visual elements Colors\n$visual-violet-1: #d1cbf1;\n$visual-violet-2: #e3e0f6;\n$visual-green-1: #abe6d1;\n$visual-green-2: #cdf0e4;\n$visual-blue: #b2d7f1;\n$visual-orange: #ffe0b9;\n$visual-pink: #ffcdd4;\n\n// // Shadows\n$shadow-default: 0px 4px 8px rgba(0, 0, 0, 0.1);\n$shadow-hover: 0px 2px 20px rgba(0, 0, 0, 0.1);\n$shadow-flat: 1px 1px 1px rgba(231, 228, 228, 0.5);\n$shadow-main-navigation: 0px 1px 3px rgba(0, 0, 0, 0.1);\n\n// Font-sizes\n$font-size-lg: 20px;\n$font-size-md: 18px;\n$font-size-rg: 16px;\n$font-size-sm: 14px;\n$font-size-xs: 12px;\n$font-size-xs-min: 10px;\n\n// Container - (with padding-inline:16px included)\n$container-xs: 100%;\n$container-md: 736px; // 12columns x 64px\n$container-lg: 956px; // 12columns x 84px\n$container-xl: 1184px; // 12columns x 96px\n$container-xxl: 1328px; // 12colu