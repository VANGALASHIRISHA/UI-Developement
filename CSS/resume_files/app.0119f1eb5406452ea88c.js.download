nd-color: $primary-10;\n    }\n}\n\n.cardPurple {\n    background-color: $secondary-10;\n    border-color: $secondary-20;\n\n    .accentDot,\n    .chevronCircleBg {\n        background-color: $secondary;\n    }\n\n    .accentIcon,\n    .ctaText,\n    .chevronIcon {\n        color: $secondary;\n    }\n\n    .chevronCircleBg {\n        background-color: $secondary-10;\n    }\n}\n\n.cardBlue {\n    background-color: $info-10;\n    border-color: $info-20;\n\n    .accentDot {\n        background-color: $info;\n    }\n\n    .accentIcon,\n    .ctaText,\n    .chevronIcon {\n        color: $info;\n    }\n\n    .chevronCircleBg {\n        background-color: $info-10;\n    }\n}\n\n.accentDot {\n    position: absolute;\n    top: 12px;\n    right: 12px;\n    width: 6px;\n    height: 6px;\n}\n\n.iconBox {\n    width: 32px;\n    height: 32px;\n    min-width: 32px;\n    transition: transform 0.2s;\n\n    .card:hover & {\n        transform: scale(1.05);\n    }\n}\n\n.accentIcon {\n    font-size: 20px;\n}\n\n.ctaSection {\n    border-top: 1px solid rgba(0, 0, 0, 0.05);\n}\n\n.ctaText {\n    .card:hover & {\n        text-decoration: underline;\n        text-underline-offset: 4px;\n    }\n}\n\n.chevronCircle {\n    width: 16px;\n    height: 16px;\n    min-width: 16px;\n    transition: transform 0.2s;\n\n    .card:hover & {\n        transform: translateX(2px);\n    }\n}\n\n.chevronCircleBg {\n    composes: chevronCircle;\n}\n\n.chevronIcon {\n    font-size: 10px;\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6df;\n$warning-hover: #feba62;\n\n// // Active elements\n$primary-active: #249a71;\n$secondary-active: #5f4dc7;\n$info-active: #3685bb;\n$warning-active: #d89745;\n$danger-active: #d94a5e;\n\n// // Transparent elements\n// // // opacity: 10%;\n$primary-10: rgba($primary, 0.1);\n$secondary-10: rgba($secondary, 0.1);\n$accent-10: rgba($accent, 0.1);\n$info-10: rgba($info, 0.1);\n$warning-10: rgba($warning, 0.1);\n$danger-10: rgba($danger, 0.1);\n// // // opacity 20%\n$primary-20: rgba($primary, 0.2);\n$secondary-20: rgba($secondary, 0.2);\n$accent-20: rgba($accent, 0.2);\n$info-20: rgba($info, 0.2);\n$warning-20: rgba($warning, 0.2);\n$danger-20: rgba($danger, 0.2);\n// // // opacity 30%\n$primary-30: rgba($primary, 0.3);\n$secondary-30: rgba($secondary, 0.3);\n$accent-30: rgba($accent, 0.3);\n$info-30: rgba($info, 0.3);\n$warning-30: rgba($warning, 0.3);\n$danger-30: rgba($danger, 0.3);\n\n// // Backgrounds\n$surface: $white;\n$surface-accent: #9cb2dc;\n$page: #f5f7fc;\n$page-alt: #fafbfd;\n\n// // Typography Colors\n$heading: #2d3639;\n$paragraph: #384347;\n$label: #60696c;\n$caption: #afb4b5;\n$subtext: #d8d9db;\n\n// // Supportive colors\n$modal: #47445a;\n$graphic-1: #f0f0f0;\n$graphic-2: #e4e4e4;\n$graphic-3: #f2f2f2;\n$border-color: #e0e0e0;\n\n// // CC colors\n$primary-cc: #eaf9f4;\n$secondary-cc: #f3f2fb;\n$danger-cc: #ffeef1;\n$info-cc: #ecf5fc;\n\n// // Visual elements Colors\n$visual-violet-1: #d1cbf1;\n$visual-violet-2: #e3e0f6;\n$visual-green-1: #abe6d1;\n$visual-green-2: #cdf0e4;\n$visual-blue: #b2d7f1;\n$visual-orange: #ffe0b9;\n$visual-pink: #ffcdd4;\n\n// // Shadows\n$shadow-default: 0px 4px 8px rgba(0, 0, 0, 0.1);\n$shadow-hover: 0px 2px 20px rgba(0, 0, 0, 0.1);\n$shadow-flat: 1px 1px 1px rgba(231, 228, 228, 0.5);\n$shadow-main-navigation: 0px 1px 3px rgba(0, 0, 0, 0.1);\n\n// Font-sizes\n$font-size-lg: 20px;\n$font-size-md: 18px;\n$font-size-rg: 16px;\n$font-size-sm: 14px;\n$font-size-xs: 12px;\n$font-size-xs-min: 10px;\n\n// Container - (with padding-inline:16px included)\n$container-xs: 100%;\n$container-md: 736px; // 12columns x 64px\n$container-lg: 956px; // 12columns x 84px\n$container-xl: 1184px; // 12columns x 96px\n$container-xxl: 1328px; // 12columns x 108px\n\n// Z-index modal\n$zindex-modal-background: 1002;\n$zindex-modal-content: 1003;\n'],sourceRoot:""}]),l.locals={card:"DownloadModalFeatureCard-module_card__AVNoi",cardGreen:"DownloadModalFeatureCard-module_cardGreen__FQDVq",accentDot:"DownloadModalFeatureCard-module_accentDot__NxcM7",chevronCircleBg:"DownloadModalFeatureCard-module_chevronCircleBg__C9790 DownloadModalFeatureCard-module_chevronCircle__wuqt5",accentIcon:"DownloadModalFeatureCard-module_accentIcon__rGssT",ctaText:"DownloadModalFeatureCard-module_ctaText__R9hWj",chevronIcon:"DownloadModalFeatureCard-module_chevronIcon__yHPwR",cardPurple:"DownloadModalFeatureCard-module_cardPurple__iY68J",cardBlue:"DownloadModalFeatureCard-module_cardBlue__MMV1y",iconBox:"DownloadModalFeatureCard-module_iconBox__AzW31",ctaSection:"DownloadModalFeatureCard-module_ctaSection__cSLqG",chevronCircle:"DownloadModalFeatureCard-module_chevronCircle__wuqt5"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/modules/Modal/DownloadModal/DownloadModalVariantB.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,".DownloadModalVariantB-module_ctaGrid__nABeZ{display:grid;grid-template-columns:2fr 1fr;gap:12px}