le_tableBodyCell__ZAiGL{overflow:hidden;white-space:nowrap;display:flex;align-items:center;height:48px;font-weight:400;font-family:Inter,Helvetica,Arial,"Sans-Serif"}.Table-module_checkboxCell__kWpWE{max-width:30px}.Table-module_tableHeadSelected__IZSsW{background-color:#eaf9f4;border:1px solid #abe6d1}.Table-module_bulkActions__gIJ2O{flex:1}.Table-module_search__tbW7Q{background:#f5f7fc}',"",{version:3,sources:["webpack://./src/pages/ResumeCheckerReports/components/Table/Table.module.scss"],names:[],mappings:"AAAA,2BACI,UAAA,CACA,iBAAA,CACA,qBAAA,CAGJ,+BACI,YAAA,CACA,wBAAA,CACA,yBAAA,CAGJ,mCACI,YAAA,CACA,kBAAA,CACA,WAAA,CACA,eAAA,CAGJ,+BACI,UAAA,CAGJ,kCACI,YAAA,CACA,8BAAA,CACA,+BAAA,CACA,6BAAA,CAGJ,mCACI,eAAA,CACA,kBAAA,CACA,YAAA,CACA,kBAAA,CACA,WAAA,CACA,eAAA,CACA,8CAAA,CAGJ,kCACI,cAAA,CAGJ,uCACI,wBAAA,CACA,wBAAA,CAGJ,iCACI,MAAA,CAGJ,4BACI,kBAAA",sourcesContent:['.table {\n    width: 100%;\n    border-radius: 5px;\n    background-color: #fff;\n}\n\n.tableHead {\n    display: flex;\n    border: 1px solid #e4e4e4;\n    border-radius: 5px 5px 0 0;\n}\n\n.tableHeadCell {\n    display: flex;\n    align-items: center;\n    height: 48px;\n    font-weight: 500;\n}\n\n.tableBody {\n    width: 100%;\n}\n\n.tableBodyRow {\n    display: flex;\n    border-right: 1px solid #e4e4e4;\n    border-bottom: 1px solid #e4e4e4;\n    border-left: 1px solid #e4e4e4;\n}\n\n.tableBodyCell {\n    overflow: hidden;\n    white-space: nowrap;\n    display: flex;\n    align-items: center;\n    height: 48px;\n    font-weight: 400;\n    font-family: Inter, Helvetica, Arial, "Sans-Serif";\n}\n\n.checkboxCell {\n    max-width: 30px;\n}\n\n.tableHeadSelected {\n    background-color: #eaf9f4;\n    border: 1px solid #abe6d1;\n}\n\n.bulkActions {\n    flex: 1;\n}\n\n.search {\n    background: #f5f7fc;\n}\n'],sourceRoot:""}]),l.locals={table:"Table-module_table__r1QrE",tableHead:"Table-module_tableHead__34h4A",tableHeadCell:"Table-module_tableHeadCell__cGoro",tableBody:"Table-module_tableBody__GGQ2R",ta