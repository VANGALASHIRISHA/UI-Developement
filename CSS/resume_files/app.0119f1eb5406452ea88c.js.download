}.EducationItemDefault-module_degree__BESrG{font-weight:500}","",{version:3,sources:["webpack://./src/packages/Resume/ItemTypes/Education/EducationItemDefault.module.scss","webpack://./node_modules/sharedstyle/_variables.scss","webpack://./node_modules/enhancv-styleguide/variables.scss"],names:[],mappings:"AAAA,kDAGA,kBACI,CAAA,UC8EI,CAAA,cD5EJ,CAAA,gBACA,CAAA,kBACA,CAAA,eACA,CAAA,oBACA,CAAA,qDAGJ,oBACI,CAAA,eACA,CAAA,+GAGA,yBACI,CAAA,mDAIR,iBACI,CAAA,OACA,CAAA,qDAGJ,oBACI,CAAA,iBACA,CAAA,6BACA,CAAA,cACA,CAAA,aEmDI,CAAA,eFjDJ,CAAA,gBACA,CAAA,6CAGJ,eACI,CAAA,8CAGJ,iBACI,CAAA,kBACA,CAAA,mDAGJ,eACI,CAAA,iBACA,CAAA,iBACA,CAAA,2BACA,CAAA,eACA,CAAA,8DAGJ,aACI,CAAA,wDAGJ,UACI,CAAA,kBACA,CAAA,kBACA,CAAA,+CAGJ,cACI,CAAA,gBACA,CAAA,gDAGJ,eACI,CAAA,cACA,CAAA,8CAGJ,cACI,CAAA,wBACA,CAAA,aACA,CAAA,WACA,CAAA,gBACA,CAAA,2CAGJ,eACI",sourcesContent:['@import "enhancv-styleguide/variables";\n@import "~sharedstyle/variables";\n\n.mobilеGpaIcon {\n    background: #2f80ed;\n    color: $white;\n    font-size: 12px;\n    line-height: 15px;\n    border-radius: 20px;\n    padding: 4px 6px;\n    display: inline-block;\n}\n\n.mobileGpaContent {\n    display: inline-block;\n    margin-left: 8px;\n\n    /*TODO add this class ? */\n    &.editable-field-wrapper {\n        margin-top: 0px !important;\n    }\n}\n\n.mobileGpaValue {\n    position: relative;\n    top: 5px;\n}\n\n.educationItemGpa {\n    display: inline-block;\n    padding-left: 12px;\n    border-left: 1px solid $label;\n    font-size: 15px;\n    color: $label;\n    font-weight: 400;\n    margin-left: 16px;\n}\n\n.gpaValue {\n    font-weight: 700;\n}\n\n.separator {\n    position: relative;\n    vertical-align: top;\n}\n\n.gpaTextWrapper {\n    margin: 4px auto;\n    margin-bottom: 6px;\n    text-align: center;\n    -webkit-font-smoothing: auto;\n    font-weight: 400;\n}\n\n.educationItemGpaContainer {\n    flex-shrink: 0;\n}\n\n.educationItemNotGpa {\n    width: auto;\n    display: table-cell;\n    padding-right: 20px;\n}\n\n.fontSize11 {\n    font-size: 11px;\n    line-height: 13px;\n}\n\n.institution {\n    font-weight: 700;\n    margin-top: 4px;\n}\n\n.iconStyle {\n    font-size: 12px;\n    color: $resume-body-color !important;\n    flex: 0 0 auto;\n    height: 14px;\n    margin-right: 4px;\n}\n\n.degree {\n    font-weight: 500;\n}\n','@use "sass:color";\n@use "sass:math";\n//\n// Variables\n// --------------------------------------------------\n\n//== Colors\n//\n//## Gray and brand colors for use across Bootstrap.\n\n$shadow-4: 0 0 12px -3px rgba(0, 0, 0, 0.3);\n$shadow-5: 0 0 4px 0px rgba(0, 0, 0, 0.3);\n\n$shadow-1: 0 0 4px 0 rgba(160, 162, 167, 0.15);\n$shadow-2: 0 0 2px 0 rgba(77, 77, 77, 0.16);\n$shadow-3: 0 0 2px 0 rgba(83, 83, 83, 0.5);\n\n$gray-base: #000 !default;\n$gray-dark: #384347 !default;\n$resume-body-color: #3e3e3e !default; // specific body color for the resumes - without blue color included\n$gray-dark-2: #222 !default;\n$gray: color.adjust($gray-base, $lightness: 33.5%) !default; // #555\n$gray-light: color.adjust($gray-base, $lightness: 46.7%) !default; // #777\n$gray-lighter: color.adjust($gray-base, $lightness: 80%) !default; // #ccc\n$green-light: #eaf8f3;\n\n$gray-1: #b2b4b6;\n$gray-1-20: rgba($gray-1, 0.2);\n$gray-1-50: rgba($gray-1, 0.5);\n$gray-2: #65696d;\n$gray-2-20: rgba($gray-2, 0.2);\n$gray-2-50: rgba($gray-2, 0.5);\n$gray-3: #384347;\n$gray-3-20: rgba($gray-3, 0.2);\n$gray-3-50: rgba($gray-3, 0.5);\n\n$green-3: #2dc08d;\n$green-2: #62d0aa;\n$green-1: #d5f2e8;\n$green-hover: #249a71;\n\n$purple-3: #8c7cdb;\n$purple-2: #c5bded;\n$purple-1: #e8e5f8;\n\n$red-3: #ff576f;\n$red-2: #ffabb7;\n$red-1: #ffeef0;\n\n$blue-3: #7aaacb;\n$blue-2: #b5d6ec;\n$blue-1: #e2eff8;\n$blue-background: #f3f5fa;\n\n$yellow-3: #feb251;\n$yellow-2: #fed8a7;\n$yellow-1: #fff0dc;\n\n$background: #fafbfd;\n$brand-primary: #00c091;\n$brand-promo: #e7762e;\n$brand-success: #2dc08c !default;\n$brand-info: #5bc0de !default;\n$brand-warning: #f2994a !default;\n$brand-danger: #ff576f !default;\n$brand-border-color: #e6e6e6 !default;\n$brand-grey-background: #f2f2f2;\n$color-facebook: #3b5998;\n$color-twitter: #5eaade;\n$color-gplus: #dd4b39;\n$color-instagram: #333333;\n$color-linkedin: #2578b5;\n$color-messenger-first: rgb(1, 183, 255);\n$color-messenger-second: rgb(0, 126, 254);\n$color-messenger-border: #ffffff;\n$color-onboarding: #009ee8;\n$purple-color: #8c7cdb;\n$brand-gray-color: #65696d;\n$brand-info-font-color: #b2b4b6;\n$toolbox-border: rgba(223, 223, 223, 0.52);\n$selected-item-border-color: #60d5ba;\n\n$white: white;\n\n$op-background-color: #333333;\n$op-nav-control-color: #464646;\n$op-control-color: $gray-dark;\n$op-light-color: #e6e6e6;\n$op-control-primary-color: $brand-success;\n$op-notification-bg-primary: #ccf5e9;\n$op-notification-bg-danger: #ffc7d4;\n$op-notification-bg-warning: #ffe2ca;\n\n$op-base-offset: 8px !default;\n$op-btn-padding-horizontal: 14px;\n\n//Resume Styles\n$resume-rounding: 5px;\n\n//== Scaffolding\n//\n//## Settings for some of the most global styles.\n\n//** Background color for `<body>`.\n$body-bg: #fff !default;\n//** Global text color on `<body>`.\n$text-color: $gray-dark !default;\n\n$text-color-hover: color.adjust($text-color, $lightness: 30%) !default;\n\n//** Global textual link color.\n$link-color: white !default;\n//** Link hover color set via `darken()` function.\n$link-hover-color: color.adjust(white, $lightness: -10%);\n//** Link hover decoration.\n$link-hover-decoration: none !default;\n\n//== Typography\n//\n//## Font, line-height, and color for body text, headings, and more.\n\n$font-family-sans-serif: "Roboto", Arial, Helvetica, "Noto Sans Devanagari", "Noto Sans CJK SC Thin",\n    "Noto Sans SC", "Noto Sans Hebrew", "Noto Sans Bengali", sans-serif !default;\n$font-family-serif: Georgia, "Times New Roman", Times, "Noto Sans Devanagari",\n    "Noto Sans CJK SC Thin", "Noto Sans SC", "Noto Sans Hebrew", "Noto Sans Bengali", serif !default;\n//** Default monospace fonts for `<code>`, `<kbd>`, and `<pre>`.\n$font-family-monospace: Menlo, Monaco, Consolas, "Courier New", monospace !default;\n$font-family-base: "Inter" !default;\n\n$roboto: "Roboto", Arial, Helvetica, sans-serif;\n$opensans: "Open Sans", Arial, Helvetica, sans-serif;\n$account-heading-font: "Rubik", sans-serif !important;\n\n$font-size-base: 14px !default;\n$font-size-large: 18px !default;\n$font-size-small: 11px !default;\n\n$font-size-h1: 68px !default; // ~36px\n$font-size-h2: 38px !default; // ~30px\n$font-size-h3: 32px !default; // ~24px\n$font-size-h4: 26px !default; // ~18px\n$font-size-h5: 22px !default;\n$font-size-h6: 20px !default; // ~12px\n\n//** Unit-less `line-height` for use in components like buttons.\n$line-height-base: 1.428571429 !default; // 20/14\n//** Computed "line-height" (`font-size` * `line-height`) for use with `margin`, `padding`, etc.\n$line-height-computed: math.floor(($font-size-base * $line-height-base)) !default; // ~20px\n\n//** By default, this inherits from the `<body>`.\n$headings-font-family: "Rubik", sans-serif !default;\n$headings-font-weight: 300 !default;\n$headings-line-height: 1.1 !default;\n$headings-color: $gray-dark !default;\n\n//== Components\n//\n//## Define common padding and border radius sizes and more. Values based on 14px text and 1.428 line-height (~20px to start).\n\n$padding-base-vertical: 9px !default;\n$padding-base-horizontal: 14px !default;\n\n$padding-large-vertical: 12px !default;\n$padding-large-horizontal: 24px !default;\n\n$padding-small-vertical: 5px !default;\n$padding-small-horizontal: 18px !default;\n\n$padding-xs-vertical: 1px !default;\n$padding-xs-horizontal: 12px !default;\n\n$line-height-large: 1.3333333 !default; // extra decimals for Win 8.1 Chrome\n$line-height-small: 1.5 !default;\n\n$border-radius-base: 5px !default;\n$border-radius-large: 9px !default;\n$border-radius-small: 4px !default;\n\n//** Global color for active items (e.g., navs or dropdowns).\n$component-active-color: #fff !default;\n//** Global background color for active items (e.g., navs or dropdowns).\n$component-active-bg: $brand-primary !default;\n\n//** Width of the `border` for generating carets that indicator dropdowns.\n$caret-width-base: 4px !default;\n//** Carets increase slightly in size for larger components.\n$caret-width-large: 5px !default;\n\n//== Tables\n//\n//## Customizes the `.table` component with basic values, each used across all table variations.\n\n//** Padding for `<th>`s and `<td>`s.\n$table-cell-padding: 8px !default;\n//** Padding for cells in `.table-condensed`.\n$table-condensed-cell-padding: 5px !default;\n\n//** Default background color used for all tables.\n$table-bg: transparent !default;\n//** Background color used for `.table-striped`.\n$table-bg-accent: #f9f9f9 !default;\n//** Background color used for `.table-hover`.\n$table-bg-hover: #f5f5f5 !default;\n$table-bg-active: $table-bg-hover !default;\n\n//** Border color for table and cell borders.\n$table-border-color: #ddd !default;\n\n//== Buttons\n//\n//## For each of Bootstrap\'s buttons, define text, background and border color.\n\n$btn-font-weight: bold !default;\n\n$btn-default-color: #8c7cdb !default;\n$btn-default-bg: #fff !default;\n$btn-default-border: #8c7cdb !default;\n\n$btn-primary-color: #fff !default;\n$btn-primary-bg: $brand-primary !default;\n$btn-primary-border: $brand-primary !default;\n\n$btn-success-color: #fff !default;\n$btn-success-bg: $brand-success !default;\n$btn-success-border: color.adjust($btn-success-bg, $lightness: -5%) !default;\n\n$btn-info-color: #fff !default;\n$btn-info-bg: $brand-info !default;\n$btn-info-border: color.adjust($btn-info-bg, $lightness: -5%) !default;\n\n$btn-warning-color: #fff !default;\n$btn-warning-bg: $brand-warning !default;\n$btn-warning-border: color.adjust($btn-warning-bg, $lightness: -5%) !default;\n\n$btn-danger-color: #fff !default;\n$btn-danger-bg: $brand-danger !default;\n$btn-danger-border: color.adjust($btn-danger-bg, $lightness: -5%) !default;\n\n$btn-link-disabled-color: $gray-light !default;\n\n// Allows for customizing button radius independently from global border radius\n$btn-border-radius-base: $border-radius-base;\n$btn-border-radius-large: $border-radius-base;\n$btn-border-radius-small: $border-radius-base;\n\n//== Forms\n//\n//##\n\n//** `<input>` background color\n$input-bg: #fff !default;\n//** `<input disabled>` background color\n$input-bg-disabled: $gray-lighter !default;\n\n//** Text color for `<input>`s\n$input-color: $gray !default;\n//** `<input>` border color\n$input-border: #b3b3b3 !default;\n\n// TODO: Rename `$input-border-radius` to `$input-border-radius-base` in v4\n//** Default `.form-control` border radius\n// This has no effect on `<select>`s in some browsers, due to the limited stylability of `<select>`s in CSS.\n$input-border-radius: $border-radius-base;\n//** Large `.form-control` border radius\n$input-border-radius-large: $border-radius-base;\n//** Small `.form-control` border radius\n$input-border-radius-small: $border-radius-base;\n\n//** Border color for inputs on focus\n$input-border-focus: $brand-primary !default;\n\n//** Placeholder text color\n$input-color-placeholder: color.adjust($gray-base, $lightness: 70%) !default;\n\n//** Default `.form-control` height\n$input-height-base: ($line-height-computed + ($padding-base-vertical * 2) + 2) !default;\n//** Large `.form-control` height\n$input-height-large: (\n    math.ceil($font-size-large * $line-height-large) + ($padding-large-vertical * 2) + 2\n) !default;\n//** Small `.form-control` height\n$input-height-small: (\n    math.floor($font-size-small * $line-height-small) + ($padding-small-vertical * 2) + 2\n) !default;\n\n//** `.form-group` margin\n$form-group-margin-bottom: 15px !default;\n\n$legend-color: $gray-dark !default;\n$legend-border-color: #e5e5e5 !default;\n\n//** Background color for textual input addons\n$input-group-addon-bg: $gray-lighter !default;\n//** Border color for textual input addons\n$input-group-addon-border-color: $input-border !default;\n\n//** Disabled cursor for form controls and buttons.\n$cursor-disabled: not-allowed !default;\n\n//== Dropdowns\n//\n//## Dropdown menu container and contents.\n\n//** Background for the dropdown menu.\n$dropdown-bg: #fff !default;\n//** Dropdown menu `border-color`.\n$dropdown-border: rgba(0, 0, 0, 0.15) !default;\n//** Dropdown menu `border-color` **for IE8**.\n$dropdown-fallback-border: #ccc !default;\n//** Divider color for between dropdown items.\n$dropdown-divider-bg: #e5e5e5 !default;\n\n//** Dropdown link text color.\n$dropdown-link-color: $gray-dark !default;\n//** Hover color for dropdown links.\n$dropdown-link-hover-color: color.adjust($gray-dark, $lightness: 50%) !default;\n//** Hover background for dropdown links.\n$dropdown-link-hover-bg: transparent !default;\n\n//** Active dropdown menu item text color.\n$dropdown-link-active-color: $component-active-color !default;\n//** Active dropdown menu item background color.\n$dropdown-link-active-bg: $component-active-bg !default;\n\n//** Disabled dropdown menu item background color.\n$dropdown-link-disabled-color: $gray-light !default;\n\n//** Text color for headers within dropdown menus.\n$dropdown-header-color: $gray-light !default;\n\n//** Deprecated `$dropdown-caret-color` as of v3.1.0\n$dropdown-caret-color: #000 !default;\n\n//-- Z-index master list\n//\n// Warning: Avoid customizing these values. They\'re used for a bird\'s eye view\n// of components dependent on the z-axis and are designed to all work together.\n//\n// Note: These variables are not generated into the Customizer.\n\n$zindex-navbar: 1000 !default;\n$zindex-dropdown: 1000 !default;\n$zindex-mobile-design-menu: 1001 !default;\n$zindex-modal-background: 1002 !default; // from style guide --\x3e\n$zindex-modal-content: 1003 !default; // <--\n$zindex-full-screen-dropdown: 1004 !default;\n$zindex-popover: 1020 !default;\n$zindex-tooltip: 1050 !default;\n$zindex-navbar-fixed: 1030 !default;\n$zindex-toaster: 1030 !default;\n$zindex-alert: 1060 !default;\n$zindex-op-currdoing-cirle: 100 !default;\n$zindex-op-section-controls: 1 !default;\n$zindex-toasters: 8000 !default;\n\n//== Media queries breakpoints\n//\n//## Define the breakpoints at which your layout will change, adapting to different screen sizes.\n\n//== Grid system\n//\n//## Define your custom responsive grid.\n\n//** Number of columns in the grid.\n$grid-columns: 12 !default;\n//** Padding between columns. Gets divided in half for the left and right.\n$grid-gutter-width: 20px !default;\n\n//== Navbar OP\n//\n//##\n$op-navbar-height: 64px !default;\n$op-navbar-padding: 2 * $op-base-offset !default;\n\n//== Navbar\n//\n//##\n\n// Basics of a navbar\n$navbar-height: 60px !default;\n$navbar-padding: 16px !default;\n$navbar-margin-bottom: 0 !default;\n$navbar-border-radius: 0 !default;\n$navbar-padding-horizontal: math.floor(($grid-gutter-width * 0.5)) !default;\n$navbar-padding-vertical: (($navbar-height - $line-height-computed) * 0.5) !default;\n$navbar-collapse-max-height: 340px !default;\n\n$navbar-default-color: $text-color !default;\n$navbar-default-bg: white !default;\n$navbar-default-border: transparent !default;\n\n// Navbar links\n$navbar-default-link-color: $text-color !default;\n$navbar-default-link-hover-color: $purple-color !default;\n$navbar-default-link-hover-bg: transparent !default;\n$navbar-default-link-active-color: #b2b4b6 !default;\n$navbar-default-link-active-bg: color.adjust($navbar-default-bg, $lightness: -6.5%) !default;\n$navbar-default-link-disabled-color: #ccc !default;\n$navbar-default-link-disabled-bg: transparent !default;\n\n// Navbar brand label\n$navbar-default-brand-color: #e6e6e6 !default;\n$navbar-default-brand-hover-color: color.adjust(\n    $navbar-default-brand-color,\n    $lightness: -10%\n) !default;\n$navbar-default-brand-hover-bg: transparent !default;\n\n// Navbar toggle\n$navbar-default-toggle-hover-bg: color.adjust(white, $lightness: -5%) !default;\n$navbar-default-toggle-icon-bar-bg: $text-color !default;\n$navbar-default-toggle-border-color: transparent !default;\n\n//=== Inverted navbar\n// Reset inverted navbar basics\n$navbar-inverse-color: $brand-gray-color !default;\n$navbar-inverse-bg: white !default;\n$navbar-inverse-border: $brand-border-color !default;\n\n// Inverted navbar links\n$navbar-inverse-link-color: $brand-gray-color !default;\n$navbar-inverse-link-hover-color: $text-color;\n$navbar-inverse-link-hover-bg: transparent !default;\n$navbar-inverse-link-active-color: $navbar-inverse-link-hover-color !default;\n$navbar-inverse-link-active-bg: color.adjust($navbar-inverse-bg, $lightness: -10%) !default;\n$navbar-inverse-link-disabled-color: #444 !default;\n$navbar-inverse-link-disabled-bg: transparent !default;\n\n// Inverted navbar brand label\n$navbar-inverse-brand-color: $navbar-inverse-link-color !default;\n$navbar-inverse-brand-hover-color: #fff !default;\n$navbar-inverse-brand-hover-bg: transparent !default;\n\n// Inverted navbar toggle\n$navbar-inverse-toggle-hover-bg: color.adjust(white, $lightness: -10%) !default;\n$navbar-inverse-toggle-icon-bar-bg: $gray !default;\n$navbar-inverse-toggle-border-color: $gray !default;\n\n//== Navs\n//\n//##\n\n//=== Shared nav styles\n$nav-link-padding: 12px 15px !default;\n$nav-link-hover-bg: transparent !default;\n\n$nav-disabled-link-color: $gray-light !default;\n$nav-disabled-link-hover-color: transparent !default;\n\n//== Tabs\n$nav-tabs-border-color: #ddd !default;\n\n$nav-tabs-link-hover-border-color: $gray-lighter !default;\n\n$nav-tabs-active-link-hover-bg: $body-bg !default;\n$nav-tabs-active-link-hover-color: $gray !default;\n$nav-tabs-active-link-hover-border-color: #ddd !default;\n\n$nav-tabs-justified-link-border-color: #ddd !default;\n$nav-tabs-justified-active-link-border-color: $body-bg !default;\n\n//== Pills\n$nav-pills-border-radius: $border-radius-base !default;\n$nav-pills-active-link-hover-bg: transparent !default;\n$nav-pills-active-link-hover-color: 