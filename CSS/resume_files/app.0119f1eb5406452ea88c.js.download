CAGJ,8CACI,WAAA,CACA,cAAA,CACA,eAAA",sourcesContent:['@import "enhancv-styleguide/variables";\n\n.name {\n    font-weight: 500;\n}\n\n.title {\n    font-weight: 400;\n    margin-bottom: 8px !important;\n}\n\n.icons {\n    margin-right: 3px;\n    margin-left: 5px;\n}\n\n.resumeHeaderColLeft {\n    width: 100%;\n}\n\n.contactInfoClass {\n    font-weight: 400;\n    display: flex;\n    width: auto;\n    padding-right: 12px !important;\n}\n\n.resumeHeader {\n    border-radius: 5px;\n    border: 1px solid transparent;\n    display: flex;\n    flex-wrap: nowrap;\n    justify-content: space-between;\n    padding-bottom: 20px;\n}\n\n.selected {\n    border: 1px solid #60d5ba;\n    position: relative;\n    z-index: 20;\n    background: $white;\n    transition: background 0.3s;\n}\n\n.row {\n    display: flex;\n    flex-wrap: wrap;\n}\n\n.photoContainer {\n    width: auto;\n    display: flex;\n    justify-content: flex-end;\n    position: relative;\n}\n\n.photo {\n    cursor: pointer;\n    position: relative;\n    border-radius: 5px;\n    vertical-align: top;\n    display: inline-block;\n    background-size: cover;\n    transition: border-radius 0.3s linear;\n    background-position: 50%;\n    background-repeat: no-repeat;\n}\n\n.photoCircle {\n    border-radius: 50%;\n}\n\n.initialsContainer {\n    height: 100%;\n    font-size: 34px;\n    font-weight: 500;\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n