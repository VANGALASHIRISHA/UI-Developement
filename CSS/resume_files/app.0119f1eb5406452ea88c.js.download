CAGJ,iDACI,kBAAA,CACA,UAAA",sourcesContent:['@import "~enhancv-styleguide/variables";\n\n.answerRow {\n    display: flex;\n    align-items: flex-start;\n    flex-direction: row-reverse;\n    margin-top: $base-offset * 3;\n    padding-left: $base-offset * 7;\n\n    @media (max-width: $screen-sm-max) {\n        padding-left: 0px;\n    }\n}\n\n.answerBubble {\n    background: $page;\n    border-radius: 8px 0px 8px 8px;\n    padding: $base-offset $base-offset * 2;\n    color: $paragraph;\n    box-shadow: 0px 1px 4px rgba(0, 0, 0, 0.06);\n}\n\n.answerPill {\n    display: inline-flex;\n    align-items: center;\n    gap: 4px;\n    border-radius: 8px;\n    padding: 2px 4px;\n    background: $accent;\n    color: $heading;\n    margin-bottom: $base-offset;\n\n    i {\n        color: $heading;\n        font-size: 20px;\n    }\n}\n\n.answerText {\n    color: $paragraph;\n}\n\n.answerTail {\n    width: 24px;\n    height: 24px;\n    min-width: 24px;\n    background: $page;\n    clip-path: polygon(0 100%, 100% 0, 0 0);\n\n    @media (max-width: $screen-sm-max) {\n        width: 16px;\n        height: 16px;\n        min-width: 16px;\n    }\n}\n\n.answerActions {\n    display: flex;\n    align-items: center;\n    justify-content: flex-end;\n    gap: $base-offset;\n    padding-left: $base-offset * 7;\n    padding-right: $base-offset * 3;\n    box-sizing: border-box;\n    margin-top: $base-offset;\n}\n\n.hintsLink {\n    background: $visual-violet-2;\n    color: $secondary-active;\n    border: 1px solid transparent;\n    padding: $base-offset * 0.25 $base-offset;\n    border-radius: 4px;\n    cursor: pointer;\n    display: inline-flex;\n    align-items: center;\n    gap: $base-offset * 0.5;\n\n    &:hover:not(:disabled) {\n        background: darken($visual-violet-2, 4%);\n    }\n\n    &[aria-pressed="true"] {\n        background: darken($visual-violet-2, 8%);\n    }\n\n    &:disabled {\n        cursor: not-allowed;\n        opacity: 0.6;\n    }\n}\n','// Base Offset\n$base-offset: 8p