n: 0 auto;\n        height: 50px;\n\n        input {\n            height: 50px;\n        }\n    }\n\n    &Steps {\n        position: relative;\n        opacity: 0;\n        animation-name: stepOpacityUp;\n        animation-duration: 0.5s;\n        animation-fill-mode: forwards;\n    }\n\n    &Step {\n        position: absolute;\n        top: 0px;\n        left: 0px;\n        right: 0px;\n        pointer-events: none;\n        opacity: 0;\n        transition: transform 0.5s, opacity 0.5s;\n\n        .new-templates-wrapper {\n            width: 100%;\n        }\n\n        &.before {\n            opacity: 0;\n            overflow: hidden;\n            height: 0px;\n            transform: translateY(40px);\n        }\n\n        &.active {\n            pointer-events: initial;\n            opacity: 1;\n            transform: translateY(0px);\n        }\n\n        &.after {\n            opacity: 0;\n            height: 0px;\n            overflow: hidden;\n            transform: translateY(-30px);\n        }\n    }\n\n    &ProgressbarMobile {\n        height: 100%;\n        width: 100%;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n\n        &Step {\n            width: 32px;\n            height: 32px;\n            min-width: 32px;\n            border-radius: 16px;\n            background: #9cb2dc;\n            color: #fff;\n            padding-top: 5px;\n            text-align: center;\n            z-index: 5;\n            transition-delay: 0.3s;\n            transition: background 0.35s, color 0.35s;\n\n            &Active {\n                background: #2dc08d;\n                color: #fff;\n            }\n\n            .icon {\n                line-height: 25px;\n                font-size: 16px;\n            }\n        }\n\n        &Line {\n            height: 3px;\n            background: #e7ecf5;\n            width: 100%;\n\n            &.green {\n                background: #2dc08d;\n                z-index: 2;\n            }\n        }\n    }\n\n    &TopBar {\n        height: 32px;\n        transform: translateY(-30px);\n        opacity: 0;\n        will-change: transform, opacity;\n        transition: opacity 0.35s, transform 0.35s;\n\n        &Appear {\n            transform: translateY(0px);\n            opacity: 1;\n        }\n\n        @media (max-width: $screen-sm-max) {\n            height: 100%;\n        }\n    }\n}\n\n.sliderContainer {\n    align-items: start !important;\n    justify-content: flex-start !important;\n    display: inline-flex !important;\n}\n\n.carousel::-webkit-scrollbar {\n    display: none;\n}\n\n.carousel {\n    overflow-x: auto !important;\n    position: relative;\n    max-width: 100%;\n    margin: auto;\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n}\n\n.sliderSlide {\n    height: 450px;\n    width: 290px;\n    border-radius: 4px;\n    background: rgba(140, 124, 219, 0);\n    transition: all 0.2s;\n}\n\n.stepsNavbar {\n    position: fixed;\n    width: 100%;\n    top: 0;\n    z-index: 999;\n\n    &.navbarStick {\n        background: #fff !important;\n    }\n}\n\n.slideAnimation {\n    position: absolute;\n    z-index: 10;\n    left: 0;\n    opacity: 1;\n    animation-name: stepOpacityDown;\n    animation-duration: 0.3s;\n    animation-fill-mode: forwards;\n    animation-delay: 1.1s;\n}\n\n.sliderWrapper {\n    position: relative;\n}\n\n@keyframes stepOpacityUp {\n    from {\n        opacity: 0;\n        pointer-events: none;\n    }\n\n    to {\n        opacity: 1;\n        pointer-events: initial;\n    }\n}\n\n@keyframes stepOpacityDown {\n    from {\n        opacity: 1;\n        z-index: 10;\n    }\n\n    to {\n        opacity: 0;\n        z-index: 0;\n    }\n}\n\n.input {\n    max-width: 600px;\n    margin: 0 auto;\n}\n\n.newTemplatesWrapper {\n    width: 90%;\n    max-width: 1600px;\n    margin: auto;\n}\n\n.backButton {\n    width: 24px;\n    height: 24px;\n    font-size: 24px;\n    display: flex;\n}\n\n.buttonWrapper {\n    flex-wrap: wrap;\n\n    @media (min-width: $screen-sm-min) {\n        flex-wrap: nowrap;\n    }\n}\n'],sourceRoot:""}]),l.locals={step:"OnboardingPageMobile-module_step__AZTjM",before:"OnboardingPageMobile-module_before__G3eoR",active:"OnboardingPageMobile-module_active__iC2cs",after:"OnboardingPageMobile-module_after__C2z2u",animatedOnboardingContainer:"OnboardingPageMobile-module_animatedOnboardingContainer__xPedI",animatedOnboardingInput:"OnboardingPageMobile-module_animatedOnboardingInput__k2Hob",animatedOnboardingSteps:"OnboardingPageMobile-module_animatedOnboardingSteps__FrDUl",stepOpacityUp:"OnboardingPageMobile-module_stepOpacityUp__Fs7tc",animatedOnboardingStep:"OnboardingPageMobile-module_animatedOnboardingStep__myWmT","new-templates-wrapper":"OnboardingPageMobile-module_new-templates-wrapper__HGhWc",animatedOnboardingProgressbarMobile:"OnboardingPageMobile-module_animatedOnboardingProgressbarMobile__O1Htk",animatedOnboardingProgressbarMobileStep:"OnboardingPageMobile-module_animatedOnboardingProgressbarMobileStep__QTdi1",animatedOnboardingProgressbarMobileStepActive:"OnboardingPageMobile-module_animatedOnboardingProgressbarMobileStepActive__xN1IX",icon:"OnboardingPageMobile-module_icon__FnECg",animatedOnboardingProgressbarMobileLine:"OnboardingPageMobile-module_animatedOnboardingProgressbarMobileLine__D29UK",green:"OnboardingPageMobile-module_green__KG3G0",animatedOnboardingTopBar:"OnboardingPageMobile-module_animatedOnboardingTopBar__2RFin",animatedOnboardingTopBarAppear:"OnboardingPageMobile-module_animatedOnboardingTopBarAppear__tKXfQ",sliderContainer:"OnboardingPageMobile-module_sliderContainer__LVKVv",carousel:"OnboardingPageMobile-module_carousel__SuPQm",sliderSlide:"OnboardingPageMobile-module_sliderSlide__pR2NP",stepsNavbar:"OnboardingPageMobile-module_stepsNavbar__eiddz",navbarStick:"OnboardingPageMobile-module_navbarStick__suxXJ",slideAnimation:"OnboardingPageMobile-module_slideAnimation__c45eK",stepOpacityDown:"OnboardingPageMobile-module_stepOpacityDown__