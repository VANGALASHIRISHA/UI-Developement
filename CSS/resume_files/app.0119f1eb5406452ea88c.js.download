 linear infinite;\n    }\n\n    &.lastViewed {\n        background: linear-gradient(#fff, #fff) padding-box,\n            linear-gradient(135deg, #9747ff, #2dc08d) border-box;\n        border: 2px solid transparent;\n    }\n}\n\n.freshnessSignal {\n    display: flex;\n    align-items: center;\n    gap: $base-offset / 2;\n    padding: $base-offset $base-offset * 2;\n    background: $secondary-10;\n    color: $secondary-active;\n    font-size: 13px;\n    font-weight: 500;\n}\n\n.freshnessIcon {\n    font-size: 14px;\n}\n\n.cardContent {\n    padding: $base-offset * 2;\n    @media screen and (max-width: $screen-sm-max) {\n        padding: $base-offset;\n    }\n}\n\n.mainRow {\n    display: flex;\n    align-items: center;\n    gap: $base-offset * 1.5;\n}\n\n.logoContainer {\n    flex-shrink: 0;\n}\n\n.logo {\n    width: 48px;\n    height: 48px;\n    border-radius: 12px;\n    object-fit: cover;\n\n    @media screen and (max-width: $screen-sm-max) {\n        width: 40px;\n        height: 40px;\n        border-radius: 8px;\n    }\n}\n\n.logoPlaceholder {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 48px;\n    height: 48px;\n    border-radius: 12px;\n    background: $accent;\n\n    i {\n        font-size: 20px;\n    }\n}\n\n.jobInfo {\n    flex: 1;\n    min-width: 0;\n\n    @media screen and (max-width: $screen-sm-max) {\n        margin-right: $base-offset * 3;\n    }\n}\n\n.title {\n    /* stylelint-disable value-no-vendor-prefix, property-no-vendor-prefix */\n    color: $heading;\n    display: -webkit-box;\n    -webkit-line-clamp: 2;\n    -webkit-box-orient: vertical;\n    /* stylelint-enable value-no-vendor-prefix, property-no-vendor-prefix */\n    overflow: hidden;\n}\n\n.company {\n    color: $label;\n}\n\n.metaRow {\n    display: flex;\n    flex-wrap: wrap;\n    gap: $base-offset * 2;\n    margin-top: $base-offset * 1;\n    padding-top: $base-offset * 1;\n    border-top: 1px solid $accent;\n\n    @media screen and (max-width: $screen-sm-max) {\n        padding-top: 0;\n        margin-bottom: $base-offset / 2;\n        border-top: 0;\n    }\n}\n\n.metaItem {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    font-size: 12px;\n    color: $heading;\n\n    i {\n        font-size: 16px;\n        color: $heading;\n    }\n}\n\n.infoIcon {\n    font-size: 12px !important;\n    position: relative;\n    top: 0px;\n    left: -2px;\n    transition: color 0.2s ease;\n}\n\n.salaryWithEstimate {\n    &:hover .infoIcon {\n        color: $warning;\n    }\n}\n\n.salaryEstimateTooltip {\n    max-width: 320px;\n}\n\n.workModeBadge {\n    background: $secondary-10;\n    color: $secondary-active;\n    padding: 2px 8px;\n    border-radius: 4px;\n\n    i {\n        color: $secondary-active;\n    }\n}\n\n.postedAgoTag {\n    color: $paragraph;\n    background: rgba($paragraph, 0.08);\n\n    .tagIcon {\n        color: $paragraph;\n    }\n}\n\n.cardFooter {\n    display: flex;\n    align-items: center;\n    justify-content: flex-end;\n    gap: $base-offset;\n\n    @media screen and (max-width: $screen-sm-max) {\n        position: absolute;\n        right: 0;\n        top: 0;\n        z-index: 1;\n    }\n}\n\n.saveButton {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    font-family: Rubik, sans-serif;\n    font-size: 14px;\n    font-weight: 500;\n    color: $paragraph;\n    background: none;\n    border: 0;\n    cursor: pointer;\n    padding: 4px 12px;\n\n    i {\n        font-size: 20px;\n    }\n\n    &:hover {\n        color: $secondary-active;\n    }\n\n    &:disabled {\n        opacity: 0.5;\n        cursor: not-allowed;\n    }\n\n    &.saved {\n        color: $secondary-active;\n        cursor: default;\n\n        &:hover {\n            color: $secondary-active;\n        }\n    }\n\n    @media screen and (max-width: $screen-sm-max) {\n        padding: $base-offset;\n\n        i {\n            font-size: 22px;\n        }\n    }\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6df;\n$warning-hover: #feba62;\n\n// // Active elements\n$primary-active: #249a71;\n$secondary-active: #5f4dc7;\n$info-active: #3685bb;\n$warning-active: #d89745;\n$danger-active: #d94a5e;\n\n// // Transparent elements\n// // // opacity: 10%;\n$primary-10: rgba($primary, 0.1);\n$secondary-10: rgba($secondary, 0.1);\n$accent-10: rgba($accent, 0.1);\n$info-10: rgba($info, 0.1);\n$warning-10: rgba($warning, 0.1);\n$danger-10: rgba($danger, 0.1);\n// // // opacity 20%\n$primary-20: rgba($primary, 0.2);\n$secondary-20: rgba($secondary, 0.2);\n$accent-20: rgba($accent, 0.2);\n$info-20: rgba($info, 0.2);\n$warning-20: rgba($warning, 0.2);\n$danger-20: rgba($danger, 0.2);\n// // // opacity 30%\n$primary-30: rgba($primary, 0.3);\n$secondary-30: rgba($secondary, 0.3);\n$accent-30: rgba($accent, 0.3);\n$info-30: rgba($info, 0.3);\n$warning-30: rgba($warning, 0.3);\n$danger-30: rgba($danger, 0.3);\n\n// // Backgrounds\n$surface: $white;\n$surface-accent: #9cb2dc;\n$page: #f5f7fc;\n$page-alt: #fafbfd;\n\n// // Typography Colors\n$heading: #2d3639;\n$paragraph: #384347;\n$label: #60696c;\n$caption: #afb4b5;\n$subtext: #d8d9db;\n\n// // Supportive colors\n$modal: #47445a;\n$graphic-1: #f0f0f0;\n$graphic-2: #e4e4e4;\n$graphic-3: #f2f2f2;\n$border-color: #e0e0e0;\n\n// // CC colors\n$primary-cc: #eaf9f4;\n$secondary-cc: #f3f2fb;\n$danger-cc: #ffeef1;\n$info-cc: #ecf5fc;\n\n// // Visual elements Colors\n$visual-violet-1: #d1cbf1;\n$visual-violet-2: #e3e0f6;\n$visual-green-1: #abe6d1;\n$visual-green-2: #cdf0e4;\n$visual-blue: #b2d7f1;\n$visual-orange: #ffe0b9;\n$visual-pink: #ffcdd4;\n\n// // Shadows\n$shadow-default: 0px 4px 8px rgba(0, 0, 0, 0.1);\n$shadow-hover: 0px 2px 20px rgba(0, 0, 0, 0.1);\n$shadow-flat: 1px 1px 1px rgba(231, 228, 228, 0.5);\n$shadow-main-navigation: 0px 1px 3px rgba(0, 0, 0, 0.1);\n\n// Font-sizes\n$font-size-lg: 20px;\n$font-size-md: 18px;\n$font-size-rg: 16px;\n$font-size-sm: 14px;\n$font-size-xs: 12px;\n$font-size-xs-min: 10px;\n\n// Container - (with padding-inline:16px included)\n$container-xs: 100%;\n$container-md: 736px; // 12columns x 64px\n$container-lg: 956px; // 12columns x 84px\n$container-xl: 1184px; // 12columns x 96px\n$container-xxl: 1328px; // 12columns x 108px\n\n// Z-index modal\n$zindex-modal-background: 1002;\n$zindex-modal-content: 1003;\n'],sourceRoot:""}]),l.locals={card:"JobCard-module_card__ejAII",selected:"JobCard-module_selected__Zw81y",rotateBorder:"JobCard-module_rotateBorder__ICbKu",lastViewed:"JobCard-module_lastViewed__wvoGH",freshnessSignal:"JobCard-module_freshnessSignal__QSlEK",freshnessIcon:"JobCard-module_freshnessIcon__YRPrF",cardContent:"JobCard-module_cardContent__Woog_",mainRow:"JobCard-module_mainRow__C1o7e",logoContainer:"JobCard-module_logoContainer__DVYNo",logo:"JobCard-module_logo__paJYk",logoPlaceholder:"JobCard-module_logoPlaceholder__JUZ_B",jobInfo:"JobCard-module_jobInfo__lGdTr",title:"JobCard-module_title__byOyL",company:"JobCard-module_company__o96zL",metaRow:"JobCard-module_metaRow__Jk4H7",metaItem:"JobCard-module_metaItem__lKuv9",infoIcon:"JobCard-module_infoIcon__WhAwx",salaryWithEstimate:"JobCard-module_salaryWithEstimate__pCZWL",salaryEstimateTooltip:"JobCard-module_salaryEstimateTooltip__q1z52",workMo