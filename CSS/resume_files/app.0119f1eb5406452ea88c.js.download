   &:nth-child(2n + 1) {\n                .skill-item {\n                    padding-right: 5px;\n                }\n            }\n\n            &:nth-child(2n) {\n                .skill-item {\n                    padding-left: 5px;\n                }\n            }\n        }\n    }\n\n    &:nth-child(2) {\n        .skill-item.item-object {\n            width: 100%;\n        }\n    }\n}\n'],sourceRoot:""}]),l.locals={skillItemContent:"SkillItemMinimal-module_skillItemContent__U_m4S",skillItemName:"SkillItemMinimal-module_skillItemName__MnIhg",skillItemNameCondensed:"SkillItemMinimal-module_skillItemNameCondensed__Shql7 SkillItemMinimal-module_skillItemName__MnIhg",sliderComponent:"SkillItemMinimal-module_sliderComponent__FGNX3",skillItem:"SkillItemMinimal-module_skillItem__UnF3k",sliderContainer:"SkillItemMinimal-module_sliderContainer__Yx76x",sliderContainerCondensed:"SkillItemMinimal-module_sliderContainerCondensed__A1Ekl SkillItemMinimal-module_sliderContainer__Yx76x",skills:"SkillItemMinimal-module_skills__a3ZHQ","resume-item-holder":"SkillItemMinimal-module_resume-item-holder__ZQIGk",inner:"SkillItemMinimal-module_inner__2EdVW","resume-renderer-two-column":"SkillItemMinimal-module_resume-renderer-two-column__oexQ5","skill-item":"SkillItemMinimal-module_skill-item__ApxZk","item-object":"SkillItemMinimal-module_item-object__kJzQa"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[1].use[3]!./src/packages/Resume/ItemTypes/Skill/SkillItemModern.module.scss"(e,n,t){"use strict";t.d(n,{A:()=>i});var o=t("./node_modules/css-loader/dist/runtime/sourceMaps.js"),a=t.n(o),r=t("./node_modules/css-loader/dist/runtime/api.js"),l=t.n(r)()(a());l.push([e.id,".SkillItemModern-module_skillItemContent__LZUWo{border:0px}.SkillItemModern-module_skillItemName__ASPW7{width:100%;display:block;font-size:15px;font-weight:700}.Skil