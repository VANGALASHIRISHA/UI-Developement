t__nGgmx{border:0 !important;border-radius:0 !important;background-color:transparent !important}.TableRow-module_tooltipLabelInput__nGgmx i,.TableRow-module_tooltipLabelInput__nGgmx svg{display:none !important}.TableRow-module_labelBadgeWrapper__EJTnA{position:relative;transition:opacity .2s ease-in-out;flex-shrink:0;cursor:pointer}.TableRow-module_labelBadgeHidden__j1mZ5{opacity:0}.TableRow-module_labelBadge___ysYb{display:inline-block;vertical-align:middle;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:12px;padding:4px 8px;font-weight:700;max-width:120px;border-radius:30px}.TableRow-module_labelIcon__I8iF8::before{font-size:20px;line-height:22px}.TableRow-module_tagIconWrapper__uWgP7:hover{z-index:10}.TableRow-module_tagIconButton__na_rN p{z-index:1}.TableRow-module_editIconTextWrapper__o51eW{opacity:0;width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.TableRow-module_iconMobile__xFVCV{font-size:20px !important;line-height:20px !important}`,"",{version:3,sources:["webpack://./src/pages/Documents/components/ListView/TableRow/TableRow.module.scss","webpack://./node_modules/enhancv-styleguide/variables.scss"],names:[],mappings:"AAGA,oCACI,4BAAA,CACA,4BAAA,CACA,8BAAA,CACA,eAAA,CACA,iBAAA,CACA,SAAA,CACA,kBAAA,CACA,eAAA,CACA,sBAAA,CACA,aAAA,CACA,eAAA,CACA,cAAA,CACA,UAAA,CACA,yBAAA,CAEA,6CACI,SAAA,CACA,oCAAA,CAGJ,0CACI,YAAA,CACA,iBAAA,CACA,wBAAA,CACA,yBAAA,CAIR,2CACI,iBAAA,CACA,YAAA,CACA,kBAAA,CACA,WAAA,CAGJ,qCACI,WAAA,CACA,aAAA,CAGJ,wCACI,iBAAA,CACA,SAAA,CACA,OAAA,CACA,aAAA,CACA,SAAA,CAEA,0BAAA,CAEA,oBATJ,wCAUQ,YAAA,CAAA,CAIR,mCACI,wBAAA,CACA,yCACI,wBC4BI,CDxBZ,kCACI,iBAAA,CACA,SAAA,CAGJ,kCACI,6BAAA,CACA,aAAA,CAGJ,wCACI,SAAA,CAGJ,6BACI,YAAA,CACA,kBAAA,CAGJ,4BACI,uDAAA,CAEA,6CACI,+BAAA,CAGJ,qBACI,kCACI,qCCxBA,CAAA,CD4BR,uCACI,8BAAA,CACA,+BAAA,CAIR,mCACI,yDAAA,CAGJ,8CACI,GACI,0BAAA,CACA,UAAA,CAGJ,IACI,2BAAA,CACA,UAAA,CAGJ,KACI,uBAAA,CACA,SAAA,CAAA,CAIR,oCACI,wBC/FK,CDkGT,4CACI,cAAA,CACA,gBAAA,CACA,gBClIU,CDqId,gCACI,wBCrDQ,CDsDR,6DAAA,CACA,UAAA,CACA,WAAA,CACA,8BAAA,CAEA,qEACI,wBC9GE,CD+GF,wBAAA,CAIR,uCACI,kBAAA,CACA,eAAA,CACA,sBAAA,CACA,gBAAA,CAGJ,4CACI,iBAAA,CACA,WAAA,CACA,SAAA,CACA,iBC7JU,CD8JV,eAAA,CACA,oCAAA,CACA,aAAA,CAGJ,0CACI,mBAAA,CACA,0BAAA,CACA,uCAAA,CAEA,0FAEI,uBAAA,CAIR,0CACI,iBAAA,CACA,kCAAA,CACA,aAAA,CACA,cAAA,CAGJ,yCACI,SAAA,CAGJ,mCACI,oBAAA,CACA,qBAAA,CACA,kBAAA,CACA,eAAA,CACA,sBAAA,CACA,cAAA,CACA,eAAA,CACA,eAAA,CACA,eAAA,CACA,kBAAA,CAGJ,0CACI,cAAA,CACA,gBAAA,CAIA,6CACI,UAAA,CAKJ,wCACI,SAAA,CAIR,4CACI,SAAA,CACA,UAAA,CACA,eAAA,CACA,sBAAA,CACA,kBAAA,CAGJ,mCACI,yBAAA,CACA,2BAAA",sourcesContent:['@import "~sharedstyle/variables";\n@import "enhancv-styleguide/variables";\n\n.editableCol {\n    background-color: transparent;\n    border: 1px solid transparent;\n    transition: all ease-in-out 0.3s;\n    padding: 4px 2px;\n    position: relative;\n    z-index: 0;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    flex: 0 1 auto;\n    min-width: 100px;\n    max-width: 100%;\n    width: 100%;\n    cursor: pointer !important;\n\n    &:disabled {\n        opacity: 1;\n        -webkit-text-fill-color: currentcolor;\n    }\n\n    &:focus {\n        outline: none;\n        border-radius: 4px;\n        border: 1px solid $primary-active;\n        cursor: default !important;\n    }\n}\n\n.editableColWrapper {\n    position: relative;\n    display: flex;\n    align-items: center;\n    min-width: 0;\n}\n\n.innerWrapper {\n    min-width: 0;\n    flex: 1 1 auto;\n}\n\n.editIconWrapper {\n    position: absolute;\n    left: -4px;\n    top: 3px;\n    flex-shrink: 0;\n    z-index: 2;\n    // width: calc(100% + 4px);\n    max-width: calc(100% + 4px);\n\n    @media (hover: none) {\n        display: none;\n    }\n}\n\n.editIconBg {\n    background-color: #f2f5fa; // custom color for natural background\n    &:hover {\n        background-color: $graphic-1;\n    }\n}\n\n.pinButton {\n    position: relative;\n    z-index: 2; // fixes tooltip overlapping\n}\n\n.actionBtn {\n    border-left: 1px solid $accent;\n    padding: 0 4px;\n}\n\n.actionBtnMobile {\n    padding: 0;\n}\n\n.icon {\n    display: flex;\n    align-items: center;\n}\n\n.row {\n    transition: background-color 0.3s ease, transform 0.3s ease;\n\n    &:not(:last-child) {\n        border-bottom: 1px solid $accent;\n    }\n\n    @media (hover: hover) {\n        &:hover {\n            background-color: $accent-30;\n        }\n    }\n\n    &:last-child {\n        border-bottom-left-radius: 16px;\n        border-bottom-right-radius: 16px;\n    }\n}\n\n.justPinned {\n    animation: pin-move-up 0.5s ease-out;\n}\n\n@keyframes pin-move-up {\n    0% {\n        transform: translateY(20px);\n        opacity: 0.7;\n    }\n\n    50% {\n        transform: translateY(-10px);\n        opacity: 0.9;\n    }\n\n    100% {\n        transform: translateY(0);\n        opacity: 1;\n    }\n}\n\n.selectedRow {\n    background-color: $accent;\n}\n\n.customLabelFontSize {\n    font-size: 12px;\n    line-height: 20px;\n    padding-left: $base-offset;\n}\n\n.pinIcon {\n    background-color: $paragraph;\n    mask: url("assets/newDashboard/pin.svg") no-repeat center;\n    width: 20px;\n    height: 20px;\n    transition: all 0.3s ease-in-out;\n\n    &.pinIconPinned {\n        background-color: $warning;\n        transform: rotate(-21deg);\n    }\n}\n\n.jobCompanyLink {\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    user-select: none;\n}\n\n.labelTooltipWrapper {\n    position: absolute;\n    bottom: 100%;\n    left: $base-offset * 2;\n    margin-bottom: $base-offset;\n    min-width: 110px;\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);\n    z-index: 10000;\n}\n\n.tooltipLabelInput {\n    border: 0 !important;\n    border-radius: 0 !important;\n    background-color: transparent !important;\n\n    i,\n    svg {\n        display: none !important;\n    }\n}\n\n.labelBadgeWrapper {\n    position: relative;\n    transition: opacity 0.2s ease-in-out;\n    flex-shrink: 0;\n    cursor: pointer;\n}\n\n.labelBadgeHidden {\n    opacity: 0;\n}\n\n.labelBadge {\n    display: inline-block;\n    vertical-align: middle;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    font-size: 12px;\n    padding: 4px 8px;\n    font-weight: 700;\n    max-width: 120px;\n    border-radius: 30px;\n}\n\n.labelIcon::before {\n    font-size: 20px;\n    line-height: 22px;\n}\n\n.tagIconWrapper {\n    &:hover {\n        z-index: 10;\n    }\n}\n\n.tagIconButton {\n    p {\n        z-index: 1;\n    }\n}\n\n.editIconTextWrapper {\n    opacity: 0;\n    width: 100%;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n}\n\n.iconMobile {\n    font-size: 20px !important;\n    line-height: 20px !important;\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6df;\n$warning-hover: #feba62;\n\n// // Active elements\n$primary-active: #249a71;\n$secondary-active: #5f4dc7;\n$info-active: #3685bb;\n$warning-active: #d89745;\n$danger-active: #d94a5e;\n\n// // Transparent elements\n// // // opacity: 10%;\n$primary-10: rgba($primary, 0.1);\n$secondary-10: rgba($secondary, 0.1);\n$accent-10: rgba($accent, 0.1);\n$info-10: rgba($info, 0.1);\n$warning-10: rgba($warning, 