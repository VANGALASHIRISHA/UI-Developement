:101,alignment:"left"}],showTitle:!0},{enabled:!0,name:"PROFESSIONAL EXPERIENCE",column:0,height:34,record:"ExperienceSection",timelineWidth:138,items:[{record:"ExperienceItem",id:"ozvao8sqam",position:"Senior IT Project Manager",workplace:"Rover Games",description:"Rover Games is a multi-play mobile game app development firm that has successful titles such as Drink Something, Trivia Tonight and King's Fight",location:"San Francisco, CA",dateRange:{record:"DateRange",fromYear:2019,fromMonth:null,toMonth:null,toYear:2020,isOngoing:!0,ongoingText:""},link:"",table:{record:"TableItem",cols:2,rows:[["<b>Project name</b>","<b>Description</b>"],["",""]]},bullets:["Accelerated outbound sales cycle by 330% by designing and implementing customer acquisition platform for training and managing technical and IT teams","Established and curated strategic partnerships with 6 out of 10 top state manufacturing companies which resulted in $20M additional annual revenue","Led re-architect effort of a core SaaS product to reduce the platform deployment time for clients by 2 months"],height:191,showTitle:!0,showCompany:!0,showDescription:!0,showBullets:!0,showLocation:!0,showDateRange:!0,showLink:!1,showTable:!0},{record:"ExperienceItem",id:"aigra5ycrs",position:"Project Manager",workplace:"Tesla",description:"Tesla is an electric vehicle manufacturer that is revolutionizing the automobile industry",location:"Los Angeles, CA",dateRange:{record:"DateRange",fromYear:2017,fromMonth:null,toMonth:null,toYear:2019,isOngoing:!1,ongoingText:""},link:"",table:{record:"TableItem",cols:2,rows:[["<b>Project name</b>","<b>Description</b>"],["",""]]},bullets:["Lead a team of developers to build a proprietary CRM system for enterprise and its strategic partners, optimizing sales process and increasing sales revenue by 24%","Curated a $2M business implementation project that saves ~ $3.5M on operational inefficiencies between sales and development departments "],height:176,showTitle:!0,showCompany:!0,showDescription:!0,showBullets:!0,showLocation:!0,showDateRange:!0,showLink:!1,showTable:!0},{record:"ExperienceItem",id:"zf5bsuxvze",position:"Customer Success, Product Support",workplace:"Reilly Group",description:"Reilly Group is a full service technology solutions provider",location:"Los Angeles, CA",dateRange:{record:"DateRange",fromYear:2016,fromMonth:null,toMonth:null,toYear:2017,isOngoing:!1,ongoingText:""},link:"",table:{record:"TableItem",cols:2,rows:[["<b>Project name</b>","<b>Description</b>"],["",""]]},bullets:["Researched user behavior and led strategic product roadmap discussion across multi functional teams","Integrated Tableau reporting system into BI sales workflow, which led to 23% increase in post-meeting inquiries for technical sales department","Streamlined post-sales support to increase customer retention rate among enterprise clients by 27% "],height:176,showTitle:!0,showCompany:!0,showDescription:!0,showBullets:!0,showLocation:!0,showDateRange:!0,showLink:!1,showTable:!0},{record:"ExperienceItem",id:"khjni5zs",position:"Project Coordinator",workplace:"Wolf Industries",description:"Wolf Industries is a home appliance part supplier to major appliance manufacturers including GE",location:"Los Angeles, CA",dateRange:{record:"DateRange",fromYear:2015,fromMonth:null,toMonth:null,toYear:2016,isOngoing:!1,ongoingText:""},link:"",table:{record:"TableItem",cols:2,rows:[["<b>Project name</b>","<b>Description</b>"],["",""]]},bullets:["Acted as liaison between 3 country offices","Maintained and documented inventory of over 4,000 items","Led a team of 15 as a project manager, creating a trusting, respectful team in the process","Consistently ranked in the department's top 3 for completed tasks","Trained over 270 temporary remote workers"],height:191,showTitle:!0,showCompany:!0,showDescription:!0,showBullets:!0,showLocation:!0,showDateRange:!0,showLink:!1,showTable:!0}]},{enabled:!0,name:"",column:0,height:34,record:"EducationSection",timelineWidth:138,items:[{record:"EducationItem",id:"zbv8l2569n",degree:"Bachelor of Science, Industrial Engineering",institution:"University of California, Berkeley",location:"Berkeley, CA",gpa:"",gpaText:"",maxGpa:"",dateRange:{record:"DateRange",fromYear:2011,fromMonth:null,toMonth:null,toYear:2015,isOngoing:!1,ongoingText:""},height:64,bullets:[""],showGpa:!1,showLocation:!0,showDateRange:!0,showBullets:!1}]},{enabled:!1,name:"",column:0,height:48,record:"QuoteSection",items:[{record:"QuoteItem",id:"wazouzlofk",author:"-Vince Lombardi",quote:"“The achievements of an organization are the results of the combined effort of each individual.”",height:100,showAuthor:!0},{record:"QuoteItem",id:"hty6mqz1g9",author:"-Dottie Herman",quote:'"Never let people tell you that you can\'t"',height:78,showAuthor:!0}]},{enabled:!1,name:"",column:1,height:35,record:"LanguageSection",showProficiency:!0,showSlider:!0,indicatorType:"dots",items:[{record:"LanguageItem",id:"ypc432q57k",name:"English",level:5,levelText:"",height:48},{record:"LanguageItem",id:"parm9ixjej",name:"German",level:4,levelText:"Advanced",height:48}]},{enabled:!1,name:"",column:0,height:47,record:"SkillSection",indicatorType:"lolly",items:[{record:"SkillItem",id:"dp5t1udcij",icon:"21-free-star",level:9,name:"Project Management",height:66},{record:"SkillItem",id:"uyz3y0tbyz",icon:"21-free-star",level:1,name:"",height:66},{record:"SkillItem",id:"y77hbn5p9x",icon:"21-free-star",level:1,name:"",height:66}],showSlider:!0},{enabled:!1,name:"",column:1,height:35,record:"AchievementSection",showIcons:!0,items:[{record:"AchievementItem",id:"rk8bpu4ia5",icon:"02-free-check-mark",title:" ",description:"",showDescription:!0,height:52},{record:"AchievementItem",id:"e26blthc79",icon:"02-free-check-mark",title:"Learning and Exploring ",description:"Online Gamification certification  University of Pennsylvania via MOOC ",showDescription:!0,height:67},{record:"AchievementItem",id:"kceghv4c",icon:"02-free-check-mark",title:"Challenge Taking",description:"Moved to the USA and headed a project no current team leads wanted to work on, reaching 90% lead time predictability.",showDescription:!0,height:67}]},{enabled:!0,name:"TECHNICAL SKILLS",column:1,height:34,record:"TechnologySection",surroundingBorder:!1,items:[{record:"TechnologyItem",id:"82mpcn6fei",title:"",description:"",height:100,showTitle:!1,tags:["Scrum","Product Development","SQL","Tableau","JIRA","Python"]}]},{enabled:!0,name:"KEY ACHIEVEMENTS",column:1,height:34,record:"CourseSection",items:[{record:"CourseItem",id:"khjc7nv1",title:"Cost Saving Of $100M",description:"Through efficient project management and teamwork, my team saved the division at Tesla over $100 Million in the engine assembly department. The new assembly process is being rolled out to other departments to realize further savings",height:122,showDescription:!0},{record:"CourseItem",id:"kh6lw17s",title:"Exceeded throughput target by 90%",description:"Cutting loading time &amp; fixing key security issues Wolf Industries by moving key remote workers successfully online at scale. Managed workflow to continuously create content for remote learning",height:107,showDescription:!0},{record:"CourseItem",id:"nb3jczg83h",title:"Business Generation",description:"Discovered new clients, negotiated over $5 Million of partnership and product deals with key customers based on insights gathered in product development phase",height:107,showDescription:!0},{record:"CourseItem",id:"kh6lw0gp",title:"Founded DeliveryToYourDorm at 22 and led to an exit",description:"One of the co-founders of DeliverToYourDorm for college students in San Francisco bay area to get dorm supplies quickly and easily. The company was later acquired by Dormstay",height:124,showDescription:!0}]},{enabled:!1,name:"",column:1,height:42,record:"TalentSection",showIcons:!0,items:[{record:"TalentItem",id:"mryiz1166j",title:"Microsoft Office 360",icon:"23-free-star-two",description:"Advanced user of Microsoft Excel in particular, use of Pivot Table, VLookup, Visual Basic and Macros, to optimize work presentation and analysis.",height:125,showDescription:!0},{record:"TalentItem",id:"qnosr76dcd",title:"TravelCLICK",icon:"23-free-star-two",description:"Demand360, Hotelligence360, Rate360",height:79,showDescription:!0},{record:"TalentItem",id:"cmskyawa7u",title:"Property Systems",icon:"23-free-star-two",description:"All Hilton OnQ Products, Epitome (Formerly Softbrands, now Infor), Cognos/BI, FRx, Great Plains, and ProfitSword.",height:109,showDescription:!0}]},{enabled:!0,name:"PROUD OF",column:1,height:34,record:"PassionSection",showIcons:!0,items:[{record:"PassionItem",id:"kb25vpzarc",icon:"129-free-heart",title:"Moving to the USA after completing my studies in",height:66,description:"",showDescription:!1}]},{enabled:!1,name:"",column:1,height:40,record:"ReferenceSection",items:[{record:"ReferenceItem",id:"j19lzu811x",name:"Nick Richards, COO, Wolf Industries",contact:"618-223-3333, nick.richards@wolf.com",height:56,showContact:!0},{record:"ReferenceItem",id:"khjny10o",name:"Frank Didonado, Team Leader, Tesla",contact:"713-333-5555, frank.didonado@tesla.com",height:57,showContact:!0}]},{enabled:!1,name:"",column:1,height:42,record:"AwardSection",showIcons:!0,items:[{record:"AwardItem",id:"khjctsqi",icon:"21-free-star",title:"New Age Technology Leader Award",description:"",showDescription:!1,height:65}]},{enabled:!0,name:"CERTIFICATIONS",column:1,height:34,record:"CertificateSection",items:[{record:"CertificateItem",id:"nbl9kgvzoo",title:"PMP Certificate - 2021",issuer:"Intensive 1-wk , New York, NY",height:44,showIssuer:!1},{record:"CertificateItem",id:"j8bp5srv",title:"Agile Certified Practitioner - 2022",issuer:"MTM-I and MTM-II certificates",height:44,showIssuer:!1}]},{enabled:!1,name:"",column:1,height:42,record:"ActivitySection",items:[]}],header:{record:"Header",name:"Taylor Foster",title:"Certified Project Management Professional",email:"taylor.foster@gmail.com",location:"San Francisco, CA",phon