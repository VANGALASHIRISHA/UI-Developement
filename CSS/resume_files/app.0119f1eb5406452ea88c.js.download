{version:3,sources:["webpack://./src/pages/Editor/components/AiAssistantInline/AiAssistant.module.scss","webpack://./node_modules/enhancv-styleguide/variables.scss"],names:[],mappings:"AAAA,kCAMA,UACI,CAAA,iBACA,CAAA,cACA,CAAA,0EAGI,UACI,CAAA,SACA,CAAA,gBACA,CAAA,iBCdE,CAAA,gBDgBF,CAAA,6CAKZ,SACI,CAAA,iBACA,CAAA,+DACA,CAAA,+CAGJ,oEACI,CAAA,+BAGJ,iBACI,CAAA,UACA,CAAA,WACA,CAAA,UACA,CAAA,UACA,CAAA,2BACA,CAAA,uBACA,CAAA,0CAGJ,mBACI,CAAA,8DACA,CAAA,0CACA,CAAA,WACA,CAAA,cACA,CAAA,eACA,CAAA,SACA,CAAA,kBACA,CAAA,sCACA,CAAA,uBACA,CAAA,sCACA,CAAA,kCAGJ,SACI,CAAA,gBACA,CAAA,kBACA,CAAA,SACA,CAAA,kCAGJ,YACI,CAAA,gDAGJ,KACI,SACI,CAAA,0BACA,CAAA,GAGJ,SACI,CAAA,uBACA,CAAA,CAAA,iDAIR,GACI,UACI,CAAA,CAAA,iCAQR,WACI,CAAA,UACA,CAAA,iDACA,CAAA,uBACA,CAAA,sCACA,CAAA,uCAEA,0CACI,CAAA,4CAIR,SACI,CAAA,kCACA,CAAA,+BAGJ,SACI,CAAA,UACA,CAAA,kBACA,CAAA,2CAGJ,UACI,CAAA,wCAGJ,UACI,CAAA,eACA,CAAA,QACA,CAAA,qCACA,CAAA,8CAEA,kBC7CG,CAAA,qCDkDP,iBACI,CAAA,4BACA,CAAA,6CAEA,uBACI,CAAA,aACA,CAAA,eCnGA,CAAA,iBDqGA,CAAA,QACA,CAAA,+BACA,CAAA,aCtDA,CAAA,oCD2DR,UACI,CAAA,WACA,CAAA,WACA,CAAA,YACA,CAAA,uCACA,CAAA,0CAEA,oBCzHM,CAAA,4DD+HN,UACI,CAAA,iBACA,CAAA,KACA,CAAA,MACA,CAAA,UACA,CAAA,WACA,CAAA,kBCxEI,CAAA,0CD6EZ,SACI,CAAA,OACA,CAAA,QACA,CAAA,mBACA,CAAA,wCAMJ,WACI,CAAA,UACA,CAAA,iDACA,CAAA,uBACA,CAAA,sCACA,CAAA,8CAEA,0CACI,CAAA,yBAGJ,wCAXJ,WAYQ,CAAA,cACA,CAAA,CAAA,0CAIR,gBACI,CAAA,aACA,CAAA,uCAGJ,OACI,CAAA,UACA,CAAA,0BACA,CAAA,eACA,CAAA,QACA,CAAA,SACA,CAAA,0CAGJ,+BACI,CAAA,2DAEA,kBCjNU,CAAA,iDDsNd,WACI,CAAA,2CAGJ,eACI,CAAA,QACA,CAAA,WACA,CAAA,aC3II,CAAA,+CDmJR,+BACI,CAAA,mCAKJ,UACI,CAAA,mBACA,CAAA,gDAQA,gEACI,CAAA,qCAIR,kBACI,CAAA,6BACA,CAAA,2CAEA,qBACI,CAAA,+CAIR,GACI,SACI,CAAA,WACA,CAAA,IAGJ,SACI,CAAA,IAGJ,SACI,CAAA,IAGJ,SACI,CAAA,WACA,CAAA,IAGJ,SACI,CAAA,IAGJ,SACI,CAAA,IAGJ,SACI,CAAA,WACA,CAAA,IAGJ,SACI,CAAA,IAGJ,SACI,CAAA,KAGJ,SACI,CAAA,WACA,CAAA",sourcesContent:['@import "~enhancv-styleguide/variables";\n\n/*\n    Trigger styles\n*/\n\n.circle {\n    z-index: 49;\n    position: absolute;\n    cursor: pointer;\n\n    &:hover {\n        .aiText {\n            width: 80px;\n            opacity: 1;\n            padding-left: calc($base-offset / 2);\n            padding-right: $base-offset;\n            margin-left: $base-offset * 3;\n        }\n    }\n}\n\n.withLowerPriority {\n    opacity: 0;\n    visibility: hidden;\n    animation: lowerZIndex 1s 0.2s forwards;\n}\n\n.circleWithAnimation {\n    animation: showCircle 0.3s ease-out forwards;\n}\n\n.pin {\n    position: absolute;\n    width: 14px;\n    height: 14px;\n    z-index: -1;\n    right: -5px;\n    background-repeat: no-repeat;\n    background-size: contain;\n}\n\n.innerContainer {\n    border-radius: 200px;\n    background: linear-gradient(141deg, #8c7cdb 9.94%, #5f4dc7 50%);\n    box-shadow: 0px 2px 20px 0px rgba(0, 0, 0, 0.1);\n    height: 28px;\n    min-width: 28px;\n    overflow: hidden;\n    opacity: 1;\n    visibility: visible;\n    transition-property: opacity, visibility;\n    transition-duration: 0.3s;\n    transition-timing-function: ease-in-out;\n}\n\n.aiText {\n    width: 0px;\n    text-wrap: nowrap;\n    transition: all 0.5s;\n    opacity: 0;\n}\n\n.hidden {\n    display: none;\n}\n\n@keyframes showCircle {\n    from {\n        opacity: 0;\n        transform: translateX(10px);\n    }\n\n    to {\n        opacity: 1;\n        transform: translateX(0);\n    }\n}\n\n@keyframes lowerZIndex {\n    to {\n        z-index: -1;\n    }\n}\n\n/*\n    Popup styles\n*/\n\n.popup {\n    width: 250px;\n    z-index: 55;\n    transition-property: box-shadow, opacity, visibility;\n    transition-duration: 0.3s;\n    transition-timing-function: ease-in-out;\n\n    &:hover {\n        box-shadow: 0px 2px 20px 0px rgba($black, 0.1);\n    }\n}\n\n.actionsContainer {\n    opacity: 1;\n    transition: opacity 0.3s ease-in-out;\n}\n\n.dot {\n    width: 8px;\n    height: 8px;\n    border-radius: 10px;\n}\n\n.actionsListItem {\n    width: 100%;\n}\n\n.actionButton {\n    width: 100%;\n    background: none;\n    border: 0;\n    transition: background 0.3s ease-in-out;\n\n    &:hover {\n        background: $page;\n    }\n}\n\n.separator {\n    position: relative;\n    border-top: 1px solid $subtext;\n\n    &::before {\n        content: attr(data-text);\n        padding: 0 $base-offset;\n        background: $white;\n        position: absolute;\n        left: 50%;\n        transform: translate(-50%, -50%);\n        color: $label;\n    }\n}\n\n.textarea {\n    width: 100%;\n    height: 56px;\n    resize: none;\n    outline: none;\n    transition: border-color 0.3s ease-in-out;\n\n    &:focus {\n        border-color: $primary;\n    }\n}\n\n.textareaContainerLoading {\n    &::before {\n        content: "";\n        position: absolute;\n        top: 0;\n        left: 0;\n        width: 100%;\n        height: 100%;\n        background: $graphic-1;\n    }\n}\n\n.textareaLoader {\n    z-index: 2;\n    top: 50%;\n    left: 50%;\n    translate: -50% -50%;\n}\n/*\n    Results popup styles\n*/\n\n.resultsPopup {\n    width: 445px;\n    z-index: 46;\n    transition-property: box-shadow, opacity, visibility;\n    transition-duration: 0.3s;\n    transition-timing-function: ease-in-out;\n\n    &:hover {\n        box-shadow: 0px 2px 20px 0px rgba($black, 0.1);\n    }\n\n    @media (max-width: $screen-xs-max) {\n        width: 350px;\n        max-width: 80vw;\n    }\n}\n\n.resultsContent {\n    max-height: 328px;\n    overflow: auto;\n}\n\n.closeButton {\n    top: 50%;\n    right: $base-offset * 2;\n    transform: translateY(-50%);\n    background: none;\n    border: 0;\n    padding: 0;\n}\n\n.suggestionItem {\n    border-bottom: 1px solid $subtext;\n\n    &:not(:last-child) {\n        padding-bottom: $base-offset;\n    }\n}\n\n.suggestionItemContent {\n    flex-grow: 1;\n}\n\n.secondaryButton {\n    background: none;\n    border: 0;\n    padding: 4px;\n    color: $label;\n}\n\n/*\n    Job context popup styles\n*/\n\n.jobAdInputContainer {\n    border-bottom: 1px solid $subtext;\n}\n/*\n    Helper styles\n*/\n.loading {\n    opacity: 0.5;\n    pointer-events: none;\n}\n\n/*\n    Icon styles\n*/\n\n.animatedIcon {\n    &::before {\n        animation: iconsRoll 9s infinite linear;\n    }\n}\n\n.skillItem {\n    border-radius: 30px;\n    transition: transform 0.3s ease;\n\n    &:hover {\n        transform: scale(1.02);\n    }\n}\n\n@keyframes iconsRoll {\n    0% {\n        opacity: 1;\n        content: "\\e13e";\n    }\n\n    17% {\n        opacity: 0;\n    }\n\n    31% {\n        opacity: 1;\n    }\n\n    33% {\n        opacity: 1;\n        content: "\\e12e";\n    }\n\n    50% {\n        opacity: 0;\n    }\n\n    64% {\n        opacity: 1;\n    }\n\n    66% {\n        opacity: 1;\n        content: "\\e160";\n    }\n\n    83% {\n        opacity: 0;\n    }\n\n    98% {\n        opacity: 1;\n    }\n\n    100% {\n        opacity: 1;\n        content: "\\e13e";\n    }\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n$primary: #2dc08d;\n$secondary: #8c7cdb;\n$accent: #e3e9f5;\n$info: #3f9cdc;\n$warning: #feb251;\n$danger: #ff576f;\n$white: #ffffff;\n$black: #000000;\n\n// // Hover elements\n$primary-hover: #57cda4;\n$secondary-hover: #a396e2;\n$danger-hover: #ff687d;\n$info-hover: #52a6df;\n$warning-hover: #feba62;\n\n// // Active elements\n$primary-active: #249a71;\n$secondary-active: #5f4dc7;\n$info-active: #3685bb;\n$warning-active: #d89745;\n$danger-active: #d94a5e;\n\n// // Transparent elements\n// // // opacity: 10%;\n$primary-10: rgba($primary, 0.1);\n$secondary-10: rgba(