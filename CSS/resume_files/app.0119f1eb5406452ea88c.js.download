c-module_companyName__eMFRR{font-weight:400;padding-right:13px}.PublicationItemClassic-module_datePeriod__PejGu{position:relative;top:-1px;font-size:12px}.PublicationItemClassic-module_link__y2k1I{margin-bottom:5px}.PublicationItemClassic-module_formatBullets__hskJB ul{list-style:none;padding-left:16px}.PublicationItemClassic-module_formatBullets__hskJB ul li::before{content:"•";position:absolute;vertical-align:middle;left:4px}',"",{version:3,sources:["webpack://./src/packages/Resume/ItemTypes/Publication/PublicationItemClassic.module.scss"],names:[],mappings:"AAAA,iDAEA,iBACI,CAAA,eACA,CAAA,iBACA,CAAA,eACA,CAAA,kDAGJ,eACI,CAAA,kBACA,CAAA,iDAGJ,iBACI,CAAA,QACA,CAAA,cAEA,CAAA,2CAGJ,iBACI,CAAA,uDAIA,eACI,CAAA,iBACA,CAAA,kEAGI,WACI,CAAA,iBACA,CAAA,qBACA,CAAA,QACA",sourcesContent:['@import "~sharedstyle/variables";\n\n.itemAuthor {\n    position: relative;\n    padding-top: 5px;\n    font-style: italic;\n    font-weight: 400;\n}\n\n.companyName {\n    font-weight: 400;\n    padding-right: 13px;\n}\n\n.datePeriod {\n    position: relative;\n    top: -1px;\n    // TODO: remove when datePriod font size changing is ready\n    font-size: 12px;\n}\n\n.link {\n    margin-bottom: 5px;\n}\n\n.formatBullets {\n    ul {\n        list-style: none;\n        padding-left: 16px;\n\n        li {\n            &::before {\n                content: "•";\n                position: absolute;\n                vertical-align: middle;\n                left: 4px;\n            }\n        }\n    }\n}\n'],sourceRoot:""}]),l.locals={itemAuthor:"PublicationItemClassic-module_itemAuthor__VHVbw",companyName:"PublicationItemClassic-module_companyName__eMFRR",datePeriod:"PublicationItemClassic-module_datePeriod__PejGu",link:"PublicationItemClassic-module_link__y2k1I",formatBullets:"PublicationItemClassic-module_formatBullets__hskJB"};const i=l},"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].use[2]!./node_modules/sass-load