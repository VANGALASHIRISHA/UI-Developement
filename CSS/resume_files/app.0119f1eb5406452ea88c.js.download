cale(1.1);\n    }\n}\n\n@keyframes animate {\n    20% {\n        transform: translateY(-10px);\n    }\n\n    40% {\n        transform: translateY(-5px);\n    }\n\n    60% {\n        transform: translateY(-10px);\n    }\n}\n\n.arrow {\n    width: 50px;\n    animation: arrow 3s infinite;\n    position: absolute;\n    top: 46%;\n    left: 46%;\n    transform-origin: center;\n}\n\n.arrowMobile {\n    font-size: 24px;\n}\n\n.fileType {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n\n    @media (max-width: $screen-xs-max) {\n        max-width: 56px;\n        top: 38%;\n    }\n}\n\n.resume {\n    height: 305px;\n\n    @media (max-width: $screen-sm-max) {\n        //max-height: 195px;\n        width: 100%;\n        height: auto;\n    }\n}\n\n@keyframes arrow {\n    50% {\n        transform: scale(1.3);\n    }\n}\n\n@keyframes arrowMobile {\n    50% {\n        transform: scale(1.3) rotate(90deg);\n    }\n}\n\n.size {\n    display: inline;\n    position: relative;\n    white-space: nowrap;\n    border-radius: 20px;\n}\n\n.sizeContainer {\n    transform: translate(0, -24px);\n\n    @media screen and (max-width: $screen-sm-max) {\n        transform: translate(0, 0);\n    }\n}\n\n.borderBottom {\n    border-bottom-left-radius: $base-offset;\n    border-bottom-right-radius: $base-offset;\n}\n\n.borderDanger {\n    border-color: $danger;\n}\n\n.borderPrimary {\n    border-color: $primary;\n}\n','// Base Offset\n$base-offset: 8px;\n\n// Breakpoints\n\n// Phones\n$screen-xs-max: 480px;\n// Big Phones, Small Tablets\n$screen-sm-min: 481px;\n$screen-sm-max: 768px;\n// Tablets\n$screen-md-min: 769px;\n$screen-md-max: 992px;\n// Big Tablets, Small Laptops\n$screen-lg-min: 993px;\n$screen-lg-max: 1200px;\n// Big Laptops, Desktops\n$screen-xl-min: 1201px;\n\n// Custom breakpoints\n$screen-tablet-max: 1280px;\n$screen-xxl-min: 1401px;\n\n$resolutions: "xs", "xsm", "sm", "md", "lg", "xl", "mxl";\n\n// Colors\n\n// // Default Colors Palette\n